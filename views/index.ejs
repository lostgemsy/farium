<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farium</title>

    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/gif" href="/logo.gif">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #000000;
            --bg-2: #050505;
            --bg-3: #0a0a0a;
            --text: #f5f5f7;
            --text-dim: rgba(255,255,255,.42);
            --text-dim-2: rgba(255,255,255,.68);
            --card: rgba(255,255,255,.04);
            --card-hover: rgba(255,255,255,.075);
            --card-border: rgba(255,255,255,.08);
            --card-border-hover: rgba(255,255,255,.26);
            --input-bg: rgba(255,255,255,.045);
            --input-border: rgba(255,255,255,.1);
            --input-border-focus: rgba(255,255,255,.4);
            --shadow: rgba(0,0,0,.8);
            --accent: #7c8cff;
            --accent-2: #b47cff;
            --accent-glow: rgba(124,140,255,.28);
            --ring: rgba(124,140,255,.28);
        }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes slideRight { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes logoDrop {
            0% { opacity:0; transform:translateY(-40px) scale(.8); }
            70% { opacity:1; transform:translateY(4px) scale(1.02); }
            100% { opacity:1; transform:none; }
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes snowFall {
            0%   { transform: translate3d(0, -30px, 0); }
            100% { transform: translate3d(var(--drift, 0px), 110vh, 0); }
        }

        html, body {
            background: #000;
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            min-height: 100vh;
        }

        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            background: #000;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(700px 500px at 50% 50%, rgba(124,140,255,.05), transparent 65%);
            z-index: 0;
            pointer-events: none;
        }

        /* ============ SNOW ============ */
        .snow-layer {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            overflow: hidden;
            contain: strict;
        }
        .snowflake {
            position: absolute;
            top: -30px;
            width: var(--size, 10px);
            height: var(--size, 10px);
            background-image: url('/snowParticle.png');
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            opacity: var(--opacity, .75);
            will-change: transform;
            animation: snowFall linear infinite;
            animation-duration: var(--dur, 8s);
            animation-delay: var(--delay, 0s);
            transform: translate3d(0,0,0);
        }

        /* ============ COUNTDOWN ============ */
        .countdown {
            position: fixed;
            top: 14px;
            left: 14px;
            z-index: 110;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 3px;
            padding: 9px 14px;
            border-radius: 14px;
            background: #0a0a0a;
            border: 1px solid var(--card-border);
            color: var(--text);
            font-size: 12px;
            font-weight: 600;
            pointer-events: none;
            user-select: none;
            animation: fadeIn .4s ease;
        }
        .countdown .label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1.4px;
            color: var(--text-dim);
            font-weight: 700;
        }
        .countdown .value {
            display: flex;
            align-items: baseline;
            gap: 4px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .countdown .value .num { font-size: 18px; line-height: 1; letter-spacing: -0.5px; }
        .countdown .value .unit { font-size: 10px; letter-spacing: 1px; text-transform: uppercase; opacity: .85; }
        .countdown .sub { font-size: 9.5px; color: var(--text-dim); font-weight: 500; }

        /* ============ RIGHT SIDE PANEL ============ */
        .side-dock {
            position: fixed;
            top: 0;
            bottom: 0;
            right: 0;
            z-index: 100;
            width: 130px;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            justify-content: center;
            gap: 6px;
            padding: 18px 12px;
            background: #0a0a0a;
            border-left: 1px solid var(--card-border);
            animation: slideRight .4s cubic-bezier(.2,.9,.25,1.15) both;
        }
        .side-dock::before {
            content: "";
            position: absolute;
            left: 0;
            top: 18%;
            bottom: 18%;
            width: 2px;
            background: linear-gradient(180deg, transparent, var(--accent), var(--accent-2), transparent);
            opacity: .5;
            pointer-events: none;
        }

        .dock-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            height: 44px;
            padding: 0 14px;
            border-radius: 12px;
            text-decoration: none;
            color: var(--text-dim-2);
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: .3px;
            background: transparent;
            border: 1px solid transparent;
            transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;
            cursor: pointer;
            will-change: transform;
            font-family: inherit;
        }
        .dock-btn .label { flex: 1; text-align: left; }
        .dock-btn svg {
            width: 17px;
            height: 17px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
            transition: stroke .2s ease, transform .25s ease;
        }
        .dock-btn:hover {
            color: var(--text);
            background: var(--card-hover);
            border-color: var(--card-border-hover);
            transform: translateY(-3px) scale(1.04);
            box-shadow: 0 10px 24px -10px var(--shadow);
        }
        .dock-btn:hover svg { stroke: var(--accent); transform: scale(1.08); }
        .dock-btn:active { transform: translateY(-1px) scale(1.01); }
        .dock-btn.active {
            color: var(--text);
            background: var(--card);
            border-color: var(--card-border);
        }
        .dock-btn.games-btn {
            background: linear-gradient(135deg, rgba(124,140,255,.16), rgba(180,124,255,.12));
            border: 1px solid rgba(124,140,255,.3);
            color: var(--text);
        }
        .dock-btn.games-btn svg { stroke: var(--accent); }
        .dock-btn.games-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border-color: transparent;
            color: #fff;
            transform: translateY(-3px) scale(1.06);
            box-shadow: 0 12px 28px -10px var(--accent-glow);
        }
        .dock-btn.games-btn:hover svg { stroke: #fff; }
        .dock-sep {
            height: 1px;
            margin: 4px 6px;
            background: linear-gradient(90deg, transparent, var(--card-border), transparent);
        }

        /* ============ MAIN CONTENT ============ */
        .main-content {
            position: relative;
            z-index: 2;
            text-align: center;
            width: 100%;
            max-width: 620px;
            padding: 0 20px;
            margin-right: 130px;
        }
        .logo-image-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 18px;
            min-height: 120px;
            animation: logoDrop .6s cubic-bezier(.16,1,.3,1) both;
        }
        .farius-logo {
            display: block;
            width: auto;
            height: auto;
            max-width: min(420px, 70vw);
            max-height: 220px;
            object-fit: contain;
            transition: transform .3s ease;
        }
        .logo-image-wrap:hover .farius-logo { transform: translateY(-4px) scale(1.03); }

        .tagline {
            font-size: 0.7rem;
            color: var(--text-dim);
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 26px;
            font-weight: 600;
        }
        .search-container {
            display: flex;
            align-items: center;
            max-width: 500px;
            margin: 0 auto;
            background: #0a0a0a;
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 5px;
            box-shadow: 0 14px 40px -16px var(--shadow);
            animation: slideUp 0.4s ease;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .search-container:focus-within {
            border-color: var(--input-border-focus);
            box-shadow: 0 0 0 3px var(--ring);
        }
        .search-input {
            flex: 1;
            border: none;
            padding: 12px 16px;
            font-size: 0.9rem;
            outline: none;
            background: transparent;
            color: var(--text);
            font-family: inherit;
        }
        .search-input::placeholder { color: var(--text-dim); }
        .search-button {
            background: linear-gradient(180deg, var(--accent), #5a6bff);
            border: none;
            border-radius: 12px;
            padding: 11px 20px;
            cursor: pointer;
            outline: none;
            color: white;
            font-size: 14px;
            font-weight: 700;
            transition: transform 0.15s, box-shadow 0.15s;
            font-family: inherit;
            box-shadow: 0 8px 22px -8px var(--accent-glow);
        }
        .search-button:hover { transform: translateY(-1px); box-shadow: 0 12px 28px -8px var(--accent-glow); }
        .search-button:active { transform: scale(0.96); }

        .app-buttons {
            display: flex;
            justify-content: center;
            margin-top: 20px;
            gap: 10px;
            flex-wrap: wrap;
            animation: slideUp 0.4s ease 0.1s both;
        }
        .app-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            height: 46px;
            border-radius: 13px;
            background: #0a0a0a;
            cursor: pointer;
            outline: none;
            border: 1px solid var(--card-border);
            color: var(--text);
            text-decoration: none;
            transition: transform 0.2s, border-color 0.2s, background 0.2s;
            box-shadow: 0 6px 18px -8px var(--shadow);
        }
        .app-button:hover {
            background: var(--card-hover);
            border-color: var(--card-border-hover);
            transform: translateY(-3px);
        }
        .app-button:active { transform: scale(0.92); }
        .app-button img { width: 24px; height: 24px; object-fit: contain; opacity: 0.9; }
        .app-button:hover img { opacity: 1; }
        #add-app-button {
            background: transparent;
            border: 1.5px dashed var(--input-border);
        }
        #add-app-button:hover { border-color: var(--accent); background: var(--card); }
        #add-app-button svg { stroke: var(--text) !important; }

        /* ============ BROWSER OVERLAY ============ */
        .browser-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: none;
            flex-direction: column;
            background: #000;
        }
        .browser-overlay.open { display: flex; }

        .tabs-bar {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 8px 12px 0;
            background: #0a0a0a;
            border-bottom: 1px solid var(--card-border);
            overflow-x: auto;
            flex-shrink: 0;
            scrollbar-width: none;
        }
        .tabs-bar::-webkit-scrollbar { display: none; }

        .tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px 8px 12px;
            border-radius: 10px 10px 0 0;
            background: transparent;
            border: 1px solid transparent;
            border-bottom: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 12px;
            white-space: nowrap;
            max-width: 200px;
            min-width: 90px;
            transition: background 0.15s, color 0.15s;
            flex-shrink: 0;
        }
        .tab:hover { background: var(--card); color: var(--text); }
        .tab.active {
            background: var(--card);
            color: var(--text);
            border-color: var(--card-border);
            font-weight: 600;
            box-shadow: inset 0 2px 0 0 var(--accent);
        }
        .tab-favicon {
            width: 14px; height: 14px;
            border-radius: 3px;
            flex-shrink: 0;
            object-fit: contain;
            background: rgba(255,255,255,.06);
        }
        .tab-favicon-placeholder {
            width: 14px; height: 14px;
            border-radius: 3px;
            flex-shrink: 0;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 8px;
            font-weight: 900;
        }
        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
        .tab-close {
            width: 16px; height: 16px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 10px;
            opacity: 0;
            transition: opacity .15s;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }
        .tab:hover .tab-close, .tab.active .tab-close { opacity: 1; }
        .tab-close:hover { background: rgba(220,38,38,0.22); color: #ff7b7b; }

        .new-tab-btn {
            width: 26px; height: 26px;
            border-radius: 8px;
            border: 1px dashed var(--input-border);
            background: transparent;
            cursor: pointer;
            color: var(--text-dim);
            font-size: 15px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 4px;
            margin-bottom: 4px;
            transition: border-color .15s, color .15s;
        }
        .new-tab-btn:hover { border-color: var(--accent); color: var(--text); }

        .browser-toolbar {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 10px 14px;
            background: #0a0a0a;
            border-bottom: 1px solid var(--card-border);
            flex-shrink: 0;
        }
        .browser-toolbar button {
            width: 34px; height: 34px;
            border-radius: 9px;
            border: none;
            background: transparent;
            color: var(--text-dim-2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s, color .15s;
        }
        .browser-toolbar button:hover:not(:disabled) { background: var(--card); color: var(--text); }
        .browser-toolbar button:active:not(:disabled) { transform: scale(0.94); }
        .browser-toolbar button:disabled { opacity: 0.25; cursor: not-allowed; }
        .browser-toolbar svg {
            width: 16px; height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        .browser-address {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: 18px;
            padding: 0 14px;
            height: 36px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .browser-address:focus-within {
            border-color: var(--input-border-focus);
            box-shadow: 0 0 0 3px var(--ring);
        }
        .browser-address .lock-icon {
            width: 13px; height: 13px;
            stroke: var(--text-dim);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
        }
        .browser-address input {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--text);
            font-size: 12.5px;
            outline: none;
            font-family: inherit;
            font-weight: 500;
        }
        .browser-address input::placeholder { color: var(--text-dim); font-weight: 400; }
        .browser-loader {
            width: 14px; height: 14px;
            border: 2px solid var(--card-border);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            flex-shrink: 0;
            display: none;
        }
        .browser-loader.visible { display: block; }

        .browser-frame-wrap {
            flex: 1;
            position: relative;
            background: var(--bg-2);
        }
        .browser-frame-wrap iframe {
            width: 100%; height: 100%;
            border: none;
            background: #fff;
            display: none;
        }
        .browser-frame-wrap iframe.visible { display: block; }

        .new-tab-page {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #050505;
            z-index: 1;
        }
        .new-tab-page.hidden { display: none; }
        .new-tab-logo {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 14px;
        }
        .new-tab-logo img {
            width: auto; height: auto;
            max-width: min(260px, 60vw);
            max-height: 130px;
            object-fit: contain;
        }
        .new-tab-sub {
            font-size: 0.7rem;
            color: var(--text-dim);
            letter-spacing: 2.5px;
            text-transform: uppercase;
            margin-bottom: 26px;
            font-weight: 600;
        }
        .new-tab-search {
            display: flex;
            align-items: center;
            gap: 8px;
            max-width: 440px;
            width: 85%;
        }
        .new-tab-search input {
            flex: 1;
            background: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: 14px;
            padding: 13px 18px;
            color: var(--text);
            font-size: 13.5px;
            outline: none;
            font-family: inherit;
            transition: border-color .2s, box-shadow .2s;
        }
        .new-tab-search input::placeholder { color: var(--text-dim); }
        .new-tab-search input:focus {
            border-color: var(--input-border-focus);
            box-shadow: 0 0 0 3px var(--ring);
        }
        .new-tab-search button {
            background: linear-gradient(180deg, var(--accent), #5a6bff);
            border: none;
            border-radius: 14px;
            padding: 13px 22px;
            color: white;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
            font-size: 13.5px;
            transition: transform .15s;
            box-shadow: 0 8px 22px -8px var(--accent-glow);
        }
        .new-tab-search button:hover { transform: translateY(-1px); }
        .new-tab-search button:active { transform: scale(0.96); }

        .venusFooter {
            position: fixed;
            bottom: 14px;
            left: 22px;
            color: var(--text-dim);
            font-size: 10px;
            text-decoration: none;
            z-index: 10;
            transition: color .2s;
        }
        .venusFooter:hover { color: var(--text); }

        .page-slide {
            position: fixed;
            inset: 0;
            z-index: 30000;
            background: #000;
            transform: translateX(100%);
            transition: transform .45s cubic-bezier(.65, 0, .35, 1);
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
            will-change: transform;
        }
        .page-slide::after {
            content: "";
            width: 40px; height: 40px;
            border: 3px solid var(--input-border);
            border-top-color: var(--accent);
            border-radius: 50%;
            opacity: 0;
        }
        .page-slide.active { transform: translateX(0); pointer-events: auto; }
        .page-slide.active::after {
            opacity: 1;
            animation: spin .8s linear infinite;
        }
        .page-slide.enter { transform: translateX(0); transition: none; }
        .page-slide.enter.leaving {
            transform: translateX(-100%);
            transition: transform .45s cubic-bezier(.65, 0, .35, 1);
        }

        @media (max-width: 720px) {
            .side-dock { width: 60px; padding: 14px 6px; gap: 4px; }
            .dock-btn { height: 42px; padding: 0; justify-content: center; gap: 0; }
            .dock-btn .label { display: none; }
            .dock-btn svg { width: 20px; height: 20px; }
            .main-content { margin-right: 60px; padding: 0 12px; }
            .farius-logo { max-width: min(300px, 78vw); max-height: 150px; }
            .logo-image-wrap { min-height: 90px; margin-bottom: 14px; }
            .search-container { max-width: 100%; }
            .app-button { width: 42px; height: 42px; border-radius: 12px; }
            .countdown { padding: 8px 12px; top: 10px; left: 10px; }
            .countdown .value .num { font-size: 16px; }
            .tab { max-width: 140px; min-width: 70px; }
            .browser-toolbar { padding: 8px; gap: 3px; }
            .browser-toolbar button { width: 30px; height: 30px; }
            .browser-address { height: 32px; padding: 0 10px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>

    <!-- Background music — starts as soon as possible -->
    <audio id="bg-music" src="/Lamour-song.mp3" loop preload="auto" autoplay playsinline></audio>

    <!-- Snow -->
    <div class="snow-layer" id="snowLayer" aria-hidden="true"></div>

    <!-- Countdown -->
    <div class="countdown" id="xmasCountdown" aria-live="polite">
        <span class="label">🎄 Until Christmas</span>
        <div class="value"><span class="num" id="xmasNum">--</span><span class="unit" id="xmasUnit">days</span></div>
        <span class="sub" id="xmasSub">loading…</span>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content" id="main-content">
        <div class="logo-image-wrap"><img class="farius-logo" src="/logo.gif" alt="Farium"></div>
        <div class="tagline">Browse Freely</div>
        <div class="search-container">
            <input type="text" class="search-input" id="search-input" placeholder="Search or enter a URL..." autocomplete="off">
            <button class="search-button" id="search-go">Go</button>
        </div>
        <div class="app-buttons" id="app-buttons">
            <div class="app-button" data-url="https://discord.com">
                <img src="/assets/svg/discord.svg" alt="Discord">
            </div>
            <div class="app-button" data-url="https://youtube.com">
                <img src="/assets/svg/youtube.svg" alt="YouTube">
            </div>
            <div class="app-button" data-url="https://spotify.com">
                <img src="/assets/svg/spotify.svg" alt="Spotify">
            </div>
            <div class="app-button" data-url="https://github.com">
                <img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="GitHub">
            </div>
            <div class="app-button" id="add-app-button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE PANEL -->
    <nav class="side-dock" aria-label="Site navigation">
        <a href="/" class="dock-btn active" title="Home">
            <span class="label">Home</span>
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </a>
        <a href="/settings" class="dock-btn" title="Settings">
            <span class="label">Settings</span>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </a>
        <div class="dock-sep" aria-hidden="true"></div>
        <a href="/gnmath.html" class="dock-btn games-btn" id="gamesBtn" title="Play Games">
            <span class="label">Games</span>
            <svg viewBox="0 0 24 24">
                <rect x="2" y="6" width="20" height="12" rx="3"/>
                <path d="M6 12h4M8 10v4M15 11h.01M17.5 13h.01"/>
            </svg>
        </a>
    </nav>

    <!-- BROWSER OVERLAY -->
    <div class="browser-overlay" id="browser-overlay">
        <div class="tabs-bar" id="tabs-bar">
            <button class="new-tab-btn" id="new-tab-btn" title="New Tab">+</button>
        </div>

        <div class="browser-toolbar">
            <button id="browser-back" title="Back">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button id="browser-forward" title="Forward">
                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <button id="browser-refresh" title="Refresh">
                <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
            </button>
            <button id="browser-home" title="Home">
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
            </button>
            <div class="browser-address">
                <svg class="lock-icon" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <input type="text" id="browser-url-input" placeholder="Search or enter URL..." autocomplete="off">
                <div class="browser-loader" id="browser-loader"></div>
            </div>
            <button id="browser-fullscreen" title="Toggle Fullscreen">
                <svg viewBox="0 0 24 24">
                    <path d="M4 9V5a1 1 0 0 1 1-1h4M20 9V5a1 1 0 0 0-1-1h-4M4 15v4a1 1 0 0 0 1 1h4M20 15v4a1 1 0 0 1-1 1h-4"/>
                </svg>
            </button>
            <button id="browser-close" title="Close">
                <svg viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
            </button>
        </div>

        <div class="browser-frame-wrap">
            <iframe id="browser-frame" src="" referrerpolicy="no-referrer" allowfullscreen></iframe>
            <div class="new-tab-page" id="new-tab-page">
                <div class="new-tab-logo"><img src="/logo.gif" alt="Farium"></div>
                <div class="new-tab-sub">Browse Freely</div>
                <div class="new-tab-search">
                    <input type="text" id="new-tab-search-input" placeholder="Search or enter URL..." autocomplete="off">
                    <button id="new-tab-search-btn">Go</button>
                </div>
            </div>
        </div>
    </div>

    <a href="#" class="venusFooter">Venus integration</a>

    <div class="page-slide" id="pageSlide"></div>

    <script>
        let tabs = [];
        let activeTabId = null;

        class Tab {
            constructor(id, url, title) {
                this.id = id;
                this.url = url || null;
                this.title = title || 'New Tab';
                this.history = [];
                this.historyIndex = -1;
                this.favicon = null;
            }
            pushHistory(url) {
                if (this.historyIndex < this.history.length - 1) {
                    this.history = this.history.slice(0, this.historyIndex + 1);
                }
                this.history.push(url);
                this.historyIndex = this.history.length - 1;
            }
            canGoBack() { return this.historyIndex > 0; }
            canGoForward() { return this.historyIndex < this.history.length - 1; }
        }

        function createTabId() {
            return 't' + Date.now() + Math.random().toString(36).substr(2, 4);
        }

        function normalizeUrl(query) {
            query = String(query).trim();
            if (!query) return null;
            if (/^https?:\/\//i.test(query)) return query;
            if (query.includes('.') && !query.includes(' ')) return 'https://' + query;
            const engine = localStorage.getItem('search') || 'https://www.google.com/search?q=';
            return engine + encodeURIComponent(query);
        }

        function getProxyUrl(url) {
            return __uv$config.prefix + __uv$config.encodeUrl(url);
        }

        function getHostname(url) {
            try { return new URL(url).hostname.replace('www.', ''); } catch(e) { return url.substring(0, 20); }
        }

        function getFaviconUrl(url) {
            try {
                const u = new URL(url);
                return `https://www.google.com/s2/favicons?domain=${u.hostname}&sz=32`;
            } catch(e) { return null; }
        }

        function addTab(url, title) {
            const id = createTabId();
            const tab = new Tab(id, url, title || (url ? getHostname(url) : 'New Tab'));
            if (url) tab.favicon = getFaviconUrl(url);
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) navigateInTab(id, url);
            return tab;
        }

        function closeTab(id) {
            if (tabs.length <= 1) {
                tabs = [];
                addTab(null);
                return;
            }
            const idx = tabs.findIndex(t => t.id === id);
            if (idx === -1) return;
            tabs.splice(idx, 1);
            if (activeTabId === id) {
                const ni = Math.min(idx, tabs.length - 1);
                activeTabId = tabs[ni].id;
                updateActiveTab();
            }
            renderTabs();
        }

        function switchTab(id) {
            activeTabId = id;
            updateActiveTab();
            renderTabs();
        }

        function updateActiveTab() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) return;
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');

            if (tab.url) {
                frame.classList.add('visible');
                newTabPage.classList.add('hidden');
                urlInput.value = tab.url;
            } else {
                frame.classList.remove('visible');
                newTabPage.classList.remove('hidden');
                urlInput.value = '';
            }

            document.getElementById('browser-back').disabled = !tab.canGoBack();
            document.getElementById('browser-forward').disabled = !tab.canGoForward();
        }

        function navigateInTab(id, url) {
            const tab = tabs.find(t => t.id === id);
            if (!tab) return;
            tab.pushHistory(url);
            tab.url = url;
            tab.title = getHostname(url);
            tab.favicon = getFaviconUrl(url);
            renderTabs();
            if (activeTabId === id) loadUrl(url);
        }

        function loadUrl(url) {
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');
            const loader = document.getElementById('browser-loader');

            frame.classList.add('visible');
            newTabPage.classList.add('hidden');
            urlInput.value = url;
            loader.classList.add('visible');
            frame.src = getProxyUrl(url);
        }

        document.addEventListener('DOMContentLoaded', () => {
            const frame = document.getElementById('browser-frame');
            if (frame) {
                frame.addEventListener('load', () => {
                    const loader = document.getElementById('browser-loader');
                    if (loader) loader.classList.remove('visible');
                });
            }
        });

        function renderTabs() {
            const tabsBar = document.getElementById('tabs-bar');
            tabsBar.querySelectorAll('.tab').forEach(el => el.remove());

            const frag = document.createDocumentFragment();

            tabs.forEach(tab => {
                const el = document.createElement('div');
                el.className = 'tab' + (tab.id === activeTabId ? ' active' : '');

                if (tab.favicon) {
                    const img = document.createElement('img');
                    img.className = 'tab-favicon';
                    img.src = tab.favicon;
                    img.alt = '';
                    img.onerror = () => { img.replaceWith(makeFaviconPlaceholder(tab.title)); };
                    el.appendChild(img);
                } else {
                    el.appendChild(makeFaviconPlaceholder(tab.title));
                }

                const titleEl = document.createElement('span');
                titleEl.className = 'tab-title';
                titleEl.textContent = tab.title || 'New Tab';
                el.appendChild(titleEl);

                if (tabs.length > 1) {
                    const cb = document.createElement('button');
                    cb.className = 'tab-close';
                    cb.textContent = '×';
                    cb.addEventListener('click', (e) => { e.stopPropagation(); closeTab(tab.id); });
                    el.appendChild(cb);
                }

                el.addEventListener('click', () => switchTab(tab.id));
                frag.appendChild(el);
            });

            tabsBar.insertBefore(frag, document.getElementById('new-tab-btn'));
        }

        function makeFaviconPlaceholder(title) {
            const d = document.createElement('div');
            d.className = 'tab-favicon-placeholder';
            d.textContent = (title || 'N')[0].toUpperCase();
            return d;
        }

        function openBrowser(url) {
            const overlay = document.getElementById('browser-overlay');
            overlay.classList.add('open');
            addTab(url);
        }

        function closeBrowser() {
            const overlay = document.getElementById('browser-overlay');
            overlay.classList.remove('open');
            tabs = [];
            activeTabId = null;
        }

        async function initProxy() {
            if ('serviceWorker' in navigator) {
                try {
                    await navigator.serviceWorker.register('/sw.js');
                    await navigator.serviceWorker.ready;
                } catch (err) {}
            }
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {}
        }

        /* ============ BACKGROUND MUSIC — starts on entry ============ */
        (function initBackgroundMusic() {
            const music = document.getElementById('bg-music');
            if (!music) return;
            music.volume = 1.0;
            music.loop = true;

            function tryPlay() {
                const p = music.play();
                if (p && typeof p.catch === 'function') p.catch(() => {});
            }

            // Try immediately at various stages
            tryPlay();
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', tryPlay, { once: true });
            }
            window.addEventListener('load', tryPlay, { once: true });

            // Fallback: start on the first user interaction
            function startOnce() {
                tryPlay();
                document.removeEventListener('click', startOnce);
                document.removeEventListener('touchstart', startOnce);
                document.removeEventListener('keydown', startOnce);
                document.removeEventListener('mousemove', startOnce);
                document.removeEventListener('scroll', startOnce);
                document.removeEventListener('pointerdown', startOnce);
            }
            document.addEventListener('click', startOnce);
            document.addEventListener('touchstart', startOnce);
            document.addEventListener('keydown', startOnce);
            document.addEventListener('mousemove', startOnce);
            document.addEventListener('scroll', startOnce);
            document.addEventListener('pointerdown', startOnce);

            // Auto-recover if it gets paused
            music.addEventListener('pause', () => { setTimeout(() => { if (music.paused) tryPlay(); }, 200); });
            music.addEventListener('ended', () => { music.currentTime = 0; tryPlay(); });
        })();

        /* ============ SNOW ============ */
        (function initSnow() {
            const layer = document.getElementById('snowLayer');
            if (!layer) return;
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduced) return;

            const isSmallScreen = window.innerWidth < 900;
            const isLowPower = (navigator.hardwareConcurrency || 4) <= 4;
            const count = isLowPower || isSmallScreen ? 35 : 60;

            const frag = document.createDocumentFragment();
            for (let i = 0; i < count; i++) {
                const el = document.createElement('div');
                el.className = 'snowflake';
                const size = 6 + Math.random() * 14;
                const duration = 7 + Math.random() * 10;
                const drift = (Math.random() - 0.5) * 200;
                const opacity = 0.45 + Math.random() * 0.5;
                const startX = Math.random() * 100;
                el.style.left = startX + 'vw';
                el.style.setProperty('--size', size + 'px');
                el.style.setProperty('--drift', drift + 'px');
                el.style.setProperty('--opacity', opacity);
                el.style.setProperty('--dur', duration + 's');
                el.style.setProperty('--delay', (-Math.random() * duration) + 's');
                frag.appendChild(el);
            }
            layer.appendChild(frag);
        })();

        /* ============ CHRISTMAS COUNTDOWN ============ */
        (function initCountdown() {
            const numEl  = document.getElementById('xmasNum');
            const unitEl = document.getElementById('xmasUnit');
            const subEl  = document.getElementById('xmasSub');
            if (!numEl || !unitEl || !subEl) return;

            function nextChristmas(now) {
                const year = now.getFullYear();
                const thisYear = new Date(year, 11, 25, 0, 0, 0, 0);
                if (now.getTime() <= thisYear.getTime()) return thisYear;
                return new Date(year + 1, 11, 25, 0, 0, 0, 0);
            }
            function pad(n) { return String(n).padStart(2, '0'); }

            function tick() {
                const now = new Date();
                const xmas = nextChristmas(now);
                let diff = xmas.getTime() - now.getTime();
                const isXmasDay = now.getMonth() === 11 && now.getDate() === 25;
                if (isXmasDay) {
                    numEl.textContent = '🎁';
                    unitEl.textContent = 'today';
                    subEl.textContent = 'Merry Christmas!';
                    return;
                }
                const days    = Math.floor(diff / 86400000);
                const hours   = Math.floor((diff % 86400000) / 3600000);
                const minutes = Math.floor((diff % 3600000) / 60000);
                const seconds = Math.floor((diff % 60000) / 1000);
                if (days === 0) {
                    numEl.textContent = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
                    unitEl.textContent = '';
                    subEl.textContent = 'Almost here!';
                } else {
                    numEl.textContent = days;
                    unitEl.textContent = days === 1 ? 'day' : 'days';
                    subEl.textContent = `${pad(hours)}h ${pad(minutes)}m ${pad(seconds)}s`;
                }
            }
            tick();
            setInterval(tick, 1000);
        })();

        /* ============ FULLSCREEN TOGGLE ============ */
        (function initFullscreenToggle() {
            const btn = document.getElementById('browser-fullscreen');
            if (!btn) return;
            const target = document.getElementById('browser-overlay');

            btn.addEventListener('click', async () => {
                try {
                    if (!document.fullscreenElement) {
                        if (target.requestFullscreen) await target.requestFullscreen();
                        else if (target.webkitRequestFullscreen) target.webkitRequestFullscreen();
                    } else {
                        if (document.exitFullscreen) await document.exitFullscreen();
                        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                    }
                } catch (e) {}
            });

            function updateIcon() {
                const isFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
                btn.innerHTML = isFs
                    ? `<svg viewBox="0 0 24 24">
                           <path d="M9 4v4a1 1 0 0 1-1 1H4M15 4v4a1 1 0 0 0 1 1h4M9 20v-4a1 1 0 0 0-1-1H4M15 20v-4a1 1 0 0 1 1-1h4"/>
                       </svg>`
                    : `<svg viewBox="0 0 24 24">
                           <path d="M4 9V5a1 1 0 0 1 1-1h4M20 9V5a1 1 0 0 0-1-1h-4M4 15v4a1 1 0 0 0 1 1h4M20 15v4a1 1 0 0 1-1 1h-4"/>
                       </svg>`;
                btn.title = isFs ? "Exit Fullscreen" : "Toggle Fullscreen";
            }

            document.addEventListener('fullscreenchange', updateIcon);
            document.addEventListener('webkitfullscreenchange', updateIcon);
        })();

        document.addEventListener('DOMContentLoaded', () => {
            (function () {
                const slide = document.getElementById("pageSlide");
                if (sessionStorage.getItem("slideFrom")) {
                    sessionStorage.removeItem("slideFrom");
                    slide.classList.add("enter");
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            slide.classList.add("leaving");
                        });
                    });
                    setTimeout(() => {
                        slide.classList.remove("enter", "leaving");
                    }, 600);
                }
            })();

            const gamesBtn = document.getElementById("gamesBtn");
            if (gamesBtn) {
                gamesBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    const slide = document.getElementById("pageSlide");
                    slide.classList.add("active");
                    sessionStorage.setItem("slideFrom", "true");
                    setTimeout(() => {
                        window.location.href = "/gnmath.html";
                    }, 500);
                });
            }

            initProxy();
            const defaultBg = '/assets/backgrounds/foggy-forest.png';
            const savedBg = localStorage.getItem('bg') || defaultBg;
            document.body.style.backgroundImage = `url('${savedBg}')`;

            document.getElementById('search-go').addEventListener('click', () => {
                const url = normalizeUrl(document.getElementById('search-input').value);
                if (url) openBrowser(url);
            });
            document.getElementById('search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('search-go').click();
            });

            document.querySelectorAll('#app-buttons .app-button[data-url]').forEach(btn => {
                btn.addEventListener('click', () => openBrowser(btn.dataset.url));
            });

            document.getElementById('browser-close').addEventListener('click', closeBrowser);
            document.getElementById('browser-home').addEventListener('click', closeBrowser);
            document.getElementById('browser-back').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoBack()) {
                    tab.historyIndex--;
                    tab.url = tab.history[tab.historyIndex];
                    tab.title = getHostname(tab.url);
                    tab.favicon = getFaviconUrl(tab.url);
                    renderTabs();
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-forward').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoForward()) {
                    tab.historyIndex++;
                    tab.url = tab.history[tab.historyIndex];
                    tab.title = getHostname(tab.url);
                    tab.favicon = getFaviconUrl(tab.url);
                    renderTabs();
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-refresh').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.url) loadUrl(tab.url);
            });

            document.getElementById('browser-url-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    const url = normalizeUrl(e.target.value);
                    if (url) {
                        const tab = tabs.find(t => t.id === activeTabId);
                        if (tab) navigateInTab(activeTabId, url);
                    }
                }
            });

            document.getElementById('new-tab-btn').addEventListener('click', () => addTab(null));
            document.getElementById('new-tab-search-btn').addEventListener('click', () => {
                const input = document.getElementById('new-tab-search-input');
                const url = normalizeUrl(input.value);
                if (url) {
                    const tab = tabs.find(t => t.id === activeTabId);
                    if (tab) navigateInTab(activeTabId, url);
                    input.value = '';
                }
            });
            document.getElementById('new-tab-search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('new-tab-search-btn').click();
            });

            document.getElementById('add-app-button').addEventListener('click', () => {
                const name = prompt('App name:');
                if (!name) return;
                const url = prompt('URL (e.g. netflix.com):');
                if (!url) return;
                let fullUrl = url.startsWith('http') ? url : 'https://' + url;
                const domain = new URL(fullUrl).hostname;
                const btn = document.createElement('div');
                btn.className = 'app-button';
                btn.dataset.url = fullUrl;
                btn.innerHTML = `<img src="https://www.google.com/s2/favicons?domain=${domain}&sz=64" alt="${name}">`;
                btn.addEventListener('click', () => openBrowser(fullUrl));
                btn.addEventListener('contextmenu', (e) => { e.preventDefault(); btn.remove(); });
                document.getElementById('app-buttons').insertBefore(btn, document.getElementById('add-app-button'));
            });
        });
    </script>
