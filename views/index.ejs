<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farium</title>
    
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
        @keyframes rumble { 0%,100%{transform:translateX(0)} 15%{transform:translateX(-2px)} 30%{transform:translateX(2px)} 45%{transform:translateX(-1px)} 60%{transform:translateX(1px)} }
        @keyframes pulse { 0%,100%{box-shadow:0 0 20px rgba(0,0,0,0.15)} 50%{box-shadow:0 0 40px rgba(0,0,0,0.25)} }
        @keyframes tabIn { from { opacity: 0; transform: translateY(4px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes browserSlideIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes bounceIn { 0%{transform:scale(0.3);opacity:0} 50%{transform:scale(1.05)} 70%{transform:scale(0.95)} 100%{transform:scale(1);opacity:1} }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            margin: 0;
            padding: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #111;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.55);
            z-index: 0;
            pointer-events: none;
        }

        .topbar {
            position: fixed;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.85);
            border: 1px solid rgba(0,0,0,0.1);
            border-radius: 20px;
            padding: 5px 10px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            animation: fadeIn 0.4s ease;
        }

        .topbar a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            transition: all 0.2s;
            text-decoration: none;
            color: #111;
        }

        .topbar a:hover { background: rgba(0,0,0,0.06); }
        .topbar a.active { background: rgba(0,0,0,0.09); }
        .customize-button {
            display:flex; align-items:center; justify-content:center;
            width:34px; height:34px; border:0; border-radius:10px;
            background:transparent; color:#111; cursor:pointer;
            transition:all .2s;
        }
        .customize-button:hover {
            background:rgba(0,0,0,.08);
            color:#000;
        }
        .customize-button:active { animation:rumble .3s ease; }
        .customize-button svg { width:16px; height:16px; fill:none; stroke:currentColor;
            stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
        .topbar a:active { animation: rumble 0.3s ease; }

        .topbar svg {
            width: 16px;
            height: 16px;
            stroke: #111;
            fill: none;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .main-content {
            position: relative;
            z-index: 1;
            text-align: center;
            animation: fadeIn 0.6s ease;
            width: 100%;
            max-width: 650px;
            padding: 0 20px;
        }

        .logo-text {
            font-size: 2.5rem;
            font-weight: 900;
            letter-spacing: 6px;
            color: #111;
            margin-bottom: 4px;
            text-shadow: 0 2px 20px rgba(255,255,255,0.5);
        }

        .tagline {
            font-size: 0.75rem;
            color: rgba(0,0,0,0.5);
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 28px;
            font-weight: 500;
        }

        .search-container {
            display: flex;
            align-items: center;
            max-width: 520px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(0,0,0,0.1);
            border-radius: 16px;
            padding: 6px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 15px 45px rgba(0,0,0,0.08);
            animation: slideUp 0.6s ease;
            transition: all 0.3s;
        }

        .search-container:focus-within {
            border-color: #111;
            box-shadow: 0 0 30px rgba(0,0,0,0.1), 0 15px 45px rgba(0,0,0,0.1);
        }

        .search-input {
            flex: 1;
            border: none;
            padding: 13px 18px;
            font-size: 0.9rem;
            outline: none;
            background: transparent;
            color: #111;
            font-family: inherit;
        }

        .search-input::placeholder { color: rgba(0,0,0,0.35); }

        .search-button {
            background: #111;
            border: none;
            border-radius: 12px;
            padding: 11px 18px;
            cursor: pointer;
            outline: none;
            color: white;
            font-size: 15px;
            font-weight: 700;
            transition: all 0.2s;
            font-family: inherit;
            animation: pulse 2.5s infinite;
        }

        .search-button:hover { background: #333; transform: translateY(-1px); }
        .search-button:active { transform: scale(0.94); animation: rumble 0.3s ease; }

        .app-buttons {
            display: flex;
            justify-content: center;
            margin-top: 22px;
            gap: 10px;
            flex-wrap: wrap;
            animation: slideUp 0.6s ease 0.15s both;
        }

        .app-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            cursor: pointer;
            outline: none;
            border: 1px solid rgba(0,0,0,0.08);
            color: #111;
            text-decoration: none;
            transition: all 0.25s;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .app-button:hover {
            background: #ffffff;
            border-color: #111;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }

        .app-button:active { transform: scale(0.88); animation: rumble 0.3s ease; }
        .app-button img { width: 24px; height: 24px; object-fit: contain; opacity: 0.85; }
        .app-button:hover img { opacity: 1; }

        #add-app-button {
            background: rgba(255, 255, 255, 0.85);
            border: 1.5px dashed rgba(0,0,0,0.2);
        }

        #add-app-button:hover {
            border-color: #111;
            background: #ffffff;
        }

        #add-app-button svg { stroke: #111 !important; }

        /* BROWSER OVERLAY */
        .browser-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: none;
            flex-direction: column;
            background: #fafafa;
        }

        .browser-overlay.open {
            display: flex;
            animation: browserSlideIn 0.3s ease;
        }

        .browser-toolbar {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 8px 12px;
            background: #ffffff;
            border-bottom: 1px solid rgba(0,0,0,0.08);
            flex-shrink: 0;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        }

        .browser-toolbar button {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: none;
            background: transparent;
            color: #666;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .browser-toolbar button:hover { background: rgba(0,0,0,0.06); color: #111; }
        .browser-toolbar button:active { animation: rumble 0.3s ease; }

        .browser-toolbar svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .browser-address {
            flex: 1;
            display: flex;
            align-items: center;
            background: #f5f5f5;
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 16px;
            padding: 0 14px;
            height: 32px;
            transition: all 0.2s;
        }

        .browser-address:focus-within {
            border-color: #111;
            background: #ffffff;
            box-shadow: 0 0 20px rgba(0,0,0,0.06);
        }

        .browser-address input {
            flex: 1;
            background: transparent;
            border: none;
            color: #111;
            font-size: 12px;
            outline: none;
            font-family: inherit;
        }

        .browser-address input::placeholder { color: #aaa; }

        /* TABS BAR */
        .tabs-bar {
            display: flex;
            align-items: flex-end;
            gap: 2px;
            padding: 5px 8px 0;
            background: #f0f0f0;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            overflow-x: auto;
            flex-shrink: 0;
            scrollbar-width: none;
        }

        .tabs-bar::-webkit-scrollbar { display: none; }

        .tab {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: 8px 8px 0 0;
            background: transparent;
            border: 1px solid transparent;
            color: #666;
            cursor: pointer;
            font-size: 11px;
            white-space: nowrap;
            max-width: 140px;
            min-width: 60px;
            transition: all 0.15s;
            flex-shrink: 0;
            animation: tabIn 0.2s ease;
        }

        .tab:hover { background: rgba(0,0,0,0.04); color: #111; }
        .tab.active { background: #ffffff; color: #111; border-color: rgba(0,0,0,0.08); border-bottom-color: transparent; font-weight: 600; }

        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }

        .tab-close {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: #aaa;
            cursor: pointer;
            font-size: 9px;
            opacity: 0;
            transition: all 0.15s;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .tab:hover .tab-close, .tab.active .tab-close { opacity: 1; }
        .tab-close:hover { background: rgba(220,38,38,0.15); color: #dc2626; }

        .new-tab-btn {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            border: 1px dashed rgba(0,0,0,0.15);
            background: transparent;
            cursor: pointer;
            color: #999;
            font-size: 14px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 3px;
            margin-bottom: 4px;
            transition: all 0.2s;
        }

        .new-tab-btn:hover { border-color: #111; color: #111; background: rgba(0,0,0,0.05); }

        .browser-frame-wrap {
            flex: 1;
            position: relative;
            background: #fff;
        }

        .browser-frame-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
            display: none;
        }

        .browser-frame-wrap iframe.visible { display: block; }

        .new-tab-page {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #fafafa;
            z-index: 1;
        }

        .new-tab-page.hidden { display: none; }

        .new-tab-logo {
            font-size: 2rem;
            font-weight: 900;
            letter-spacing: 5px;
            color: #111;
            margin-bottom: 4px;
        }

        .new-tab-sub { font-size: 0.7rem; color: #999; letter-spacing: 2px; margin-bottom: 22px; }

        .new-tab-search {
            display: flex;
            align-items: center;
            gap: 8px;
            max-width: 400px;
            width: 85%;
        }

        .new-tab-search input {
            flex: 1;
            background: #ffffff;
            border: 1px solid rgba(0,0,0,0.1);
            border-radius: 12px;
            padding: 12px 16px;
            color: #111;
            font-size: 13px;
            outline: none;
            font-family: inherit;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        }

        .new-tab-search input::placeholder { color: #aaa; }

        .new-tab-search input:focus { border-color: #111; }

        .new-tab-search button {
            background: #111;
            border: none;
            border-radius: 12px;
            padding: 12px 18px;
            color: white;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
            font-size: 13px;
            transition: all 0.2s;
        }

        .new-tab-search button:hover { background: #333; }

        .venusFooter {
            position: fixed;
            bottom: 10px;
            right: 20px;
            color: rgba(0,0,0,0.4);
            font-size: 10px;
            text-decoration: none;
            z-index: 10;
        }

        @media (max-width: 600px) {
            .logo-text { font-size: 1.8rem; }
            .search-container { max-width: 90%; }
            .app-button { width: 42px; height: 42px; border-radius: 12px; }
        }



        /* ===== FARIUM PARTICLES ===== */
        #particle-canvas { position:fixed; inset:0; width:100%; height:100%; z-index:0; pointer-events:none; opacity:.6; }
        .main-content, .topbar, .browser-overlay, .venusFooter, .farium-chat-launch, .chat-overlay { z-index: 10; }
        body::before { background:linear-gradient(135deg, rgba(255,255,255,.55), rgba(245,245,245,.4)); }

        /* ===== FARIUM CHAT ===== */
        .farium-chat-launch {
            position:fixed; right:22px; bottom:22px; display:flex; align-items:center; gap:8px;
            border:1px solid rgba(0,0,0,.1); border-radius:15px; padding:11px 15px;
            color:#111; background:rgba(255,255,255,.9); backdrop-filter:blur(18px);
            -webkit-backdrop-filter:blur(18px); cursor:pointer;
            box-shadow:0 12px 35px rgba(0,0,0,.1); transition:.25s; font:600 12px Inter,sans-serif;
        }
        .farium-chat-launch:hover { transform:translateY(-3px); border-color:#111; background:#ffffff; }
        .chat-launch-icon { color:#111; font-size:13px; animation:chatPulse 1.8s infinite; }
        @keyframes chatPulse { 50% { opacity:.35; transform:scale(.72); } }
        .chat-overlay { position:fixed; inset:0; display:flex; align-items:flex-end; justify-content:flex-end; padding:22px; background:rgba(0,0,0,.08); backdrop-filter:blur(2px); opacity:0; visibility:hidden; pointer-events:none; transition:.25s; }
        .chat-overlay.open { opacity:1; visibility:visible; pointer-events:auto; }
        .chat-window { width:min(900px, calc(100vw - 30px)); height:min(650px, calc(100vh - 45px)); overflow:hidden; display:flex; flex-direction:column; border:1px solid rgba(0,0,0,.1); border-radius:22px; background:rgba(255,255,255,.98); box-shadow:0 35px 100px rgba(0,0,0,.2); backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px); transform:translateY(25px) scale(.97); transition:.35s cubic-bezier(.2,.8,.2,1); }
        .chat-overlay.open .chat-window { transform:none; }
        .chat-header { height:62px; flex:none; display:flex; align-items:center; justify-content:space-between; padding:0 15px 0 18px; border-bottom:1px solid rgba(0,0,0,.07); background:linear-gradient(180deg,rgba(0,0,0,.015),transparent); }
        .chat-brand { display:flex; gap:10px; align-items:center; } .chat-brand-mark { width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:#111;color:#fff;font-weight:900; } .chat-brand small,.chat-room-head small { display:block;color:#888;font-size:10px;margin-top:2px; }
        .chat-close { border:0;background:rgba(0,0,0,.05);color:#666;border-radius:10px;width:32px;height:32px;font-size:20px;cursor:pointer; } .chat-close:hover{color:#111;background:rgba(0,0,0,.08)}
        .chat-auth { width:min(390px,100%); margin:auto; padding:25px; } .chat-auth-title{font-size:25px;font-weight:800;color:#111}.chat-auth-sub{font-size:12px;color:#888;margin:7px 0 18px}.chat-tabs{display:flex;gap:4px;padding:4px;background:rgba(0,0,0,.05);border-radius:11px;margin-bottom:13px}.chat-auth-tab{flex:1;border:0;background:transparent;color:#777;padding:9px;border-radius:8px;cursor:pointer}.chat-auth-tab.active{background:#111;color:#fff}.chat-auth form{display:flex;flex-direction:column;gap:10px}.chat-auth input,.chat-search-row input,.chat-compose input{border:1px solid rgba(0,0,0,.1);background:rgba(0,0,0,.02);color:#111;outline:none;border-radius:10px;padding:11px;font:inherit}.chat-auth input:focus,.chat-search-row input:focus,.chat-compose input:focus{border-color:#111;box-shadow:0 0 20px rgba(0,0,0,.06)}.chat-primary,.chat-compose button{border:0;border-radius:10px;background:#111;color:#fff;padding:11px;font-weight:800;cursor:pointer}.chat-primary:hover,.chat-compose button:hover{background:#333}.chat-error{min-height:15px;color:#c0392b;font-size:11px}.avatar-picker label{display:block;color:#666;font-size:11px;margin:4px 0 8px}.avatar-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px}.avatar-choice{height:45px;border-radius:12px;border:1px solid rgba(0,0,0,.1);cursor:pointer;color:#fff;font-weight:900}.avatar-choice.selected{border-color:#111;box-shadow:0 0 0 2px rgba(0,0,0,.1)}.avatar-choice[data-avatar="red"]{background:#111}.avatar-choice[data-avatar="black"]{background:#111}.avatar-choice[data-avatar="white"]{background:#eee;color:#111}.avatar-choice[data-avatar="crimson"]{background:linear-gradient(135deg,#333,#111)}.avatar-choice[data-avatar="ember"]{background:linear-gradient(135deg,#444,#222)}.avatar-choice[data-avatar="mono"]{background:linear-gradient(135deg,#222,#888)}
        .chat-app{display:grid;grid-template-columns:250px 1fr;min-height:0;flex:1}.chat-sidebar{border-right:1px solid rgba(0,0,0,.08);padding:12px;display:flex;flex-direction:column;min-width:0}.chat-me{padding:10px;border-radius:12px;background:rgba(0,0,0,.03);margin-bottom:9px}.chat-user-card{display:flex;align-items:center;gap:8px;padding:8px;border-radius:9px}.chat-user-card:hover{background:rgba(0,0,0,.04)}.chat-avatar{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;font-weight:900;color:#fff;flex:none}.chat-search-row{display:flex;gap:5px}.chat-search-row input{width:100%;padding:8px}.chat-search-row button{width:34px;border:0;border-radius:9px;background:rgba(0,0,0,.05);color:#111;cursor:pointer}.chat-section-title{font-size:9px;text-transform:uppercase;letter-spacing:1.4px;color:#999;margin:15px 5px 7px}.chat-friends,.chat-results{overflow:auto}.friend-add{margin-left:auto;border:0;border-radius:7px;background:rgba(0,0,0,.06);color:#111;padding:5px 7px;cursor:pointer}.chat-logout{margin-top:auto;border:1px solid rgba(0,0,0,.08);background:transparent;color:#666;border-radius:9px;padding:8px;cursor:pointer}.chat-logout:hover{color:#111;background:rgba(0,0,0,.04)}
        .chat-main{min-width:0;display:flex;flex-direction:column}.chat-room-head{height:56px;flex:none;padding:0 17px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(0,0,0,.07);color:#111}.online-dot{width:8px;height:8px;border-radius:50%;background:#111;box-shadow:0 0 10px rgba(0,0,0,.3)}.chat-messages{flex:1;overflow:auto;padding:16px}.chat-message{display:flex;gap:9px;margin-bottom:13px;animation:chatMessageIn .2s ease}.chat-message .chat-avatar{width:32px;height:32px}.chat-message-body{min-width:0}.chat-message-name{font-size:11px;font-weight:800;color:#111}.chat-message-time{font-size:8px;color:#999;margin-left:6px}.chat-message-text{margin-top:3px;color:#333;font-size:12px;line-height:1.5;white-space:pre-wrap;word-break:break-word}.chat-compose{display:flex;gap:8px;padding:12px;border-top:1px solid rgba(0,0,0,.07)}.chat-compose input{flex:1}.chat-compose button{padding:0 17px}@keyframes chatMessageIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
        @media(max-width:700px){.chat-overlay{padding:8px}.chat-window{width:100%;height:calc(100vh - 16px);border-radius:18px}.chat-app{grid-template-columns:1fr}.chat-sidebar{display:none}.farium-chat-launch{right:14px;bottom:14px}.chat-compose button{padding:0 12px}}

    
        /* ===== FARIUS WHITE THEME ===== */
        :root {
            --accent: #111111;
            --accent-2: #333333;
            --accent-rgb: 17,17,17;
        }

        body {
            background: #f7f7f7 !important;
            color: #111;
        }

        body::before {
            background:
                radial-gradient(circle at 50% 35%, rgba(0,0,0,.03), transparent 34%),
                linear-gradient(180deg, #f7f7f7 0%, #f0f0f0 55%, #f7f7f7 100%) !important;
        }

        body::after {
            opacity: .5;
            background:
                radial-gradient(circle at 15% 20%, rgba(0,0,0,.025), transparent 25%),
                radial-gradient(circle at 85% 75%, rgba(0,0,0,.02), transparent 30%),
                linear-gradient(115deg, transparent 25%, rgba(0,0,0,.015) 50%, transparent 75%);
            filter: blur(40px);
        }

        .topbar {
            background: rgba(255,255,255,.9) !important;
            border-color: rgba(0,0,0,.08) !important;
            box-shadow: 0 15px 45px rgba(0,0,0,.08);
        }

        .topbar a:hover,
        .topbar a.active {
            background: rgba(0,0,0,.06) !important;
            box-shadow: inset 0 0 0 1px rgba(0,0,0,.05);
        }

        .logo-image-wrap {
            display:flex;
            justify-content:center;
