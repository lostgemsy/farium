<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farium</title>

    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/gif" href="/logo.gif">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ============ ORIGINAL STYLES (unchanged) ============ */
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #000000;
            --bg-2: #050505;
            --bg-3: #0a0a0a;
            --text: #f5f5f7;
            --text-dim: rgba(255,255,255,.42);
            --text-dim-2: rgba(255,255,255,.68);
            --card: rgba(255,255,255,.04);
            --card-hover: rgba(255,255,255,.075);
            --card-border: rgba(255,255,255,.08);
            --card-border-hover: rgba(255,255,255,.26);
            --input-bg: rgba(255,255,255,.045);
            --input-border: rgba(255,255,255,.1);
            --input-border-focus: rgba(255,255,255,.4);
            --shadow: rgba(0,0,0,.8);
            --accent: #7c8cff;
            --accent-2: #b47cff;
            --accent-glow: rgba(124,140,255,.28);
            --ring: rgba(124,140,255,.28);

            --bg-scale: 1;
            --bg-pos-x: 50%;
            --bg-pos-y: 50%;

            --overlay-top: rgba(0,0,0,.65);
            --overlay-bottom: rgba(0,0,0,.78);
        }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes slideRight { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes logoDrop {
            0% { opacity:0; transform:translateY(-40px) scale(.8); }
            70% { opacity:1; transform:translateY(4px) scale(1.02); }
            100% { opacity:1; transform:none; }
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes snowFall {
            0%   { transform: translate3d(0, -30px, 0); }
            100% { transform: translate3d(var(--drift, 0px), 110vh, 0); }
        }

        html { background: #000; }

        body {
            margin: 0;
            padding: 0;
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;

            background-color: #000;
            background-image: url('/assets/backgrounds/foggy-forest.png');
            background-size: calc(100% * var(--bg-scale, 1)) auto;
            background-position: var(--bg-pos-x, 50%) var(--bg-pos-y, 50%);
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                linear-gradient(180deg, var(--overlay-top) 0%, var(--overlay-bottom) 100%),
                radial-gradient(700px 500px at 50% 50%, rgba(124,140,255,.05), transparent 65%);
            z-index: 0;
            pointer-events: none;
            transition: background .15s ease;
        }

        .snow-layer {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            overflow: hidden;
            contain: strict;
        }
        .snowflake {
            position: absolute;
            top: -30px;
            width: var(--size, 10px);
            height: var(--size, 10px);
            background-image: url('/snowParticle.png');
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            opacity: var(--opacity, .75);
            will-change: transform;
            animation: snowFall linear infinite;
            animation-duration: var(--dur, 8s);
            animation-delay: var(--delay, 0s);
        }

        .countdown {
            position: fixed;
            top: 14px;
            left: 14px;
            z-index: 110;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 3px;
            padding: 9px 14px;
            border-radius: 14px;
            background: rgba(10,10,10,.85);
            border: 1px solid var(--card-border);
            color: var(--text);
            font-size: 12px;
            font-weight: 600;
            pointer-events: none;
            user-select: none;
            animation: fadeIn .4s ease;
        }
        .countdown .label { font-size: 9px; text-transform: uppercase; letter-spacing: 1.4px; color: var(--text-dim); font-weight: 700; }
        .countdown .value {
            display: flex; align-items: baseline; gap: 4px; font-weight: 800;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        }
        .countdown .value .num { font-size: 18px; line-height: 1; letter-spacing: -0.5px; }
        .countdown .value .unit { font-size: 10px; letter-spacing: 1px; text-transform: uppercase; opacity: .85; }
        .countdown .sub { font-size: 9.5px; color: var(--text-dim); font-weight: 500; }

        .side-dock {
            position: fixed; top: 0; bottom: 0; right: 0; z-index: 100;
            width: 130px; display: flex; flex-direction: column; align-items: stretch;
            justify-content: center; gap: 6px; padding: 18px 12px;
            background: rgba(10,10,10,.85); border-left: 1px solid var(--card-border);
            animation: slideRight .4s cubic-bezier(.2,.9,.25,1.15) both;
        }
        .side-dock::before {
            content: ""; position: absolute; left: 0; top: 18%; bottom: 18%; width: 2px;
            background: linear-gradient(180deg, transparent, var(--accent), var(--accent-2), transparent);
            opacity: .5; pointer-events: none;
        }
        .dock-btn {
            display: flex; align-items: center; gap: 10px; height: 44px;
            padding: 0 14px; border-radius: 12px; text-decoration: none;
            color: var(--text-dim-2); font-size: 12.5px; font-weight: 700;
            letter-spacing: .3px; background: transparent; border: 1px solid transparent;
            transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;
            cursor: pointer; will-change: transform; font-family: inherit;
        }
        .dock-btn .label { flex: 1; text-align: left; }
        .dock-btn svg {
            width: 17px; height: 17px; stroke: currentColor; fill: none;
            stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round;
            flex-shrink: 0; transition: stroke .2s ease, transform .25s ease;
        }
        .dock-btn:hover {
            color: var(--text); background: var(--card-hover); border-color: var(--card-border-hover);
            transform: translateY(-3px) scale(1.04); box-shadow: 0 10px 24px -10px var(--shadow);
        }
        .dock-btn:hover svg { stroke: var(--accent); transform: scale(1.08); }
        .dock-btn:active { transform: translateY(-1px) scale(1.01); }
        .dock-btn.active { color: var(--text); background: var(--card); border-color: var(--card-border); }
        .dock-btn.games-btn {
            background: linear-gradient(135deg, rgba(124,140,255,.16), rgba(180,124,255,.12));
            border: 1px solid rgba(124,140,255,.3); color: var(--text);
        }
        .dock-btn.games-btn svg { stroke: var(--accent); }
        .dock-btn.games-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border-color: transparent; color: #fff; transform: translateY(-3px) scale(1.06);
            box-shadow: 0 12px 28px -10px var(--accent-glow);
        }
        .dock-btn.games-btn:hover svg { stroke: #fff; }
        .dock-sep {
            height: 1px; margin: 4px 6px;
            background: linear-gradient(90deg, transparent, var(--card-border), transparent);
        }

        .main-content {
            position: relative; z-index: 2; text-align: center; width: 100%;
            max-width: 620px; padding: 0 20px; margin-right: 130px;
        }
        .logo-image-wrap {
            display: flex; justify-content: center; align-items: center;
            margin-bottom: 18px; min-height: 120px;
            animation: logoDrop .6s cubic-bezier(.16,1,.3,1) both;
        }
        .farius-logo {
            display: block; width: auto; height: auto;
            max-width: min(420px, 70vw); max-height: 220px;
            object-fit: contain; transition: transform .3s ease;
        }
        .logo-image-wrap:hover .farius-logo { transform: translateY(-4px) scale(1.03); }

        .tagline {
            font-size: 0.7rem; color: var(--text-dim); letter-spacing: 3px;
            text-transform: uppercase; margin-bottom: 26px; font-weight: 600;
        }
        .search-container {
            display: flex; align-items: center; max-width: 500px; margin: 0 auto;
            background: rgba(10,10,10,.85); border: 1px solid var(--card-border);
            border-radius: 16px; padding: 5px;
            box-shadow: 0 14px 40px -16px var(--shadow);
            animation: slideUp 0.4s ease; transition: border-color 0.2s, box-shadow 0.2s;
        }
        .search-container:focus-within { border-color: var(--input-border-focus); box-shadow: 0 0 0 3px var(--ring); }
        .search-input {
            flex: 1; border: none; padding: 12px 16px; font-size: 0.9rem;
            outline: none; background: transparent; color: var(--text); font-family: inherit;
        }
        .search-input::placeholder { color: var(--text-dim); }
        .search-button {
            background: linear-gradient(180deg, var(--accent), #5a6bff);
            border: none; border-radius: 12px; padding: 11px 20px; cursor: pointer;
            outline: none; color: white; font-size: 14px; font-weight: 700;
            transition: transform 0.15s, box-shadow 0.15s; font-family: inherit;
            box-shadow: 0 8px 22px -8px var(--accent-glow);
        }
        .search-button:hover { transform: translateY(-1px); box-shadow: 0 12px 28px -8px var(--accent-glow); }
        .search-button:active { transform: scale(0.96); }

        .app-buttons {
            display: flex; justify-content: center; margin-top: 20px; gap: 10px;
            flex-wrap: wrap; animation: slideUp 0.4s ease 0.1s both;
        }
        .app-button {
            display: flex; align-items: center; justify-content: center;
            width: 46px; height: 46px; border-radius: 13px;
            background: rgba(10,10,10,.85); cursor: pointer; outline: none;
            border: 1px solid var(--card-border); color: var(--text);
            text-decoration: none; transition: transform 0.2s, border-color 0.2s, background 0.2s;
            box-shadow: 0 6px 18px -8px var(--shadow);
        }
        .app-button:hover {
            background: var(--card-hover); border-color: var(--card-border-hover);
            transform: translateY(-3px);
        }
        .app-button:active { transform: scale(0.92); }
        .app-button img { width: 24px; height: 24px; object-fit: contain; opacity: 0.9; }
        .app-button:hover img { opacity: 1; }
        #add-app-button { background: transparent; border: 1.5px dashed var(--input-border); }
        #add-app-button:hover { border-color: var(--accent); background: var(--card); }
        #add-app-button svg { stroke: var(--text) !important; }

        .browser-overlay {
            position: fixed; inset: 0; z-index: 200; display: none; flex-direction: column;
            color: var(--text); font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #000;
            background-image: url('/assets/backgrounds/foggy-forest.png');
            background-size: calc(100% * var(--bg-scale, 1)) auto;
            background-position: var(--bg-pos-x, 50%) var(--bg-pos-y, 50%);
            background-repeat: no-repeat; background-attachment: fixed;
        }
        .browser-overlay::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(180deg, var(--overlay-top) 0%, var(--overlay-bottom) 100%);
            z-index: 0; pointer-events: none;
        }
        .browser-overlay.open { display: flex; }
        .browser-overlay > * { position: relative; z-index: 1; }

        .tabs-bar {
            display: flex; align-items: center; gap: 4px; padding: 8px 12px 0;
            background: rgba(10,10,10,.82); backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--card-border);
            overflow-x: auto; flex-shrink: 0; scrollbar-width: none;
        }
        .tabs-bar::-webkit-scrollbar { display: none; }
        .tab {
            display: flex; align-items: center; gap: 8px; padding: 8px 10px 8px 12px;
            border-radius: 10px 10px 0 0; background: transparent; border: 1px solid transparent;
            border-bottom: none; color: var(--text-dim); cursor: pointer; font-size: 12px;
            white-space: nowrap; max-width: 200px; min-width: 90px;
            transition: background 0.15s, color 0.15s; flex-shrink: 0;
        }
        .tab:hover { background: var(--card); color: var(--text); }
        .tab.active {
            background: var(--card); color: var(--text); border-color: var(--card-border);
            font-weight: 600; box-shadow: inset 0 2px 0 0 var(--accent);
        }
        .tab-favicon { width: 14px; height: 14px; border-radius: 3px; flex-shrink: 0; object-fit: contain; background: rgba(255,255,255,.06); }
        .tab-favicon-placeholder {
            width: 14px; height: 14px; border-radius: 3px; flex-shrink: 0;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid; place-items: center; color: #fff; font-size: 8px; font-weight: 900;
        }
        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
        .tab-close {
            width: 16px; height: 16px; border-radius: 50%; border: none; background: transparent;
            color: var(--text-dim); cursor: pointer; font-size: 10px; opacity: 0;
            transition: opacity .15s; flex-shrink: 0; display: flex; align-items: center;
            justify-content: center; line-height: 1;
        }
        .tab:hover .tab-close, .tab.active .tab-close { opacity: 1; }
        .tab-close:hover { background: rgba(220,38,38,0.22); color: #ff7b7b; }

        .new-tab-btn {
            width: 26px; height: 26px; border-radius: 8px; border: 1px dashed var(--input-border);
            background: transparent; cursor: pointer; color: var(--text-dim); font-size: 15px;
            flex-shrink: 0; display: flex; align-items: center; justify-content: center;
            margin-left: 4px; margin-bottom: 4px; transition: border-color .15s, color .15s;
        }
        .new-tab-btn:hover { border-color: var(--accent); color: var(--text); }

        .browser-toolbar {
            display: flex; align-items: center; gap: 6px; padding: 10px 14px;
            background: rgba(10,10,10,.82); backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--card-border);
            flex-shrink: 0;
        }
        .browser-toolbar button {
            width: 34px; height: 34px; border-radius: 9px; border: none; background: transparent;
            color: var(--text-dim-2); cursor: pointer; display: flex; align-items: center;
            justify-content: center; transition: background .15s, color .15s;
        }
        .browser-toolbar button:hover:not(:disabled) { background: var(--card); color: var(--text); }
        .browser-toolbar button:active:not(:disabled) { transform: scale(0.94); }
        .browser-toolbar button:disabled { opacity: 0.25; cursor: not-allowed; }
        .browser-toolbar svg {
            width: 16px; height: 16px; fill: none; stroke: currentColor;
            stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round;
        }
        .browser-address {
            flex: 1; display: flex; align-items: center; gap: 8px;
            background: rgba(255,255,255,.05); border: 1.5px solid var(--input-border);
            border-radius: 18px; padding: 0 14px; height: 36px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .browser-address:focus-within { border-color: var(--input-border-focus); box-shadow: 0 0 0 3px var(--ring); }
        .browser-address .lock-icon {
            width: 13px; height: 13px; stroke: var(--text-dim); fill: none;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0;
        }
        .browser-address input {
            flex: 1; background: transparent; border: none; color: var(--text);
            font-size: 12.5px; outline: none; font-family: inherit; font-weight: 500;
        }
        .browser-address input::placeholder { color: var(--text-dim); font-weight: 400; }
        .browser-loader {
            width: 14px; height: 14px; border: 2px solid var(--card-border);
            border-top-color: var(--accent); border-radius: 50%;
            animation: spin 0.7s linear infinite; flex-shrink: 0; display: none;
        }
        .browser-loader.visible { display: block; }

        .browser-frame-wrap { flex: 1; position: relative; background: transparent; }
        .browser-frame-wrap iframe {
            width: 100%; height: 100%; border: none; background: #fff; display: none;
        }
        .browser-frame-wrap iframe.visible { display: block; }

        .new-tab-page {
            position: absolute; inset: 0; display: flex; flex-direction: column;
            align-items: center; justify-content: center; background: transparent; z-index: 1;
        }
        .new-tab-page.hidden { display: none; }
        .new-tab-logo { display: flex; justify-content: center; align-items: center; margin-bottom: 14px; }
        .new-tab-logo img {
            width: auto; height: auto; max-width: min(260px, 60vw);
            max-height: 130px; object-fit: contain;
        }
        .new-tab-sub {
            font-size: 0.7rem; color: var(--text-dim); letter-spacing: 2.5px;
            text-transform: uppercase; margin-bottom: 26px; font-weight: 600;
        }
        .new-tab-search { display: flex; align-items: center; gap: 8px; max-width: 440px; width: 85%; }
        .new-tab-search input {
            flex: 1; background: rgba(10,10,10,.85); border: 1.5px solid var(--input-border);
            border-radius: 14px; padding: 13px 18px; color: var(--text);
            font-size: 13.5px; outline: none; font-family: inherit;
            transition: border-color .2s, box-shadow .2s;
        }
        .new-tab-search input::placeholder { color: var(--text-dim); }
        .new-tab-search input:focus { border-color: var(--input-border-focus); box-shadow: 0 0 0 3px var(--ring); }
        .new-tab-search button {
            background: linear-gradient(180deg, var(--accent), #5a6bff);
            border: none; border-radius: 14px; padding: 13px 22px; color: white;
            font-weight: 700; cursor: pointer; font-family: inherit; font-size: 13.5px;
            transition: transform .15s; box-shadow: 0 8px 22px -8px var(--accent-glow);
        }
        .new-tab-search button:hover { transform: translateY(-1px); }
        .new-tab-search button:active { transform: scale(0.96); }

        .venusFooter {
            position: fixed; bottom: 14px; left: 22px; color: var(--text-dim);
            font-size: 10px; text-decoration: none; z-index: 10; transition: color .2s;
        }
        .venusFooter:hover { color: var(--text); }

        .page-slide {
            position: fixed; inset: 0; z-index: 30000; background: #000;
            transform: translateX(100%); transition: transform .45s cubic-bezier(.65, 0, .35, 1);
            pointer-events: none; display: flex; align-items: center; justify-content: center;
            will-change: transform;
        }
        .page-slide::after {
            content: ""; width: 40px; height: 40px; border: 3px solid var(--input-border);
            border-top-color: var(--accent); border-radius: 50%; opacity: 0;
        }
        .page-slide.active { transform: translateX(0); pointer-events: auto; }
        .page-slide.active::after { opacity: 1; animation: spin .8s linear infinite; }
        .page-slide.enter { transform: translateX(0); transition: none; }
        .page-slide.enter.leaving {
            transform: translateX(-100%); transition: transform .45s cubic-bezier(.65, 0, .35, 1);
        }

        @media (max-width: 720px) {
            .side-dock { width: 60px; padding: 14px 6px; gap: 4px; }
            .dock-btn { height: 42px; padding: 0; justify-content: center; gap: 0; }
            .dock-btn .label { display: none; }
            .dock-btn svg { width: 20px; height: 20px; }
            .main-content { margin-right: 60px; padding: 0 12px; }
            .farius-logo { max-width: min(300px, 78vw); max-height: 150px; }
            .logo-image-wrap { min-height: 90px; margin-bottom: 14px; }
            .search-container { max-width: 100%; }
            .app-button { width: 42px; height: 42px; border-radius: 12px; }
            .countdown { padding: 8px 12px; top: 10px; left: 10px; }
            .countdown .value .num { font-size: 16px; }
            .tab { max-width: 140px; min-width: 70px; }
            .browser-toolbar { padding: 8px; gap: 3px; }
            .browser-toolbar button { width: 30px; height: 30px; }
            .browser-address { height: 32px; padding: 0 10px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* ============================================================
           CHOOSER MODAL
           ============================================================ */
        .chooser-overlay {
            position: fixed; inset: 0; z-index: 400; display: none;
            align-items: center; justify-content: center;
            background: rgba(0,0,0,.85); backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            animation: fadeIn .3s ease;
        }
        .chooser-overlay.open { display: flex; }
        .chooser-card {
            background: #1a1a1a;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 8px;
            padding: 40px 44px 36px;
            max-width: 640px;
            width: 92%;
            text-align: center;
            box-shadow: 0 32px 80px -20px rgba(0,0,0,.95);
            animation: slideUp .3s cubic-bezier(.2,.9,.25,1.15);
        }
        .chooser-logo { display: flex; justify-content: center; margin-bottom: 18px; }
        .chooser-logo img {
            max-width: 200px; max-height: 100px; object-fit: contain;
            filter: drop-shadow(0 0 24px rgba(124,140,255,.35));
        }
        .chooser-title {
            font-size: 26px; font-weight: 700; margin-bottom: 8px;
            letter-spacing: -0.4px;
            color: #fff;
        }
        .chooser-sub {
            color: #999; font-size: 13px;
            margin-bottom: 32px; font-weight: 400;
        }
        .chooser-options { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
        .chooser-btn {
            flex: 1; min-width: 200px; padding: 22px 20px 18px;
            border-radius: 6px; border: 1px solid rgba(255,255,255,.1);
            background: rgba(255,255,255,.04);
            color: var(--text); font-weight: 600; font-size: 15px;
            cursor: pointer; transition: background .15s, border-color .15s, transform .15s;
            display: flex; flex-direction: column; align-items: center; gap: 10px;
            font-family: inherit;
        }
        .chooser-btn:hover {
            background: rgba(255,255,255,.08);
            border-color: rgba(124,140,255,.6);
            transform: translateY(-2px);
        }
        .chooser-btn:active { transform: scale(0.98); }
        .chooser-btn svg {
            width: 32px; height: 32px; stroke: var(--accent);
            stroke-width: 1.6; fill: none;
        }
        .chooser-btn span {
            font-size: 12px; font-weight: 400;
            color: #888; letter-spacing: .2px;
        }
        .chooser-close {
            margin-top: 28px; background: none; border: none;
            color: #888; font-size: 13px; cursor: pointer;
            font-weight: 500; padding: 8px 18px; border-radius: 4px;
            transition: color .15s, background .15s; font-family: inherit;
        }
        .chooser-close:hover { color: #fff; background: rgba(255,255,255,.05); }

        /* ============================================================
           BROWSER OS — WINDOWS 11 DARK THEME
           ============================================================ */
        .os-desktop {
            position: fixed; inset: 0; z-index: 300;
            display: none; flex-direction: column;
            background: #000;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            animation: fadeIn .3s ease;
        }
        .os-desktop.open { display: flex; }

        /* ===== WINDOWS ===== */
        .os-window {
            position: absolute;
            background: #202020;
            border: 1px solid #3a3a3a;
            border-radius: 0;
            box-shadow: 0 8px 32px rgba(0,0,0,.7);
            display: flex; flex-direction: column;
            overflow: hidden;
            min-width: 280px; min-height: 160px;
            z-index: 10;
            animation: osWindowOpen .2s ease-out;
        }
        @keyframes osWindowOpen {
            from { opacity: 0; transform: scale(.96); }
            to { opacity: 1; transform: scale(1); }
        }
        .os-window.minimized { display: none; }
        .os-window.maximized {
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: calc(100% - 40px) !important;
            border-radius: 0;
        }
        .os-window.snapped-left {
            top: 0 !important;
            left: 0 !important;
            width: 50% !important;
            height: calc(100% - 40px) !important;
        }
        .os-window.snapped-right {
            top: 0 !important;
            left: 50% !important;
            width: 50% !important;
            height: calc(100% - 40px) !important;
        }

        /* Title bar */
        .os-window-titlebar {
            display: flex; align-items: center;
            height: 32px;
            background: #202020;
            border-bottom: 1px solid #2e2e2e;
            cursor: default; user-select: none;
            flex-shrink: 0;
            position: relative;
        }
        .os-window-title {
            flex: 1;
            font-size: 12px;
            font-weight: 400;
            color: #d0d0d0;
            padding: 0 12px;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
            pointer-events: none;
        }
        .os-window-icon {
            display: flex; align-items: center;
            padding-left: 10px;
            pointer-events: none;
        }
        .os-window-icon img { width: 16px; height: 16px; object-fit: contain; }
        .os-window-icon svg {
            width: 15px; height: 15px;
            stroke: #d0d0d0; fill: none; stroke-width: 1.8;
        }

        /* Window controls (Windows-style: minimize, maximize, close on the right) */
        .os-window-controls {
            display: flex; align-items: stretch;
            height: 100%;
            margin-left: auto;
        }
        .os-window-control {
            width: 46px; height: 100%;
            border: none; background: transparent;
            color: #d0d0d0;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: background .1s, color .1s;
            padding: 0;
        }
        .os-window-control svg {
            width: 10px; height: 10px;
            stroke: currentColor; fill: none;
            stroke-width: 1.2;
        }
        .os-window-control.min:hover { background: rgba(255,255,255,.08); }
        .os-window-control.max:hover { background: rgba(255,255,255,.08); }
        .os-window-control.close:hover { background: #c42b1c; color: #fff; }
        .os-window-control.close:hover svg { stroke: #fff; }

        /* Window content */
        .os-window-content {
            flex: 1; position: relative; overflow: hidden;
            background: #1a1a1a;
        }
        .os-window-content iframe {
            width: 100%; height: 100%; border: none;
            background: #fff; display: block;
        }

        /* ===== RESIZE HANDLES (real Windows-style edges) ===== */
        .os-resize-handle { position: absolute; z-index: 20; }
        .os-resize-handle.n  { top: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
        .os-resize-handle.s  { bottom: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
        .os-resize-handle.e  { right: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
        .os-resize-handle.w  { left: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
        .os-resize-handle.ne { top: -3px; right: -3px; width: 12px; height: 12px; cursor: nesw-resize; }
        .os-resize-handle.nw { top: -3px; left: -3px; width: 12px; height: 12px; cursor: nwse-resize; }
        .os-resize-handle.se { bottom: -3px; right: -3px; width: 12px; height: 12px; cursor: nwse-resize; }
        .os-resize-handle.sw { bottom: -3px; left: -3px; width: 12px; height: 12px; cursor: nesw-resize; }

        /* ===== TASKBAR (Windows 11 dark) ===== */
        .os-taskbar {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 40px;
            background: #1c1c1c;
            border-top: 1px solid #2e2e2e;
            display: flex; align-items: center;
            z-index: 500;
            user-select: none;
        }
        .os-taskbar-center {
            display: flex; align-items: center; gap: 2px;
            position: absolute;
            left: 50%; transform: translateX(-50%);
            height: 100%;
        }
        .os-taskbar-btn {
            width: 40px; height: 40px;
            border: none; background: transparent;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            border-radius: 4px;
            transition: background .1s;
            position: relative;
            padding: 0;
        }
        .os-taskbar-btn:hover { background: rgba(255,255,255,.06); }
        .os-taskbar-btn:active { background: rgba(255,255,255,.1); }
        .os-taskbar-btn svg {
            width: 20px; height: 20px;
            stroke: #e0e0e0; fill: none;
            stroke-width: 1.6;
        }
        .os-taskbar-btn img { width: 22px; height: 22px; object-fit: contain; }
        .os-taskbar-btn .os-taskbar-tooltip {
            position: absolute;
            bottom: calc(100% + 8px);
            left: 50%; transform: translateX(-50%);
            background: #2a2a2a;
            border: 1px solid #3a3a3a;
            color: #e0e0e0;
            font-size: 11px; font-weight: 400;
            padding: 4px 10px;
            border-radius: 4px;
            white-space: nowrap;
            opacity: 0; pointer-events: none;
            transition: opacity .12s;
            font-family: inherit;
        }
        .os-taskbar-btn:hover .os-taskbar-tooltip { opacity: 1; }
        /* Running indicator dot */
        .os-taskbar-btn.running::after {
            content: '';
            position: absolute;
            bottom: 3px; left: 50%; transform: translateX(-50%);
            width: 6px; height: 2px;
            background: #7c8cff;
            border-radius: 1px;
        }
        .os-taskbar-btn.active-app {
            background: rgba(255,255,255,.1);
        }

        /* Taskbar left (start / search) */
        .os-taskbar-left {
            display: flex; align-items: center;
            padding: 0 6px;
            height: 100%;
        }
        .os-taskbar-right {
            display: flex; align-items: center;
            padding: 0 10px;
            height: 100%;
            margin-left: auto;
            gap: 4px;
        }
        .os-tray-btn {
            height: 32px;
            padding: 0 8px;
            border: none; background: transparent;
            color: #d0d0d0;
            display: flex; align-items: center; gap: 6px;
            cursor: pointer;
            border-radius: 4px;
            font-size: 11px; font-weight: 400;
            transition: background .1s;
            font-family: inherit;
        }
        .os-tray-btn:hover { background: rgba(255,255,255,.06); }
        .os-tray-btn svg {
            width: 14px; height: 14px;
            stroke: currentColor; fill: none; stroke-width: 1.6;
        }
        .os-tray-clock {
            display: flex; flex-direction: column;
            align-items: flex-end;
            padding: 0 8px;
            font-size: 11px;
            color: #d0d0d0;
            line-height: 1.3;
            font-weight: 400;
            cursor: default;
        }
        .os-tray-clock .time { font-weight: 500; }
        .os-tray-clock .date { font-size: 10px; color: #a0a0a0; }

        /* ===== START MENU (Windows 11 style) ===== */
        .os-start-menu {
            position: absolute;
            bottom: 48px;
            left: 50%; transform: translateX(-50%) translateY(8px);
            width: 560px; max-width: 92vw;
            max-height: 640px;
            background: #1f1f1f;
            border: 1px solid #3a3a3a;
            border-radius: 8px;
            box-shadow: 0 16px 48px rgba(0,0,0,.7);
            padding: 28px 32px 24px;
            z-index: 600;
            display: none; flex-direction: column;
            opacity: 0; pointer-events: none;
            transition: opacity .15s, transform .15s;
        }
        .os-start-menu.open {
            display: flex;
            opacity: 1; pointer-events: auto;
            transform: translateX(-50%) translateY(0);
        }
        .os-start-search {
            display: flex; align-items: center; gap: 10px;
            background: #2a2a2a;
            border: 1px solid #3a3a3a;
            border-radius: 4px;
            padding: 8px 12px;
            margin-bottom: 24px;
        }
        .os-start-search svg { width: 15px; height: 15px; stroke: #888; fill: none; stroke-width: 1.8; }
        .os-start-search input {
            flex: 1; background: transparent; border: none;
            color: #e0e0e0; font-size: 12.5px; outline: none;
            font-family: inherit;
        }
        .os-start-search input::placeholder { color: #888; }

        .os-start-section-title {
            font-size: 11px;
            font-weight: 600;
            color: #a0a0a0;
            margin-bottom: 12px;
            letter-spacing: .3px;
            text-transform: uppercase;
        }

        .os-start-apps {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 4px;
        }
        .os-start-app {
            display: flex; flex-direction: column; align-items: center;
            gap: 6px; padding: 14px 6px 10px;
            border-radius: 4px;
            background: transparent;
            border: none;
            cursor: pointer;
            transition: background .1s;
            font-family: inherit; color: #e0e0e0;
        }
        .os-start-app:hover { background: rgba(255,255,255,.06); }
        .os-start-app:active { background: rgba(255,255,255,.1); }
        .os-start-app svg { width: 26px; height: 26px; stroke: #c0c0c0; fill: none; stroke-width: 1.5; }
        .os-start-app span { font-size: 11px; font-weight: 400; color: #c0c0c0; }
        .os-start-app img { width: 26px; height: 26px; object-fit: contain; }

        /* ===== CALCULATOR ===== */
        .os-calc-display {
            background: #1a1a1a;
            border-bottom: 1px solid #2e2e2e;
            padding: 14px 18px;
            text-align: right;
            font-size: 28px; font-weight: 400;
            color: #e0e0e0; overflow: hidden;
            text-overflow: ellipsis; white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }
        .os-calc-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2px; padding: 8px;
            flex: 1;
            background: #1a1a1a;
        }
        .os-calc-btn {
            background: #2a2a2a;
            border: 1px solid #2e2e2e;
            border-radius: 2px;
            color: #e0e0e0; font-size: 15px; font-weight: 400;
            cursor: pointer; font-family: inherit;
            transition: background .1s;
        }
        .os-calc-btn:hover { background: #333; }
        .os-calc-btn:active { background: #3a3a3a; }
        .os-calc-btn.op { background: #2d2d2d; color: #a5b0ff; }
        .os-calc-btn.op:hover { background: #363636; }
        .os-calc-btn.eq { background: #7c8cff; color: #fff; }
        .os-calc-btn.eq:hover { background: #6a7aee; }
        .os-calc-btn.clr { background: #2d2d2d; color: #ff9b9b; }
        .os-calc-btn.clr:hover { background: #363636; }

        /* ===== CLOCK ===== */
        .os-clock-display {
            flex: 1; display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 6px; padding: 24px;
            background: #1a1a1a;
        }
        .os-clock-time {
            font-size: 48px; font-weight: 300;
            letter-spacing: -1px;
            color: #e0e0e0;
            font-variant-numeric: tabular-nums;
        }
        .os-clock-date {
            font-size: 14px; color: #a0a0a0;
            font-weight: 400; letter-spacing: .3px;
        }

        /* ===== WALLPAPER GALLERY ===== */
        .os-wallpaper-gallery {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 8px; padding: 14px; height: 100%;
            overflow-y: auto;
            background: #1a1a1a;
        }
        .os-wallpaper-gallery::-webkit-scrollbar { width: 8px; }
        .os-wallpaper-gallery::-webkit-scrollbar-track { background: #1a1a1a; }
        .os-wallpaper-gallery::-webkit-scrollbar-thumb { background: #3a3a3a; border-radius: 4px; }
        .os-wallpaper-thumb {
            aspect-ratio: 16/9;
            border-radius: 2px;
            border: 2px solid transparent;
            background-size: cover; background-position: center;
            cursor: pointer;
            transition: border-color .15s;
        }
        .os-wallpaper-thumb:hover {
            border-color: #7c8cff;
        }
        .os-wallpaper-actions {
            padding: 12px 14px;
            border-top: 1px solid #2e2e2e;
            display: flex; gap: 8px;
            background: #1f1f1f;
        }
        .os-wallpaper-actions button {
            flex: 1; padding: 8px 12px;
            border-radius: 4px;
            border: 1px solid #3a3a3a;
            background: #2a2a2a;
            color: #e0e0e0; font-weight: 400;
            cursor: pointer; font-size: 12px;
            font-family: inherit;
            transition: background .1s;
        }
        .os-wallpaper-actions button:hover { background: #333; }
        .os-wallpaper-actions button.primary {
            background: #7c8cff;
            border-color: #7c8cff;
            color: #fff;
        }
        .os-wallpaper-actions button.primary:hover { background: #6a7aee; }

        /* ===== DESKTOP ICONS ===== */
        .os-desktop-icons {
            position: absolute; top: 16px; left: 16px;
            display: flex; flex-direction: column; gap: 4px;
            z-index: 5;
        }
        .os-desktop-icon {
            display: flex; flex-direction: column; align-items: center;
            gap: 4px; width: 72px; padding: 8px 4px;
            border-radius: 2px;
            cursor: pointer;
            transition: background .1s;
            user-select: none;
        }
        .os-desktop-icon:hover { background: rgba(124,140,255,.2); outline: 1px solid rgba(124,140,255,.4); }
        .os-desktop-icon svg {
            width: 32px; height: 32px;
            stroke: #fff; fill: none;
            stroke-width: 1.4;
            filter: drop-shadow(0 1px 2px rgba(0,0,0,.8));
        }
        .os-desktop-icon span {
            font-size: 11px; font-weight: 400;
            color: #fff;
            text-shadow: 0 1px 3px rgba(0,0,0,.9);
            text-align: center;
            line-height: 1.2;
        }

        /* ===== BROWSER IN OS ===== */
        .os-browser-inner {
            display: flex; flex-direction: column; height: 100%;
            background: #1a1a1a;
        }
        .os-browser-bar {
            display: flex; align-items: center; gap: 4px;
            padding: 6px 8px;
            background: #202020;
            border-bottom: 1px solid #2e2e2e;
            flex-shrink: 0;
        }
        .os-browser-bar button {
            width: 30px; height: 30px; border-radius: 3px; border: none;
            background: transparent; color: #c0c0c0;
            cursor: pointer; display: flex; align-items: center; justify-content: center;
            transition: background .1s;
        }
        .os-browser-bar button:hover:not(:disabled) { background: rgba(255,255,255,.08); }
        .os-browser-bar button:disabled { opacity: .3; cursor: not-allowed; }
        .os-browser-bar svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .os-browser-url {
            flex: 1; display: flex; align-items: center; gap: 6px;
            background: #2a2a2a;
            border: 1px solid #3a3a3a;
            border-radius: 3px;
            padding: 0 10px; height: 28px;
        }
        .os-browser-url input {
            flex: 1; background: transparent; border: none;
            color: #e0e0e0; font-size: 12px; outline: none;
            font-family: inherit;
        }
        .os-browser-url input::placeholder { color: #888; }
        .os-browser-iframe {
            flex: 1; border: none; background: #fff; width: 100%;
        }

        /* ===== SNAP PREVIEW ===== */
        .os-snap-preview {
            position: absolute;
            background: rgba(124,140,255,.15);
            border: 2px solid rgba(124,140,255,.5);
            pointer-events: none;
            z-index: 400;
            display: none;
            transition: all .12s ease;
        }
        .os-snap-preview.show { display: block; }

        /* ===== NOTIFICATION ===== */
        .os-toast {
            position: absolute;
            bottom: 52px; right: 12px;
            background: #2a2a2a;
            border: 1px solid #3a3a3a;
            border-radius: 6px;
            padding: 12px 16px;
            color: #e0e0e0;
            font-size: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,.6);
            z-index: 700;
            animation: slideUp .2s ease;
            max-width: 320px;
        }

        /* ===== WALLPAPER INPUT ===== */
        .os-wallpaper-input { display: none; }

        @media (max-width: 720px) {
            .chooser-card { padding: 28px 20px 24px; }
            .chooser-title { font-size: 20px; }
            .chooser-options { flex-direction: column; }
            .chooser-btn { min-width: auto; }
            .os-window { min-width: 240px; }
            .os-start-apps { grid-template-columns: repeat(3, 1fr); }
            .os-start-menu { width: 92vw; padding: 20px; }
            .os-clock-time { font-size: 32px; }
            .os-taskbar-center { gap: 0; }
            .os-taskbar-btn { width: 36px; height: 36px; }
            .os-tray-clock { display: none; }
        }
    </style>
</head>
<body>

    <audio id="bg-music" src="/Lamour-song.mp3" loop preload="auto" autoplay playsinline></audio>

    <div class="snow-layer" id="snowLayer" aria-hidden="true"></div>

    <div class="countdown" id="xmasCountdown" aria-live="polite">
        <span class="label">🎄 Until Christmas</span>
        <div class="value"><span class="num" id="xmasNum">--</span><span class="unit" id="xmasUnit">days</span></div>
        <span class="sub" id="xmasSub">loading…</span>
    </div>

    <div class="main-content" id="main-content">
        <div class="logo-image-wrap"><img class="farius-logo" src="/logo.gif" alt="Farium"></div>
        <div class="tagline">Browse Freely</div>
        <div class="search-container">
            <input type="text" class="search-input" id="search-input" placeholder="Search or enter a URL..." autocomplete="off">
            <button class="search-button" id="search-go">Go</button>
        </div>
        <div class="app-buttons" id="app-buttons">
            <div class="app-button" data-url="https://discord.com">
                <img src="/assets/svg/discord.svg" alt="Discord">
            </div>
            <div class="app-button" data-url="https://youtube.com">
                <img src="/assets/svg/youtube.svg" alt="YouTube">
            </div>
            <div class="app-button" data-url="https://spotify.com">
                <img src="/assets/svg/spotify.svg" alt="Spotify">
            </div>
            <div class="app-button" data-url="https://github.com">
                <img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="GitHub">
            </div>
            <div class="app-button" id="add-app-button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
        </div>
    </div>

    <nav class="side-dock" aria-label="Site navigation">
        <a href="/" class="dock-btn active" title="Home">
            <span class="label">Home</span>
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </a>
        <a href="/settings" class="dock-btn" title="Settings">
            <span class="label">Settings</span>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </a>
        <div class="dock-sep" aria-hidden="true"></div>
        <a href="/gnmath.html" class="dock-btn games-btn" id="gamesBtn" title="Play Games">
            <span class="label">Games</span>
            <svg viewBox="0 0 24 24">
                <rect x="2" y="6" width="20" height="12" rx="3"/>
                <path d="M6 12h4M8 10v4M15 11h.01M17.5 13h.01"/>
            </svg>
        </a>
    </nav>

    <!-- ============ SIMPLE BROWSER OVERLAY ============ -->
    <div class="browser-overlay" id="browser-overlay">
        <div class="tabs-bar" id="tabs-bar">
            <button class="new-tab-btn" id="new-tab-btn" title="New Tab">+</button>
        </div>

        <div class="browser-toolbar">
            <button id="browser-back" title="Back">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button id="browser-forward" title="Forward">
                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <button id="browser-refresh" title="Refresh">
                <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
            </button>
            <button id="browser-home" title="Home">
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
