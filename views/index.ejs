<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farium · Browse Freely</title>

    <!-- External proxy libraries (keep as is) -->
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/gif" href="/logo.gif">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ============ RESET & DESIGN TOKENS ============ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #000000;
            --bg-2: #08080a;
            --bg-3: #101014;
            --text: #f8f8fc;
            --text-dim: rgba(255, 255, 255, 0.5);
            --text-dim-2: rgba(255, 255, 255, 0.78);
            --card: rgba(255, 255, 255, 0.045);
            --card-hover: rgba(255, 255, 255, 0.09);
            --card-border: rgba(255, 255, 255, 0.09);
            --card-border-hover: rgba(255, 255, 255, 0.28);
            --input-bg: rgba(255, 255, 255, 0.05);
            --input-border: rgba(255, 255, 255, 0.12);
            --input-border-focus: rgba(255, 255, 255, 0.45);
            --shadow: rgba(0, 0, 0, 0.8);
            --accent: #7c8cff;
            --accent-2: #b47cff;
            --accent-glow: rgba(124, 140, 255, 0.35);
            --ring: rgba(124, 140, 255, 0.35);

            --bg-scale: 1;
            --bg-pos-x: 50%;
            --bg-pos-y: 50%;

            --overlay-top: rgba(0, 0, 0, 0.62);
            --overlay-bottom: rgba(0, 0, 0, 0.82);

            --radius-card: 20px;
            --radius-btn: 14px;
            --transition-smooth: cubic-bezier(0.22, 0.98, 0.36, 1);
        }

        /* ============ GLOBAL & SCROLLBAR ============ */
        html {
            background: #000;
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding: 0;
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            background-color: #000;
            background-image: url('/assets/backgrounds/foggy-forest.png');
            background-size: calc(100% * var(--bg-scale, 1)) auto;
            background-position: var(--bg-pos-x, 50%) var(--bg-pos-y, 50%);
            background-repeat: no-repeat;
            background-attachment: fixed;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                linear-gradient(180deg, var(--overlay-top) 0%, var(--overlay-bottom) 100%),
                radial-gradient(900px 600px at 50% 40%, rgba(124, 140, 255, 0.06), transparent 70%);
            z-index: 0;
            pointer-events: none;
            transition: background 0.2s ease;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        /* ============ ANIMATIONS ============ */
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideRight {
            from { opacity: 0; transform: translateX(24px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes logoDrop {
            0% { opacity: 0; transform: translateY(-40px) scale(0.82); }
            70% { opacity: 1; transform: translateY(4px) scale(1.02); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        @keyframes snowFall {
            0% { transform: translate3d(0, -30px, 0); }
            100% { transform: translate3d(var(--drift, 0px), 110vh, 0); }
        }
        @keyframes osWindowOpen {
            from { opacity: 0; transform: scale(0.96); }
            to { opacity: 1; transform: scale(1); }
        }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 20px -4px var(--accent-glow); }
            50% { box-shadow: 0 0 40px -2px var(--accent-glow); }
        }

        /* ============ SNOW LAYER ============ */
        .snow-layer {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            overflow: hidden;
            contain: strict;
        }
        .snowflake {
            position: absolute;
            top: -30px;
            width: var(--size, 10px);
            height: var(--size, 10px);
            background-image: url('/snowParticle.png');
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            opacity: var(--opacity, 0.75);
            will-change: transform;
            animation: snowFall linear infinite;
            animation-duration: var(--dur, 8s);
            animation-delay: var(--delay, 0s);
        }

        /* ============ COUNTDOWN ============ */
        .countdown {
            position: fixed;
            top: 18px;
            left: 18px;
            z-index: 110;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
            padding: 12px 18px;
            border-radius: var(--radius-btn);
            background: rgba(12, 12, 16, 0.88);
            border: 1px solid var(--card-border);
            color: var(--text);
            font-size: 12px;
            font-weight: 600;
            pointer-events: none;
            user-select: none;
            animation: fadeIn 0.5s ease;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: 0 8px 28px -10px rgba(0, 0, 0, 0.9);
        }
        .countdown .label {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1.6px;
            color: var(--text-dim);
            font-weight: 700;
        }
        .countdown .value {
            display: flex;
            align-items: baseline;
            gap: 4px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .countdown .value .num {
            font-size: 22px;
            line-height: 1;
            letter-spacing: -0.5px;
        }
        .countdown .value .unit {
            font-size: 10px;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            opacity: 0.9;
        }
        .countdown .sub {
            font-size: 10px;
            color: var(--text-dim);
            font-weight: 500;
        }

        /* ============ SIDE DOCK ============ */
        .side-dock {
            position: fixed;
            top: 0;
            bottom: 0;
            right: 0;
            z-index: 100;
            width: 148px;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            justify-content: center;
            gap: 8px;
            padding: 20px 14px;
            background: rgba(10, 10, 14, 0.88);
            border-left: 1px solid var(--card-border);
            animation: slideRight 0.45s var(--transition-smooth) both;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
        .side-dock::before {
            content: "";
            position: absolute;
            left: 0;
            top: 18%;
            bottom: 18%;
            width: 2px;
            background: linear-gradient(180deg, transparent, var(--accent), var(--accent-2), transparent);
            opacity: 0.6;
            pointer-events: none;
        }
        .dock-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            height: 48px;
            padding: 0 16px;
            border-radius: var(--radius-btn);
            text-decoration: none;
            color: var(--text-dim-2);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.3px;
            background: transparent;
            border: 1px solid transparent;
            transition: all 0.25s var(--transition-smooth);
            cursor: pointer;
            will-change: transform;
            font-family: inherit;
        }
        .dock-btn .label {
            flex: 1;
            text-align: left;
        }
        .dock-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
            transition: stroke 0.2s ease, transform 0.25s ease;
        }
        .dock-btn:hover {
            color: var(--text);
            background: var(--card-hover);
            border-color: var(--card-border-hover);
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 28px -12px var(--shadow);
        }
        .dock-btn:hover svg {
            stroke: var(--accent);
            transform: scale(1.1);
        }
        .dock-btn:active {
            transform: translateY(-1px) scale(1.01);
        }
        .dock-btn.active {
            color: var(--text);
            background: var(--card);
            border-color: var(--card-border);
        }
        .dock-btn.games-btn {
            background: linear-gradient(135deg, rgba(124, 140, 255, 0.18), rgba(180, 124, 255, 0.14));
            border: 1px solid rgba(124, 140, 255, 0.35);
            color: var(--text);
        }
        .dock-btn.games-btn svg {
            stroke: var(--accent);
        }
        .dock-btn.games-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border-color: transparent;
            color: #fff;
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 14px 32px -10px var(--accent-glow);
        }
        .dock-btn.games-btn:hover svg {
            stroke: #fff;
        }
        .dock-sep {
            height: 1px;
            margin: 6px 8px;
            background: linear-gradient(90deg, transparent, var(--card-border), transparent);
        }

        /* ============ MAIN CONTENT ============ */
        .main-content {
            position: relative;
            z-index: 2;
            text-align: center;
            width: 100%;
            max-width: 660px;
            padding: 0 24px;
            margin-right: 148px;
        }
        .logo-image-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            min-height: 130px;
            animation: logoDrop 0.7s var(--transition-smooth) both;
        }
        .farius-logo {
            display: block;
            width: auto;
            height: auto;
            max-width: min(440px, 72vw);
            max-height: 240px;
            object-fit: contain;
            transition: transform 0.35s var(--transition-smooth);
            filter: drop-shadow(0 8px 32px rgba(124, 140, 255, 0.15));
        }
        .logo-image-wrap:hover .farius-logo {
            transform: translateY(-6px) scale(1.04);
            filter: drop-shadow(0 12px 40px rgba(124, 140, 255, 0.28));
        }
        .tagline {
            font-size: 0.72rem;
            color: var(--text-dim);
            letter-spacing: 3.5px;
            text-transform: uppercase;
            margin-bottom: 30px;
            font-weight: 600;
        }
        .search-container {
            display: flex;
            align-items: center;
            max-width: 520px;
            margin: 0 auto;
            background: rgba(12, 12, 16, 0.88);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 6px;
            box-shadow: 0 16px 44px -18px var(--shadow);
            animation: slideUp 0.45s var(--transition-smooth);
            transition: border-color 0.25s, box-shadow 0.25s;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
        .search-container:focus-within {
            border-color: var(--input-border-focus);
            box-shadow: 0 0 0 4px var(--ring), 0 16px 44px -18px var(--shadow);
        }
        .search-input {
            flex: 1;
            border: none;
            padding: 14px 18px;
            font-size: 0.92rem;
            outline: none;
            background: transparent;
            color: var(--text);
            font-family: inherit;
            font-weight: 500;
        }
        .search-input::placeholder {
            color: var(--text-dim);
            font-weight: 400;
        }
        .search-button {
            background: linear-gradient(180deg, var(--accent), #5a6bff);
            border: none;
            border-radius: 14px;
            padding: 12px 24px;
            cursor: pointer;
            outline: none;
            color: white;
            font-size: 14px;
            font-weight: 700;
            transition: all 0.2s var(--transition-smooth);
            font-family: inherit;
            box-shadow: 0 8px 24px -8px var(--accent-glow);
            letter-spacing: 0.3px;
        }
        .search-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px -8px var(--accent-glow);
            filter: brightness(1.08);
        }
        .search-button:active {
            transform: scale(0.96);
        }

        /* ============ APP BUTTONS ============ */
        .app-buttons {
            display: flex;
            justify-content: center;
            margin-top: 24px;
            gap: 12px;
            flex-wrap: wrap;
            animation: slideUp 0.45s ease 0.1s both;
        }
        .app-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            border-radius: var(--radius-btn);
            background: rgba(12, 12, 16, 0.88);
            cursor: pointer;
            outline: none;
            border: 1px solid var(--card-border);
            color: var(--text);
            text-decoration: none;
            transition: all 0.25s var(--transition-smooth);
            box-shadow: 0 8px 20px -10px var(--shadow);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .app-button:hover {
            background: var(--card-hover);
            border-color: var(--card-border-hover);
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 14px 28px -10px var(--shadow);
        }
        .app-button:active {
            transform: scale(0.94);
        }
        .app-button img {
            width: 26px;
            height: 26px;
            object-fit: contain;
            opacity: 0.9;
            transition: opacity 0.2s;
        }
        .app-button:hover img {
            opacity: 1;
        }
        #add-app-button {
            background: transparent;
            border: 1.5px dashed var(--input-border);
        }
        #add-app-button:hover {
            border-color: var(--accent);
            background: var(--card);
        }
        #add-app-button svg {
            stroke: var(--text) !important;
        }

        /* ============ BROWSER OVERLAY ============ */
        .browser-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: none;
            flex-direction: column;
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #000;
            background-image: url('/assets/backgrounds/foggy-forest.png');
            background-size: calc(100% * var(--bg-scale, 1)) auto;
            background-position: var(--bg-pos-x, 50%) var(--bg-pos-y, 50%);
            background-repeat: no-repeat;
            background-attachment: fixed;
        }
        .browser-overlay::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, var(--overlay-top) 0%, var(--overlay-bottom) 100%);
            z-index: 0;
            pointer-events: none;
        }
        .browser-overlay.open {
            display: flex;
        }
        .browser-overlay > * {
            position: relative;
            z-index: 1;
        }

        /* Tabs */
        .tabs-bar {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 10px 14px 0;
            background: rgba(10, 10, 14, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--card-border);
            overflow-x: auto;
            flex-shrink: 0;
            scrollbar-width: none;
        }
        .tabs-bar::-webkit-scrollbar {
            display: none;
        }
        .tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px 9px 14px;
            border-radius: 12px 12px 0 0;
            background: transparent;
            border: 1px solid transparent;
            border-bottom: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 12.5px;
            white-space: nowrap;
            max-width: 220px;
            min-width: 100px;
            transition: all 0.18s ease;
            flex-shrink: 0;
        }
        .tab:hover {
            background: var(--card);
            color: var(--text);
        }
        .tab.active {
            background: var(--card);
            color: var(--text);
            border-color: var(--card-border);
            font-weight: 600;
            box-shadow: inset 0 3px 0 0 var(--accent);
        }
        .tab-favicon {
            width: 15px;
            height: 15px;
            border-radius: 4px;
            flex-shrink: 0;
            object-fit: contain;
            background: rgba(255, 255, 255, 0.06);
        }
        .tab-favicon-placeholder {
            width: 15px;
            height: 15px;
            border-radius: 4px;
            flex-shrink: 0;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 8px;
            font-weight: 900;
        }
        .tab-title {
            overflow: hidden;
            text-overflow: ellipsis;
            flex: 1;
            min-width: 0;
        }
        .tab-close {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 11px;
            opacity: 0;
            transition: opacity 0.15s, background 0.15s;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }
        .tab:hover .tab-close,
        .tab.active .tab-close {
            opacity: 1;
        }
        .tab-close:hover {
            background: rgba(220, 38, 38, 0.25);
            color: #ff7b7b;
        }
        .new-tab-btn {
            width: 28px;
            height: 28px;
            border-radius: 10px;
            border: 1px dashed var(--input-border);
            background: transparent;
            cursor: pointer;
            color: var(--text-dim);
            font-size: 16px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 6px;
            margin-bottom: 5px;
            transition: all 0.2s;
        }
        .new-tab-btn:hover {
            border-color: var(--accent);
            color: var(--text);
            background: var(--card);
        }

        /* Toolbar */
        .browser-toolbar {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 12px 16px;
            background: rgba(10, 10, 14, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--card-border);
            flex-shrink: 0;
        }
        .browser-toolbar button {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            border: none;
            background: transparent;
            color: var(--text-dim-2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.18s;
        }
        .browser-toolbar button:hover:not(:disabled) {
            background: var(--card);
            color: var(--text);
        }
        .browser-toolbar button:active:not(:disabled) {
            transform: scale(0.92);
        }
        .browser-toolbar button:disabled {
            opacity: 0.25;
            cursor: not-allowed;
        }
        .browser-toolbar svg {
            width: 17px;
            height: 17px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        .browser-address {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.06);
            border: 1.5px solid var(--input-border);
            border-radius: 20px;
            padding: 0 16px;
            height: 38px;
            transition: border-color 0.25s, box-shadow 0.25s;
        }
        .browser-address:focus-within {
            border-color: var(--input-border-focus);
            box-shadow: 0 0 0 4px var(--ring);
        }
        .browser-address .lock-icon {
            width: 14px;
            height: 14px;
            stroke: var(--text-dim);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
        }
        .browser-address input {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--text);
            font-size: 13px;
            outline: none;
            font-family: inherit;
            font-weight: 500;
        }
        .browser-address input::placeholder {
            color: var(--text-dim);
            font-weight: 400;
        }
        .browser-loader {
            width: 15px;
            height: 15px;
            border: 2px solid var(--card-border);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            flex-shrink: 0;
            display: none;
        }
        .browser-loader.visible {
            display: block;
        }

        /* Frame */
        .browser-frame-wrap {
            flex: 1;
            position: relative;
            background: transparent;
        }
        .browser-frame-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
            display: none;
        }
        .browser-frame-wrap iframe.visible {
            display: block;
        }
        .new-tab-page {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: transparent;
            z-index: 1;
        }
        .new-tab-page.hidden {
            display: none;
        }
        .new-tab-logo {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 16px;
        }
        .new-tab-logo img {
            width: auto;
            height: auto;
            max-width: min(280px, 62vw);
            max-height: 140px;
            object-fit: contain;
        }
        .new-tab-sub {
            font-size: 0.72rem;
            color: var(--text-dim);
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 30px;
            font-weight: 600;
        }
        .new-tab-search {
            display: flex;
            align-items: center;
            gap: 10px;
            max-width: 480px;
            width: 88%;
        }
        .new-tab-search input {
            flex: 1;
            background: rgba(12, 12, 16, 0.9);
            border: 1.5px solid var(--input-border);
            border-radius: 16px;
            padding: 15px 20px;
            color: var(--text);
            font-size: 14px;
            outline: none;
            font-family: inherit;
            transition: border-color 0.25s, box-shadow 0.25s;
        }
        .new-tab-search input::placeholder {
            color: var(--text-dim);
        }
        .new-tab-search input:focus {
            border-color: var(--input-border-focus);
            box-shadow: 0 0 0 4px var(--ring);
        }
        .new-tab-search button {
            background: linear-gradient(180deg, var(--accent), #5a6bff);
            border: none;
            border-radius: 16px;
            padding: 15px 26px;
            color: white;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
            font-size: 14px;
            transition: all 0.2s;
            box-shadow: 0 8px 24px -8px var(--accent-glow);
        }
        .new-tab-search button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px -8px var(--accent-glow);
        }
        .new-tab-search button:active {
            transform: scale(0.96);
        }

        /* ============ CHOOSER MODAL ============ */
        .chooser-overlay {
            position: fixed;
            inset: 0;
            z-index: 400;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.86);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            animation: fadeIn 0.3s ease;
        }
        .chooser-overlay.open {
            display: flex;
        }
        .chooser-card {
            background: #16161c;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 48px 52px 40px;
            max-width: 680px;
            width: 92%;
            text-align: center;
            box-shadow: 0 40px 100px -24px rgba(0, 0, 0, 0.98);
            animation: slideUp 0.35s var(--transition-smooth);
        }
        .chooser-logo {
            display: flex;
            justify-content: center;
            margin-bottom: 22px;
        }
        .chooser-logo img {
            max-width: 220px;
            max-height: 110px;
            object-fit: contain;
            filter: drop-shadow(0 0 32px rgba(124, 140, 255, 0.4));
        }
        .chooser-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
            color: #fff;
        }
        .chooser-sub {
            color: #999;
            font-size: 14px;
            margin-bottom: 36px;
            font-weight: 400;
        }
        .chooser-options {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .chooser-btn {
            flex: 1;
            min-width: 220px;
            padding: 26px 24px 22px;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.04);
            color: var(--text);
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.25s var(--transition-smooth);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            font-family: inherit;
        }
        .chooser-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(124, 140, 255, 0.7);
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -16px rgba(124, 140, 255, 0.3);
        }
        .chooser-btn:active {
            transform: scale(0.98);
        }
        .chooser-btn svg {
            width: 36px;
            height: 36px;
            stroke: var(--accent);
            stroke-width: 1.6;
            fill: none;
        }
        .chooser-btn span {
            font-size: 12px;
            font-weight: 400;
            color: #888;
            letter-spacing: 0.2px;
        }
        .chooser-close {
            margin-top: 32px;
            background: none;
            border: none;
            color: #888;
            font-size: 13px;
            cursor: pointer;
            font-weight: 500;
            padding: 10px 22px;
            border-radius: 10px;
            transition: all 0.18s;
            font-family: inherit;
        }
        .chooser-close:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
        }

        /* ============ BROWSER OS — WINDOWS 11 DARK ============ */
        .os-desktop {
            position: fixed;
            inset: 0;
            z-index: 300;
            display: none;
            flex-direction: column;
            background: #000;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            animation: fadeIn 0.3s ease;
        }
        .os-desktop.open {
            display: flex;
        }
        .os-window {
            position: absolute;
            background: #1e1e1e;
            border: 1px solid #383838;
            border-radius: 8px;
            box-shadow: 0 16px 56px rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-width: 280px;
            min-height: 160px;
            z-index: 10;
            animation: osWindowOpen 0.22s ease-out;
        }
        .os-window.minimized {
            display: none;
        }
        .os-window.maximized {
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: calc(100% - 42px) !important;
            border-radius: 0;
        }
        .os-window.snapped-left {
            top: 0 !important;
            left: 0 !important;
            width: 50% !important;
            height: calc(100% - 42px) !important;
        }
        .os-window.snapped-right {
            top: 0 !important;
            left: 50% !important;
            width: 50% !important;
            height: calc(100% - 42px) !important;
        }

        /* Title bar */
        .os-window-titlebar {
            display: flex;
            align-items: center;
            height: 34px;
            background: #1e1e1e;
            border-bottom: 1px solid #2c2c2c;
            cursor: default;
            user-select: none;
            flex-shrink: 0;
            position: relative;
        }
        .os-window-title {
            flex: 1;
            font-size: 12px;
            font-weight: 400;
            color: #d0d0d0;
            padding: 0 12px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            pointer-events: none;
        }
        .os-window-icon {
            display: flex;
            align-items: center;
            padding-left: 12px;
            pointer-events: none;
        }
        .os-window-icon img {
            width: 16px;
            height: 16px;
            object-fit: contain;
        }
        .os-window-icon svg {
            width: 15px;
            height: 15px;
            stroke: #d0d0d0;
            fill: none;
            stroke-width: 1.8;
        }
        .os-window-controls {
            display: flex;
            align-items: stretch;
            height: 100%;
            margin-left: auto;
        }
        .os-window-control {
            width: 46px;
            height: 100%;
            border: none;
            background: transparent;
            color: #d0d0d0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.1s, color 0.1s;
            padding: 0;
        }
        .os-window-control svg {
            width: 10px;
            height: 10px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.2;
        }
        .os-window-control.min:hover {
            background: rgba(255, 255, 255, 0.08);
        }
        .os-window-control.max:hover {
            background: rgba(255, 255, 255, 0.08);
        }
        .os-window-control.close:hover {
            background: #c42b1c;
            color: #fff;
        }
        .os-window-control.close:hover svg {
            stroke: #fff;
        }

        /* Window content */
        .os-window-content {
            flex: 1;
            position: relative;
            overflow: hidden;
            background: #181818;
        }
        .os-window-content iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
            display: block;
        }

        /* Resize handles */
        .os-resize-handle {
            position: absolute;
            z-index: 20;
        }
        .os-resize-handle.n { top: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
        .os-resize-handle.s { bottom: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
        .os-resize-handle.e { right: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
        .os-resize-handle.w { left: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
        .os-resize-handle.ne { top: -3px; right: -3px; width: 12px; height: 12px; cursor: nesw-resize; }
        .os-resize-handle.nw { top: -3px; left: -3px; width: 12px; height: 12px; cursor: nwse-resize; }
        .os-resize-handle.se { bottom: -3px; right: -3px; width: 12px; height: 12px; cursor: nwse-resize; }
        .os-resize-handle.sw { bottom: -3px; left: -3px; width: 12px; height: 12px; cursor: nesw-resize; }

        /* Taskbar */
        .os-taskbar {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 42px;
            background: #1a1a1a;
            border-top: 1px solid #2c2c2c;
            display: flex;
            align-items: center;
            z-index: 500;
            user-select: none;
        }
        .os-taskbar-center {
            display: flex;
            align-items: center;
            gap: 2px;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            height: 100%;
        }
        .os-taskbar-btn {
            width: 42px;
            height: 42px;
            border: none;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border-radius: 6px;
            transition: background 0.12s;
            position: relative;
            padding: 0;
        }
        .os-taskbar-btn:hover {
            background: rgba(255, 255, 255, 0.07);
        }
        .os-taskbar-btn:active {
            background: rgba(255, 255, 255, 0.12);
        }
        .os-taskbar-btn svg {
            width: 21px;
            height: 21px;
            stroke: #e0e0e0;
            fill: none;
            stroke-width: 1.6;
        }
        .os-taskbar-btn img {
            width: 22px;
            height: 22px;
            object-fit: contain;
        }
        .os-taskbar-btn .os-taskbar-tooltip {
            position: absolute;
            bottom: calc(100% + 10px);
            left: 50%;
            transform: translateX(-50%);
            background: #2a2a2a;
            border: 1px solid #3a3a3a;
            color: #e0e0e0;
            font-size: 11px;
            font-weight: 400;
            padding: 5px 12px;
            border-radius: 6px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.15s;
            font-family: inherit;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.6);
        }
        .os-taskbar-btn:hover .os-taskbar-tooltip {
            opacity: 1;
        }
        .os-taskbar-btn.running::after {
            content: '';
            position: absolute;
            bottom: 4px;
            left: 50%;
            transform: translateX(-50%);
            width: 6px;
            height: 2px;
            background: #7c8cff;
            border-radius: 1px;
        }
        .os-taskbar-btn.active-app {
            background: rgba(255, 255, 255, 0.1);
        }
        .os-taskbar-left {
            display: flex;
            align-items: center;
            padding: 0 8px;
            height: 100%;
        }
        .os-taskbar-right {
            display: flex;
            align-items: center;
            padding: 0 12px;
            height: 100%;
            margin-left: auto;
            gap: 4px;
        }
        .os-tray-btn {
            height: 34px;
            padding: 0 10px;
            border: none;
            background: transparent;
            color: #d0d0d0;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 400;
            transition: background 0.12s;
            font-family: inherit;
        }
        .os-tray-btn:hover {
            background: rgba(255, 255, 255, 0.07);
        }
        .os-tray-btn svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.6;
        }
        .os-tray-clock {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            padding: 0 10px;
            font-size: 11px;
            color: #d0d0d0;
            line-height: 1.35;
            font-weight: 400;
            cursor: default;
        }
        .os-tray-clock .time {
            font-weight: 500;
        }
        .os-tray-clock .date {
            font-size: 10px;
            color: #a0a0a0;
        }

        /* Start menu */
        .os-start-menu {
            position: absolute;
            bottom: 52px;
            left: 50%;
            transform: translateX(-50%) translateY(10px);
            width: 600px;
            max-width: 92vw;
            max-height: 660px;
            background: #1c1c1e;
            border: 1px solid #3a3a3c;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
            padding: 32px 36px 28px;
            z-index: 600;
            display: none;
            flex-direction: column;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.18s, transform 0.18s;
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
        }
        .os-start-menu.open {
            display: flex;
            opacity: 1;
            pointer-events: auto;
            transform: translateX(-50%) translateY(0);
        }
        .os-start-search {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #2a2a2c;
            border: 1px solid #3a3a3c;
            border-radius: 8px;
            padding: 10px 16px;
            margin-bottom: 28px;
        }
        .os-start-search svg {
            width: 16px;
            height: 16px;
            stroke: #888;
            fill: none;
            stroke-width: 1.8;
        }
        .os-start-search input {
            flex: 1;
            background: transparent;
            border: none;
            color: #e0e0e0;
            font-size: 13px;
            outline: none;
            font-family: inherit;
        }
        .os-start-search input::placeholder {
            color: #888;
        }
        .os-start-section-title {
            font-size: 12px;
            font-weight: 600;
            color: #a0a0a0;
            margin-bottom: 14px;
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }
        .os-start-apps {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
        }
        .os-start-app {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 16px 8px 12px;
            border-radius: 8px;
            background: transparent;
            border: none;
            cursor: pointer;
            transition: background 0.12s;
            font-family: inherit;
            color: #e0e0e0;
        }
        .os-start-app:hover {
            background: rgba(255, 255, 255, 0.07);
        }
        .os-start-app:active {
            background: rgba(255, 255, 255, 0.12);
        }
        .os-start-app svg {
            width: 28px;
            height: 28px;
            stroke: #c0c0c0;
            fill: none;
            stroke-width: 1.5;
        }
        .os-start-app span {
            font-size: 11px;
            font-weight: 400;
            color: #c0c0c0;
        }
        .os-start-app img {
            width: 28px;
            height: 28px;
            object-fit: contain;
        }

        /* Calculator */
        .os-calc-display {
            background: #1a1a1a;
            border-bottom: 1px solid #2e2e2e;
            padding: 16px 20px;
            text-align: right;
            font-size: 30px;
            font-weight: 400;
            color: #e0e0e0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }
        .os-calc-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 3px;
            padding: 10px;
            flex: 1;
            background: #1a1a1a;
        }
        .os-calc-btn {
            background: #2a2a2a;
            border: 1px solid #2e2e2e;
            border-radius: 4px;
            color: #e0e0e0;
            font-size: 16px;
            font-weight: 400;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.1s;
        }
        .os-calc-btn:hover {
            background: #333;
        }
        .os-calc-btn:active {
            background: #3a3a3a;
        }
        .os-calc-btn.op {
            background: #2d2d2d;
            color: #a5b0ff;
        }
        .os-calc-btn.op:hover {
            background: #363636;
        }
        .os-calc-btn.eq {
            background: #7c8cff;
            color: #fff;
        }
        .os-calc-btn.eq:hover {
            background: #6a7aee;
        }
        .os-calc-btn.clr {
            background: #2d2d2d;
            color: #ff9b9b;
        }
        .os-calc-btn.clr:hover {
            background: #363636;
        }

        /* Clock */
        .os-clock-display {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 28px;
            background: #1a1a1a;
        }
        .os-clock-time {
            font-size: 52px;
            font-weight: 300;
            letter-spacing: -1.5px;
            color: #e0e0e0;
            font-variant-numeric: tabular-nums;
        }
        .os-clock-date {
            font-size: 15px;
            color: #a0a0a0;
            font-weight: 400;
            letter-spacing: 0.3px;
        }

        /* Wallpaper gallery */
        .os-wallpaper-gallery {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            padding: 16px;
            height: 100%;
            overflow-y: auto;
            background: #1a1a1a;
        }
        .os-wallpaper-gallery::-webkit-scrollbar {
            width: 8px;
        }
        .os-wallpaper-gallery::-webkit-scrollbar-track {
            background: #1a1a1a;
        }
        .os-wallpaper-gallery::-webkit-scrollbar-thumb {
            background: #3a3a3a;
            border-radius: 4px;
        }
        .os-wallpaper-thumb {
            aspect-ratio: 16/9;
            border-radius: 6px;
            border: 2px solid transparent;
            background-size: cover;
            background-position: center;
            cursor: pointer;
            transition: border-color 0.18s, transform 0.18s;
        }
        .os-wallpaper-thumb:hover {
            border-color: #7c8cff;
            transform: scale(1.03);
        }
        .os-wallpaper-actions {
            padding: 14px 16px;
            border-top: 1px solid #2e2e2e;
            display: flex;
            gap: 10px;
            background: #1c1c1e;
        }
        .os-wallpaper-actions button {
            flex: 1;
            padding: 10px 14px;
            border-radius: 6px;
            border: 1px solid #3a3a3a;
            background: #2a2a2a;
            color: #e0e0e0;
            font-weight: 400;
            cursor: pointer;
            font-size: 12px;
            font-family: inherit;
            transition: background 0.12s;
        }
        .os-wallpaper-actions button:hover {
            background: #333;
        }
        .os-wallpaper-actions button.primary {
            background: #7c8cff;
            border-color: #7c8cff;
            color: #fff;
        }
        .os-wallpaper-actions button.primary:hover {
            background: #6a7aee;
        }

        /* Desktop icons */
        .os-desktop-icons {
            position: absolute;
            top: 20px;
            left: 20px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            z-index: 5;
        }
        .os-desktop-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            width: 80px;
            padding: 10px 6px;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.12s;
            user-select: none;
        }
        .os-desktop-icon:hover {
            background: rgba(124, 140, 255, 0.22);
            outline: 1px solid rgba(124, 140, 255, 0.45);
        }
        .os-desktop-icon svg {
            width: 34px;
            height: 34px;
            stroke: #fff;
            fill: none;
            stroke-width: 1.4;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.9));
        }
        .os-desktop-icon span {
            font-size: 11px;
            font-weight: 400;
            color: #fff;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
            text-align: center;
            line-height: 1.25;
        }

        /* Snap preview */
        .os-snap-preview {
            position: absolute;
            background: rgba(124, 140, 255, 0.18);
            border: 2px solid rgba(124, 140, 255, 0.55);
            pointer-events: none;
            z-index: 400;
            display: none;
            transition: all 0.15s ease;
            border-radius: 8px;
        }
        .os-snap-preview.show {
            display: block;
        }

        /* Toast */
        .os-toast {
            position: absolute;
            bottom: 56px;
            right: 16px;
            background: #2a2a2c;
            border: 1px solid #3a3a3c;
            border-radius: 10px;
            padding: 14px 20px;
            color: #e0e0e0;
            font-size: 12.5px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
            z-index: 700;
            animation: slideUp 0.25s ease;
            max-width: 340px;
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
        }

        /* OS browser inner */
        .os-browser-inner {
            display: flex;
            flex-direction: column;
            height: 100%;
            background: #181818;
        }
        .os-browser-bar {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 8px 10px;
            background: #1e1e1e;
            border-bottom: 1px solid #2e2e2e;
            flex-shrink: 0;
        }
        .os-browser-bar button {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            border: none;
            background: transparent;
            color: #c0c0c0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.12s;
        }
        .os-browser-bar button:hover:not(:disabled) {
            background: rgba(255, 255, 255, 0.08);
        }
        .os-browser-bar button:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }
        .os-browser-bar svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        .os-browser-url {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 8px;
            background: #2a2a2c;
            border: 1px solid #3a3a3c;
            border-radius: 6px;
            padding: 0 12px;
            height: 30px;
        }
        .os-browser-url input {
            flex: 1;
            background: transparent;
            border: none;
            color: #e0e0e0;
            font-size: 12.5px;
            outline: none;
            font-family: inherit;
        }
        .os-browser-url input::placeholder {
            color: #888;
        }
        .os-browser-iframe {
            flex: 1;
            border: none;
            background: #fff;
            width: 100%;
        }

        .os-wallpaper-input {
            display: none;
        }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 720px) {
            .side-dock {
                width: 68px;
                padding: 16px 8px;
                gap: 6px;
            }
            .dock-btn {
                height: 46px;
                padding: 0;
                justify-content: center;
                gap: 0;
            }
            .dock-btn .label {
                display: none;
            }
            .dock-btn svg {
                width: 21px;
                height: 21px;
            }
            .main-content {
                margin-right: 68px;
                padding: 0 16px;
            }
            .farius-logo {
                max-width: min(320px, 80vw);
                max-height: 160px;
            }
            .logo-image-wrap {
                min-height: 100px;
                margin-bottom: 16px;
            }
            .search-container {
                max-width: 100%;
            }
            .app-button {
                width: 46px;
                height: 46px;
                border-radius: 14px;
            }
            .countdown {
                padding: 10px 14px;
                top: 12px;
                left: 12px;
            }
            .countdown .value .num {
                font-size: 18px;
            }
            .tab {
                max-width: 150px;
                min-width: 80px;
            }
            .browser-toolbar {
                padding: 10px;
                gap: 4px;
            }
            .browser-toolbar button {
                width: 32px;
                height: 32px;
            }
            .browser-address {
                height: 34px;
                padding: 0 12px;
            }
            .chooser-card {
                padding: 32px 24px 28px;
            }
            .chooser-title {
                font-size: 22px;
            }
            .chooser-options {
                flex-direction: column;
            }
            .chooser-btn {
                min-width: auto;
            }
            .os-window {
                min-width: 240px;
            }
            .os-start-apps {
                grid-template-columns: repeat(3, 1fr);
            }
            .os-start-menu {
                width: 92vw;
                padding: 24px;
            }
            .os-clock-time {
                font-size: 36px;
            }
            .os-taskbar-center {
                gap: 0;
            }
            .os-taskbar-btn {
                width: 38px;
                height: 38px;
            }
            .os-tray-clock {
                display: none;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* ============ BLACK + SILVER GLASS THEME ============ */
        :root {
            --bg: #070707;
            --bg-2: #101010;
            --bg-3: #181818;
            --text: #f4f4f4;
            --text-dim: rgba(255, 255, 255, 0.58);
            --text-dim-2: rgba(255, 255, 255, 0.84);
            --card: rgba(255, 255, 255, 0.075);
            --card-hover: rgba(255, 255, 255, 0.15);
            --card-border: rgba(255, 255, 255, 0.18);
            --card-border-hover: rgba(255, 255, 255, 0.46);
            --input-bg: rgba(0, 0, 0, 0.38);
            --input-border: rgba(255, 255, 255, 0.2);
            --input-border-focus: rgba(255, 255, 255, 0.72);
            --shadow: rgba(0, 0, 0, 0.82);
            --accent: #e8e8e8;
            --accent-2: #777777;
            --accent-glow: rgba(220, 220, 220, 0.28);
            --ring: rgba(255, 255, 255, 0.14);
            --overlay-top: rgba(0, 0, 0, 0.2);
            --overlay-bottom: rgba(0, 0, 0, 0.58);
        }

        #shader-background {
            position: fixed;
            inset: 0;
            z-index: 0;
            width: 100%;
            height: 100%;
            background: #080808;
        }
        body, .browser-overlay {
            background-color: transparent !important;
            background-image: none !important;
            background-attachment: initial !important;
        }
        body::before, .browser-overlay::before {
            background: linear-gradient(135deg, rgba(255,255,255,.025), rgba(0,0,0,.34)) !important;
        }
        .countdown, .side-dock, .search-container, .app-button,
        .browser-toolbar, .tabs-bar, .browser-address, .new-tab-search input,
        .new-tab-search button, .chooser-card, .chooser-btn, .os-window,
        .os-taskbar, .os-start-menu, .os-browser-bar, .os-browser-url,
        .os-tray-btn, .os-taskbar-btn {
            background: linear-gradient(135deg, rgba(255,255,255,.13), rgba(0,0,0,.42)) !important;
            border-color: rgba(255,255,255,.2) !important;
            box-shadow: 0 18px 45px rgba(0,0,0,.48), inset 0 1px rgba(255,255,255,.2), inset 0 -1px rgba(0,0,0,.5);
            backdrop-filter: blur(24px) saturate(115%);
            -webkit-backdrop-filter: blur(24px) saturate(115%);
        }
        .side-dock { background: rgba(5,5,5,.62) !important; }
        .dock-btn, .browser-toolbar button { color: var(--text-dim-2); }
        .dock-btn:hover, .app-button:hover, .chooser-btn:hover,
        .browser-toolbar button:hover:not(:disabled), .os-taskbar-btn:hover {
            background: linear-gradient(135deg, rgba(255,255,255,.24), rgba(0,0,0,.32)) !important;
            color: #fff;
            border-color: rgba(255,255,255,.58) !important;
        }
        .dock-btn.games-btn, .search-button, .new-tab-search button,
        .os-calc-btn.eq, .os-wallpaper-actions button.primary {
            background: linear-gradient(135deg, #eeeeee, #686868) !important;
            border: 1px solid rgba(255,255,255,.75) !important;
            color: #090909 !important;
            box-shadow: 0 12px 30px rgba(0,0,0,.5), inset 0 1px rgba(255,255,255,.8);
        }
        /* Preserve the original logo colors while keeping a subtle shadow. */
        .farius-logo, .new-tab-logo img, .chooser-logo img {
            filter: drop-shadow(0 10px 25px rgba(0, 0, 0, .55));
        }
        .browser-frame-wrap, .new-tab-page { background: transparent !important; }
        /* Keep the OS opaque so the home page cannot show through it. */
        .os-desktop { background-color: #080808 !important; }
        .os-window, .os-window-titlebar, .os-window-content, .os-calc-grid,
        .os-calc-display, .os-clock-display, .os-wallpaper-gallery, .os-start-menu {
            color: #f2f2f2 !important;
            background: rgba(18,18,18,.78) !important;
        }
        .os-window-title, .os-clock-time, .os-calc-display, .os-start-app span { color: #f2f2f2 !important; }
        .os-window-control, .os-start-app { color: #e5e5e5; }
    </style>
</head>
<body>
    <canvas id="shader-background" aria-hidden="true"></canvas>

    <div class="snow-layer" id="snowLayer" aria-hidden="true"></div>

    <div class="countdown" id="xmasCountdown" aria-live="polite">
        <span class="label">🎄 Until Christmas</span>
        <div class="value"><span class="num" id="xmasNum">--</span><span class="unit" id="xmasUnit">days</span></div>
        <span class="sub" id="xmasSub">loading…</span>
    </div>

    <div class="main-content" id="main-content">
        <div class="logo-image-wrap"><img class="farius-logo" src="/logo.gif" alt="Farium"></div>
        <div class="tagline">Browse Freely</div>
        <div class="search-container">
            <input type="text" class="search-input" id="search-input" placeholder="Search or enter a URL..." autocomplete="off">
            <button class="search-button" id="search-go">Go</button>
        </div>
        <div class="app-buttons" id="app-buttons">
            <div class="app-button" data-url="https://discord.com">
                <img src="/assets/svg/discord.svg" alt="Discord">
            </div>
            <div class="app-button" data-url="https://youtube.com">
                <img src="/assets/svg/youtube.svg" alt="YouTube">
            </div>
            <div class="app-button" data-url="https://spotify.com">
                <img src="/assets/svg/spotify.svg" alt="Spotify">
            </div>
            <div class="app-button" data-url="https://github.com">
                <img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="GitHub">
            </div>
            <div class="app-button" id="add-app-button">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
        </div>
    </div>

    <nav class="side-dock" aria-label="Site navigation">
        <a href="/" class="dock-btn active" title="Home">
            <span class="label">Home</span>
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </a>
        <a href="/settings" class="dock-btn" title="Settings">
            <span class="label">Settings</span>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </a>
        <div class="dock-sep" aria-hidden="true"></div>
        <a href="/gnmath.html" class="dock-btn games-btn" id="gamesBtn" title="Play Games">
            <span class="label">Games</span>
            <svg viewBox="0 0 24 24">
                <rect x="2" y="6" width="20" height="12" rx="3"/>
                <path d="M6 12h4M8 10v4M15 11h.01M17.5 13h.01"/>
            </svg>
        </a>
    </nav>

    <!-- ============ SIMPLE BROWSER OVERLAY ============ -->
    <div class="browser-overlay" id="browser-overlay">
        <div class="tabs-bar" id="tabs-bar">
            <button class="new-tab-btn" id="new-tab-btn" title="New Tab">+</button>
        </div>

        <div class="browser-toolbar">
            <button id="browser-back" title="Back">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button id="browser-forward" title="Forward">
                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <button id="browser-refresh" title="Refresh">
                <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
            </button>
            <button id="browser-home" title="Home">
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
            </button>
            <div class="browser-address">
                <svg class="lock-icon" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <input type="text" id="browser-url-input" placeholder="Search or enter URL..." autocomplete="off">
                <div class="browser-loader" id="browser-loader"></div>
            </div>
            <button id="browser-fullscreen" title="Toggle Fullscreen">
                <svg viewBox="0 0 24 24">
                    <path d="M4 9V5a1 1 0 0 1 1-1h4M20 9V5a1 1 0 0 0-1-1h-4M4 15v4a1 1 0 0 0 1 1h4M20 15v4a1 1 0 0 1-1 1h-4"/>
                </svg>
            </button>
            <button id="browser-close" title="Close">
                <svg viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
            </button>
        </div>

        <div class="browser-frame-wrap">
            <iframe id="browser-frame" src="" referrerpolicy="no-referrer" allowfullscreen></iframe>
            <div class="new-tab-page" id="new-tab-page">
                <div class="new-tab-logo"><img src="/logo.gif" alt="Farium"></div>
                <div class="new-tab-sub">Browse Freely</div>
                <div class="new-tab-search">
                    <input type="text" id="new-tab-search-input" placeholder="Search or enter URL..." autocomplete="off">
                    <button id="new-tab-search-btn">Go</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ CHOOSER OVERLAY ============ -->
    <div class="chooser-overlay" id="chooser-overlay">
        <div class="chooser-card">
            <div class="chooser-logo">
                <img src="/assets/BrowserLogo.png" alt="Farium" onerror="this.src='/logo.gif'">
            </div>
            <div class="chooser-title">What will you choose?</div>
            <div class="chooser-sub">Pick the classic proxy browser or the full Browser OS desktop</div>
            <div class="chooser-options">
                <button class="chooser-btn" id="choose-simple">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                    Simple Browser
                    <span>Classic proxy browser with tabs</span>
                </button>
                <button class="chooser-btn" id="choose-os">
                    <svg viewBox="0 0 24 24">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <line x1="8" y1="21" x2="16" y2="21"/>
                        <line x1="12" y1="17" x2="12" y2="21"/>
                    </svg>
                    Browser OS
                    <span>Full Windows-style desktop</span>
                </button>
            </div>
            <button class="chooser-close" id="chooser-close">Cancel</button>
        </div>
    </div>

    <!-- ============ BROWSER OS ============ -->
    <div class="os-desktop" id="os-desktop">
        <div class="os-snap-preview" id="os-snap-preview"></div>

        <div class="os-desktop-icons">
            <div class="os-desktop-icon" data-os-app="browser">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <span>Browser</span>
            </div>
            <div class="os-desktop-icon" data-os-app="calculator">
                <svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="12" x2="10" y2="12"/><line x1="14" y1="12" x2="16" y2="12"/><line x1="8" y1="17" x2="10" y2="17"/><line x1="14" y1="17" x2="16" y2="17"/></svg>
                <span>Calculator</span>
            </div>
            <div class="os-desktop-icon" data-os-app="clock">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>Clock</span>
            </div>
            <div class="os-desktop-icon" data-os-app="wallpaper">
                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span>Wallpaper</span>
            </div>
            <div class="os-desktop-icon" data-os-app="settings">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                <span>Settings</span>
            </div>
        </div>

        <div id="os-windows-container"></div>

        <div class="os-start-menu" id="os-start-menu">
            <div class="os-start-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" id="os-start-search-input" placeholder="Type here to search">
            </div>
            <div class="os-start-section-title">Pinned</div>
            <div class="os-start-apps" id="os-start-apps">
                <button class="os-start-app" data-os-app="browser">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    <span>Browser</span>
                </button>
                <button class="os-start-app" data-os-app="calculator">
                    <svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="12" x2="10" y2="12"/><line x1="14" y1="12" x2="16" y2="12"/><line x1="8" y1="17" x2="10" y2="17"/><line x1="14" y1="17" x2="16" y2="17"/></svg>
                    <span>Calculator</span>
                </button>
                <button class="os-start-app" data-os-app="clock">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>Clock</span>
                </button>
                <button class="os-start-app" data-os-app="wallpaper">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    <span>Wallpaper</span>
                </button>
                <button class="os-start-app" data-os-app="settings">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                    <span>Settings</span>
                </button>
                <button class="os-start-app" data-os-app="exit">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span>Exit OS</span>
                </button>
            </div>
        </div>

        <div class="os-taskbar">
            <div class="os-taskbar-left">
                <button class="os-taskbar-btn" data-os-app="start" title="Start">
                    <svg viewBox="0 0 24 24" style="stroke:none;fill:#e0e0e0;">
                        <rect x="3" y="3" width="8" height="8" rx="1" fill="#e0e0e0" stroke="none"/>
                        <rect x="13" y="3" width="8" height="8" rx="1" fill="#e0e0e0" stroke="none"/>
                        <rect x="3" y="13" width="8" height="8" rx="1" fill="#e0e0e0" stroke="none"/>
                        <rect x="13" y="13" width="8" height="8" rx="1" fill="#e0e0e0" stroke="none"/>
                    </svg>
                    <span class="os-taskbar-tooltip">Start</span>
                </button>
            </div>

            <div class="os-taskbar-center">
                <button class="os-taskbar-btn" data-os-app="browser" title="Browser">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    <span class="os-taskbar-tooltip">Browser</span>
                </button>
                <button class="os-taskbar-btn" data-os-app="calculator" title="Calculator">
                    <svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="12" x2="10" y2="12"/><line x1="14" y1="12" x2="16" y2="12"/><line x1="8" y1="17" x2="10" y2="17"/><line x1="14" y1="17" x2="16" y2="17"/></svg>
                    <span class="os-taskbar-tooltip">Calculator</span>
                </button>
                <button class="os-taskbar-btn" data-os-app="clock" title="Clock">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span class="os-taskbar-tooltip">Clock</span>
                </button>
                <button class="os-taskbar-btn" data-os-app="wallpaper" title="Wallpaper">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    <span class="os-taskbar-tooltip">Wallpaper</span>
                </button>
            </div>

            <div class="os-taskbar-right">
                <button class="os-tray-btn" title="Network">
                    <svg viewBox="0 0 24 24"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                </button>
                <button class="os-tray-btn" title="Volume">
                    <svg viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                </button>
                <div class="os-tray-clock" id="os-tray-clock">
                    <span class="time" id="os-tray-time">--:--</span>
                    <span class="date" id="os-tray-date">--/--/----</span>
                </div>
            </div>
        </div>

        <input type="file" class="os-wallpaper-input" id="os-wallpaper-input" accept="image/*">
    </div>

    <a href="#" class="venusFooter" style="position: fixed; bottom: 16px; left: 24px; color: var(--text-dim); font-size: 10px; text-decoration: none; z-index: 10; transition: color 0.2s;">Venus integration</a>

    <div class="page-slide" id="pageSlide" style="position: fixed; inset: 0; z-index: 30000; background: #000; transform: translateX(100%); transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1); pointer-events: none; display: flex; align-items: center; justify-content: center; will-change: transform;"></div>

    <script>
        /* ============ ORIGINAL SCRIPT (with minor polish) ============ */
        let tabs = [];
        let activeTabId = null;

        class Tab {
            constructor(id, url, title) {
                this.id = id;
                this.url = url || null;
                this.title = title || 'New Tab';
                this.history = [];
                this.historyIndex = -1;
                this.favicon = null;
            }
            pushHistory(url) {
                if (this.historyIndex < this.history.length - 1) {
                    this.history = this.history.slice(0, this.historyIndex + 1);
                }
                this.history.push(url);
                this.historyIndex = this.history.length - 1;
            }
            canGoBack() { return this.historyIndex > 0; }
            canGoForward() { return this.historyIndex < this.history.length - 1; }
        }

        function createTabId() {
            return 't' + Date.now() + Math.random().toString(36).substr(2, 4);
        }

        function normalizeUrl(query) {
            query = String(query).trim();
            if (!query) return null;
            if (/^https?:\/\//i.test(query)) return query;
            if (query.includes('.') && !query.includes(' ')) return 'https://' + query;
            const engine = localStorage.getItem('search') || 'https://www.google.com/search?q=';
            return engine + encodeURIComponent(query);
        }

        function getProxyUrl(url) {
            return __uv$config.prefix + __uv$config.encodeUrl(url);
        }

        function getHostname(url) {
            try { return new URL(url).hostname.replace('www.', ''); } catch(e) { return url.substring(0, 20); }
        }

        function getFaviconUrl(url) {
            try {
                const u = new URL(url);
                return `https://www.google.com/s2/favicons?domain=${u.hostname}&sz=32`;
            } catch(e) { return null; }
        }

        function addTab(url, title) {
            const id = createTabId();
            const tab = new Tab(id, url, title || (url ? getHostname(url) : 'New Tab'));
            if (url) tab.favicon = getFaviconUrl(url);
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) navigateInTab(id, url);
            return tab;
        }

        function closeTab(id) {
            if (tabs.length <= 1) {
                tabs = [];
                addTab(null);
                return;
            }
            const idx = tabs.findIndex(t => t.id === id);
            if (idx === -1) return;
            tabs.splice(idx, 1);
            if (activeTabId === id) {
                const ni = Math.min(idx, tabs.length - 1);
                activeTabId = tabs[ni].id;
                updateActiveTab();
            }
            renderTabs();
        }

        function switchTab(id) {
            activeTabId = id;
            updateActiveTab();
            renderTabs();
        }

        function updateActiveTab() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) return;
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');

            if (tab.url) {
                frame.classList.add('visible');
                newTabPage.classList.add('hidden');
                urlInput.value = tab.url;
            } else {
                frame.classList.remove('visible');
                newTabPage.classList.remove('hidden');
                urlInput.value = '';
            }

            document.getElementById('browser-back').disabled = !tab.canGoBack();
            document.getElementById('browser-forward').disabled = !tab.canGoForward();
        }

        function navigateInTab(id, url) {
            const tab = tabs.find(t => t.id === id);
            if (!tab) return;
            tab.pushHistory(url);
            tab.url = url;
            tab.title = getHostname(url);
            tab.favicon = getFaviconUrl(url);
            renderTabs();
            if (activeTabId === id) loadUrl(url);
        }

        function loadUrl(url) {
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');
            const loader = document.getElementById('browser-loader');

            frame.classList.add('visible');
            newTabPage.classList.add('hidden');
            urlInput.value = url;
            loader.classList.add('visible');
            frame.src = getProxyUrl(url);
        }

        document.addEventListener('DOMContentLoaded', () => {
            const frame = document.getElementById('browser-frame');
            if (frame) {
                frame.addEventListener('load', () => {
                    const loader = document.getElementById('browser-loader');
                    if (loader) loader.classList.remove('visible');
                });
            }
        });

        function renderTabs() {
            const tabsBar = document.getElementById('tabs-bar');
            tabsBar.querySelectorAll('.tab').forEach(el => el.remove());

            const frag = document.createDocumentFragment();

            tabs.forEach(tab => {
                const el = document.createElement('div');
                el.className = 'tab' + (tab.id === activeTabId ? ' active' : '');

                if (tab.favicon) {
                    const img = document.createElement('img');
                    img.className = 'tab-favicon';
                    img.src = tab.favicon;
                    img.alt = '';
                    img.onerror = () => { img.replaceWith(makeFaviconPlaceholder(tab.title)); };
                    el.appendChild(img);
                } else {
                    el.appendChild(makeFaviconPlaceholder(tab.title));
                }

                const titleEl = document.createElement('span');
                titleEl.className = 'tab-title';
                titleEl.textContent = tab.title || 'New Tab';
                el.appendChild(titleEl);

                if (tabs.length > 1) {
                    const cb = document.createElement('button');
                    cb.className = 'tab-close';
                    cb.textContent = '×';
                    cb.addEventListener('click', (e) => { e.stopPropagation(); closeTab(tab.id); });
                    el.appendChild(cb);
                }

                el.addEventListener('click', () => switchTab(tab.id));
                frag.appendChild(el);
            });

            tabsBar.insertBefore(frag, document.getElementById('new-tab-btn'));
        }

        function makeFaviconPlaceholder(title) {
            const d = document.createElement('div');
            d.className = 'tab-favicon-placeholder';
            d.textContent = (title || 'N')[0].toUpperCase();
            return d;
        }

        function openBrowser(url) {
            const overlay = document.getElementById('browser-overlay');
            overlay.classList.add('open');
            addTab(url);
        }

        function closeBrowser() {
            const overlay = document.getElementById('browser-overlay');
            overlay.classList.remove('open');
            tabs = [];
            activeTabId = null;
        }

        async function initProxy() {
            if ('serviceWorker' in navigator) {
                try {
                    await navigator.serviceWorker.register('/sw.js');
                    await navigator.serviceWorker.ready;
                } catch (err) {}
            }
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {}
        }

        (function initBackground() {
            const DEFAULT_BG = '/assets/backgrounds/foggy-forest.png';
            const DEFAULT_DARKNESS = 72;
            const DEFAULT_SCALE = 1;
            const DEFAULT_X = 50;
            const DEFAULT_Y = 50;

            const bg = '';
            const scale = parseFloat(localStorage.getItem('bgScale')) || DEFAULT_SCALE;
            const posX = parseFloat(localStorage.getItem('bgX'));
            const posY = parseFloat(localStorage.getItem('bgY'));
            const finalX = isNaN(posX) ? DEFAULT_X : posX;
            const finalY = isNaN(posY) ? DEFAULT_Y : posY;

            document.documentElement.style.setProperty('--bg-scale', scale);
            document.documentElement.style.setProperty('--bg-pos-x', finalX + '%');
            document.documentElement.style.setProperty('--bg-pos-y', finalY + '%');

            const applyTo = (el) => {
                el.style.backgroundColor = 'transparent';
                el.style.backgroundImage = 'none';
            };
            applyTo(document.body);
            const overlay = document.getElementById('browser-overlay');
            if (overlay) applyTo(overlay);

            const raw = localStorage.getItem('bgDarkness');
            const percent = raw !== null ? Number(raw) : DEFAULT_DARKNESS;
            const p = Math.max(0, Math.min(100, percent));
            const alpha = p / 100;
            const alphaBottom = Math.min(1, alpha * 1.15);

            document.documentElement.style.setProperty('--overlay-top', `rgba(0, 0, 0, ${alpha.toFixed(3)})`);
            document.documentElement.style.setProperty('--overlay-bottom', `rgba(0, 0, 0, ${alphaBottom.toFixed(3)})`);
        })();

        (function initSnow() {
            const layer = document.getElementById('snowLayer');
            if (!layer) return;
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduced) return;

            const isSmallScreen = window.innerWidth < 900;
            const isLowPower = (navigator.hardwareConcurrency || 4) <= 4;
            const count = isLowPower || isSmallScreen ? 35 : 60;

            const frag = document.createDocumentFragment();
            for (let i = 0; i < count; i++) {
                const el = document.createElement('div');
                el.className = 'snowflake';
                const size = 6 + Math.random() * 14;
                const duration = 7 + Math.random() * 10;
                const drift = (Math.random() - 0.5) * 200;
                const opacity = 0.45 + Math.random() * 0.5;
                const startX = Math.random() * 100;
                el.style.left = startX + 'vw';
                el.style.setProperty('--size', size + 'px');
                el.style.setProperty('--drift', drift + 'px');
                el.style.setProperty('--opacity', opacity);
                el.style.setProperty('--dur', duration + 's');
                el.style.setProperty('--delay', (-Math.random() * duration) + 's');
                frag.appendChild(el);
            }
            layer.appendChild(frag);
        })();

        (function initCountdown() {
            const numEl  = document.getElementById('xmasNum');
            const unitEl = document.getElementById('xmasUnit');
            const subEl  = document.getElementById('xmasSub');
            if (!numEl || !unitEl || !subEl) return;

            function nextChristmas(now) {
                const year = now.getFullYear();
                const thisYear = new Date(year, 11, 25, 0, 0, 0, 0);
                if (now.getTime() <= thisYear.getTime()) return thisYear;
                return new Date(year + 1, 11, 25, 0, 0, 0, 0);
            }
            function pad(n) { return String(n).padStart(2, '0'); }

            function tick() {
                const now = new Date();
                const xmas = nextChristmas(now);
                let diff = xmas.getTime() - now.getTime();
                const isXmasDay = now.getMonth() === 11 && now.getDate() === 25;
                if (isXmasDay) {
                    numEl.textContent = '🎁';
                    unitEl.textContent = 'today';
                    subEl.textContent = 'Merry Christmas!';
                    return;
                }
                const days    = Math.floor(diff / 86400000);
                const hours   = Math.floor((diff % 86400000) / 3600000);
                const minutes = Math.floor((diff % 3600000) / 60000);
                const seconds = Math.floor((diff % 60000) / 1000);
                if (days === 0) {
                    numEl.textContent = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
                    unitEl.textContent = '';
                    subEl.textContent = 'Almost here!';
                } else {
                    numEl.textContent = days;
                    unitEl.textContent = days === 1 ? 'day' : 'days';
                    subEl.textContent = `${pad(hours)}h ${pad(minutes)}m ${pad(seconds)}s`;
                }
            }
            tick();
            setInterval(tick, 1000);
        })();

        (function initFullscreenToggle() {
            const btn = document.getElementById('browser-fullscreen');
            if (!btn) return;
            const target = document.getElementById('browser-overlay');

            btn.addEventListener('click', async () => {
                try {
                    if (!document.fullscreenElement) {
                        if (target.requestFullscreen) await target.requestFullscreen();
                        else if (target.webkitRequestFullscreen) target.webkitRequestFullscreen();
                    } else {
                        if (document.exitFullscreen) await document.exitFullscreen();
                        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                    }
                } catch (e) {}
            });

            function updateIcon() {
                const isFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
                btn.innerHTML = isFs
                    ? `<svg viewBox="0 0 24 24">
                           <path d="M9 4v4a1 1 0 0 1-1 1H4M15 4v4a1 1 0 0 0 1 1h4M9 20v-4a1 1 0 0 0-1-1H4M15 20v-4a1 1 0 0 1 1-1h4"/>
                       </svg>`
                    : `<svg viewBox="0 0 24 24">
                           <path d="M4 9V5a1 1 0 0 1 1-1h4M20 9V5a1 1 0 0 0-1-1h-4M4 15v4a1 1 0 0 0 1 1h4M20 15v4a1 1 0 0 1-1 1h-4"/>
                       </svg>`;
                btn.title = isFs ? "Exit Fullscreen" : "Toggle Fullscreen";
            }

            document.addEventListener('fullscreenchange', updateIcon);
            document.addEventListener('webkitfullscreenchange', updateIcon);
        })();

        document.addEventListener('DOMContentLoaded', () => {
            (function () {
                const slide = document.getElementById("pageSlide");
                if (sessionStorage.getItem("slideFrom")) {
                    sessionStorage.removeItem("slideFrom");
                    slide.classList.add("enter");
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            slide.classList.add("leaving");
                        });
                    });
                    setTimeout(() => {
                        slide.classList.remove("enter", "leaving");
                    }, 600);
                }
            })();

            const gamesBtn = document.getElementById("gamesBtn");
            if (gamesBtn) {
                gamesBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    const slide = document.getElementById("pageSlide");
                    slide.classList.add("active");
                    sessionStorage.setItem("slideFrom", "true");
                    setTimeout(() => {
                        window.location.href = "/gnmath.html";
                    }, 500);
                });
            }

            initProxy();

            // Search triggers chooser
            document.getElementById('search-go').addEventListener('click', () => {
                const raw = document.getElementById('search-input').value.trim();
                if (!raw) return;
                document.getElementById('chooser-overlay').classList.add('open');
                document.getElementById('chooser-overlay').dataset.pendingUrl = raw;
            });
            document.getElementById('search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    const raw = e.target.value.trim();
                    if (!raw) return;
                    document.getElementById('chooser-overlay').classList.add('open');
                    document.getElementById('chooser-overlay').dataset.pendingUrl = raw;
                }
            });

            // Chooser actions
            document.getElementById('chooser-close').addEventListener('click', () => {
                document.getElementById('chooser-overlay').classList.remove('open');
            });
            document.getElementById('chooser-overlay').addEventListener('click', (e) => {
                if (e.target === e.currentTarget) {
                    document.getElementById('chooser-overlay').classList.remove('open');
                }
            });

            document.getElementById('choose-simple').addEventListener('click', () => {
                const pending = document.getElementById('chooser-overlay').dataset.pendingUrl;
                document.getElementById('chooser-overlay').classList.remove('open');
                if (pending) {
                    const url = normalizeUrl(pending);
                    if (url) openBrowser(url);
                }
            });

            document.getElementById('choose-os').addEventListener('click', () => {
                document.getElementById('chooser-overlay').classList.remove('open');
                openBrowserOS();
            });

            // App buttons trigger chooser
            document.querySelectorAll('#app-buttons .app-button[data-url]').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('chooser-overlay').classList.add('open');
                    document.getElementById('chooser-overlay').dataset.pendingUrl = btn.dataset.url;
                });
            });

            // Simple browser controls
            document.getElementById('browser-close').addEventListener('click', closeBrowser);
            document.getElementById('browser-home').addEventListener('click', closeBrowser);
            document.getElementById('browser-back').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoBack()) {
                    tab.historyIndex--;
                    tab.url = tab.history[tab.historyIndex];
                    tab.title = getHostname(tab.url);
                    tab.favicon = getFaviconUrl(tab.url);
                    renderTabs();
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-forward').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoForward()) {
                    tab.historyIndex++;
                    tab.url = tab.history[tab.historyIndex];
                    tab.title = getHostname(tab.url);
                    tab.favicon = getFaviconUrl(tab.url);
                    renderTabs();
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-refresh').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.url) loadUrl(tab.url);
            });

            document.getElementById('browser-url-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    const url = normalizeUrl(e.target.value);
                    if (url) {
                        const tab = tabs.find(t => t.id === activeTabId);
                        if (tab) navigateInTab(activeTabId, url);
                    }
                }
            });

            document.getElementById('new-tab-btn').addEventListener('click', () => addTab(null));
            document.getElementById('new-tab-search-btn').addEventListener('click', () => {
                const input = document.getElementById('new-tab-search-input');
                const url = normalizeUrl(input.value);
                if (url) {
                    const tab = tabs.find(t => t.id === activeTabId);
                    if (tab) navigateInTab(activeTabId, url);
                    input.value = '';
                }
            });
            document.getElementById('new-tab-search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('new-tab-search-btn').click();
            });

            document.getElementById('add-app-button').addEventListener('click', () => {
                const name = prompt('App name:');
                if (!name) return;
                const url = prompt('URL (e.g. netflix.com):');
                if (!url) return;
                let fullUrl = url.startsWith('http') ? url : 'https://' + url;
                const domain = new URL(fullUrl).hostname;
                const btn = document.createElement('div');
                btn.className = 'app-button';
                btn.dataset.url = fullUrl;
                btn.innerHTML = `<img src="https://www.google.com/s2/favicons?domain=${domain}&sz=64" alt="${name}">`;
                btn.addEventListener('click', () => {
                    document.getElementById('chooser-overlay').classList.add('open');
                    document.getElementById('chooser-overlay').dataset.pendingUrl = fullUrl;
                });
                btn.addEventListener('contextmenu', (e) => { e.preventDefault(); btn.remove(); });
                document.getElementById('app-buttons').insertBefore(btn, document.getElementById('add-app-button'));
            });

            // Browser OS
            initBrowserOS();
        });

        /* ============ BROWSER OS — WINDOWS 11 DARK (unchanged) ============ */
        let osWindows = [];
        let osWindowZ = 100;
        let osMinimized = [];
        let osSnapPreviewTimer = null;

        function openBrowserOS() {
            const desktop = document.getElementById('os-desktop');
            // OS is a separate full-screen mode; hide the home UI behind it.
            document.getElementById('main-content').style.visibility = 'hidden';
            document.querySelector('.side-dock').style.visibility = 'hidden';
            document.getElementById('xmasCountdown').style.visibility = 'hidden';
            document.querySelector('.snow-layer').style.visibility = 'hidden';
            desktop.classList.add('open');

            const savedWall = localStorage.getItem('os-wallpaper');
            if (savedWall) {
                desktop.style.backgroundImage = `url('${savedWall}')`;
            } else {
                desktop.style.backgroundImage = 'none';
            }

            updateOSTrayClock();
            setInterval(updateOSTrayClock, 1000);
            updateTaskbarRunning();

            const pending = document.getElementById('chooser-overlay').dataset.pendingUrl;
            // Consume the original search once, so the OS does not reopen the home page.
            delete document.getElementById('chooser-overlay').dataset.pendingUrl;
            if (pending) {
                const url = normalizeUrl(pending);
                if (url) {
                    setTimeout(() => createOSWindow('browser', { url }), 150);
                }
            }
        }

        function closeBrowserOS() {
            document.getElementById('os-desktop').classList.remove('open');
            document.querySelectorAll('.os-window').forEach(w => w.remove());
            // Restore the main page only after leaving the OS.
            document.getElementById('main-content').style.visibility = '';
            document.querySelector('.side-dock').style.visibility = '';
            document.getElementById('xmasCountdown').style.visibility = '';
            document.querySelector('.snow-layer').style.visibility = '';
            document.getElementById('chooser-overlay').classList.remove('open');
            osWindows = [];
            osMinimized = [];
            updateTaskbarRunning();
        }

        function updateOSTrayClock() {
            const timeEl = document.getElementById('os-tray-time');
            const dateEl = document.getElementById('os-tray-date');
            if (!timeEl || !dateEl) return;
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            timeEl.textContent = `${h}:${m}`;
            const dd = String(now.getDate()).padStart(2, '0');
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const yyyy = now.getFullYear();
            dateEl.textContent = `${dd}/${mm}/${yyyy}`;
        }

        function updateTaskbarRunning() {
            document.querySelectorAll('.os-taskbar-btn[data-os-app]').forEach(btn => {
                const app = btn.dataset.osApp;
                if (app === 'start') return;
                const isRunning = osWindows.some(w => w.type === app);
                btn.classList.toggle('running', isRunning);
                btn.classList.toggle('active-app', isRunning && osWindows.some(w => w.type === app && !w.minimized));
            });
        }

        function createOSWindow(type, opts = {}) {
            const container = document.getElementById('os-windows-container');
            const id = 'osw-' + Date.now() + Math.random().toString(36).substr(2, 4);

            const win = document.createElement('div');
            win.className = 'os-window';
            win.id = id;
            win.style.zIndex = ++osWindowZ;

            const offset = (osWindows.length % 6) * 26;
            const w = opts.width || 780;
            const h = opts.height || 520;
            win.style.width = w + 'px';
            win.style.height = h + 'px';
            win.style.left = Math.max(16, (window.innerWidth - w) / 2 + offset - 80) + 'px';
            win.style.top = Math.max(16, (window.innerHeight - h) / 2 + offset - 60) + 'px';

            const titlebar = document.createElement('div');
            titlebar.className = 'os-window-titlebar';

            const icon = document.createElement('div');
            icon.className = 'os-window-icon';
            icon.innerHTML = getOSIconSVG(type);

            const title = document.createElement('div');
            title.className = 'os-window-title';
            title.textContent = opts.title || getOSTitle(type);

            const controls = document.createElement('div');
            controls.className = 'os-window-controls';

            const minBtn = document.createElement('button');
            minBtn.className = 'os-window-control min';
            minBtn.title = 'Minimize';
            minBtn.innerHTML = '<svg viewBox="0 0 12 12"><line x1="2" y1="6" x2="10" y2="6"/></svg>';
            minBtn.addEventListener('click', (e) => { e.stopPropagation(); minimizeOSWindow(id); });

            const maxBtn = document.createElement('button');
            maxBtn.className = 'os-window-control max';
            maxBtn.title = 'Maximize';
            maxBtn.innerHTML = '<svg viewBox="0 0 12 12"><rect x="2.5" y="2.5" width="7" height="7" rx="0.5"/></svg>';
            maxBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleMaximizeOSWindow(id); });

            const closeBtn = document.createElement('button');
            closeBtn.className = 'os-window-control close';
            closeBtn.title = 'Close';
            closeBtn.innerHTML = '<svg viewBox="0 0 12 12"><line x1="3" y1="3" x2="9" y2="9"/><line x1="9" y1="3" x2="3" y2="9"/></svg>';
            closeBtn.addEventListener('click', (e) => { e.stopPropagation(); closeOSWindow(id); });

            controls.appendChild(minBtn);
            controls.appendChild(maxBtn);
            controls.appendChild(closeBtn);

            titlebar.appendChild(icon);
            titlebar.appendChild(title);
            titlebar.appendChild(controls);

            const content = document.createElement('div');
            content.className = 'os-window-content';
            content.appendChild(buildOSContent(type, opts, id));

            ['n','s','e','w','ne','nw','se','sw'].forEach(dir => {
                const handle = document.createElement('div');
                handle.className = 'os-resize-handle ' + dir;
                handle.dataset.dir = dir;
                win.appendChild(handle);
            });

            win.appendChild(titlebar);
            win.appendChild(content);
            container.appendChild(win);

            makeDraggable(win, titlebar, id);
            makeResizable(win);

            win.addEventListener('mousedown', () => {
                win.style.zIndex = ++osWindowZ;
            });

            osWindows.push({ id, type, el: win, opts, minimized: false });
            updateTaskbarRunning();
            return win;
        }

