<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xylara - Settings</title>
    <script src="https://app.rybbit.io/api/script.js" data-site-id="8b65ec526edf" defer></script>
    <link rel="icon" type="image/png" href="/logo.gif">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #000000;
            --bg-2: #050505;
            --bg-3: #0a0a0a;
            --text: #f5f5f7;
            --text-dim: rgba(255,255,255,.42);
            --text-dim-2: rgba(255,255,255,.68);
            --card: rgba(255,255,255,.04);
            --card-hover: rgba(255,255,255,.075);
            --card-border: rgba(255,255,255,.08);
            --card-border-hover: rgba(255,255,255,.26);
            --input-bg: rgba(255,255,255,.045);
            --input-border: rgba(255,255,255,.1);
            --input-border-focus: rgba(255,255,255,.4);
            --shadow: rgba(0,0,0,.8);
            --accent: #7c8cff;
            --accent-2: #b47cff;
            --accent-glow: rgba(124,140,255,.28);
            --ring: rgba(124,140,255,.28);
        }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes slideRight { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes logoDrop {
            0% { opacity:0; transform:translateY(-40px) scale(.8); }
            70% { opacity:1; transform:translateY(4px) scale(1.02); }
            100% { opacity:1; transform:none; }
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        html {
            min-height: 100%;
            background: #000;
        }

        body {
            color: var(--text);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            position: relative;
            overflow-x: hidden;

            /* Foggy forest background image, fixed and covering */
            background-color: #000;
            background-image: url('/assets/backgrounds/foggy-forest.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        /* Dark overlay so text stays readable over the background */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                linear-gradient(180deg, rgba(0,0,0,.72) 0%, rgba(0,0,0,.82) 100%),
                radial-gradient(700px 500px at 50% 30%, rgba(124,140,255,.06), transparent 65%);
            z-index: 0;
            pointer-events: none;
        }

        /* ============ SETTINGS WRAPPER ============ */
        .settings-wrapper {
            position: relative;
            z-index: 2;
            width: min(100%, 580px);
            padding: 40px 22px 60px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-right: 130px;
        }

        /* Logo */
        .logo-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            animation: logoDrop .6s cubic-bezier(.16,1,.3,1) both;
        }

        .farius-logo {
            height: auto;
            width: auto;
            max-height: 90px;
            max-width: 240px;
            object-fit: contain;
            transition: transform 0.3s ease;
        }
        .farius-logo:hover {
            transform: scale(1.05) translateY(-3px);
        }

        .logo-fallback {
            display: none;
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: 6px;
            text-transform: uppercase;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Title */
        .page-title {
            text-align: center;
            margin: 0 4px 6px;
            font-size: clamp(1.8rem, 5vw, 2.35rem);
            font-weight: 800;
            letter-spacing: -1px;
            animation: slideUp 0.4s 0.05s ease both;
            background: linear-gradient(180deg, var(--text), var(--text-dim-2));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .page-subtitle {
            text-align: center;
            margin: -8px 4px 12px;
            color: var(--text-dim);
            font-size: 0.86rem;
            letter-spacing: 0.3px;
            font-weight: 500;
            animation: slideUp 0.4s 0.1s ease both;
        }

        /* ============ SETTING CARD — now semi-transparent so background shows ============ */
        .settings-container {
            position: relative;
            background: rgba(10,10,10,.72);
            padding: 22px 24px;
            border-radius: 16px;
            border: 1px solid var(--card-border);
            box-shadow: 0 12px 32px -16px var(--shadow);
            animation: slideUp 0.4s ease both;
            transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
        }

        .settings-container::before {
            content: '';
            position: absolute;
            top: 12px;
            bottom: 12px;
            left: 0;
            width: 2px;
            background: linear-gradient(180deg, var(--accent), var(--accent-2) 60%, transparent);
            border-top-left-radius: 2px;
            border-bottom-left-radius: 2px;
            opacity: 0.6;
            transition: opacity 0.2s ease;
        }

        .settings-container:hover {
            border-color: var(--card-border-hover);
            background: rgba(15,15,15,.82);
            transform: translateY(-2px);
        }
        .settings-container:hover::before { opacity: 1; }

        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            min-height: 40px;
            margin-bottom: 14px;
        }
        .setting-item:last-child { margin-bottom: 0; }

        .setting-item label {
            font-size: 0.82rem;
            margin-right: 10px;
            color: var(--text);
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .setting-item select,
        .setting-item input {
            min-height: 40px;
            border-radius: 10px;
            border: 1.5px solid var(--input-border);
            background: rgba(5,5,5,.7);
            color: var(--text);
            font-size: 0.8rem;
            font-family: inherit;
            font-weight: 500;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }

        .setting-item select {
            min-width: 160px;
            padding: 8px 34px 8px 13px;
            cursor: pointer;
        }

        .setting-item input {
            width: 245px;
            padding: 8px 13px;
        }

        .setting-item select:hover,
        .setting-item input:hover {
            border-color: var(--card-border-hover);
            background: rgba(8,8,8,.85);
        }

        .setting-item select:focus,
        .setting-item input:focus {
            border-color: var(--input-border-focus);
            background: #0d0d0d;
            box-shadow: 0 0 0 3px var(--ring);
        }

        .setting-item select option {
            background-color: #0a0a0a;
            color: var(--text);
        }

        .setting-item input::placeholder {
            color: var(--text-dim);
        }

        /* ============ ACTION BAR ============ */
        .action-bar {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 26px;
            padding-top: 22px;
            border-top: 1px solid var(--card-border);
            animation: slideUp 0.4s 0.25s ease both;
            flex-wrap: wrap;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 13px 28px;
            border-radius: 12px;
            background: rgba(10,10,10,.72);
            border: 1.5px solid var(--input-border);
            color: var(--text);
            font-family: inherit;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            cursor: pointer;
            text-decoration: none;
            transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 8px 22px -12px var(--shadow);
        }

        .action-btn svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform 0.2s ease;
        }

        .action-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border-color: transparent;
            color: #ffffff;
            transform: translateY(-3px);
            box-shadow: 0 14px 36px -12px var(--accent-glow);
        }

        .action-btn:hover svg { transform: translateX(-3px); }
        .action-btn:active { transform: translateY(-1px) scale(0.98); }

        /* ============ RIGHT SIDE PANEL — TOP-TO-BOTTOM, FLUSH ============ */
        .side-dock {
            position: fixed;
            top: 0;
            bottom: 0;
            right: 0;
            z-index: 100;
            width: 130px;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            justify-content: center;
            gap: 6px;
            padding: 18px 12px;
            background: rgba(10,10,10,.85);
            border-left: 1px solid var(--card-border);
            animation: slideRight .4s cubic-bezier(.2,.9,.25,1.15) both;
        }

        .side-dock::before {
            content: "";
            position: absolute;
            left: 0;
            top: 18%;
            bottom: 18%;
            width: 2px;
            background: linear-gradient(180deg, transparent, var(--accent), var(--accent-2), transparent);
            opacity: .5;
            pointer-events: none;
        }

        .dock-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            height: 44px;
            padding: 0 14px;
            border-radius: 12px;
            text-decoration: none;
            color: var(--text-dim-2);
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: .3px;
            background: transparent;
            border: 1px solid transparent;
            transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;
            cursor: pointer;
            will-change: transform;
        }

        .dock-btn .label {
            flex: 1;
            text-align: left;
        }

        .dock-btn svg {
            width: 17px;
            height: 17px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
            transition: stroke .2s ease, transform .25s ease;
        }

        .dock-btn:hover {
            color: var(--text);
            background: var(--card-hover);
            border-color: var(--card-border-hover);
            transform: translateY(-3px) scale(1.04);
            box-shadow: 0 10px 24px -10px var(--shadow);
        }
        .dock-btn:hover svg { stroke: var(--accent); transform: scale(1.08); }
        .dock-btn:active { transform: translateY(-1px) scale(1.01); }

        .dock-btn.active {
            color: var(--text);
            background: var(--card);
            border-color: var(--card-border);
        }

        .dock-btn.games-btn {
            background: linear-gradient(135deg, rgba(124,140,255,.16), rgba(180,124,255,.12));
            border: 1px solid rgba(124,140,255,.3);
            color: var(--text);
        }
        .dock-btn.games-btn svg { stroke: var(--accent); }
        .dock-btn.games-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border-color: transparent;
            color: #fff;
            transform: translateY(-3px) scale(1.06);
            box-shadow: 0 12px 28px -10px var(--accent-glow);
        }
        .dock-btn.games-btn:hover svg { stroke: #fff; }

        .dock-sep {
            height: 1px;
            margin: 4px 6px;
            background: linear-gradient(90deg, transparent, var(--card-border), transparent);
        }

        /* ============ PAGE SLIDE ============ */
        .page-slide {
            position: fixed;
            inset: 0;
            z-index: 30000;
            background: #000;
            transform: translateX(100%);
            transition: transform .45s cubic-bezier(.65, 0, .35, 1);
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
            will-change: transform;
        }

        .page-slide::after {
            content: "";
            width: 40px;
            height: 40px;
            border: 3px solid var(--input-border);
            border-top-color: var(--accent);
            border-radius: 50%;
            opacity: 0;
        }

        .page-slide.active {
            transform: translateX(0);
            pointer-events: auto;
        }
        .page-slide.active::after {
            opacity: 1;
            animation: spin .8s linear infinite;
        }
        .page-slide.enter { transform: translateX(0); transition: none; }
        .page-slide.enter.leaving {
            transform: translateX(-100%);
            transition: transform .45s cubic-bezier(.65, 0, .35, 1);
        }

        /* ============ MOBILE ============ */
        @media (max-width: 720px) {
            .side-dock { width: 60px; padding: 14px 6px; gap: 4px; }
            .dock-btn { height: 42px; padding: 0; justify-content: center; gap: 0; }
            .dock-btn .label { display: none; }
            .dock-btn svg { width: 20px; height: 20px; }
            .settings-wrapper { margin-right: 60px; padding: 30px 14px 40px; gap: 13px; }
            .farius-logo { max-height: 60px; max-width: 180px; }
            .settings-container { padding: 17px 18px; border-radius: 14px; }
            .setting-item { gap: 12px; }
            .setting-item label { font-size: 0.76rem; }
            .setting-item select { min-width: 132px; max-width: 52%; padding-left: 10px; padding-right: 25px; }
            .setting-item input { width: 52%; min-width: 0; }
            #custom-wisp-server-container { align-items: flex-start; }
            .action-bar { gap: 8px; }
            .action-btn { padding: 11px 20px; font-size: 0.8rem; }
        }

        @media (max-width: 360px) {
            .setting-item { align-items: flex-start; flex-direction: column; }
            .setting-item select,
            .setting-item input { width: 100%; max-width: none; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>

    <!-- Background music — loops forever, hidden -->
    <audio id="bg-music" src="/Lamour-song.mp3" loop preload="auto" autoplay></audio>

    <div class="settings-wrapper">

        <!-- LOGO -->
        <div class="logo-area">
            <img src="/logo.gif" alt="Farius" class="farius-logo"
                 onerror="this.style.display='none'; document.querySelector('.logo-fallback').style.display='block';">
            <div class="logo-fallback">Farius</div>
        </div>

        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Make sure to use DuckDuckGo — Google ain't workin :sob</p>

        <div class="settings-container" style="animation-delay: 0.05s;">
            <div class="setting-item">
                <label for="type">Proxy Type</label>
                <select id="type">
                    <option value="ultraviolet">Ultraviolet</option>
                    <option value="scramjet">Scramjet</option>
                </select>
            </div>
        </div>

        <div class="settings-container" style="animation-delay: 0.1s;">
            <div class="setting-item">
                <label for="search-engine">Search Engine</label>
                <select id="search-engine">
                    <option value="https://duckduckgo.com/?q=">DuckDuckGo</option>
                    <option value="https://www.bing.com/search?q=">Bing</option>
                    <option value="https://search.brave.com/search?q=">Brave</option>
                    <option value="https://www.google.com/search?q=">Google</option>
                    <option value="https://www.ecosia.org/search?q=">Ecosia</option>
                </select>
            </div>
        </div>

        <div class="settings-container" style="animation-delay: 0.15s;">
            <div class="setting-item">
                <label for="transport-type">Transport</label>
                <select id="transport-type">
                    <option value="libcurl">Libcurl</option>
                    <option value="epoxy">Epoxy</option>
                </select>
            </div>
        </div>

        <div class="settings-container" style="animation-delay: 0.2s;">
            <div class="setting-item">
                <label for="wisp-server-type">Wisp Server</label>
                <select id="wisp-server-type">
                    <option value="default">Default</option>
                    <option value="custom">Custom</option>
                </select>
            </div>
            <div class="setting-item" id="custom-wisp-server-container" style="display: none;">
                <label for="custom-wisp-server-input">Custom Wisp URL</label>
                <input type="text" id="custom-wisp-server-input" placeholder="wss://your-wisp.com/wisp/">
            </div>
        </div>

        <!-- SINGLE ACTION BUTTON -->
        <div class="action-bar">
            <a href="/" class="action-btn">
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
                Back to Home
            </a>
        </div>

    </div>

    <!-- RIGHT SIDE PANEL -->
    <nav class="side-dock" aria-label="Site navigation">
        <a href="/" class="dock-btn" title="Home">
            <span class="label">Home</span>
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </a>
        <a href="/settings" class="dock-btn active" title="Settings">
            <span class="label">Settings</span>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </a>
        <div class="dock-sep" aria-hidden="true"></div>
        <a href="/gnmath.html" class="dock-btn games-btn" id="gamesBtn" title="Play Games">
            <span class="label">Games</span>
            <svg viewBox="0 0 24 24">
                <rect x="2" y="6" width="20" height="12" rx="3"/>
                <path d="M6 12h4M8 10v4M15 11h.01M17.5 13h.01"/>
            </svg>
        </a>
    </nav>

    <!-- PAGE SLIDE OVERLAY -->
    <div class="page-slide" id="pageSlide"></div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            /* ============ PAGE SLIDE — ENTER ANIMATION ============ */
            (function () {
                const slide = document.getElementById("pageSlide");
                if (sessionStorage.getItem("slideFrom")) {
                    sessionStorage.removeItem("slideFrom");
                    slide.classList.add("enter");
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            slide.classList.add("leaving");
                        });
                    });
                    setTimeout(() => {
                        slide.classList.remove("enter", "leaving");
                    }, 600);
                }
            })();

            /* ============ PAGE SLIDE — EXIT (Games button) ============ */
            const gamesBtn = document.getElementById("gamesBtn");
            if (gamesBtn) {
                gamesBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    const slide = document.getElementById("pageSlide");
                    slide.classList.add("active");
                    sessionStorage.setItem("slideFrom", "true");
                    setTimeout(() => {
                        window.location.href = "/gnmath.html";
                    }, 500);
                });
            }

            /* ============ BACKGROUND MUSIC ============ */
            (function initBackgroundMusic() {
                const music = document.getElementById('bg-music');
                if (!music) return;
                music.volume = 1.0;
                music.loop = true;

                function tryPlay() {
                    const p = music.play();
                    if (p && typeof p.catch === 'function') p.catch(() => {});
                }
                tryPlay();

                function startOnce() {
                    tryPlay();
                    document.removeEventListener('click', startOnce);
                    document.removeEventListener('touchstart', startOnce);
                    document.removeEventListener('keydown', startOnce);
                    document.removeEventListener('mousemove', startOnce);
                }
                document.addEventListener('click', startOnce);
                document.addEventListener('touchstart', startOnce);
                document.addEventListener('keydown', startOnce);
                document.addEventListener('mousemove', startOnce);

                music.addEventListener('pause', () => { setTimeout(() => { if (music.paused) tryPlay(); }, 200); });
                music.addEventListener('ended', () => { music.currentTime = 0; tryPlay(); });
            })();

            /* ============ SETTINGS LOGIC ============ */
            const defaultBg = '/assets/backgrounds/foggy-forest.png';
            let bg = localStorage.getItem('bg');
            if (!bg) {
                bg = defaultBg;
                localStorage.setItem('bg', bg);
            }

            // Apply any saved background override (from localStorage) on top of the default
            if (bg && bg !== defaultBg) {
                document.body.style.backgroundImage = `url('${bg}')`;
            }

            const proxyTypeSelect = document.getElementById('type');
            if (!localStorage.getItem('proxy')) localStorage.setItem('proxy', 'ultraviolet');
            proxyTypeSelect.value = localStorage.getItem('proxy');
            proxyTypeSelect.addEventListener('change', (event) => localStorage.setItem('proxy', event.target.value));

            const searchEngineSelect = document.getElementById('search-engine');
            if (!localStorage.getItem('search')) localStorage.setItem('search', 'https://duckduckgo.com/?q=');
            searchEngineSelect.value = localStorage.getItem('search');
            searchEngineSelect.addEventListener('change', (event) => localStorage.setItem('search', event.target.value));

            const transportTypeSelect = document.getElementById('transport-type');
            if (!localStorage.getItem('transport')) localStorage.setItem('transport', 'libcurl');
            transportTypeSelect.value = localStorage.getItem('transport');
            transportTypeSelect.addEventListener('change', (event) => localStorage.setItem('transport', event.target.value));

            const wispServerTypeSelect = document.getElementById('wisp-server-type');
            const customWispServerContainer = document.getElementById('custom-wisp-server-container');
            const customWispServerInput = document.getElementById('custom-wisp-server-input');
            const defaultWispUrl = `wss://${window.location.host}/wisp/`;

            if (!localStorage.getItem('wisp')) localStorage.setItem('wisp', defaultWispUrl);

            const currentWispUrl = localStorage.getItem('wisp');
            if (currentWispUrl === defaultWispUrl) {
                wispServerTypeSelect.value = 'default';
                customWispServerInput.value = '';
            } else {
                wispServerTypeSelect.value = 'custom';
                customWispServerInput.value = currentWispUrl;
            }

            const updateWispServerVisibility = () => {
                if (wispServerTypeSelect.value === 'custom') {
                    customWispServerContainer.style.display = 'flex';
                } else {
                    customWispServerContainer.style.display = 'none';
                }
            };
            updateWispServerVisibility();

            wispServerTypeSelect.addEventListener('change', (event) => {
                const selectedType = event.target.value;
                if (selectedType === 'default') localStorage.setItem('wisp', defaultWispUrl);
                else localStorage.setItem('wisp', customWispServerInput.value);
                updateWispServerVisibility();
            });

            customWispServerInput.addEventListener('input', (event) => {
                if (wispServerTypeSelect.value === 'custom') localStorage.setItem('wisp', event.target.value);
            });

            const savedFont = localStorage.getItem('font');
            if (savedFont) document.body.style.fontFamily = savedFont;
        });
    </script>
</body>
</html>