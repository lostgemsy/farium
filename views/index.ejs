    <a href="#" class="venusFooter">Venus integration</a>

    <script>
        let tabs = [];
        let activeTabId = null;
        let tabIdCounter = 0;

        class Tab {
            constructor(id, url, title) {
                this.id = id;
                this.url = url || null;
                this.title = title || 'New Tab';
                this.history = [];
                this.historyIndex = -1;
            }
            pushHistory(url) {
                if (this.historyIndex < this.history.length - 1) {
                    this.history = this.history.slice(0, this.historyIndex + 1);
                }
                this.history.push(url);
                this.historyIndex = this.history.length - 1;
            }
            canGoBack() { return this.historyIndex > 0; }
            canGoForward() { return this.historyIndex < this.history.length - 1; }
        }

        function createTabId() {
            return 't' + Date.now() + Math.random().toString(36).substr(2, 4);
        }

        function normalizeUrl(query) {
            query = String(query).trim();
            if (!query) return null;
            if (/^https?:\/\//i.test(query)) return query;
            if (query.includes('.') && !query.includes(' ')) return 'https://' + query;
            const engine = localStorage.getItem('search') || 'https://www.google.com/search?q=';
            return engine + encodeURIComponent(query);
        }

        function getProxyUrl(url) {
            return __uv$config.prefix + __uv$config.encodeUrl(url);
        }

        function getHostname(url) {
            try { return new URL(url).hostname.replace('www.', ''); } catch(e) { return url.substring(0, 20); }
        }

        function addTab(url, title) {
            const id = createTabId();
            const tab = new Tab(id, url, title || (url ? getHostname(url) : 'New Tab'));
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) navigateInTab(id, url);
            return tab;
        }

        function closeTab(id) {
            if (tabs.length <= 1) {
                tabs = [];
                addTab(null);
                return;
            }
            const idx = tabs.findIndex(t => t.id === id);
            if (idx === -1) return;
            tabs.splice(idx, 1);
            if (activeTabId === id) {
                const ni = Math.min(idx, tabs.length - 1);
                activeTabId = tabs[ni].id;
                updateActiveTab();
            }
            renderTabs();
        }

        function switchTab(id) {
            activeTabId = id;
            updateActiveTab();
            renderTabs();
        }

        function updateActiveTab() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) return;
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');

            if (tab.url) {
                frame.classList.add('visible');
                newTabPage.classList.add('hidden');
                urlInput.value = tab.url;
            } else {
                frame.classList.remove('visible');
                newTabPage.classList.remove('hidden');
                urlInput.value = '';
            }

            document.getElementById('browser-back').disabled = !tab.canGoBack();
            document.getElementById('browser-forward').disabled = !tab.canGoForward();
        }

        function navigateInTab(id, url) {
            const tab = tabs.find(t => t.id === id);
            if (!tab) return;
            tab.pushHistory(url);
            tab.url = url;
            tab.title = getHostname(url);
            renderTabs();
            if (activeTabId === id) {
                loadUrl(url);
            }
        }

        function loadUrl(url) {
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');
            
            frame.classList.add('visible');
            newTabPage.classList.add('hidden');
            urlInput.value = url;
            frame.src = getProxyUrl(url);
        }

        function renderTabs() {
            const tabsBar = document.getElementById('tabs-bar');
            tabsBar.querySelectorAll('.tab').forEach(el => el.remove());
            
            tabs.forEach(tab => {
                const el = document.createElement('div');
                el.className = 'tab' + (tab.id === activeTabId ? ' active' : '');
                el.innerHTML = '<span class="tab-title">' + escapeHtml(tab.title || 'New Tab') + '</span>' +
                    (tabs.length > 1 ? '<button class="tab-close">X</button>' : '');
                el.querySelector('.tab-title').addEventListener('click', () => switchTab(tab.id));
                const cb = el.querySelector('.tab-close');
                if (cb) cb.addEventListener('click', (e) => { e.stopPropagation(); closeTab(tab.id); });
                tabsBar.insertBefore(el, document.getElementById('new-tab-btn'));
            });
        }

        function escapeHtml(s) {
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        function openBrowser(url) {
            const overlay = document.getElementById('browser-overlay');
            overlay.classList.remove('closing');
            overlay.classList.add('open');
            addTab(url);
        }

        function closeBrowser() {
            const overlay = document.getElementById('browser-overlay');
            overlay.classList.remove('open');
            overlay.classList.add('closing');
            setTimeout(() => {
                if (!overlay.classList.contains('open')) {
                    overlay.classList.remove('closing');
                    tabs = [];
                    activeTabId = null;
                }
            }, 340);
        }

        async function initProxy() {
            if ('serviceWorker' in navigator) {
                try {
                    await navigator.serviceWorker.register('/sw.js');
                    await navigator.serviceWorker.ready;
                } catch (err) {}
            }
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {}
        }

        document.addEventListener('DOMContentLoaded', () => {
            initProxy();
            const defaultBg = '/assets/backgrounds/foggy-forest.png';
            document.body.style.backgroundImage = `url('${localStorage.getItem('bg') || defaultBg}')`;

            // Main search
            document.getElementById('search-go').addEventListener('click', () => {
                const url = normalizeUrl(document.getElementById('search-input').value);
                if (url) openBrowser(url);
            });
            document.getElementById('search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('search-go').click();
            });

            // App shortcuts
            document.querySelectorAll('#app-buttons .app-button[data-url]').forEach(btn => {
                btn.addEventListener('click', () => openBrowser(btn.dataset.url));
            });

            // Browser controls
            document.getElementById('browser-close').addEventListener('click', closeBrowser);
            document.getElementById('browser-home').addEventListener('click', closeBrowser);
            document.getElementById('browser-back').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoBack()) {
                    tab.historyIndex--;
                    tab.url = tab.history[tab.historyIndex];
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-forward').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoForward()) {
                    tab.historyIndex++;
                    tab.url = tab.history[tab.historyIndex];
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-refresh').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.url) loadUrl(tab.url);
            });

            document.getElementById('browser-url-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    const url = normalizeUrl(e.target.value);
                    if (url) {
                        const tab = tabs.find(t => t.id === activeTabId);
                        if (tab) navigateInTab(activeTabId, url);
                    }
                }
            });

            // New tab
            document.getElementById('new-tab-btn').addEventListener('click', () => addTab(null));
            document.getElementById('new-tab-search-btn').addEventListener('click', () => {
                const input = document.getElementById('new-tab-search-input');
                const url = normalizeUrl(input.value);
                if (url) {
                    const tab = tabs.find(t => t.id === activeTabId);
                    if (tab) navigateInTab(activeTabId, url);
                    input.value = '';
                }
            });
            document.getElementById('new-tab-search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('new-tab-search-btn').click();
            });

            // Add app
document.getElementById('add-app-button').addEventListener('click', () => {
                const name = prompt('App name:');
                if (!name) return;
                const url = prompt('URL (e.g. netflix.com):');
                if (!url) return;
                let fullUrl = url.startsWith('http') ? url : 'https://' + url;
                const domain = new URL(fullUrl).hostname;
                const btn = document.createElement('div');
                btn.className = 'app-button';
                btn.dataset.url = fullUrl;
                btn.innerHTML = `<img src="https://www.google.com/s2/favicons?domain=${domain}&sz=64" alt="${name}">`;
                btn.addEventListener('click', () => openBrowser(fullUrl));
                btn.addEventListener('contextmenu', (e) => { e.preventDefault(); btn.remove(); });
                document.getElementById('app-buttons').insertBefore(btn, document.getElementById('add-app-button'));
            });
        });

        // ===== Farium particles: user-configurable from Settings =====
        const particleCanvas = document.getElementById('particle-canvas');
        const particleCtx = particleCanvas.getContext('2d');
        let particleMode = localStorage.getItem('fariumParticles') || 'embers';
        let particleCount = Number(localStorage.getItem('fariumParticleCount') || 55);
        let particles = [];
        function particleColor() { return '#000000'; }
        function resizeParticles(){ particleCanvas.width=innerWidth*devicePixelRatio; particleCanvas.height=innerHeight*devicePixelRatio; particleCanvas.style.width=innerWidth+'px'; particleCanvas.style.height=innerHeight+'px'; particleCtx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0); }
        function resetParticles(){ particles=[]; if(particleMode==='off') return; const n=Math.max(0,Math.min(180,particleCount)); for(let i=0;i<n;i++) particles.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*2+.5,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.35,a:Math.random()*.6+.15}); }
        function drawParticles(){ particleCtx.clearRect(0,0,innerWidth,innerHeight); if(particleMode==='off'){requestAnimationFrame(drawParticles);return;} const c=particleColor(); for(const p of particles){p.x+=p.vx;p.y+=p.vy;if(p.x<-10)p.x=innerWidth+10;if(p.x>innerWidth+10)p.x=-10;if(p.y<-10)p.y=innerHeight+10;if(p.y>innerHeight+10)p.y=-10; particleCtx.globalAlpha=p.a; particleCtx.fillStyle=c; if(particleMode==='stars'){particleCtx.beginPath();particleCtx.arc(p.x,p.y,p.r*.65,0,Math.PI*2);particleCtx.fill();}else if(particleMode==='bubbles'){particleCtx.strokeStyle=c;particleCtx.lineWidth=1;particleCtx.beginPath();particleCtx.arc(p.x,p.y,p.r*2.2,0,Math.PI*2);particleCtx.stroke();}else{particleCtx.beginPath();particleCtx.arc(p.x,p.y,p.r,0,Math.PI*2);particleCtx.fill();}} particleCtx.globalAlpha=1; requestAnimationFrame(drawParticles); }
        addEventListener('resize',()=>{resizeParticles();resetParticles()}); resizeParticles(); resetParticles(); drawParticles();

        // ===== Farium Chat =====
        const chatOverlay=document.getElementById('chat-overlay'), chatLaunch=document.getElementById('farium-chat-launch'), chatClose=document.getElementById('chat-close');
        const chatAuth=document.getElementById('chat-auth'), chatApp=document.getElementById('chat-app'), authForm=document.getElementById('chat-auth-form');
        let authMode='login', currentUser=null, selectedAvatar='red', lastMessageTime=0;
        const avatarMap={red:'#111111',black:'#111111',white:'#eeeeee',crimson:'linear-gradient(135deg,#333,#111)',ember:'linear-gradient(135deg,#444,#222)',mono:'linear-gradient(135deg,#222,#888)'};
        function avatarEl(u,small=false){const d=document.createElement('div');d.className='chat-avatar';d.style.background=avatarMap[u.avatar]||'#111';d.style.color=u.avatar==='white'?'#111':'#fff';d.textContent=(u.username||'F')[0].toUpperCase();if(small)d.style.width=d.style.height='26px';return d;}
        function openChat(){chatOverlay.classList.add('open');chatOverlay.setAttribute('aria-hidden','false');checkMe();}
        function closeChat(){chatOverlay.classList.remove('open');chatOverlay.setAttribute('aria-hidden','true');}
        chatLaunch.addEventListener('click',openChat); if(location.hash==='#chat') openChat(); chatClose.addEventListener('click',closeChat); chatOverlay.addEventListener('click',e=>{if(e.target===chatOverlay)closeChat()});
        document.querySelectorAll('.chat-auth-tab').forEach(b=>b.addEventListener('click',()=>{authMode=b.dataset.mode;document.querySelectorAll('.chat-auth-tab').forEach(x=>x.classList.toggle('active',x===b));document.getElementById('chat-auth-submit').textContent=authMode==='login'?'Sign in':'Create account';document.getElementById('avatar-picker').hidden=authMode!=='register';document.getElementById('chat-password').autocomplete=authMode==='login'?'current-password':'new-password';}));
        document.querySelectorAll('.avatar-choice').forEach(b=>b.addEventListener('click',()=>{selectedAvatar=b.dataset.avatar;document.querySelectorAll('.avatar-choice').forEach(x=>x.classList.toggle('selected',x===b));}));
        async function api(url,opts={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(opts.headers||{})},...opts});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||'Request failed');return j;}
        async function checkMe(){try{const j=await api('/api/auth/me');currentUser=j.user;if(currentUser){chatAuth.hidden=true;chatApp.hidden=false;renderMe();renderFriends();loadMessages(true);}else{chatAuth.hidden=false;chatApp.hidden=true;}}catch(e){chatAuth.hidden=false;chatApp.hidden=true;}}
        function renderMe(){const el=document.getElementById('chat-me');el.replaceChildren(avatarEl(currentUser));const wrap=document.createElement('div');wrap.style.display='inline-block';wrap.style.verticalAlign='top';wrap.style.marginLeft='8px';wrap.innerHTML=`<strong style="font-size:11px">${escapeHtml(currentUser.username)}</strong><small style="display:block;color:#888;font-size:9px">Signed in</small>`;el.appendChild(wrap);}
        function renderFriends(){const box=document.getElementById('chat-friends');box.innerHTML='';(currentUser.friends||[]).forEach(id=>{const d=document.createElement('div');d.className='chat-user-card';d.textContent='Friend';box.appendChild(d);});}
        function renderMessages(msgs){const box=document.getElementById('chat-messages');for(const m of msgs){if(box.querySelector(`[data-message-id="${m.id}"]`))continue;const row=document.createElement('div');row.className='chat-message';row.dataset.messageId=m.id;row.appendChild(avatarEl(m));const body=document.createElement('div');body.className='chat-message-body';const dt=new Date(m.createdAt).toLocaleTimeString([], {hour:'numeric',minute:'2-digit'});body.innerHTML=`<div><span class="chat-message-name">${escapeHtml(m.username)}</span><span class="chat-message-time">${dt}</span></div><div class="chat-message-text">${escapeHtml(m.text)}</div>`;row.appendChild(body);box.appendChild(row);lastMessageTime=Math.max(lastMessageTime,m.createdAt);}box.scrollTop=box.scrollHeight;}
        async function loadMessages(initial=false){try{const j=await api('/api/chat/messages?since='+(initial?0:lastMessageTime));renderMessages(j.messages);}catch(e){}}
        authForm.addEventListener('submit',async e=>{e.preventDefault();const err=document.getElementById('chat-auth-error');err.textContent='';try{const body={username:document.getElementById('chat-username').value,password:document.getElementById('chat-password').value,avatar:selectedAvatar};const j=await api(authMode==='login'?'/api/auth/login':'/api/auth/register',{method:'POST',body:JSON.stringify(body)});currentUser=j.user;authForm.reset();chatAuth.hidden=true;chatApp.hidden=false;renderMe();renderFriends();loadMessages(true);}catch(x){err.textContent=x.message;}});
        document.getElementById('chat-compose').addEventListener('submit',async e=>{e.preventDefault();const input=document.getElementById('chat-message-input');const text=input.value.trim();if(!text)return;try{const j=await api('/api/chat/messages',{method:'POST',body:JSON.stringify({text})});input.value='';renderMessages([j.message]);}catch(x){alert(x.message);}});
        document.getElementById('chat-logout').addEventListener('click',async()=>{await api('/api/auth/logout',{method:'POST'});currentUser=null;lastMessageTime=0;document.getElementById('chat-messages').innerHTML='';chatAuth.hidden=false;chatApp.hidden=true;});
        async function searchUsers(){const q=document.getElementById('chat-user-search').value.trim();if(!q)return;try{const j=await api('/api/users/search?q='+encodeURIComponent(q));const box=document.getElementById('chat-results');box.innerHTML='';j.users.forEach(u=>{const d=document.createElement('div');d.className='chat-user-card';d.appendChild(avatarEl(u,true));const n=document.createElement('span');n.textContent=u.username;n.style.fontSize='11px';d.appendChild(n);const b=document.createElement('button');b.className='friend-add';b.textContent='+';b.onclick=async()=>{try{const r=await api('/api/friends/add',{method:'POST',body:JSON.stringify({username:u.username})});currentUser=r.user;renderMe();renderFriends();b.textContent='✓';}catch(e){b.textContent='!';}};d.appendChild(b);box.appendChild(d);});}catch(e){}}
        document.getElementById('chat-user-search-btn').addEventListener('click',searchUsers);document.getElementById('chat-user-search').addEventListener('keydown',e=>{if(e.key==='Enter')searchUsers();});
        setInterval(()=>{if(currentUser&&chatOverlay.classList.contains('open'))loadMessages(false)},1800);

    </script>
</body>
</html>
