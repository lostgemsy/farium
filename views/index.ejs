<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farium · Browse Freely</title>

    <!-- External proxy libraries -->
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/gif" href="/logo.gif">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ============ RESET & GREEN FOREST TOKENS ============ */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #0a0f0a;
            --text: #e8f0e8;
            --text-dim: rgba(200, 235, 200, 0.55);
            --text-dim-2: rgba(215, 240, 215, 0.85);
            --card: rgba(30, 50, 30, 0.18);
            --card-hover: rgba(60, 110, 60, 0.28);
            --card-border: rgba(140, 220, 140, 0.22);
            --card-border-hover: rgba(160, 255, 160, 0.55);
            --input-bg: rgba(10, 25, 10, 0.28);
            --input-border: rgba(140, 220, 140, 0.25);
            --input-border-focus: rgba(160, 255, 160, 0.7);
            --shadow: rgba(0, 0, 0, 0.6);
            --accent: #5cb85c;
            --accent-2: #3a9e3a;
            --accent-glow: rgba(92, 184, 92, 0.35);
            --ring: rgba(92, 184, 92, 0.25);
            --overlay-top: rgba(0, 0, 0, 0.28);
            --overlay-bottom: rgba(0, 0, 0, 0.55);
            --radius-card: 20px;
            --radius-btn: 14px;
            --radius-pill: 40px;
            --transition-smooth: cubic-bezier(0.22, 0.98, 0.36, 1);
            --transition-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        html { background: #0a0f0a; scroll-behavior: smooth; }

        body {
            margin: 0; padding: 0;
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            min-height: 100vh;
            display: flex; justify-content: center; align-items: center;
            position: relative;
            background-color: #0a0f0a;
            background-image: url('/background.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            -webkit-font-smoothing: antialiased;
        }

        body::before {
            content: '';
            position: fixed; inset: 0;
            background: linear-gradient(180deg, var(--overlay-top) 0%, var(--overlay-bottom) 100%);
            z-index: 0; pointer-events: none;
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb {
            background: rgba(120, 200, 120, 0.25);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover { background: rgba(140, 240, 140, 0.45); }

        /* ============ ANIMATIONS ============ */
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideRight {
            from { opacity: 0; transform: translateX(24px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes slideInSearch {
            from { opacity: 0; transform: translateY(18px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes logoDrop {
            0% { opacity: 0; transform: translateY(-40px) scale(0.82); }
            70% { opacity: 1; transform: translateY(4px) scale(1.02); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes osWindowOpen {
            0% { opacity: 0; transform: scale(0.92) translateY(20px); }
            60% { opacity: 1; transform: scale(1.01) translateY(-3px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }
        @keyframes osWindowClose {
            0% { opacity: 1; transform: scale(1); }
            100% { opacity: 0; transform: scale(0.92) translateY(20px); }
        }
        @keyframes bounceIn {
            0%   { opacity: 0; transform: translateY(20px) scale(0.94); }
            60%  { opacity: 1; transform: translateY(-6px) scale(1.02); }
            80%  { transform: translateY(2px) scale(0.99); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes startMenuOpen {
            0% { opacity: 0; transform: translateX(-50%) translateY(30px) scale(0.95); }
            60% { opacity: 1; transform: translateX(-50%) translateY(-4px) scale(1.01); }
            100% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
        }
        @keyframes lockFade {
            0% { opacity: 0; backdrop-filter: blur(0px); }
            100% { opacity: 1; backdrop-filter: blur(40px); }
        }
        @keyframes lockClockIn {
            0% { opacity: 0; transform: translateY(30px) scale(0.9); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes pulseRing {
            0% { transform: scale(0.9); opacity: 0.7; }
            100% { transform: scale(1.3); opacity: 0; }
        }
        @keyframes dockPulse {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-3px); }
        }

        /* ============ SIDE DOCK ============ */
        .side-dock {
            position: fixed; top: 0; bottom: 0; right: 0;
            z-index: 100; width: 180px;
            display: flex; flex-direction: column;
            align-items: stretch; justify-content: center;
            gap: 6px; padding: 20px 12px;
            background: rgba(15, 30, 15, 0.22);
            border-left: 1px solid rgba(140, 220, 140, 0.18);
            animation: slideRight 0.45s var(--transition-smooth) both;
            backdrop-filter: blur(28px) saturate(140%);
            -webkit-backdrop-filter: blur(28px) saturate(140%);
            transition: width 0.3s var(--transition-smooth);
            box-shadow: -8px 0 32px rgba(0, 0, 0, 0.35);
        }
        .side-dock::before {
            content: ""; position: absolute; left: 0;
            top: 18%; bottom: 18%; width: 2px;
            background: linear-gradient(180deg, transparent, var(--accent), var(--accent-2), transparent);
            opacity: 0.7; pointer-events: none; border-radius: 2px;
        }
        .dock-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 6px 10px;
            border-bottom: 1px solid rgba(140, 220, 140, 0.15);
            margin-bottom: 6px;
        }
        .dock-header span {
            font-size: 10px; text-transform: uppercase;
            letter-spacing: 1.6px; color: var(--text-dim); font-weight: 700;
        }
        .dock-collapse-btn {
            background: transparent; border: none; color: var(--text-dim);
            cursor: pointer; font-size: 16px; line-height: 1;
            padding: 4px 8px; border-radius: 8px; transition: all 0.2s;
        }
        .dock-collapse-btn:hover { background: var(--card-hover); color: var(--text); }
        .dock-items {
            display: flex; flex-direction: column; gap: 6px;
            overflow-y: auto; overflow-x: hidden; flex: 1; padding-right: 2px;
        }
        .dock-item {
            position: relative; display: flex; align-items: center; gap: 10px;
            height: 44px; padding: 0 12px; border-radius: var(--radius-btn);
            text-decoration: none; color: var(--text-dim-2);
            font-size: 13px; font-weight: 600; letter-spacing: 0.3px;
            background: transparent; border: 1px solid transparent;
            transition: all 0.28s var(--transition-smooth);
            cursor: pointer; font-family: inherit; flex-shrink: 0;
        }
        .dock-item .label { flex: 1; text-align: left; }
        .dock-item svg {
            width: 18px; height: 18px; stroke: currentColor; fill: none;
            stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round;
            flex-shrink: 0;
            transition: stroke 0.2s ease, transform 0.28s ease;
        }
        .dock-item:hover {
            color: #fff;
            background: rgba(60, 110, 60, 0.3);
            border-color: var(--card-border-hover);
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 28px -12px var(--shadow), 0 0 24px -8px rgba(92, 184, 92, 0.3);
        }
        .dock-item:hover svg { stroke: #b8ffb8; transform: scale(1.15) rotate(-6deg); }
        .dock-item:active { transform: translateY(-1px) scale(1.01); }
        .dock-item.active {
            color: #fff;
            background: rgba(60, 120, 60, 0.32);
            border-color: rgba(140, 220, 140, 0.4);
        }
        .dock-item.games-btn {
            background: linear-gradient(135deg, rgba(60, 140, 60, 0.32), rgba(40, 100, 40, 0.22));
            border: 1px solid rgba(140, 220, 140, 0.35); color: #fff;
        }
        .dock-item.games-btn svg { stroke: #b8ffb8; }
        .dock-item.games-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border-color: transparent; color: #fff;
            box-shadow: 0 14px 32px -10px var(--accent-glow);
        }
        .dock-item.games-btn:hover svg { stroke: #fff; }
        .dock-sep {
            height: 1px; margin: 6px 8px;
            background: linear-gradient(90deg, transparent, rgba(140, 220, 140, 0.2), transparent);
            flex-shrink: 0;
        }
        .side-dock.collapsed { width: 60px; padding: 20px 6px; align-items: center; }
        .side-dock.collapsed .dock-header span,
        .side-dock.collapsed .dock-item .label,
        .side-dock.collapsed .dock-sep { display: none; }
        .side-dock.collapsed .dock-header { border-bottom: none; padding: 0 0 8px; justify-content: center; }
        .side-dock.collapsed .dock-collapse-btn { font-size: 18px; }
        .side-dock.collapsed .dock-item { justify-content: center; padding: 0; width: 44px; height: 44px; }
        .side-dock.collapsed .dock-item svg { width: 20px; height: 20px; }

        /* ============ MAIN CONTENT ============ */
        .main-content {
            position: relative; z-index: 2; text-align: center;
            width: 100%; max-width: 660px; padding: 0 24px;
            margin-right: 180px; transition: margin-right 0.3s var(--transition-smooth);
        }
        .side-dock.collapsed ~ .main-content { margin-right: 60px; }
        .logo-image-wrap {
            display: flex; justify-content: center; align-items: center;
            margin-bottom: 20px; min-height: 130px;
            animation: logoDrop 0.7s var(--transition-smooth) both;
        }
        .farius-logo {
            display: block; width: auto; height: auto;
            max-width: min(440px, 72vw); max-height: 240px;
            object-fit: contain;
            transition: transform 0.35s var(--transition-smooth);
            filter: drop-shadow(0 8px 32px rgba(92, 184, 92, 0.35));
        }
        .logo-image-wrap:hover .farius-logo {
            transform: translateY(-6px) scale(1.04);
            filter: drop-shadow(0 12px 40px rgba(92, 184, 92, 0.5));
        }
        .tagline {
            font-size: 0.72rem; color: var(--text-dim-2);
            letter-spacing: 3.5px; text-transform: uppercase;
            margin-bottom: 30px; font-weight: 600;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
        }

        /* ============ SEARCH BAR ============ */
        .search-container {
            display: flex; align-items: center; max-width: 520px; margin: 0 auto;
            background: rgba(15, 30, 15, 0.22);
            border: 1px solid rgba(140, 220, 140, 0.25);
            border-radius: var(--radius-pill); padding: 6px;
            box-shadow: 0 16px 44px -18px rgba(0, 0, 0, 0.6);
            animation: slideInSearch 0.55s var(--transition-smooth);
            transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
            backdrop-filter: blur(24px) saturate(150%);
            -webkit-backdrop-filter: blur(24px) saturate(150%);
        }
        .search-container:focus-within {
            border-color: rgba(160, 255, 160, 0.7);
            box-shadow: 0 0 0 4px rgba(92, 184, 92, 0.2), 0 16px 44px -18px rgba(0, 0, 0, 0.6);
            background: rgba(30, 60, 30, 0.32);
        }
        .search-input {
            flex: 1; border: none; padding: 14px 18px;
            font-size: 0.92rem; outline: none; background: transparent;
            color: var(--text); font-family: inherit; font-weight: 500;
        }
        .search-input::placeholder { color: rgba(200, 235, 200, 0.55); font-weight: 400; }
        .search-button {
            background: linear-gradient(180deg, #5cb85c, #3a8e3a);
            border: none; border-radius: var(--radius-pill);
            padding: 12px 28px; cursor: pointer; outline: none;
            color: white; font-size: 14px; font-weight: 700;
            transition: all 0.25s var(--transition-smooth);
            font-family: inherit;
            box-shadow: 0 8px 24px -8px rgba(92, 184, 92, 0.5);
            letter-spacing: 0.3px;
        }
        .search-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px -8px rgba(92, 184, 92, 0.6);
            filter: brightness(1.1);
        }
        .search-button:active { transform: scale(0.96); }

        /* ============ APP BUTTONS ============ */
        .app-buttons {
            display: flex; justify-content: center; margin-top: 24px;
            gap: 20px; flex-wrap: wrap;
            animation: slideUp 0.55s var(--transition-smooth) 0.1s both;
        }
        .app-button {
            display: flex; align-items: center; justify-content: center;
            width: 52px; height: 52px; border-radius: 50%;
            background: transparent; cursor: pointer; outline: none;
            border: none; color: var(--text); text-decoration: none;
            transition: all 0.3s var(--transition-smooth); position: relative;
        }
        .app-button::before {
            content: ''; position: absolute; inset: 0; border-radius: 50%;
            background: rgba(30, 60, 30, 0.25);
            backdrop-filter: blur(14px) saturate(140%);
            -webkit-backdrop-filter: blur(14px) saturate(140%);
            border: 1px solid rgba(140, 220, 140, 0.25);
            transition: all 0.3s var(--transition-smooth); opacity: 0.9;
        }
        .app-button:hover::before {
            background: rgba(60, 120, 60, 0.45);
            border-color: rgba(160, 255, 160, 0.7);
            transform: scale(1.08);
            box-shadow: 0 0 32px -6px rgba(92, 184, 92, 0.6);
        }
        .app-button:active { transform: scale(0.94); }
        .app-button img {
            position: relative; z-index: 1; width: 28px; height: 28px;
            object-fit: contain;
            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.6));
            transition: transform 0.3s var(--transition-smooth);
        }
        .app-button:hover img { transform: scale(1.12); }

        /* ============ SIMPLE BROWSER OVERLAY ============ */
        .browser-overlay {
            position: fixed; inset: 0; z-index: 200;
            display: none; flex-direction: column; color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: rgba(5, 12, 5, 0.55);
            backdrop-filter: blur(40px) saturate(140%);
            -webkit-backdrop-filter: blur(40px) saturate(140%);
        }
        .browser-overlay::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.55) 100%);
            z-index: 0; pointer-events: none;
        }
        .browser-overlay.open { display: flex; animation: fadeIn 0.3s ease; }
        .browser-overlay > * { position: relative; z-index: 1; }

        .tabs-bar {
            display: flex; align-items: center; gap: 4px;
            padding: 10px 14px 0;
            background: rgba(10, 25, 10, 0.3);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(140, 220, 140, 0.15);
            overflow-x: auto; flex-shrink: 0; scrollbar-width: none;
        }
        .tabs-bar::-webkit-scrollbar { display: none; }
        .tab {
            display: flex; align-items: center; gap: 8px;
            padding: 9px 12px 9px 14px; border-radius: 12px 12px 0 0;
            background: transparent; border: 1px solid transparent;
            border-bottom: none; color: var(--text-dim);
            cursor: pointer; font-size: 12.5px; white-space: nowrap;
            max-width: 220px; min-width: 100px;
            transition: all 0.2s ease; flex-shrink: 0;
        }
        .tab:hover { background: rgba(40, 80, 40, 0.25); color: var(--text); }
        .tab.active {
            background: rgba(40, 90, 40, 0.4); color: var(--text);
            border-color: rgba(140, 220, 140, 0.25);
            font-weight: 600; box-shadow: inset 0 3px 0 0 var(--accent);
        }
        .tab-favicon {
            width: 15px; height: 15px; border-radius: 4px;
            flex-shrink: 0; object-fit: contain;
            background: rgba(255, 255, 255, 0.06);
        }
        .tab-favicon-placeholder {
            width: 15px; height: 15px; border-radius: 4px; flex-shrink: 0;
            background: linear-gradient(135deg, #5cb85c, #2d8a2d);
            display: grid; place-items: center; color: #fff;
            font-size: 8px; font-weight: 900;
        }
        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
        .tab-close {
            width: 18px; height: 18px; border-radius: 50%; border: none;
            background: transparent; color: var(--text-dim); cursor: pointer;
            font-size: 11px; opacity: 0;
            transition: opacity 0.15s, background 0.15s;
            flex-shrink: 0; display: flex; align-items: center; justify-content: center;
            line-height: 1;
        }
        .tab:hover .tab-close, .tab.active .tab-close { opacity: 1; }
        .tab-close:hover { background: rgba(200, 50, 50, 0.4); color: #ff8888; }
        .new-tab-btn {
            width: 28px; height: 28px; border-radius: 10px;
            border: 1px dashed rgba(140, 220, 140, 0.3);
            background: transparent; cursor: pointer; color: var(--text-dim);
            font-size: 16px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            margin-left: 6px; margin-bottom: 5px; transition: all 0.2s;
        }
        .new-tab-btn:hover {
            border-color: var(--accent); color: var(--text);
            background: rgba(40, 80, 40, 0.3);
        }

        .browser-toolbar {
            display: flex; align-items: center; gap: 6px; padding: 12px 16px;
            background: rgba(10, 25, 10, 0.28);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(140, 220, 140, 0.12);
            flex-shrink: 0;
        }
        .browser-toolbar button {
            width: 36px; height: 36px; border-radius: 10px; border: none;
            background: transparent; color: var(--text-dim-2); cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.2s;
        }
        .browser-toolbar button:hover:not(:disabled) {
            background: rgba(40, 80, 40, 0.35); color: var(--text);
        }
        .browser-toolbar button:active:not(:disabled) { transform: scale(0.92); }
        .browser-toolbar button:disabled { opacity: 0.25; cursor: not-allowed; }
        .browser-toolbar svg {
            width: 17px; height: 17px; fill: none; stroke: currentColor;
            stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round;
        }
        .browser-address {
            flex: 1; display: flex; align-items: center; gap: 10px;
            background: rgba(15, 30, 15, 0.3);
            border: 1.5px solid rgba(140, 220, 140, 0.2);
            border-radius: 20px; padding: 0 16px; height: 38px;
            transition: border-color 0.25s, box-shadow 0.25s, background 0.25s;
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        }
        .browser-address:focus-within {
            border-color: rgba(160, 255, 160, 0.6);
            box-shadow: 0 0 0 4px rgba(92, 184, 92, 0.15);
            background: rgba(25, 50, 25, 0.4);
        }
        .browser-address .lock-icon {
            width: 14px; height: 14px; stroke: var(--text-dim); fill: none;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
            flex-shrink: 0;
        }
        .browser-address input {
            flex: 1; background: transparent; border: none;
            color: var(--text); font-size: 13px; outline: none;
            font-family: inherit; font-weight: 500;
        }
        .browser-address input::placeholder { color: rgba(200, 235, 200, 0.5); }
        .browser-loader {
            width: 15px; height: 15px;
            border: 2px solid rgba(140, 220, 140, 0.2);
            border-top-color: var(--accent); border-radius: 50%;
            animation: spin 0.7s linear infinite;
            flex-shrink: 0; display: none;
        }
        .browser-loader.visible { display: block; }

        .browser-frame-wrap { flex: 1; position: relative; background: transparent; }
        .browser-frame-wrap iframe {
            width: 100%; height: 100%; border: none;
            background: #fff; display: none;
        }
        .browser-frame-wrap iframe.visible { display: block; }
        .new-tab-page {
            position: absolute; inset: 0;
            display: flex; flex-direction: column; align-items: center;
            justify-content: center; background: transparent; z-index: 1;
        }
        .new-tab-page.hidden { display: none; }
        .new-tab-logo {
            display: flex; justify-content: center; align-items: center;
            margin-bottom: 16px;
        }
        .new-tab-logo img {
            width: auto; height: auto;
            max-width: min(280px, 62vw); max-height: 140px; object-fit: contain;
        }
        .new-tab-sub {
            font-size: 0.72rem; color: var(--text-dim);
            letter-spacing: 3px; text-transform: uppercase;
            margin-bottom: 30px; font-weight: 600;
        }
        .new-tab-search {
            display: flex; align-items: center; gap: 10px;
            max-width: 480px; width: 88%;
        }
        .new-tab-search input {
            flex: 1; background: rgba(15, 30, 15, 0.3);
            border: 1.5px solid rgba(140, 220, 140, 0.2);
            border-radius: 16px; padding: 15px 20px;
            color: var(--text); font-size: 14px; outline: none;
            font-family: inherit;
            transition: border-color 0.25s, box-shadow 0.25s, background 0.25s;
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        }
        .new-tab-search input::placeholder { color: rgba(200, 235, 200, 0.5); }
        .new-tab-search input:focus {
            border-color: rgba(160, 255, 160, 0.6);
            box-shadow: 0 0 0 4px rgba(92, 184, 92, 0.15);
            background: rgba(25, 50, 25, 0.4);
        }
        .new-tab-search button {
            background: linear-gradient(180deg, #5cb85c, #3a8e3a);
            border: none; border-radius: 16px; padding: 15px 26px;
            color: white; font-weight: 700; cursor: pointer;
            font-family: inherit; font-size: 14px;
            transition: all 0.2s;
            box-shadow: 0 8px 24px -8px rgba(92, 184, 92, 0.5);
        }
        .new-tab-search button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px -8px rgba(92, 184, 92, 0.6);
        }
        .new-tab-search button:active { transform: scale(0.96); }

        /* ============ CHOOSER MODAL ============ */
        .chooser-overlay {
            position: fixed; inset: 0; z-index: 400;
            display: none; align-items: center; justify-content: center;
            background: rgba(5, 12, 5, 0.6);
            backdrop-filter: blur(32px) saturate(140%);
            -webkit-backdrop-filter: blur(32px) saturate(140%);
            animation: fadeIn 0.3s ease;
        }
        .chooser-overlay.open { display: flex; }
        .chooser-card {
            background: rgba(20, 40, 20, 0.4);
            border: 1px solid rgba(140, 220, 140, 0.22);
            border-radius: var(--radius-card); padding: 48px 52px 40px;
            max-width: 680px; width: 92%; text-align: center;
            box-shadow: 0 40px 100px -24px rgba(0, 0, 0, 0.95);
            animation: slideUp 0.35s var(--transition-smooth);
            backdrop-filter: blur(40px) saturate(140%);
            -webkit-backdrop-filter: blur(40px) saturate(140%);
        }
        .chooser-logo { display: flex; justify-content: center; margin-bottom: 22px; }
        .chooser-logo img {
            max-width: 220px; max-height: 110px; object-fit: contain;
            filter: drop-shadow(0 0 32px rgba(92, 184, 92, 0.4));
        }
        .chooser-title {
            font-size: 28px; font-weight: 700; margin-bottom: 10px;
            letter-spacing: -0.5px; color: #fff;
        }
        .chooser-sub {
            color: rgba(200, 235, 200, 0.7); font-size: 14px;
            margin-bottom: 36px; font-weight: 400;
        }
        .chooser-options { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
        .chooser-btn {
            flex: 1; min-width: 220px; padding: 26px 24px 22px;
            border-radius: var(--radius-btn);
            border: 1px solid rgba(140, 220, 140, 0.22);
            background: rgba(30, 60, 30, 0.28);
            color: var(--text); font-weight: 600; font-size: 16px;
            cursor: pointer; transition: all 0.3s var(--transition-smooth);
            display: flex; flex-direction: column; align-items: center;
            gap: 12px; font-family: inherit;
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
        }
        .chooser-btn:hover {
            background: rgba(50, 100, 50, 0.4);
            border-color: rgba(160, 255, 160, 0.6);
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -16px rgba(92, 184, 92, 0.3);
        }
        .chooser-btn:active { transform: scale(0.98); }
        .chooser-btn svg {
            width: 36px; height: 36px; stroke: var(--accent);
            stroke-width: 1.6; fill: none;
        }
        .chooser-btn span {
            font-size: 12px; font-weight: 400;
            color: rgba(200, 235, 200, 0.65); letter-spacing: 0.2px;
        }
        .chooser-close {
            margin-top: 32px; background: none; border: none;
            color: rgba(200, 235, 200, 0.6); font-size: 13px;
            cursor: pointer; font-weight: 500;
            padding: 10px 22px; border-radius: 10px;
            transition: all 0.2s; font-family: inherit;
        }
        .chooser-close:hover { color: #fff; background: rgba(50, 100, 50, 0.35); }

        /* ============ BROWSER OS (ENHANCED) ============ */
        .os-desktop {
            position: fixed; inset: 0; z-index: 300;
            display: none; flex-direction: column;
            background: #0a0f0a;
            background-image: url('/background.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            animation: fadeIn 0.4s ease;
        }
        .os-desktop.open { display: flex; }
        .os-desktop::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(180deg, rgba(0,0,0,0.28) 0%, rgba(0,0,0,0.55) 100%);
            pointer-events: none; z-index: 0;
        }

        /* Desktop icons */
        .os-desktop-icons {
            position: absolute; top: 20px; left: 20px;
            display: grid; grid-template-columns: repeat(auto-fill, 88px);
            grid-auto-rows: 100px; gap: 4px;
            z-index: 5; max-width: calc(100vw - 200px);
            max-height: calc(100vh - 80px);
            align-content: start;
        }
        .os-desktop-icon {
            display: flex; flex-direction: column; align-items: center;
            gap: 6px; padding: 10px 6px; border-radius: 12px;
            cursor: pointer; transition: all 0.2s var(--transition-spring);
            user-select: none; position: relative;
        }
        .os-desktop-icon:hover {
            background: rgba(92, 184, 92, 0.22);
            outline: 1.5px solid rgba(140, 240, 140, 0.5);
            transform: translateY(-2px);
        }
        .os-desktop-icon.dragging {
            opacity: 0.5; transform: scale(0.9);
        }
        .os-desktop-icon.drag-over {
            background: rgba(92, 184, 92, 0.3);
            outline: 2px dashed rgba(140, 240, 140, 0.7);
        }
        .os-desktop-icon svg {
            width: 40px; height: 40px; stroke: #e0f0e0;
            fill: none; stroke-width: 1.4;
            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.8));
            transition: transform 0.3s var(--transition-spring);
        }
        .os-desktop-icon img {
            width: 44px; height: 44px; object-fit: contain;
            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.8));
            transition: transform 0.3s var(--transition-spring);
        }
        .os-desktop-icon:hover svg,
        .os-desktop-icon:hover img { transform: scale(1.15); }
        .os-desktop-icon span {
            font-size: 11px; font-weight: 500; color: #e0f0e0;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
            text-align: center; line-height: 1.25;
            overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap; max-width: 100%;
        }

        /* Windows */
        .os-window {
            position: absolute;
            background: rgba(15, 30, 15, 0.72);
            border: 1px solid rgba(140, 220, 140, 0.22);
            border-radius: 16px;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.85), inset 0 1px rgba(255, 255, 255, 0.06);
            display: flex; flex-direction: column; overflow: hidden;
            min-width: 280px; min-height: 160px; z-index: 10;
            animation: osWindowOpen 0.35s var(--transition-spring);
            backdrop-filter: blur(32px) saturate(140%);
            -webkit-backdrop-filter: blur(32px) saturate(140%);
            transition: box-shadow 0.25s ease;
        }
        .os-window.focused {
            box-shadow: 0 30px 90px rgba(0, 0, 0, 0.9),
                        0 0 0 1px rgba(140, 240, 140, 0.25),
                        inset 0 1px rgba(255, 255, 255, 0.08);
        }
        .os-window.closing {
            animation: osWindowClose 0.22s var(--transition-smooth) forwards;
        }
        .os-window.minimized {
            animation: osWindowClose 0.22s var(--transition-smooth) forwards;
            pointer-events: none;
        }
        .os-window.maximized {
            top: 0 !important; left: 0 !important;
            width: 100% !important;
            height: calc(100% - 48px) !important;
            border-radius: 0;
        }
        .os-window.snapped-left {
            top: 0 !important; left: 0 !important;
            width: 50% !important;
            height: calc(100% - 48px) !important;
            border-radius: 0;
        }
        .os-window.snapped-right {
            top: 0 !important; left: 50% !important;
            width: 50% !important;
            height: calc(100% - 48px) !important;
            border-radius: 0;
        }

        .os-window-titlebar {
            display: flex; align-items: center; height: 40px;
            background: rgba(10, 25, 10, 0.55);
            border-bottom: 1px solid rgba(140, 220, 140, 0.12);
            cursor: default; user-select: none; flex-shrink: 0;
            position: relative;
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        }
        .os-window-title {
            flex: 1; font-size: 12.5px; font-weight: 500;
            color: #c8e0c8; padding: 0 12px;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
            pointer-events: none;
        }
        .os-window-icon {
            display: flex; align-items: center;
            padding-left: 12px; pointer-events: none;
        }
        .os-window-icon svg {
            width: 16px; height: 16px; stroke: #8cbf8c;
            fill: none; stroke-width: 1.8;
        }
        .os-window-icon img {
            width: 18px; height: 18px; object-fit: contain;
        }
        .os-window-controls {
            display: flex; align-items: stretch; height: 100%; margin-left: auto;
        }
        .os-window-control {
            width: 46px; height: 100%; border: none; background: transparent;
            color: #c8e0c8; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: background 0.12s, color 0.12s; padding: 0;
        }
        .os-window-control svg {
            width: 11px; height: 11px; stroke: currentColor;
            fill: none; stroke-width: 1.3;
        }
        .os-window-control.min:hover,
        .os-window-control.max:hover { background: rgba(120, 200, 120, 0.15); }
        .os-window-control.close:hover { background: #b33a2e; color: #fff; }
        .os-window-control.close:hover svg { stroke: #fff; }

        .os-window-content {
            flex: 1; position: relative; overflow: hidden;
            background: rgba(12, 25, 12, 0.4);
        }
        .os-window-content iframe {
            width: 100%; height: 100%; border: none;
            background: #fff; display: block;
        }

        .os-resize-handle { position: absolute; z-index: 20; }
        .os-resize-handle.n { top: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
        .os-resize-handle.s { bottom: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
        .os-resize-handle.e { right: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
        .os-resize-handle.w { left: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
        .os-resize-handle.ne { top: -3px; right: -3px; width: 14px; height: 14px; cursor: nesw-resize; }
        .os-resize-handle.nw { top: -3px; left: -3px; width: 14px; height: 14px; cursor: nwse-resize; }
        .os-resize-handle.se { bottom: -3px; right: -3px; width: 14px; height: 14px; cursor: nwse-resize; }
        .os-resize-handle.sw { bottom: -3px; left: -3px; width: 14px; height: 14px; cursor: nesw-resize; }

        /* Resize guideline (shows when resizing) */
        .os-resize-guide {
            position: fixed; z-index: 9999;
            background: rgba(92, 184, 92, 0.6);
            pointer-events: none; display: none;
            box-shadow: 0 0 8px rgba(92, 184, 92, 0.8);
        }
        .os-resize-guide.show { display: block; }
        .os-resize-guide.h { height: 1px; }
        .os-resize-guide.v { width: 1px; }
        .os-resize-dim {
            position: fixed; z-index: 10000;
            background: rgba(20, 45, 20, 0.9);
            border: 1px solid rgba(140, 240, 140, 0.5);
            color: #e0f0e0; font-size: 11px;
            padding: 3px 8px; border-radius: 6px;
            pointer-events: none; display: none;
            font-family: 'Inter', monospace;
            font-variant-numeric: tabular-nums;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        .os-resize-dim.show { display: block; }

        /* Taskbar */
        .os-taskbar {
            position: absolute; bottom: 0; left: 0; right: 0;
            height: 52px;
            background: rgba(8, 20, 8, 0.55);
            border-top: 1px solid rgba(140, 220, 140, 0.15);
            display: flex; align-items: center; z-index: 500;
            user-select: none;
            backdrop-filter: blur(36px) saturate(150%);
            -webkit-backdrop-filter: blur(36px) saturate(150%);
            box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.4);
        }
        .os-taskbar-center {
            display: flex; align-items: center; gap: 3px;
            position: absolute; left: 50%; transform: translateX(-50%);
            height: 100%; padding: 0 6px;
        }
        .os-taskbar-btn {
            width: 46px; height: 46px; border: none; background: transparent;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; border-radius: 12px;
            transition: all 0.25s var(--transition-spring);
            position: relative; padding: 0;
        }
        .os-taskbar-btn:hover {
            background: rgba(120, 200, 120, 0.18);
            transform: translateY(-3px);
        }
        .os-taskbar-btn:active { transform: translateY(-1px) scale(0.95); }
        .os-taskbar-btn svg {
            width: 24px; height: 24px; stroke: #b8d8b8;
            fill: none; stroke-width: 1.6;
            transition: transform 0.25s var(--transition-spring);
        }
        .os-taskbar-btn img {
            width: 26px; height: 26px; object-fit: contain;
            transition: transform 0.25s var(--transition-spring);
        }
        .os-taskbar-btn:hover svg,
        .os-taskbar-btn:hover img { transform: scale(1.15); }
        .os-taskbar-btn .os-taskbar-tooltip {
            position: absolute; bottom: calc(100% + 12px); left: 50%;
            transform: translateX(-50%);
            background: rgba(20, 45, 20, 0.9);
            border: 1px solid rgba(140, 220, 140, 0.25);
            color: #d0e8d0; font-size: 11px; font-weight: 400;
            padding: 5px 14px; border-radius: 8px; white-space: nowrap;
            opacity: 0; pointer-events: none;
            transition: opacity 0.15s;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .os-taskbar-btn:hover .os-taskbar-tooltip { opacity: 1; }
        .os-taskbar-btn.running::after {
            content: ''; position: absolute; bottom: 4px; left: 50%;
            transform: translateX(-50%); width: 8px; height: 3px;
            background: #5cb85c; border-radius: 2px;
            box-shadow: 0 0 10px rgba(92, 184, 92, 0.8);
        }
        .os-taskbar-btn.active-app {
            background: rgba(120, 200, 120, 0.2);
        }
        .os-taskbar-btn.pinned::before {
            content: ''; position: absolute;
            top: 6px; right: 6px; width: 5px; height: 5px;
            background: rgba(140, 240, 140, 0.7);
            border-radius: 50%;
        }
        .os-taskbar-left {
            display: flex; align-items: center;
            padding: 0 10px; height: 100%; gap: 2px;
        }
        .os-taskbar-right {
            display: flex; align-items: center;
            padding: 0 12px; height: 100%;
            margin-left: auto; gap: 4px;
        }
        .os-tray-btn {
            height: 38px; padding: 0 10px; border: none;
            background: transparent; color: #b8d8b8;
            display: flex; align-items: center; gap: 6px;
            cursor: pointer; border-radius: 8px;
            font-size: 11px; font-weight: 400;
            transition: background 0.12s; font-family: inherit;
        }
        .os-tray-btn:hover { background: rgba(120, 200, 120, 0.12); }
        .os-tray-btn svg {
            width: 16px; height: 16px; stroke: currentColor;
            fill: none; stroke-width: 1.6;
        }
        .os-tray-clock {
            display: flex; flex-direction: column; align-items: flex-end;
            padding: 0 10px; font-size: 11px; color: #b8d8b8;
            line-height: 1.35; font-weight: 400; cursor: default;
        }
        .os-tray-clock .time { font-weight: 500; }
        .os-tray-clock .date { font-size: 10px; color: #8aa88a; }

        /* Start menu */
        .os-start-menu {
            position: absolute; bottom: 62px; left: 50%;
            transform: translateX(-50%) translateY(30px);
            width: 620px; max-width: 92vw; max-height: 660px;
            background: rgba(12, 30, 12, 0.72);
            border: 1px solid rgba(140, 220, 140, 0.22);
            border-radius: 20px;
            box-shadow: 0 24px 80px rgba(0, 0, 0, 0.85);
            padding: 28px 32px 24px;
            z-index: 600; display: none; flex-direction: column;
            opacity: 0; pointer-events: none;
            backdrop-filter: blur(44px) saturate(150%);
            -webkit-backdrop-filter: blur(44px) saturate(150%);
        }
        .os-start-menu.open {
            display: flex;
            animation: startMenuOpen 0.32s var(--transition-spring) forwards;
            opacity: 1; pointer-events: auto;
        }
        .os-start-menu.closing {
            animation: osWindowClose 0.2s var(--transition-smooth) forwards;
        }
        .os-start-search {
            display: flex; align-items: center; gap: 12px;
            background: rgba(15, 35, 15, 0.5);
            border: 1px solid rgba(140, 220, 140, 0.18);
            border-radius: 12px; padding: 11px 16px; margin-bottom: 22px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .os-start-search:focus-within {
            border-color: rgba(160, 255, 160, 0.5);
            box-shadow: 0 0 0 3px rgba(92, 184, 92, 0.15);
        }
        .os-start-search svg {
            width: 16px; height: 16px; stroke: #8aa88a;
            fill: none; stroke-width: 1.8;
        }
        .os-start-search input {
            flex: 1; background: transparent; border: none;
            color: #d0e8d0; font-size: 13px; outline: none;
            font-family: inherit;
        }
        .os-start-search input::placeholder { color: #6a8a6a; }
        .os-start-section-title {
            font-size: 12px; font-weight: 600; color: #8aa88a;
            margin-bottom: 14px; letter-spacing: 0.4px;
            text-transform: uppercase;
            display: flex; justify-content: space-between; align-items: center;
        }
        .os-start-section-title button {
            background: rgba(120, 200, 120, 0.12);
            border: 1px solid rgba(140, 220, 140, 0.2);
            color: #b8d8b8; padding: 4px 10px; border-radius: 8px;
            font-size: 10px; font-weight: 600; cursor: pointer;
            font-family: inherit; letter-spacing: 0.3px;
            transition: all 0.2s;
        }
        .os-start-section-title button:hover {
            background: rgba(120, 200, 120, 0.25);
            color: #fff;
        }
        .os-start-apps {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 6px; overflow-y: auto; padding-right: 4px;
            max-height: 340px;
        }
        .os-start-app {
            display: flex; flex-direction: column; align-items: center;
            gap: 8px; padding: 14px 8px 12px; border-radius: 12px;
            background: transparent; border: none; cursor: pointer;
            transition: all 0.2s var(--transition-spring);
            font-family: inherit; color: #d0e8d0;
            position: relative;
        }
        .os-start-app:hover {
            background: rgba(120, 200, 120, 0.15);
            transform: translateY(-2px);
        }
        .os-start-app:active { transform: translateY(0) scale(0.96); }
        .os-start-app svg {
            width: 30px; height: 30px; stroke: #a8c8a8;
            fill: none; stroke-width: 1.5;
        }
        .os-start-app img {
            width: 32px; height: 32px; object-fit: contain;
        }
        .os-start-app span {
            font-size: 11px; font-weight: 400; color: #a8c8a8;
            overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap; max-width: 100%;
        }
        .os-start-app .remove-app {
            position: absolute; top: 4px; right: 4px;
            width: 16px; height: 16px; border-radius: 50%;
            background: rgba(180, 40, 40, 0.5); color: #fff;
            border: none; font-size: 10px; line-height: 1;
            cursor: pointer; opacity: 0;
            transition: opacity 0.15s;
            display: flex; align-items: center; justify-content: center;
        }
        .os-start-app:hover .remove-app { opacity: 1; }

        /* HUD Editor mode */
        .os-desktop.hud-editing .os-desktop-icon {
            animation: dockPulse 1.8s ease-in-out infinite;
            outline: 1.5px dashed rgba(140, 240, 140, 0.55);
        }
        .os-desktop.hud-editing .os-desktop-icons {
            background: rgba(20, 45, 20, 0.25);
            border-radius: 16px; padding: 8px;
        }

        /* Calculator */
        .os-calc-display {
            background: rgba(10, 25, 10, 0.55);
            border-bottom: 1px solid rgba(140, 220, 140, 0.12);
            padding: 20px 24px; text-align: right;
            font-size: 32px; font-weight: 300; color: #d0e8d0;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }
        .os-calc-grid {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 4px; padding: 10px; flex: 1;
            background: rgba(10, 25, 10, 0.35);
        }
        .os-calc-btn {
            background: rgba(30, 60, 30, 0.4);
            border: 1px solid rgba(140, 220, 140, 0.12);
            border-radius: 12px; color: #d0e8d0;
            font-size: 17px; font-weight: 400; cursor: pointer;
            font-family: inherit;
            transition: all 0.15s var(--transition-spring);
        }
        .os-calc-btn:hover {
            background: rgba(50, 100, 50, 0.55);
            border-color: rgba(140, 220, 140, 0.3);
            transform: scale(1.03);
        }
        .os-calc-btn:active { transform: scale(0.96); }
        .os-calc-btn.op {
            background: rgba(40, 80, 40, 0.4); color: #8cd88c;
        }
        .os-calc-btn.eq {
            background: linear-gradient(180deg, #5cb85c, #3a8e3a);
            color: #fff; border-color: rgba(140, 220, 140, 0.4);
        }
        .os-calc-btn.clr {
            background: rgba(40, 80, 40, 0.4); color: #ff9b9b;
        }

        /* Clock */
        .os-clock-display {
            flex: 1; display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 8px; padding: 28px;
            background: rgba(10, 25, 10, 0.35);
        }
        .os-clock-time {
            font-size: 56px; font-weight: 300;
            letter-spacing: -1.5px; color: #d0e8d0;
            font-variant-numeric: tabular-nums;
            text-shadow: 0 0 40px rgba(92, 184, 92, 0.3);
        }
        .os-clock-date {
            font-size: 15px; color: #8aa88a;
            font-weight: 400; letter-spacing: 0.3px;
        }

        /* Wallpaper gallery */
        .os-wallpaper-gallery {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 10px; padding: 16px; height: 100%;
            overflow-y: auto;
            background: rgba(10, 25, 10, 0.25);
        }
        .os-wallpaper-thumb {
            aspect-ratio: 16/9; border-radius: 12px;
            border: 2px solid transparent;
            background-size: cover; background-position: center;
            cursor: pointer;
            transition: all 0.2s var(--transition-spring);
        }
        .os-wallpaper-thumb:hover {
            border-color: #5cb85c; transform: scale(1.04);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        }
        .os-wallpaper-actions {
            padding: 14px 16px;
            border-top: 1px solid rgba(140, 220, 140, 0.12);
            display: flex; gap: 10px;
            background: rgba(12, 30, 12, 0.4);
        }
        .os-wallpaper-actions button {
            flex: 1; padding: 10px 14px; border-radius: 10px;
            border: 1px solid rgba(140, 220, 140, 0.18);
            background: rgba(30, 60, 30, 0.35);
            color: #d0e8d0; font-weight: 400;
            cursor: pointer; font-size: 12px;
            font-family: inherit;
            transition: all 0.2s;
        }
        .os-wallpaper-actions button:hover {
            background: rgba(50, 100, 50, 0.5);
            transform: translateY(-1px);
        }
        .os-wallpaper-actions button.primary {
            background: linear-gradient(180deg, #5cb85c, #3a8e3a);
            border-color: rgba(140, 220, 140, 0.4);
            color: #fff;
        }

        /* Settings app */
        .os-settings {
            padding: 24px 28px; overflow-y: auto; height: 100%;
            background: rgba(10, 25, 10, 0.35);
            color: #d0e8d0;
        }
        .os-settings h2 {
            font-size: 22px; font-weight: 600; margin-bottom: 6px;
            color: #e0f0e0; letter-spacing: -0.4px;
        }
        .os-settings .settings-sub {
            font-size: 12px; color: #8aa88a; margin-bottom: 24px;
        }
        .os-settings-section {
            margin-bottom: 28px;
            padding-bottom: 24px;
            border-bottom: 1px solid rgba(140, 220, 140, 0.1);
        }
        .os-settings-section:last-child { border-bottom: none; }
        .os-settings-section-title {
            font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 1.4px;
            color: #8aa88a; margin-bottom: 14px;
        }
        .os-settings-row {
            display: flex; align-items: center;
            justify-content: space-between; gap: 12px;
            padding: 10px 0;
        }
        .os-settings-row label {
            font-size: 13px; font-weight: 500; color: #d0e8d0;
            flex: 1;
        }
        .os-settings-row .os-settings-desc {
            font-size: 11px; color: #7a9a7a; margin-top: 2px;
        }
        .os-settings-input {
            background: rgba(15, 35, 15, 0.5);
            border: 1px solid rgba(140, 220, 140, 0.2);
            border-radius: 8px; padding: 8px 12px;
            color: #d0e8d0; font-size: 12px;
            font-family: inherit; outline: none;
            transition: border-color 0.2s;
            min-width: 180px;
        }
        .os-settings-input:focus {
            border-color: rgba(160, 255, 160, 0.55);
            box-shadow: 0 0 0 3px rgba(92, 184, 92, 0.15);
        }
        .os-settings-btn {
            background: rgba(30, 60, 30, 0.5);
            border: 1px solid rgba(140, 220, 140, 0.22);
            color: #d0e8d0; padding: 8px 16px;
            border-radius: 8px; cursor: pointer;
            font-size: 12px; font-weight: 600;
            font-family: inherit;
            transition: all 0.2s;
        }
        .os-settings-btn:hover {
            background: rgba(60, 120, 60, 0.55);
            transform: translateY(-1px);
        }
        .os-settings-btn.primary {
            background: linear-gradient(180deg, #5cb85c, #3a8e3a);
            border-color: rgba(140, 220, 140, 0.4);
            color: #fff;
        }
        .os-settings-btn.danger {
            background: rgba(140, 40, 40, 0.5);
            border-color: rgba(220, 100, 100, 0.4);
            color: #ffb8b8;
        }
        .os-settings-btn.danger:hover {
            background: rgba(180, 50, 50, 0.6);
        }
        .os-app-list {
            display: flex; flex-direction: column; gap: 6px;
            margin-top: 8px;
        }
        .os-app-row {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 12px;
            background: rgba(15, 35, 15, 0.4);
            border: 1px solid rgba(140, 220, 140, 0.12);
            border-radius: 10px;
            transition: all 0.15s;
        }
        .os-app-row:hover {
            background: rgba(30, 60, 30, 0.5);
            border-color: rgba(140, 220, 140, 0.25);
        }
        .os-app-row img, .os-app-row svg {
            width: 24px; height: 24px; flex-shrink: 0;
            stroke: #b8d8b8; fill: none; stroke-width: 1.6;
        }
        .os-app-row .app-name {
            flex: 1; font-size: 13px; color: #d0e8d0;
            overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap;
        }
        .os-app-row .app-url {
            font-size: 10px; color: #7a9a7a;
            overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap; max-width: 180px;
        }
        .os-app-row .app-remove {
            background: rgba(140, 40, 40, 0.4);
            border: 1px solid rgba(220, 100, 100, 0.3);
            color: #ffb8b8; width: 26px; height: 26px;
            border-radius: 6px; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; line-height: 1;
            transition: all 0.15s;
        }
        .os-app-row .app-remove:hover {
            background: rgba(200, 50, 50, 0.6);
            color: #fff;
        }
        .add-app-form {
            display: grid; grid-template-columns: 1fr 2fr auto;
            gap: 8px; margin-top: 10px;
        }
        .add-app-form .os-settings-input { min-width: 0; }

        /* OS browser tabs */
        .os-browser-tabs {
            display: flex; align-items: center; gap: 3px;
            padding: 6px 8px 0;
            background: rgba(10, 25, 10, 0.55);
            border-bottom: 1px solid rgba(140, 220, 140, 0.12);
            overflow-x: auto; flex-shrink: 0;
            scrollbar-width: none;
        }
        .os-browser-tabs::-webkit-scrollbar { display: none; }
        .os-browser-tab {
            display: flex; align-items: center; gap: 6px;
            padding: 6px 10px 6px 10px;
            border-radius: 8px 8px 0 0;
            background: transparent; border: none;
            color: #8aa88a; cursor: pointer;
            font-size: 11.5px; white-space: nowrap;
            max-width: 180px; min-width: 80px;
            font-family: inherit;
            transition: all 0.18s;
            flex-shrink: 0;
        }
        .os-browser-tab:hover {
            background: rgba(40, 80, 40, 0.3); color: #d0e8d0;
        }
        .os-browser-tab.active {
            background: rgba(40, 90, 40, 0.45); color: #e0f0e0;
            box-shadow: inset 0 2px 0 0 #5cb85c;
            font-weight: 600;
        }
        .os-browser-tab .tab-fav {
            width: 12px; height: 12px; border-radius: 3px;
            flex-shrink: 0; object-fit: contain;
        }
        .os-browser-tab .tab-label {
            overflow: hidden; text-overflow: ellipsis;
            flex: 1; min-width: 0;
        }
        .os-browser-tab .tab-close-x {
            width: 14px; height: 14px; border-radius: 50%;
            border: none; background: transparent;
            color: #8aa88a; cursor: pointer;
            font-size: 10px; line-height: 1;
            display: flex; align-items: center; justify-content: center;
            opacity: 0; transition: opacity 0.12s, background 0.12s;
        }
        .os-browser-tab:hover .tab-close-x,
        .os-browser-tab.active .tab-close-x { opacity: 1; }
        .os-browser-tab .tab-close-x:hover {
            background: rgba(200, 50, 50, 0.4); color: #fff;
        }
        .os-browser-newtab {
            width: 24px; height: 24px; border-radius: 6px;
            border: 1px dashed rgba(140, 220, 140, 0.3);
            background: transparent; color: #8aa88a;
            cursor: pointer; font-size: 14px;
            display: flex; align-items: center; justify-content: center;
            margin-left: 4px; margin-bottom: 2px;
            transition: all 0.2s; flex-shrink: 0;
        }
        .os-browser-newtab:hover {
            border-color: #5cb85c; color: #d0e8d0;
            background: rgba(40, 80, 40, 0.4);
        }

        /* OS browser history panel */
        .os-history-panel {
            position: absolute; top: 0; right: 0; bottom: 0;
            width: 340px;
            background: rgba(12, 30, 12, 0.85);
            border-left: 1px solid rgba(140, 220, 140, 0.2);
            backdrop-filter: blur(40px) saturate(150%);
            -webkit-backdrop-filter: blur(40px) saturate(150%);
            z-index: 50; transform: translateX(100%);
            transition: transform 0.3s var(--transition-smooth);
            display: flex; flex-direction: column;
            box-shadow: -8px 0 32px rgba(0, 0, 0, 0.5);
        }
        .os-history-panel.open { transform: translateX(0); }
        .os-history-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 18px;
            border-bottom: 1px solid rgba(140, 220, 140, 0.15);
        }
        .os-history-header h3 {
            font-size: 14px; font-weight: 600; color: #e0f0e0;
            letter-spacing: -0.2px;
        }
        .os-history-header button {
            width: 28px; height: 28px; border-radius: 8px;
            border: none; background: rgba(120, 200, 120, 0.12);
            color: #d0e8d0; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.15s;
        }
        .os-history-header button:hover {
            background: rgba(120, 200, 120, 0.25);
        }
        .os-history-list {
            flex: 1; overflow-y: auto; padding: 8px;
        }
        .os-history-item {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 12px; border-radius: 10px;
            cursor: pointer; transition: background 0.12s;
            margin-bottom: 2px;
        }
        .os-history-item:hover {
            background: rgba(120, 200, 120, 0.12);
        }
        .os-history-item img {
            width: 18px; height: 18px; border-radius: 4px;
            object-fit: contain; flex-shrink: 0;
            background: rgba(255, 255, 255, 0.05);
        }
        .os-history-item .hist-info {
            flex: 1; min-width: 0;
        }
        .os-history-item .hist-title {
            font-size: 12.5px; color: #d0e8d0; font-weight: 500;
            overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap;
        }
        .os-history-item .hist-url {
            font-size: 10.5px; color: #7a9a7a;
            overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap; margin-top: 2px;
        }
        .os-history-empty {
            text-align: center; color: #7a9a7a;
            font-size: 12px; padding: 40px 20px;
        }
        .os-history-footer {
            padding: 12px 16px;
            border-top: 1px solid rgba(140, 220, 140, 0.15);
        }
        .os-history-footer button {
            width: 100%; padding: 10px;
            background: rgba(140, 40, 40, 0.4);
            border: 1px solid rgba(220, 100, 100, 0.3);
            color: #ffb8b8; border-radius: 10px;
            cursor: pointer; font-size: 12px; font-weight: 600;
            font-family: inherit;
            transition: all 0.15s;
        }
        .os-history-footer button:hover {
            background: rgba(200, 50, 50, 0.5); color: #fff;
        }

        /* OS browser main */
        .os-browser-inner {
            display: flex; flex-direction: column;
            height: 100%; background: rgba(10, 20, 10, 0.5);
            position: relative;
        }
        .os-browser-bar {
            display: flex; align-items: center; gap: 4px;
            padding: 8px 10px;
            background: rgba(10, 25, 10, 0.55);
            border-bottom: 1px solid rgba(140, 220, 140, 0.12);
            flex-shrink: 0;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .os-browser-bar button {
            width: 34px; height: 34px; border-radius: 10px;
            border: none; background: transparent;
            color: #b8d8b8; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.18s var(--transition-spring);
            flex-shrink: 0;
        }
        .os-browser-bar button:hover:not(:disabled) {
            background: rgba(120, 200, 120, 0.18);
            transform: scale(1.06);
        }
        .os-browser-bar button:active:not(:disabled) { transform: scale(0.94); }
        .os-browser-bar button:disabled {
            opacity: 0.25; cursor: not-allowed;
        }
        .os-browser-bar svg {
            width: 16px; height: 16px; stroke: currentColor;
            fill: none; stroke-width: 1.8;
            stroke-linecap: round; stroke-linejoin: round;
        }
        .os-browser-url {
            flex: 1; display: flex; align-items: center; gap: 8px;
            background: rgba(15, 35, 15, 0.5);
            border: 1px solid rgba(140, 220, 140, 0.18);
            border-radius: 12px; padding: 0 12px 0 8px;
            height: 34px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .os-browser-url:focus-within {
            border-color: rgba(160, 255, 160, 0.55);
            box-shadow: 0 0 0 3px rgba(92, 184, 92, 0.15);
        }
        .os-browser-url .url-favicon {
            width: 18px; height: 18px; border-radius: 5px;
            object-fit: contain; flex-shrink: 0;
            background: rgba(255, 255, 255, 0.05);
        }
        .os-browser-url input {
            flex: 1; background: transparent; border: none;
            color: #d0e8d0; font-size: 12.5px; outline: none;
            font-family: inherit;
        }
        .os-browser-url input::placeholder { color: #6a8a6a; }
        .os-browser-content {
            flex: 1; position: relative;
        }
        .os-browser-iframe {
            position: absolute; inset: 0;
            border: none; background: #fff; width: 100%;
        }

        /* Lock screen */
        .os-lock-screen {
            position: fixed; inset: 0; z-index: 10000;
            display: none;
            flex-direction: column;
            background: rgba(5, 12, 5, 0.35);
            backdrop-filter: blur(44px) saturate(140%);
            -webkit-backdrop-filter: blur(44px) saturate(140%);
            color: #e0f0e0;
            animation: lockFade 0.4s ease;
        }
        .os-lock-screen.open { display: flex; }
        .os-lock-screen.sliding {
            transition: transform 0.4s var(--transition-smooth),
                        opacity 0.4s ease;
        }
        .os-lock-top {
            flex: 1; display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 10px;
            animation: lockClockIn 0.5s var(--transition-spring) 0.1s both;
        }
        .os-lock-time {
            font-size: 96px; font-weight: 200;
            letter-spacing: -4px; color: #f0f8f0;
            text-shadow: 0 0 60px rgba(92, 184, 92, 0.4);
            font-variant-numeric: tabular-nums;
            line-height: 1;
        }
        .os-lock-date {
            font-size: 18px; color: rgba(200, 235, 200, 0.7);
            font-weight: 400; letter-spacing: 0.5px;
        }
        .os-lock-hint {
            margin-top: 24px;
            font-size: 12px; color: rgba(200, 235, 200, 0.5);
            letter-spacing: 1.5px; text-transform: uppercase;
            font-weight: 600;
            animation: dockPulse 2.4s ease-in-out infinite;
        }
        .os-lock-arrow {
            margin-top: 10px;
            width: 26px; height: 26px;
            stroke: rgba(140, 240, 140, 0.8);
            fill: none; stroke-width: 2;
            stroke-linecap: round; stroke-linejoin: round;
            animation: dockPulse 2.4s ease-in-out infinite;
        }
        .os-lock-bottom {
            padding: 20px; text-align: center;
            font-size: 11px; color: rgba(200, 235, 200, 0.4);
        }

        /* Snap preview */
        .os-snap-preview {
            position: absolute;
            background: rgba(92, 184, 92, 0.15);
            border: 2px solid rgba(92, 184, 92, 0.5);
            pointer-events: none; z-index: 400;
            display: none; transition: all 0.18s var(--transition-smooth);
            border-radius: 14px;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
        }
        .os-snap-preview.show { display: block; }

        /* Panic overlay */
        .panic-flash {
            position: fixed; inset: 0; z-index: 99999;
            background: #fff; pointer-events: none;
            opacity: 0; animation: panicFlash 0.4s ease;
        }
        @keyframes panicFlash {
            0% { opacity: 0; }
            20% { opacity: 1; }
            100% { opacity: 0; }
        }

        .os-wallpaper-input { display: none; }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 720px) {
            .side-dock { width: 68px; padding: 16px 8px; gap: 6px; }
            .side-dock .dock-item { height: 46px; padding: 0; justify-content: center; gap: 0; }
            .side-dock .dock-item .label { display: none; }
            .side-dock .dock-item svg { width: 21px; height: 21px; }
            .main-content { margin-right: 68px; padding: 0 16px; }
            .side-dock.collapsed ~ .main-content { margin-right: 60px; }
            .farius-logo { max-width: min(320px, 80vw); max-height: 160px; }
            .logo-image-wrap { min-height: 100px; margin-bottom: 16px; }
            .search-container { max-width: 100%; }
            .app-button { width: 48px; height: 48px; }
            .app-button img { width: 24px; height: 24px; }
            .tab { max-width: 150px; min-width: 80px; }
            .browser-toolbar { padding: 10px; gap: 4px; }
            .browser-toolbar button { width: 32px; height: 32px; }
            .browser-address { height: 34px; padding: 0 12px; }
            .chooser-card { padding: 32px 24px 28px; }
            .chooser-title { font-size: 22px; }
            .chooser-options { flex-direction: column; }
            .chooser-btn { min-width: auto; }
            .os-start-apps { grid-template-columns: repeat(3, 1fr); }
            .os-start-menu { width: 92vw; padding: 20px; }
            .os-clock-time { font-size: 64px; }
            .os-taskbar-center { gap: 1px; }
            .os-taskbar-btn { width: 42px; height: 42px; }
            .os-tray-clock { display: none; }
            .os-desktop-icons { grid-template-columns: repeat(auto-fill, 80px); }
            .os-desktop-icon svg,
            .os-desktop-icon img { width: 34px; height: 34px; }
            .os-lock-time { font-size: 64px; letter-spacing: -2px; }
            .os-lock-date { font-size: 14px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <div class="main-content" id="main-content">
        <div class="logo-image-wrap"><img class="farius-logo" src="/logo.gif" alt="Farium"></div>
        <div class="tagline">Browse Freely</div>
        <div class="search-container">
            <input type="text" class="search-input" id="search-input" placeholder="Search or enter a URL..." autocomplete="off">
            <button class="search-button" id="search-go">Go</button>
        </div>
        <div class="app-buttons" id="app-buttons">
            <div class="app-button" data-url="https://discord.com">
                <img src="/assets/svg/discord.svg" alt="Discord">
            </div>
            <div class="app-button" data-url="https://youtube.com">
                <img src="/assets/svg/youtube.svg" alt="YouTube">
            </div>
            <div class="app-button" data-url="https://spotify.com">
                <img src="/assets/svg/spotify.svg" alt="Spotify">
            </div>
        </div>
    </div>

    <nav class="side-dock" id="sideDock" aria-label="Site navigation">
        <div class="dock-header">
            <span>Menu</span>
            <button class="dock-collapse-btn" id="dockCollapseBtn" title="Collapse/Expand">◀</button>
        </div>
        <div class="dock-items" id="dockItems">
            <a href="/" class="dock-item active" data-dock-id="home" title="Home">
                <span class="label">Home</span>
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
            </a>
            <a href="/settings" class="dock-item" data-dock-id="settings" title="Settings">
                <span class="label">Settings</span>
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
            </a>
            <div class="dock-sep"></div>
            <a href="/gnmath.html" class="dock-item games-btn" id="gamesBtn" data-dock-id="games" title="Play Games">
                <span class="label">Games</span>
                <svg viewBox="0 0 24 24">
                    <rect x="2" y="6" width="20" height="12" rx="3"/>
                    <path d="M6 12h4M8 10v4M15 11h.01M17.5 13h.01"/>
                </svg>
            </a>
        </div>
    </nav>

    <!-- ============ SIMPLE BROWSER OVERLAY ============ -->
    <div class="browser-overlay" id="browser-overlay">
        <div class="tabs-bar" id="tabs-bar">
            <button class="new-tab-btn" id="new-tab-btn" title="New Tab">+</button>
        </div>

        <div class="browser-toolbar">
            <button id="browser-back" title="Back">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button id="browser-forward" title="Forward">
                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <button id="browser-refresh" title="Refresh">
                <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
            </button>
            <button id="browser-home" title="Home">
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
            </button>
            <div class="browser-address">
                <svg class="lock-icon" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <input type="text" id="browser-url-input" placeholder="Search or enter URL..." autocomplete="off">
                <div class="browser-loader" id="browser-loader"></div>
            </div>
            <button id="browser-fullscreen" title="Toggle Fullscreen">
                <svg viewBox="0 0 24 24">
                    <path d="M4 9V5a1 1 0 0 1 1-1h4M20 9V5a1 1 0 0 0-1-1h-4M4 15v4a1 1 0 0 0 1 1h4M20 15v4a1 1 0 0 1-1 1h-4"/>
                </svg>
            </button>
            <button id="browser-close" title="Close">
                <svg viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
            </button>
        </div>

        <div class="browser-frame-wrap">
            <iframe id="browser-frame" src="" referrerpolicy="no-referrer" allowfullscreen></iframe>
            <div class="new-tab-page" id="new-tab-page">
                <div class="new-tab-logo"><img src="/logo.gif" alt="Farium"></div>
                <div class="new-tab-sub">Browse Freely</div>
                <div class="new-tab-search">
                    <input type="text" id="new-tab-search-input" placeholder="Search or enter URL..." autocomplete="off">
                    <button id="new-tab-search-btn">Go</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ CHOOSER OVERLAY ============ -->
    <div class="chooser-overlay" id="chooser-overlay">
        <div class="chooser-card">
            <div class="chooser-logo">
                <img src="/assets/BrowserLogo.png" alt="Farium" onerror="this.src='/logo.gif'">
            </div>
            <div class="chooser-title">What will you choose?</div>
            <div class="chooser-sub">Pick the classic proxy browser or the full Browser OS desktop</div>
            <div class="chooser-options">
                <button class="chooser-btn" id="choose-simple">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                    Simple Browser
                    <span>Classic proxy browser with tabs</span>
                </button>
                <button class="chooser-btn" id="choose-os">
                    <svg viewBox="0 0 24 24">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <line x1="8" y1="21" x2="16" y2="21"/>
                        <line x1="12" y1="17" x2="12" y2="21"/>
                    </svg>
                    Browser OS
                    <span>Full Windows-style desktop</span>
                </button>
            </div>
            <button class="chooser-close" id="chooser-close">Cancel</button>
        </div>
    </div>

    <!-- ============ BROWSER OS ============ -->
    <div class="os-desktop" id="os-desktop">
        <div class="os-snap-preview" id="os-snap-preview"></div>

        <!-- Resize guide lines -->
        <div class="os-resize-guide h" id="os-resize-guide-h"></div>
        <div class="os-resize-guide v" id="os-resize-guide-v"></div>
        <div class="os-resize-dim" id="os-resize-dim"></div>

        <div class="os-desktop-icons" id="os-desktop-icons"></div>

        <div id="os-windows-container"></div>

        <div class="os-start-menu" id="os-start-menu">
            <div class="os-start-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" id="os-start-search-input" placeholder="Type here to search">
            </div>
            <div class="os-start-section-title">
                <span>Pinned</span>
                <button id="os-edit-hud-btn">Edit HUD</button>
            </div>
            <div class="os-start-apps" id="os-start-apps"></div>
        </div>

        <div class="os-taskbar">
            <div class="os-taskbar-left">
                <button class="os-taskbar-btn" data-os-app="start" title="Start">
                    <svg viewBox="0 0 24 24" style="stroke:none;fill:#b8d8b8;">
                        <rect x="3" y="3" width="8" height="8" rx="2" fill="#b8d8b8" stroke="none"/>
                        <rect x="13" y="3" width="8" height="8" rx="2" fill="#b8d8b8" stroke="none"/>
                        <rect x="3" y="13" width="8" height="8" rx="2" fill="#b8d8b8" stroke="none"/>
                        <rect x="13" y="13" width="8" height="8" rx="2" fill="#b8d8b8" stroke="none"/>
                    </svg>
                    <span class="os-taskbar-tooltip">Start</span>
                </button>
                <button class="os-taskbar-btn" data-os-app="browser" title="Browser">
                    <img src="/assets/apps/bing.png" alt="Browser" onerror="this.replaceWith(makeSvgFallback('browser'))">
                    <span class="os-taskbar-tooltip">Browser</span>
                </button>
            </div>

            <div class="os-taskbar-center" id="os-taskbar-center"></div>

            <div class="os-taskbar-right">
                <button class="os-tray-btn" title="Network">
                    <svg viewBox="0 0 24 24"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                </button>
                <button class="os-tray-btn" title="Volume">
                    <svg viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                </button>
                <button class="os-tray-btn" id="os-power-btn" title="Lock screen">
                    <svg viewBox="0 0 24 24"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
                </button>
                <div class="os-tray-clock" id="os-tray-clock">
                    <span class="time" id="os-tray-time">--:--</span>
                    <span class="date" id="os-tray-date">--/--/----</span>
                </div>
            </div>
        </div>

        <input type="file" class="os-wallpaper-input" id="os-wallpaper-input" accept="image/*">
    </div>

    <!-- ============ LOCK SCREEN ============ -->
    <div class="os-lock-screen" id="os-lock-screen">
        <div class="os-lock-top">
            <div class="os-lock-time" id="os-lock-time">--:--</div>
            <div class="os-lock-date" id="os-lock-date">Loading...</div>
            <div class="os-lock-hint">Slide up to unlock</div>
            <svg class="os-lock-arrow" viewBox="0 0 24 24"><polyline points="6 15 12 9 18 15"/></svg>
        </div>
        <div class="os-lock-bottom">Press any key or slide up</div>
    </div>

    <a href="#" class="venusFooter" style="position: fixed; bottom: 16px; left: 24px; color: var(--text-dim); font-size: 10px; text-decoration: none; z-index: 10; transition: color 0.2s;">Venus integration</a>

    <div class="page-slide" id="pageSlide" style="position: fixed; inset: 0; z-index: 30000; background: #0a0f0a; transform: translateX(100%); transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1); pointer-events: none; display: flex; align-items: center; justify-content: center; will-change: transform;"></div>

    <script>
        /* =========================================================
           CORE SIMPLE BROWSER (unchanged logic)
           ========================================================= */
        let tabs = [];
        let activeTabId = null;

        class Tab {
            constructor(id, url, title) {
                this.id = id;
                this.url = url || null;
                this.title = title || 'New Tab';
                this.history = [];
                this.historyIndex = -1;
                this.favicon = null;
            }
            pushHistory(url) {
                if (this.historyIndex < this.history.length - 1) {
                    this.history = this.history.slice(0, this.historyIndex + 1);
                }
                this.history.push(url);
                this.historyIndex = this.history.length - 1;
            }
            canGoBack() { return this.historyIndex > 0; }
            canGoForward() { return this.historyIndex < this.history.length - 1; }
        }

        function createTabId() {
            return 't' + Date.now() + Math.random().toString(36).substr(2, 4);
        }

        function normalizeUrl(query) {
            query = String(query).trim();
            if (!query) return null;
            if (/^https?:\/\//i.test(query)) return query;
            if (query.includes('.') && !query.includes(' ')) return 'https://' + query;
            const engine = localStorage.getItem('search') || 'https://www.google.com/search?q=';
            return engine + encodeURIComponent(query);
        }

        function getProxyUrl(url) {
            return __uv$config.prefix + __uv$config.encodeUrl(url);
        }

        function getHostname(url) {
            try { return new URL(url).hostname.replace('www.', ''); } catch(e) { return url.substring(0, 20); }
        }

        function getFaviconUrl(url) {
            try {
                const u = new URL(url);
                return `https://www.google.com/s2/favicons?domain=${u.hostname}&sz=32`;
            } catch(e) { return null; }
        }

        function addTab(url, title) {
            const id = createTabId();
            const tab = new Tab(id, url, title || (url ? getHostname(url) : 'New Tab'));
            if (url) tab.favicon = getFaviconUrl(url);
            tabs.push(tab);
            renderTabs();
            switchTab(id);
            if (url) navigateInTab(id, url);
            return tab;
        }

        function closeTab(id) {
            if (tabs.length <= 1) { tabs = []; addTab(null); return; }
            const idx = tabs.findIndex(t => t.id === id);
            if (idx === -1) return;
            tabs.splice(idx, 1);
            if (activeTabId === id) {
                const ni = Math.min(idx, tabs.length - 1);
                activeTabId = tabs[ni].id;
                updateActiveTab();
            }
            renderTabs();
        }

        function switchTab(id) {
            activeTabId = id;
            updateActiveTab();
            renderTabs();
        }

        function updateActiveTab() {
            const tab = tabs.find(t => t.id === activeTabId);
            if (!tab) return;
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');
            if (tab.url) {
                frame.classList.add('visible');
                newTabPage.classList.add('hidden');
                urlInput.value = tab.url;
            } else {
                frame.classList.remove('visible');
                newTabPage.classList.remove('hidden');
                urlInput.value = '';
            }
            document.getElementById('browser-back').disabled = !tab.canGoBack();
            document.getElementById('browser-forward').disabled = !tab.canGoForward();
        }

        function navigateInTab(id, url) {
            const tab = tabs.find(t => t.id === id);
            if (!tab) return;
            tab.pushHistory(url);
            tab.url = url;
            tab.title = getHostname(url);
            tab.favicon = getFaviconUrl(url);
            renderTabs();
            if (activeTabId === id) loadUrl(url);
        }

        function loadUrl(url) {
            const frame = document.getElementById('browser-frame');
            const newTabPage = document.getElementById('new-tab-page');
            const urlInput = document.getElementById('browser-url-input');
            const loader = document.getElementById('browser-loader');
            frame.classList.add('visible');
            newTabPage.classList.add('hidden');
            urlInput.value = url;
            loader.classList.add('visible');
            frame.src = getProxyUrl(url);
        }

        document.addEventListener('DOMContentLoaded', () => {
            const frame = document.getElementById('browser-frame');
            if (frame) {
                frame.addEventListener('load', () => {
                    const loader = document.getElementById('browser-loader');
                    if (loader) loader.classList.remove('visible');
                });
            }
        });

        function renderTabs() {
            const tabsBar = document.getElementById('tabs-bar');
            tabsBar.querySelectorAll('.tab').forEach(el => el.remove());
            const frag = document.createDocumentFragment();
            tabs.forEach(tab => {
                const el = document.createElement('div');
                el.className = 'tab' + (tab.id === activeTabId ? ' active' : '');
                if (tab.favicon) {
                    const img = document.createElement('img');
                    img.className = 'tab-favicon';
                    img.src = tab.favicon;
                    img.alt = '';
                    img.onerror = () => { img.replaceWith(makeFaviconPlaceholder(tab.title)); };
                    el.appendChild(img);
                } else {
                    el.appendChild(makeFaviconPlaceholder(tab.title));
                }
                const titleEl = document.createElement('span');
                titleEl.className = 'tab-title';
                titleEl.textContent = tab.title || 'New Tab';
                el.appendChild(titleEl);
                if (tabs.length > 1) {
                    const cb = document.createElement('button');
                    cb.className = 'tab-close';
                    cb.textContent = '×';
                    cb.addEventListener('click', (e) => { e.stopPropagation(); closeTab(tab.id); });
                    el.appendChild(cb);
                }
                el.addEventListener('click', () => switchTab(tab.id));
                frag.appendChild(el);
            });
            tabsBar.insertBefore(frag, document.getElementById('new-tab-btn'));
        }

        function makeFaviconPlaceholder(title) {
            const d = document.createElement('div');
            d.className = 'tab-favicon-placeholder';
            d.textContent = (title || 'N')[0].toUpperCase();
            return d;
        }

        function openBrowser(url) {
            document.getElementById('browser-overlay').classList.add('open');
            addTab(url);
        }

        function closeBrowser() {
            document.getElementById('browser-overlay').classList.remove('open');
            tabs = [];
            activeTabId = null;
        }

        async function initProxy() {
            if ('serviceWorker' in navigator) {
                try {
                    await navigator.serviceWorker.register('/sw.js');
                    await navigator.serviceWorker.ready;
                } catch (err) {}
            }
            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {}
        }

        (function initFullscreenToggle() {
            const btn = document.getElementById('browser-fullscreen');
            if (!btn) return;
            const target = document.getElementById('browser-overlay');
            btn.addEventListener('click', async () => {
                try {
                    if (!document.fullscreenElement) {
                        if (target.requestFullscreen) await target.requestFullscreen();
                        else if (target.webkitRequestFullscreen) target.webkitRequestFullscreen();
                    } else {
                        if (document.exitFullscreen) await document.exitFullscreen();
                        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                    }
                } catch (e) {}
            });
            function updateIcon() {
                const isFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
                btn.innerHTML = isFs
                    ? `<svg viewBox="0 0 24 24"><path d="M9 4v4a1 1 0 0 1-1 1H4M15 4v4a1 1 0 0 0 1 1h4M9 20v-4a1 1 0 0 0-1-1H4M15 20v-4a1 1 0 0 1 1-1h4"/></svg>`
                    : `<svg viewBox="0 0 24 24"><path d="M4 9V5a1 1 0 0 1 1-1h4M20 9V5a1 1 0 0 0-1-1h-4M4 15v4a1 1 0 0 0 1 1h4M20 15v4a1 1 0 0 1-1 1h-4"/></svg>`;
                btn.title = isFs ? "Exit Fullscreen" : "Toggle Fullscreen";
            }
            document.addEventListener('fullscreenchange', updateIcon);
            document.addEventListener('webkitfullscreenchange', updateIcon);
        })();

        /* =========================================================
           MAIN PAGE INIT
           ========================================================= */
        document.addEventListener('DOMContentLoaded', () => {
            (function () {
                const slide = document.getElementById("pageSlide");
                if (sessionStorage.getItem("slideFrom")) {
                    sessionStorage.removeItem("slideFrom");
                    slide.classList.add("enter");
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => { slide.classList.add("leaving"); });
                    });
                    setTimeout(() => { slide.classList.remove("enter", "leaving"); }, 600);
                }
            })();

            (function initDock() {
                const dock = document.getElementById('sideDock');
                const collapseBtn = document.getElementById('dockCollapseBtn');
                let collapsed = localStorage.getItem('dockCollapsed') === 'true';
                if (collapsed) dock.classList.add('collapsed');
                collapseBtn.addEventListener('click', () => {
                    collapsed = !collapsed;
                    dock.classList.toggle('collapsed', collapsed);
                    localStorage.setItem('dockCollapsed', collapsed);
                    collapseBtn.textContent = collapsed ? '▶' : '◀';
                });
                if (collapsed) collapseBtn.textContent = '▶';
            })();

            const gamesBtn = document.getElementById("gamesBtn");
            if (gamesBtn) {
                gamesBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    const slide = document.getElementById("pageSlide");
                    slide.classList.add("active");
                    sessionStorage.setItem("slideFrom", "true");
                    setTimeout(() => { window.location.href = "/gnmath.html"; }, 500);
                });
            }

            initProxy();

            document.getElementById('search-go').addEventListener('click', () => {
                const raw = document.getElementById('search-input').value.trim();
                if (!raw) return;
                document.getElementById('chooser-overlay').classList.add('open');
                document.getElementById('chooser-overlay').dataset.pendingUrl = raw;
            });
            document.getElementById('search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    const raw = e.target.value.trim();
                    if (!raw) return;
                    document.getElementById('chooser-overlay').classList.add('open');
                    document.getElementById('chooser-overlay').dataset.pendingUrl = raw;
                }
            });

            document.getElementById('chooser-close').addEventListener('click', () => {
                document.getElementById('chooser-overlay').classList.remove('open');
            });
            document.getElementById('chooser-overlay').addEventListener('click', (e) => {
                if (e.target === e.currentTarget) {
                    document.getElementById('chooser-overlay').classList.remove('open');
                }
            });

            document.getElementById('choose-simple').addEventListener('click', () => {
                const pending = document.getElementById('chooser-overlay').dataset.pendingUrl;
                document.getElementById('chooser-overlay').classList.remove('open');
                if (pending) {
                    const url = normalizeUrl(pending);
                    if (url) openBrowser(url);
                }
            });

            document.getElementById('choose-os').addEventListener('click', () => {
                document.getElementById('chooser-overlay').classList.remove('open');
                openBrowserOS();
            });

            document.querySelectorAll('#app-buttons .app-button[data-url]').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('chooser-overlay').classList.add('open');
                    document.getElementById('chooser-overlay').dataset.pendingUrl = btn.dataset.url;
                });
            });

            document.getElementById('browser-close').addEventListener('click', closeBrowser);
            document.getElementById('browser-home').addEventListener('click', closeBrowser);
            document.getElementById('browser-back').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoBack()) {
                    tab.historyIndex--;
                    tab.url = tab.history[tab.historyIndex];
                    tab.title = getHostname(tab.url);
                    tab.favicon = getFaviconUrl(tab.url);
                    renderTabs();
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-forward').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.canGoForward()) {
                    tab.historyIndex++;
                    tab.url = tab.history[tab.historyIndex];
                    tab.title = getHostname(tab.url);
                    tab.favicon = getFaviconUrl(tab.url);
                    renderTabs();
                    loadUrl(tab.url);
                }
            });
            document.getElementById('browser-refresh').addEventListener('click', () => {
                const tab = tabs.find(t => t.id === activeTabId);
                if (tab && tab.url) loadUrl(tab.url);
            });

            document.getElementById('browser-url-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    const url = normalizeUrl(e.target.value);
                    if (url) {
                        const tab = tabs.find(t => t.id === activeTabId);
                        if (tab) navigateInTab(activeTabId, url);
                    }
                }
            });

            document.getElementById('new-tab-btn').addEventListener('click', () => addTab(null));
            document.getElementById('new-tab-search-btn').addEventListener('click', () => {
                const input = document.getElementById('new-tab-search-input');
                const url = normalizeUrl(input.value);
                if (url) {
                    const tab = tabs.find(t => t.id === activeTabId);
                    if (tab) navigateInTab(activeTabId, url);
                    input.value = '';
                }
            });
            document.getElementById('new-tab-search-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('new-tab-search-btn').click();
            });

            initBrowserOS();
        });

        /* =========================================================
           BROWSER OS — ENHANCED
           ========================================================= */
        let osWindows = [];
        let osWindowZ = 100;
        let osMinimized = [];
        let osSnapPreviewTimer = null;

        /* === Built-in apps === */
        const BUILTIN_APPS = {
            browser:    { name: 'Browser',    icon: '/assets/apps/bing.png',        useSvg: false },
            calculator: { name: 'Calculator', icon: '/assets/apps/calculator.png',  useSvg: false },
            clock:      { name: 'Clock',      icon: null,                            useSvg: true,  svg: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' },
            wallpaper:  { name: 'Wallpaper',  icon: null,                            useSvg: true,  svg: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>' },
            settings:   { name: 'Settings',   icon: '/assets/apps/settings.png',    useSvg: false },
            files:      { name: 'Files',      icon: null,                            useSvg: true,  svg: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>' },
            terminal:   { name: 'Terminal',   icon: null,                            useSvg: true,  svg: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>' },
            notes:      { name: 'Notes',      icon: null,                            useSvg: true,  svg: '<path d="M4 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/>' }
        };

        /* === OS state === */
        let osState = {
            desktopIcons: [],   // [{ id, type: 'builtin'|'custom', appKey?, name, icon?, url? }]
            pinned: [],         // app keys on start menu
            customApps: [],     // [{ id, name, url, icon }]
            history: [],        // [{ url, title, favicon, time }]
            panicKey: 'Escape',
            panicUrl: 'https://www.google.com',
            hudEditing: false
        };

        function loadOSState() {
            try {
                const saved = JSON.parse(localStorage.getItem('osState') || '{}');
                if (saved.desktopIcons) osState.desktopIcons = saved.desktopIcons;
                if (saved.pinned) osState.pinned = saved.pinned;
                if (saved.customApps) osState.customApps = saved.customApps;
                if (saved.history) osState.history = saved.history;
                if (saved.panicKey) osState.panicKey = saved.panicKey;
                if (saved.panicUrl) osState.panicUrl = saved.panicUrl;
            } catch (e) {}
            if (!osState.desktopIcons.length) {
                osState.desktopIcons = [
                    { id: 'd-browser', type: 'builtin', appKey: 'browser' },
                    { id: 'd-calc', type: 'builtin', appKey: 'calculator' },
                    { id: 'd-clock', type: 'builtin', appKey: 'clock' },
                    { id: 'd-wall', type: 'builtin', appKey: 'wallpaper' },
                    { id: 'd-settings', type: 'builtin', appKey: 'settings' }
                ];
            }
            if (!osState.pinned.length) {
                osState.pinned = ['browser', 'calculator', 'clock', 'wallpaper', 'settings'];
            }
        }

        function saveOSState() {
            localStorage.setItem('osState', JSON.stringify(osState));
        }

        function getAppInfo(appKey) {
            if (BUILTIN_APPS[appKey]) return BUILTIN_APPS[appKey];
            const custom = osState.customApps.find(c => c.id === appKey);
            if (custom) return { name: custom.name, icon: custom.icon, useSvg: false, url: custom.url };
            return { name: appKey, icon: null, useSvg: true, svg: '<circle cx="12" cy="12" r="10"/>' };
        }

        /* === SVG fallback helper === */
        function makeSvgFallback(type) {
            const map = {
                browser: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
                calculator: '<svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/></svg>',
                settings: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>'
            };
            const wrapper = document.createElement('span');
            wrapper.innerHTML = map[type] || map.browser;
            return wrapper.firstChild;
        }

        /* === Build an icon element (for desktop/start/taskbar) === */
        function buildIconEl(appKey, size) {
            const info = getAppInfo(appKey);
            if (info.useSvg && info.svg) {
                const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                svg.setAttribute('viewBox', '0 0 24 24');
                svg.innerHTML = info.svg;
                return svg;
            }
            const img = document.createElement('img');
            img.src = info.icon || '/assets/apps/settings.png';
            img.alt = info.name;
            img.onerror = () => {
                const fb = makeSvgFallback(appKey);
                img.replaceWith(fb);
            };
            return img;
        }

        /* === Open OS === */
        function openBrowserOS() {
            const desktop = document.getElementById('os-desktop');
            document.getElementById('main-content').style.visibility = 'hidden';
            document.getElementById('sideDock').style.visibility = 'hidden';
            desktop.classList.add('open');

            loadOSState();
            applyOSWallpaper();

            renderDesktopIcons();
            renderStartApps();
            renderTaskbarCenter();
            updateOSTrayClock();
            setInterval(updateOSTrayClock, 1000);
            updateTaskbarRunning();

            const pending = document.getElementById('chooser-overlay').dataset.pendingUrl;
            delete document.getElementById('chooser-overlay').dataset.pendingUrl;
            if (pending) {
                const url = normalizeUrl(pending);
                if (url) setTimeout(() => createOSWindow('browser', { url }), 150);
            }
        }

        function applyOSWallpaper() {
            const desktop = document.getElementById('os-desktop');
            const savedWall = localStorage.getItem('os-wallpaper');
            desktop.style.backgroundImage = savedWall ? `url('${savedWall}')` : "url('/background.png')";
        }

        function closeBrowserOS() {
            document.getElementById('os-desktop').classList.remove('open');
            document.querySelectorAll('.os-window').forEach(w => w.remove());
            document.getElementById('main-content').style.visibility = '';
            document.getElementById('sideDock').style.visibility = '';
            document.getElementById('chooser-overlay').classList.remove('open');
            osWindows = [];
            osMinimized = [];
            updateTaskbarRunning();
        }

        /* === Desktop icons === */
        function renderDesktopIcons() {
            const container = document.getElementById('os-desktop-icons');
            container.innerHTML = '';
            osState.desktopIcons.forEach((icon, idx) => {
                const el = document.createElement('div');
                el.className = 'os-desktop-icon';
                el.draggable = true;
                el.dataset.iconId = icon.id;
                el.dataset.index = idx;

                let iconEl;
                if (icon.type === 'custom') {
                    iconEl = document.createElement('img');
                    iconEl.src = icon.icon || '/assets/apps/settings.png';
                    iconEl.onerror = () => {
                        const fb = makeSvgFallback('settings');
                        iconEl.replaceWith(fb);
                    };
                } else {
                    iconEl = buildIconEl(icon.appKey);
                }
                el.appendChild(iconEl);

                const span = document.createElement('span');
                if (icon.type === 'custom') span.textContent = icon.name;
                else span.textContent = getAppInfo(icon.appKey).name;
                el.appendChild(span);

                // Drag/drop reordering
                el.addEventListener('dragstart', (e) => {
                    e.dataTransfer.setData('text/plain', icon.id);
                    el.classList.add('dragging');
                });
                el.addEventListener('dragend', () => {
                    el.classList.remove('dragging');
                    document.querySelectorAll('.os-desktop-icon.drag-over').forEach(x => x.classList.remove('drag-over'));
                });
                el.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    el.classList.add('drag-over');
                });
                el.addEventListener('dragleave', () => el.classList.remove('drag-over'));
                el.addEventListener('drop', (e) => {
                    e.preventDefault();
                    el.classList.remove('drag-over');
                    const draggedId = e.dataTransfer.getData('text/plain');
                    if (draggedId === icon.id) return;
                    const fromIdx = osState.desktopIcons.findIndex(i => i.id === draggedId);
                    const toIdx = osState.desktopIcons.findIndex(i => i.id === icon.id);
                    if (fromIdx === -1 || toIdx === -1) return;
                    const [moved] = osState.desktopIcons.splice(fromIdx, 1);
                    osState.desktopIcons.splice(toIdx, 0, moved);
                    saveOSState();
                    renderDesktopIcons();
                });

                // Double click to open
                el.addEventListener('dblclick', () => openDesktopIcon(icon));
                // Single click in edit mode: also fine.

                container.appendChild(el);
            });
        }

        function openDesktopIcon(icon) {
            if (icon.type === 'custom') {
                createOSWindow('browser', { url: icon.url });
            } else {
                handleOSApp(icon.appKey);
            }
        }

        /* === Start menu apps === */
        function renderStartApps() {
            const container = document.getElementById('os-start-apps');
            container.innerHTML = '';

            // Pinned apps
            osState.pinned.forEach(appKey => {
                if (!BUILTIN_APPS[appKey]) return;
                const btn = document.createElement('button');
                btn.className = 'os-start-app';
                btn.dataset.osApp = appKey;
                btn.appendChild(buildIconEl(appKey));
                const span = document.createElement('span');
                span.textContent = BUILTIN_APPS[appKey].name;
                btn.appendChild(span);
                btn.addEventListener('click', () => {
                    handleOSApp(appKey);
                    closeStartMenu();
                });
                container.appendChild(btn);
            });

            // Custom apps
            osState.customApps.forEach(app => {
                const btn = document.createElement('button');
                btn.className = 'os-start-app';
                btn.dataset.customId = app.id;
                const img = document.createElement('img');
                img.src = app.icon || '/assets/apps/settings.png';
                img.onerror = () => {
                    const fb = makeSvgFallback('settings');
                    img.replaceWith(fb);
                };
                btn.appendChild(img);
                const span = document.createElement('span');
                span.textContent = app.name;
                btn.appendChild(span);
                const removeBtn = document.createElement('button');
                removeBtn.className = 'remove-app';
                removeBtn.textContent = '×';
                removeBtn.title = 'Remove';
                removeBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (confirm('Remove ' + app.name + '?')) {
                        osState.customApps = osState.customApps.filter(c => c.id !== app.id);
                        osState.desktopIcons = osState.desktopIcons.filter(c => c.id !== 'd-custom-' + app.id);
                        saveOSState();
                        renderStartApps();
                        renderDesktopIcons();
                    }
                });
                btn.appendChild(removeBtn);
                btn.addEventListener('click', () => {
                    createOSWindow('browser', { url: app.url });
                    closeStartMenu();
                });
                container.appendChild(btn);
            });

            // Exit button
            const exitBtn = document.createElement('button');
            exitBtn.className = 'os-start-app';
            exitBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg><span>Exit OS</span>';
            exitBtn.addEventListener('click', () => { closeStartMenu(); closeBrowserOS(); });
            container.appendChild(exitBtn);
        }

        function closeStartMenu() {
            const menu = document.getElementById('os-start-menu');
            menu.classList.remove('open');
        }

        /* === Taskbar center icons === */
        function renderTaskbarCenter() {
            const container = document.getElementById('os-taskbar-center');
            container.innerHTML = '';
            const centerApps = ['browser', 'calculator', 'clock', 'wallpaper'];
            centerApps.forEach(appKey => {
                const btn = document.createElement('button');
                btn.className = 'os-taskbar-btn';
                btn.dataset.osApp = appKey;
                btn.title = getAppInfo(appKey).name;
                btn.appendChild(buildIconEl(appKey));
                const tip = document.createElement('span');
                tip.className = 'os-taskbar-tooltip';
                tip.textContent = getAppInfo(appKey).name;
                btn.appendChild(tip);
                btn.addEventListener('click', () => handleOSApp(appKey));
                container.appendChild(btn);
            });
        }

        /* === OS clock === */
        function updateOSTrayClock() {
            const timeEl = document.getElementById('os-tray-time');
            const dateEl = document.getElementById('os-tray-date');
            if (!timeEl || !dateEl) return;
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            timeEl.textContent = `${h}:${m}`;
            const dd = String(now.getDate()).padStart(2, '0');
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const yyyy = now.getFullYear();
            dateEl.textContent = `${dd}/${mm}/${yyyy}`;
        }

        function updateTaskbarRunning() {
            document.querySelectorAll('.os-taskbar-btn[data-os-app]').forEach(btn => {
                const app = btn.dataset.osApp;
                if (app === 'start') return;
                const isRunning = osWindows.some(w => w.type === app);
                btn.classList.toggle('running', isRunning);
                btn.classList.toggle('active-app', isRunning && osWindows.some(w => w.type === app && !w.minimized));
            });
        }

        /* === Create window === */
        function createOSWindow(type, opts = {}) {
            const container = document.getElementById('os-windows-container');
            const id = 'osw-' + Date.now() + Math.random().toString(36).substr(2, 4);

            const win = document.createElement('div');
            win.className = 'os-window focused';
            win.id = id;
            win.style.zIndex = ++osWindowZ;
            document.querySelectorAll('.os-window').forEach(w => w.classList.remove('focused'));
            win.classList.add('focused');

            const offset = (osWindows.length % 6) * 26;
            const w = opts.width || 780;
            const h = opts.height || 520;
            win.style.width = w + 'px';
            win.style.height = h + 'px';
            win.style.left = Math.max(16, (window.innerWidth - w) / 2 + offset - 80) + 'px';
            win.style.top = Math.max(16, (window.innerHeight - h) / 2 + offset - 60) + 'px';

            const titlebar = document.createElement('div');
            titlebar.className = 'os-window-titlebar';

            const icon = document.createElement('div');
            icon.className = 'os-window-icon';
            const info = getAppInfo(type);
            if (info.useSvg && info.svg) {
                const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                svg.setAttribute('viewBox', '0 0 24 24');
                svg.innerHTML = info.svg;
                icon.appendChild(svg);
            } else {
                const img = document.createElement('img');
                img.src = info.icon || '/assets/apps/settings.png';
                img.onerror = () => { img.replaceWith(makeSvgFallback(type)); };
                icon.appendChild(img);
            }

            const title = document.createElement('div');
            title.className = 'os-window-title';
            title.textContent = opts.title || info.name;

            const controls = document.createElement('div');
            controls.className = 'os-window-controls';

            const minBtn = document.createElement('button');
            minBtn.className = 'os-window-control min';
            minBtn.title = 'Minimize';
            minBtn.innerHTML = '<svg viewBox="0 0 12 12"><line x1="2" y1="6" x2="10" y2="6"/></svg>';
            minBtn.addEventListener('click', (e) => { e.stopPropagation(); minimizeOSWindow(id); });

            const maxBtn = document.createElement('button');
            maxBtn.className = 'os-window-control max';
            maxBtn.title = 'Maximize';
            maxBtn.innerHTML = '<svg viewBox="0 0 12 12"><rect x="2.5" y="2.5" width="7" height="7" rx="0.5"/></svg>';
            maxBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleMaximizeOSWindow(id); });

            const closeBtn = document.createElement('button');
            closeBtn.className = 'os-window-control close';
            closeBtn.title = 'Close';
            closeBtn.innerHTML = '<svg viewBox="0 0 12 12"><line x1="3" y1="3" x2="9" y2="9"/><line x1="9" y1="3" x2="3" y2="9"/></svg>';
            closeBtn.addEventListener('click', (e) => { e.stopPropagation(); closeOSWindow(id); });

            controls.appendChild(minBtn);
            controls.appendChild(maxBtn);
            controls.appendChild(closeBtn);
            titlebar.appendChild(icon);
            titlebar.appendChild(title);
            titlebar.appendChild(controls);

            const content = document.createElement('div');
            content.className = 'os-window-content';
            content.appendChild(buildOSContent(type, opts, id));

            ['n','s','e','w','ne','nw','se','sw'].forEach(dir => {
                const handle = document.createElement('div');
                handle.className = 'os-resize-handle ' + dir;
                handle.dataset.dir = dir;
                win.appendChild(handle);
            });

            win.appendChild(titlebar);
            win.appendChild(content);
            container.appendChild(win);

            makeDraggable(win, titlebar, id);
            makeResizable(win);

            win.addEventListener('mousedown', () => {
                document.querySelectorAll('.os-window').forEach(w => w.classList.remove('focused'));
                win.classList.add('focused');
                win.style.zIndex = ++osWindowZ;
            });

            osWindows.push({ id, type, el: win, opts, minimized: false });
            updateTaskbarRunning();
            return win;
        }

        function buildOSContent(type, opts, winId) {
            if (type === 'browser') return buildOSBrowser(opts, winId);
            if (type === 'calculator') return buildOSCalculator();
            if (type === 'clock') return buildOSClock();
            if (type === 'wallpaper') return buildOSWallpaper();
            if (type === 'settings') return buildOSSettings();
            if (type === 'files') return buildOSFiles();
            if (type === 'terminal') return buildOSTerminal();
            if (type === 'notes') return buildOSNotes();
            return document.createElement('div');
        }

        /* === OS browser with tabs, history, arrows === */
        function buildOSBrowser(opts, winId) {
            const wrap = document.createElement('div');
            wrap.className = 'os-browser-inner';

            let browserTabs = [];
            let activeBrowserTabId = null;
            let tabIdCounter = 0;

            const tabsBar = document.createElement('div');
            tabsBar.className = 'os-browser-tabs';

            const newTabBtn = document.createElement('button');
            newTabBtn.className = 'os-browser-newtab';
            newTabBtn.textContent = '+';
            newTabBtn.title = 'New tab';

            const bar = document.createElement('div');
            bar.className = 'os-browser-bar';

            const back = document.createElement('button');
            back.innerHTML = '<svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>';
            back.title = 'Back';
            back.disabled = true;

            const forward = document.createElement('button');
            forward.innerHTML = '<svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>';
            forward.title = 'Forward';
            forward.disabled = true;

            const refresh = document.createElement('button');
            refresh.innerHTML = '<svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>';
            refresh.title = 'Refresh';

            const home = document.createElement('button');
            home.innerHTML = '<svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>';
            home.title = 'Home';

            const urlWrap = document.createElement('div');
            urlWrap.className = 'os-browser-url';
            const urlFav = document.createElement('img');
            urlFav.className = 'url-favicon';
            urlFav.src = '/logo.gif';
            urlFav.onerror = () => { urlFav.style.display = 'none'; };
            const input = document.createElement('input');
            input.type = 'text';
            input.placeholder = 'Search or enter URL...';
            input.value = opts.url || '';
            urlWrap.appendChild(urlFav);
            urlWrap.appendChild(input);

            const historyBtn = document.createElement('button');
            historyBtn.innerHTML = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
            historyBtn.title = 'History';

            bar.appendChild(back);
            bar.appendChild(forward);
            bar.appendChild(refresh);
            bar.appendChild(home);
            bar.appendChild(urlWrap);
            bar.appendChild(historyBtn);

            const content = document.createElement('div');
            content.className = 'os-browser-content';

            // History panel
            const historyPanel = document.createElement('div');
            historyPanel.className = 'os-history-panel';
            historyPanel.innerHTML = `
                <div class="os-history-header">
                    <h3>History</h3>
                    <button class="hist-close-btn" title="Close">✕</button>
                </div>
                <div class="os-history-list"></div>
                <div class="os-history-footer">
                    <button class="hist-clear-btn">Clear history</button>
                </div>
            `;
            content.appendChild(historyPanel);

            // Iframe
            const iframe = document.createElement('iframe');
            iframe.className = 'os-browser-iframe';
            iframe.referrerPolicy = 'no-referrer';
            iframe.allowFullscreen = true;
            iframe.src = 'about:blank';
            content.appendChild(iframe);

            /* Tab management */
            function createBrowserTab(url) {
                const tab = {
                    id: ++tabIdCounter,
                    url: null,
                    title: 'New Tab',
                    favicon: '/logo.gif',
                    history: [],
                    historyIndex: -1
                };
                browserTabs.push(tab);
                activeBrowserTabId = tab.id;
                renderBrowserTabs();
                if (url) navigateBrowserTab(tab, url);
                else updateBrowserUI();
                return tab;
            }

            function closeBrowserTab(id) {
                if (browserTabs.length <= 1) return;
                const idx = browserTabs.findIndex(t => t.id === id);
                if (idx === -1) return;
                browserTabs.splice(idx, 1);
                if (activeBrowserTabId === id) {
                    activeBrowserTabId = browserTabs[Math.max(0, idx - 1)].id;
                }
                renderBrowserTabs();
                updateBrowserUI();
            }

            function switchBrowserTab(id) {
                activeBrowserTabId = id;
                renderBrowserTabs();
                updateBrowserUI();
            }

            function getActiveTab() {
                return browserTabs.find(t => t.id === activeBrowserTabId);
            }

            function navigateBrowserTab(tab, rawUrl) {
                const url = normalizeUrl(rawUrl);
                if (!url) return;
                if (tab.historyIndex < tab.history.length - 1) {
                    tab.history = tab.history.slice(0, tab.historyIndex + 1);
                }
                tab.history.push(url);
                tab.historyIndex = tab.history.length - 1;
                tab.url = url;
                tab.title = getHostname(url);
                tab.favicon = getFaviconUrl(url) || '/logo.gif';
                // Record history
                pushOSHistory(url, tab.title, tab.favicon);
                renderBrowserTabs();
                if (tab.id === activeBrowserTabId) {
                    iframe.src = getProxyUrl(url);
                    updateBrowserUI();
                }
            }

            function updateBrowserUI() {
                const tab = getActiveTab();
                if (!tab) return;
                if (tab.url) {
                    input.value = tab.url;
                    urlFav.src = tab.favicon || '/logo.gif';
                    urlFav.style.display = '';
                } else {
                    input.value = '';
                    urlFav.src = '/logo.gif';
                }
                back.disabled = !(tab.historyIndex > 0);
                forward.disabled = !(tab.historyIndex < tab.history.length - 1);
            }

            function renderBrowserTabs() {
                tabsBar.querySelectorAll('.os-browser-tab').forEach(el => el.remove());
                browserTabs.forEach(tab => {
                    const el = document.createElement('button');
                    el.className = 'os-browser-tab' + (tab.id === activeBrowserTabId ? ' active' : '');
                    const fav = document.createElement('img');
                    fav.className = 'tab-fav';
                    fav.src = tab.favicon || '/logo.gif';
                    fav.onerror = () => { fav.src = '/logo.gif'; };
                    el.appendChild(fav);
                    const label = document.createElement('span');
                    label.className = 'tab-label';
                    label.textContent = tab.title || 'New Tab';
                    el.appendChild(label);
                    if (browserTabs.length > 1) {
                        const closeX = document.createElement('button');
                        closeX.className = 'tab-close-x';
                        closeX.textContent = '×';
                        closeX.addEventListener('click', (e) => {
                            e.stopPropagation();
                            closeBrowserTab(tab.id);
                        });
                        el.appendChild(closeX);
                    }
                    el.addEventListener('click', () => switchBrowserTab(tab.id));
                    tabsBar.insertBefore(el, newTabBtn);
                });
            }

            /* History panel rendering */
            function renderHistoryPanel() {
                const list = historyPanel.querySelector('.os-history-list');
                list.innerHTML = '';
                if (!osState.history.length) {
                    list.innerHTML = '<div class="os-history-empty">No history yet</div>';
                    return;
                }
                osState.history.slice().reverse().forEach(item => {
                    const el = document.createElement('div');
                    el.className = 'os-history-item';
                    const fav = document.createElement('img');
                    fav.src = item.favicon || '/logo.gif';
                    fav.onerror = () => { fav.src = '/logo.gif'; };
                    el.appendChild(fav);
                    const info = document.createElement('div');
                    info.className = 'hist-info';
                    const t = document.createElement('div');
                    t.className = 'hist-title';
                    t.textContent = item.title;
                    const u = document.createElement('div');
                    u.className = 'hist-url';
                    u.textContent = item.url;
                    info.appendChild(t);
                    info.appendChild(u);
                    el.appendChild(info);
                    el.addEventListener('click', () => {
                        const tab = getActiveTab();
                        if (tab) navigateBrowserTab(tab, item.url);
                        historyPanel.classList.remove('open');
                    });
                    list.appendChild(el);
                });
            }

            historyBtn.addEventListener('click', () => {
                const isOpen = historyPanel.classList.contains('open');
                if (isOpen) historyPanel.classList.remove('open');
                else {
                    renderHistoryPanel();
                    historyPanel.classList.add('open');
                }
            });

            historyPanel.querySelector('.hist-close-btn').addEventListener('click', () => {
                historyPanel.classList.remove('open');
            });

            historyPanel.querySelector('.hist-clear-btn').addEventListener('click', () => {
                if (confirm('Clear all history?')) {
                    osState.history = [];
                    saveOSState();
                    renderHistoryPanel();
                }
            });

            /* Nav actions */
            back.addEventListener('click', () => {
                const tab = getActiveTab();
                if (!tab) return;
                if (tab.historyIndex > 0) {
                    tab.historyIndex--;
                    tab.url = tab.history[tab.historyIndex];
                    tab.title = getHostname(tab.url);
                    tab.favicon = getFaviconUrl(tab.url) || '/logo.gif';
                    iframe.src = getProxyUrl(tab.url);
                    renderBrowserTabs();
                    updateBrowserUI();
                }
            });
            forward.addEventListener('click', () => {
                const tab = getActiveTab();
                if (!tab) return;
                if (tab.historyIndex < tab.history.length - 1) {
                    tab.historyIndex++;
                    tab.url = tab.history[tab.historyIndex];
                    tab.title = getHostname(tab.url);
                    tab.favicon = getFaviconUrl(tab.url) || '/logo.gif';
                    iframe.src = getProxyUrl(tab.url);
                    renderBrowserTabs();
                    updateBrowserUI();
                }
            });
            refresh.addEventListener('click', () => {
                const tab = getActiveTab();
                if (tab && tab.url) iframe.src = getProxyUrl(tab.url);
            });
            home.addEventListener('click', () => {
                const tab = getActiveTab();
                if (!tab) return;
                // Blank page
                tab.url = null;
                tab.title = 'New Tab';
                tab.history = [];
                tab.historyIndex = -1;
                iframe.src = 'about:blank';
                renderBrowserTabs();
                updateBrowserUI();
            });

            function go() {
                const tab = getActiveTab();
                if (!tab) return;
                navigateBrowserTab(tab, input.value);
            }
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') go();
            });

            newTabBtn.addEventListener('click', () => {
                createBrowserTab(null);
            });

            /* Initialize with first tab */
            createBrowserTab(opts.url || null);

            /* Poll iframe for navigation (allow back/forward to work when user clicks links) */
            setInterval(() => {
                try {
                    const tab = getActiveTab();
                    if (!tab) return;
                    const frameLoc = iframe.contentWindow.location.href;
                    if (frameLoc && frameLoc !== 'about:blank' && !frameLoc.startsWith('about:')) {
                        // Could be a proxied URL; try to decode
                        let realUrl = frameLoc;
                        if (typeof __uv$config !== 'undefined') {
                            try {
                                const decoded = __uv$config.decodeUrl(frameLoc);
                                if (decoded) realUrl = decoded;
                            } catch (e) {}
                        }
                        if (realUrl && realUrl !== tab.url && !realUrl.startsWith('about:')) {
                            // Push to history
                            if (tab.historyIndex < tab.history.length - 1) {
                                tab.history = tab.history.slice(0, tab.historyIndex + 1);
                            }
                            tab.history.push(realUrl);
                            tab.historyIndex = tab.history.length - 1;
                            tab.url = realUrl;
                            tab.title = getHostname(realUrl);
                            tab.favicon = getFaviconUrl(realUrl) || '/logo.gif';
                            pushOSHistory(realUrl, tab.title, tab.favicon);
                            renderBrowserTabs();
                            updateBrowserUI();
                        }
                    }
                } catch (e) {
                    // Cross-origin — can't read; that's fine
                }
            }, 800);

            wrap.appendChild(tabsBar);
            tabsBar.appendChild(newTabBtn);
            wrap.appendChild(bar);
            wrap.appendChild(content);
            return wrap;
        }

        function pushOSHistory(url, title, favicon) {
            // Dedupe consecutive duplicates
            const last = osState.history[osState.history.length - 1];
            if (last && last.url === url) return;
            osState.history.push({ url, title, favicon, time: Date.now() });
            if (osState.history.length > 500) osState.history.shift();
            saveOSState();
        }

        /* === Calculator === */
        function buildOSCalculator() {
            const wrap = document.createElement('div');
            wrap.style.display = 'flex';
            wrap.style.flexDirection = 'column';
            wrap.style.height = '100%';

            const display = document.createElement('div');
            display.className = 'os-calc-display';
            display.textContent = '0';

            const grid = document.createElement('div');
            grid.className = 'os-calc-grid';

            let current = '0';
            let previous = null;
            let op = null;
            let reset = false;

            const buttons = [
                { t: 'C', c: 'clr' }, { t: '⌫', c: '' }, { t: '%', c: 'op' }, { t: '÷', c: 'op', v: '/' },
                { t: '7', c: '' }, { t: '8', c: '' }, { t: '9', c: '' }, { t: '×', c: 'op', v: '*' },
                { t: '4', c: '' }, { t: '5', c: '' }, { t: '6', c: '' }, { t: '−', c: 'op', v: '-' },
                { t: '1', c: '' }, { t: '2', c: '' }, { t: '3', c: '' }, { t: '+', c: 'op', v: '+' },
                { t: '±', c: '' }, { t: '0', c: '' }, { t: '.', c: '' }, { t: '=', c: 'eq' }
            ];

            function update() { display.textContent = current; }

            function handle(action) {
                if (/[0-9]/.test(action) && action.length === 1) {
                    if (reset) { current = action; reset = false; }
                    else { current = current === '0' ? action : current + action; }
                } else if (action === '.') {
                    if (reset) { current = '0.'; reset = false; }
                    else if (!current.includes('.')) current += '.';
                } else if (action === 'C') {
                    current = '0'; previous = null; op = null; reset = false;
                } else if (action === '⌫') {
                    current = current.length > 1 ? current.slice(0, -1) : '0';
                } else if (action === '±') {
                    current = current.startsWith('-') ? current.slice(1) : '-' + current;
                } else if (action === '%') {
                    current = String(parseFloat(current) / 100);
                } else if (['+','-','*','/'].includes(action)) {
                    if (op !== null && !reset) compute();
                    previous = current; op = action; reset = true;
                } else if (action === '=') { compute(); }
                update();
            }

            function compute() {
                if (op === null || previous === null) return;
                const a = parseFloat(previous), b = parseFloat(current);
                let r = 0;
                if (op === '+') r = a + b;
                else if (op === '-') r = a - b;
                else if (op === '*') r = a * b;
                else if (op === '/') r = b === 0 ? NaN : a / b;
                current = String(r);
                previous = null; op = null; reset = true;
                update();
            }

            buttons.forEach(b => {
                const btn = document.createElement('button');
                btn.className = 'os-calc-btn ' + b.c;
                btn.textContent = b.t;
                btn.addEventListener('click', () => handle(b.v || b.t));
                grid.appendChild(btn);
            });

            wrap.appendChild(display);
            wrap.appendChild(grid);
            return wrap;
        }

