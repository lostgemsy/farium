            label.textContent = 'Desktop Wallpaper';
            label.style.fontSize = '13px';
            label.style.fontWeight = '600';
            label.style.marginBottom = '10px';
            label.style.color = '#a0a0a0';

            const changeBtn = document.createElement('button');
            changeBtn.textContent = 'Change wallpaper';
            changeBtn.style.padding = '8px 16px';
            changeBtn.style.background = '#7c8cff';
            changeBtn.style.border = 'none';
            changeBtn.style.borderRadius = '4px';
            changeBtn.style.color = '#fff';
            changeBtn.style.cursor = 'pointer';
            changeBtn.style.fontFamily = 'inherit';
            changeBtn.style.fontSize = '12px';
            changeBtn.addEventListener('click', () => {
                document.getElementById('os-wallpaper-input').click();
            });

            section.appendChild(label);
            section.appendChild(changeBtn);
            wrap.appendChild(title);
            wrap.appendChild(section);

            return wrap;
        }

        function setOSWallpaper(url) {
            const desktop = document.getElementById('os-desktop');
            desktop.style.backgroundImage = `url('${url}')`;
            localStorage.setItem('os-wallpaper', url);
        }

        /* ===== DRAGGING ===== */
        function makeDraggable(win, handle, winId) {
            let startX, startY, startLeft, startTop;
            let isDragging = false;
            let snapSide = null;

            function onDown(e) {
                if (e.target.closest('.os-window-control')) return;
                if (e.target.closest('.os-resize-handle')) return;
                if (win.classList.contains('maximized')) return;
                e.preventDefault();
                const rect = win.getBoundingClientRect();
                startX = e.clientX;
                startY = e.clientY;
                startLeft = rect.left;
                startTop = rect.top;
                isDragging = true;
                document.addEventListener('mousemove', onMove);
                document.addEventListener('mouseup', onUp);
            }

            function onMove(e) {
                if (!isDragging) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                const newLeft = startLeft + dx;
                const newTop = Math.max(0, startTop + dy);

                // Snap detection
                const preview = document.getElementById('os-snap-preview');
                const threshold = 20;
                const screenW = window.innerWidth;
                const screenH = window.innerHeight - 40;

                clearTimeout(osSnapPreviewTimer);

                if (e.clientX < threshold) {
                    snapSide = 'left';
                    preview.style.display = 'block';
                    preview.style.left = '0';
                    preview.style.top = '0';
                    preview.style.width = '50%';
                    preview.style.height = screenH + 'px';
                } else if (e.clientX > screenW - threshold) {
                    snapSide = 'right';
                    preview.style.display = 'block';
                    preview.style.left = '50%';
                    preview.style.top = '0';
                    preview.style.width = '50%';
                    preview.style.height = screenH + 'px';
                } else {
                    snapSide = null;
                    preview.style.display = 'none';
                }

                win.style.left = newLeft + 'px';
                win.style.top = newTop + 'px';
            }

            function onUp() {
                isDragging = false;
                document.removeEventListener('mousemove', onMove);
                document.removeEventListener('mouseup', onUp);

                const preview = document.getElementById('os-snap-preview');
                if (snapSide) {
                    win.classList.remove('snapped-left', 'snapped-right');
                    win.classList.add('snapped-' + snapSide);
                    preview.style.display = 'none';
                    snapSide = null;
                } else {
                    // Un-snap if dragged away
                    if (win.classList.contains('snapped-left') || win.classList.contains('snapped-right')) {
                        win.classList.remove('snapped-left', 'snapped-right');
                    }
                }
            }

            handle.addEventListener('mousedown', onDown);

            // Double-click titlebar to maximize
            handle.addEventListener('dblclick', (e) => {
                if (e.target.closest('.os-window-control')) return;
                toggleMaximizeOSWindow(winId);
            });
        }

        /* ===== RESIZING ===== */
        function makeResizable(win) {
            const handles = win.querySelectorAll('.os-resize-handle');
            handles.forEach(handle => {
                handle.addEventListener('mousedown', (e) => {
                    if (win.classList.contains('maximized')) return;
                    e.preventDefault();
                    e.stopPropagation();

                    const dir = handle.dataset.dir;
                    const rect = win.getBoundingClientRect();
                    const startX = e.clientX;
                    const startY = e.clientY;
                    const startW = rect.width;
                    const startH = rect.height;
                    const startL = rect.left;
                    const startT = rect.top;

                    function onMove(e) {
                        let newW = startW, newH = startH, newL = startL, newT = startT;

                        if (dir.includes('e')) newW = Math.max(280, startW + (e.clientX - startX));
                        if (dir.includes('w')) {
                            newW = Math.max(280, startW - (e.clientX - startX));
                            newL = startL + (startW - newW);
                        }
                        if (dir.includes('s')) newH = Math.max(160, startH + (e.clientY - startY));
                        if (dir.includes('n')) {
                            newH = Math.max(160, startH - (e.clientY - startY));
                            newT = startT + (startH - newH);
                        }

                        win.style.width = newW + 'px';
                        win.style.height = newH + 'px';
                        win.style.left = newL + 'px';
                        win.style.top = newT + 'px';
                    }

                    function onUp() {
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                    }

                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                });
            });
        }

        /* ===== WINDOW CONTROLS ===== */
        function closeOSWindow(id) {
            const win = osWindows.find(w => w.id === id);
            if (win) {
                win.el.remove();
                osWindows = osWindows.filter(w => w.id !== id);
                osMinimized = osMinimized.filter(m => m !== id);
                updateTaskbarRunning();
            }
        }

        function minimizeOSWindow(id) {
            const win = osWindows.find(w => w.id === id);
            if (!win) return;
            win.el.classList.add('minimized');
            win.minimized = true;
            if (!osMinimized.includes(id)) osMinimized.push(id);
            updateTaskbarRunning();
        }

        function restoreOSWindow(id) {
            const win = osWindows.find(w => w.id === id);
            if (!win) return;
            win.el.classList.remove('minimized');
            win.minimized = false;
            win.el.style.zIndex = ++osWindowZ;
            osMinimized = osMinimized.filter(m => m !== id);
            updateTaskbarRunning();
        }

        function toggleMaximizeOSWindow(id) {
            const win = osWindows.find(w => w.id === id);
            if (!win) return;
            win.el.classList.toggle('maximized');
        }

        /* ===== INIT OS ===== */
        function initBrowserOS() {
            setInterval(() => {
                if (document.getElementById('os-desktop').classList.contains('open')) {
                    updateOSTrayClock();
                }
            }, 1000);

            // Taskbar and desktop icons
            document.querySelectorAll('.os-taskbar-btn[data-os-app], .os-desktop-icon[data-os-app]').forEach(el => {
                el.addEventListener('click', () => {
                    const app = el.dataset.osApp;
                    handleOSApp(app);
                });
            });

            // Start menu apps
            document.querySelectorAll('.os-start-app').forEach(btn => {
                btn.addEventListener('click', () => {
                    const app = btn.dataset.osApp;
                    handleOSApp(app);
                    document.getElementById('os-start-menu').classList.remove('open');
                });
            });

            // Wallpaper input
            document.getElementById('os-wallpaper-input').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (ev) => setOSWallpaper(ev.target.result);
                reader.readAsDataURL(file);
            });

            // Close start menu on outside click
            document.addEventListener('click', (e) => {
                const menu = document.getElementById('os-start-menu');
                const startBtn = document.querySelector('.os-taskbar-btn[data-os-app="start"]');
                if (menu.classList.contains('open') &&
                    !menu.contains(e.target) &&
                    !startBtn.contains(e.target)) {
                    menu.classList.remove('open');
                }
            });

            // Escape closes start menu
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    document.getElementById('os-start-menu').classList.remove('open');
                }
            });
        }

        function handleOSApp(app) {
            if (app === 'start') {
                document.getElementById('os-start-menu').classList.toggle('open');
                return;
            }
            if (app === 'exit') {
                closeBrowserOS();
                return;
            }

            // If window of this type already exists, restore/focus it
            const existing = osWindows.find(w => w.type === app);
            if (existing) {
                if (existing.minimized) restoreOSWindow(existing.id);
                existing.el.style.zIndex = ++osWindowZ;
                return;
            }

            if (app === 'browser') {
                createOSWindow('browser', { width: 820, height: 540 });
            } else if (app === 'calculator') {
                createOSWindow('calculator', { width: 320, height: 460, title: 'Calculator' });
            } else if (app === 'clock') {
                createOSWindow('clock', { width: 380, height: 260, title: 'Clock' });
            } else if (app === 'wallpaper') {
                createOSWindow('wallpaper', { width: 540, height: 440, title: 'Wallpaper' });
            } else if (app === 'settings') {
                createOSWindow('settings', { width: 520, height: 400, title: 'Settings' });
            }
        }
    </script>
</body>
</html>