<script>
/* =========================================================
   HELPERS
========================================================= */

const $ = selector =>
  document.querySelector(selector);

const $$ = selector =>
  [...document.querySelectorAll(selector)];


/* =========================================================
   INTRO
========================================================= */

function dismissIntro(){

  const intro = $('#intro');

  if(!intro) return;

  intro.style.opacity = '0';
  intro.style.visibility = 'hidden';
  intro.style.pointerEvents = 'none';
}

setTimeout(
  dismissIntro,
  3000
);


/* =========================================================
   STATE
========================================================= */

const state = {

  engine:
    localStorage.fariumEngine || 'scramjet',

  search:
    localStorage.fariumSearch || 'google',

  motion:true,

  shader:true,

  controller:null,

  frame:null,

  tabs:[],

  active:null

};


/* =========================================================
   SEARCH ENGINES
========================================================= */

const searches = {

  google:
    q =>
      'https://www.google.com/search?q=' +
      encodeURIComponent(q),

  duck:
    q =>
      'https://duckduckgo.com/?q=' +
      encodeURIComponent(q),

  brave:
    q =>
      'https://search.brave.com/search?q=' +
      encodeURIComponent(q)

};


const searchNames = {

  google:'GOOGLE',

  duck:'DUCKDUCKGO',

  brave:'BRAVE'

};


/* =========================================================
   SEARCH ICON
========================================================= */

function icon(name){

  if(name === 'search'){

    return `
      <svg
        viewBox="0 0 24 24"
        fill="none">

        <circle
          cx="11"
          cy="11"
          r="6.5"
          stroke="currentColor"
          stroke-width="1.8"/>

        <path
          d="M20 20l-4-4"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"/>

      </svg>
    `;

  }

  return '◉';
}


$('#searchIcon').innerHTML =
  icon('search');

$('#homeEngine').textContent =
  searchNames[state.search];


/* =========================================================
   SHORTCUTS
========================================================= */

const apps = [

  ['Google','https://google.com'],

  ['YouTube','https://youtube.com'],

  ['Discord','https://discord.com'],

  ['Spotify','https://spotify.com'],

  ['Reddit','https://reddit.com'],

  ['Add','']

];


function renderApps(){

  const wrap = $('#shortcuts');

  wrap.innerHTML = '';

  apps.forEach((app,index)=>{

    const element =
      document.createElement('div');

    element.className =
      'shortcut fall';

    element.style.animationDelay =
      (.12 + index * .07) + 's';

    element.innerHTML = `

      <div class="ico">
        ${app[0] === 'Add' ? '+' : '◉'}
      </div>

      <small>
        ${app[0]}
      </small>

    `;

    if(app[1]){

      element.onclick = () =>
        navigate(
          app[1],
          app[0]
        );

    }

    wrap.appendChild(element);

  });

}

renderApps();


/* =========================================================
   URL DETECTION
========================================================= */

function looksUrl(value){

  return (
    /^https?:\/\//i.test(value) ||

    /^[\w-]+(\.[\w-]+)+(\/.*)?$/i.test(value)
  );

}


function normalize(value){

  if(/^https?:\/\//i.test(value)){

    return value;

  }

  return 'https://' + value;

}


/* =========================================================
   SCRAMJET
========================================================= */

/*
  IMPORTANT:

  This uses the Scramjet bootstrap/controller
  instead of putting the raw website URL directly
  into the iframe.

  DO NOT replace this with:

      iframe.src = url;

  because that bypasses the proxy.
*/

async function initScramjet(){

  if(state.controller){

    return state.controller;

  }

  await loadScript(
    '/bootstrap-init.js'
  );

  state.controller =
    await window.initBootstrap();

  await state.controller.wait();

  return state.controller;

}


function loadScript(src){

  return new Promise(
    (resolve,reject)=>{

      const script =
        document.createElement('script');

      script.src = src;

      script.onload = resolve;

      script.onerror = () =>
        reject(
          new Error(
            'Could not load ' + src
          )
        );

      document.head.appendChild(script);

    }
  );

}


/* =========================================================
   TABS
========================================================= */

function tabNew(){

  const id =
    Math.random()
      .toString(36)
      .slice(2);

  state.tabs.push({

    id,

    title:'New Tab',

    url:''

  });

  state.active = id;

  renderTabs();

  showHomeView();

}


function renderTabs(){

  const tabs =
    $('#tabs');

  tabs.innerHTML = '';


  state.tabs.forEach(tab=>{

    const element =
      document.createElement('div');

    element.className =
      'tab ' +
      (
        tab.id === state.active
          ? 'active'
          : ''
      );


    element.innerHTML = `

      <span>◉</span>

      <span>
        ${escapeHtml(tab.title)}
      </span>

      <button>
        ×
      </button>

    `;


    element.onclick = event => {

      if(
        event.target.tagName ===
        'BUTTON'
      ){

        state.tabs =
          state.tabs.filter(
            item =>
              item.id !== tab.id
          );


        if(!state.tabs.length){

          tabNew();

        }else{

          state.active =
            state.tabs[
              Math.max(
                0,
                state.tabs.length - 1
              )
            ].id;

          renderTabs();

          loadTab(
            state.tabs.find(
              item =>
                item.id === state.active
            )
          );

        }

        return;

      }


      state.active = tab.id;

      renderTabs();

      loadTab(tab);

    };


    tabs.appendChild(element);

  });


  const add =
    document.createElement('button');

  add.className = 'tab';

  add.style.minWidth = '34px';

  add.textContent = '+';

  add.onclick = tabNew;

  tabs.appendChild(add);

}


function escapeHtml(value){

  return String(value).replace(
    /[&<>"']/g,

    character => ({

      '&':'&amp;',

      '<':'&lt;',

      '>':'&gt;',

      '"':'&quot;',

      "'":'&#39;'

    })[character]

  );

}


/* =========================================================
   BROWSER HOME
========================================================= */

function showHomeView(){

  const view =
    $('#view');

  view.innerHTML = `

    <div class="browserHome">

      <h2>
        FARIUM
      </h2>

    </div>

    <div
      class="status"
      id="status">

      Loading

      <b id="statusText"></b>

    </div>

  `;

}


/* =========================================================
   LOAD TAB
========================================================= */

async function loadTab(tab){

  if(!tab || !tab.url){

    showHomeView();

    return;

  }


  const view =
    $('#view');

  view.innerHTML = `

    <div
      class="status show"
      id="status">

      Loading

      <b id="statusText"></b>

    </div>

  `;


  const status =
    $('#status');

  const statusText =
    $('#statusText');


  statusText.textContent =
    tab.url;

  $('#addressInput').value =
    tab.url;


  const iframe =
    document.createElement('iframe');


  iframe.setAttribute(
    'allow',
    'fullscreen; autoplay; clipboard-read; clipboard-write'
  );


  iframe.style.width = '100%';

  iframe.style.height = '100%';

  iframe.style.border = '0';


  iframe.addEventListener(
    'load',
    ()=>{
      status.classList.remove('show');
    },
    {once:true}
  );


  view.appendChild(iframe);


  try{

    /*
      SCRAMJET
    */

    if(state.engine === 'scramjet'){

      const controller =
        await initScramjet();


      state.frame =
        controller.createFrame(
          iframe
        );


      /*
        This is the important part.

        Frame.go() handles the
        Scramjet URL rewriting.
      */

      state.frame.go(
        tab.url
      );

    }


    /*
      ULTRAVIOLET
    */

    else{

      await ensureUV();


      iframe.src =
        '/uv/service/' +
        self.__uv$config.encodeUrl(
          tab.url
        );

    }


  }catch(error){

    console.error(
      'Farium proxy error:',
      error
    );

    status.classList.remove(
      'show'
    );

    statusText.textContent =
      'Proxy failed: ' +
      error.message;

  }

}


/* =========================================================
   ULTRAVIOLET SERVICE WORKER
========================================================= */

async function ensureUV(){

  if(
    navigator.serviceWorker.controller
  ){

    return;

  }


  await navigator.serviceWorker.register(
    '/uv-sw.js',
    {
      scope:'/'
    }
  );


  await navigator.serviceWorker.ready;

}


/* =========================================================
   INIT PROXY (BareMux)
========================================================= */

async function initProxy(){

  if ('serviceWorker' in navigator) {
    try {
      await navigator.serviceWorker.register('/sw.js');
      await navigator.serviceWorker.ready;
    } catch (err) {}
  }

  try {
    const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
    const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
    const transport = localStorage.getItem("transport") || "libcurl";
    const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
    if (await connection.getTransport() !== transportPath) {
      await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
    }
  } catch (err) {}
}


/* =========================================================
   NAVIGATION
========================================================= */

async function navigate(
  raw,
  title
){

  let value =
    (raw || '').trim();

  if(!value){

    return;

  }


  /*
    If the user enters:

      youtube.com

    it becomes:

      https://youtube.com

    If they enter:

      minecraft pvp

    it becomes:

      https://www.google.com/search?q=minecraft+pvp

    Then THAT URL is passed through
    Scramjet / UV.
  */

  const url =
    looksUrl(value)
      ? normalize(value)
      : searches[state.search](value);


  if(!state.tabs.length){

    tabNew();

  }


  const tab =
    state.tabs.find(
      item =>
        item.id === state.active
    );


  tab.url = url;


  try{

    tab.title =
      title ||
      new URL(url)
        .hostname
        .replace(
          /^www\./,
          ''
        );

  }catch{

    tab.title = 'Farium';

  }


  $('#browser')
    .classList
    .add('show');


  renderTabs();

  await loadTab(tab);

}


/* =========================================================
   HOME SEARCH
========================================================= */

$('#homeInput')
