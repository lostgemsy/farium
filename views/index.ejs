<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farium</title>

    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <script src="/epoxy/index.js"></script>
    <script src="/baremux/index.js"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>

    <link rel="icon" type="image/png" href="https://cdn.jsdelivr.net/gh/lostgemsy/SrFrosty-games@main/logo.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
        @keyframes rumble { 0%,100%{transform:translateX(0)} 15%{transform:translateX(-2px)} 30%{transform:translateX(2px)} 45%{transform:translateX(-1px)} 60%{transform:translateX(1px)} }
        @keyframes pulse { 0%,100%{box-shadow:0 0 20px rgba(124,140,255,0.15)} 50%{box-shadow:0 0 40px rgba(124,140,255,0.3)} }
        @keyframes tabIn { from { opacity: 0; transform: translateY(4px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes browserSlideIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes bounceIn { 0%{transform:scale(0.3);opacity:0} 50%{transform:scale(1.05)} 70%{transform:scale(0.95)} 100%{transform:scale(1);opacity:1} }
        @keyframes logoFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }
        @keyframes logoDrop {
            0% { opacity:0; transform:translateY(-55px) scale(.72) rotate(-4deg); filter:blur(10px); }
            55% { opacity:1; transform:translateY(7px) scale(1.04) rotate(1deg); filter:blur(0); }
            72% { transform:translateY(-3px) scale(.985); }
            100% { opacity:1; transform:none; }
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes auroraShift {
            0%,100% { transform: translate(0,0) scale(1); }
            50% { transform: translate(-4%, 3%) scale(1.15); }
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #05060a;
            --bg-2: #0a0b10;
            --bg-3: #0f1118;
            --text: #f5f5f7;
            --text-dim: rgba(255,255,255,.45);
            --text-dim-2: rgba(255,255,255,.68);
            --card: rgba(255,255,255,.045);
            --card-hover: rgba(255,255,255,.08);
            --card-border: rgba(255,255,255,.09);
            --card-border-hover: rgba(255,255,255,.28);
            --input-bg: rgba(255,255,255,.05);
            --input-border: rgba(255,255,255,.1);
            --input-border-focus: rgba(255,255,255,.4);
            --shadow: rgba(0,0,0,.65);
            --shadow-glow: rgba(120,140,255,.14);
            --accent: #7c8cff;
            --accent-2: #b47cff;
            --accent-glow: rgba(124,140,255,.35);
            --ring: rgba(124,140,255,.32);
        }

        body {
            margin: 0;
            padding: 0;
            background: var(--bg);
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            position: relative;
            overflow: hidden;
        }

        /* Layered transparent aurora look */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(900px 500px at 15% -5%, var(--shadow-glow), transparent 65%),
                radial-gradient(800px 500px at 100% 0%, rgba(180,124,255,.09), transparent 60%),
                radial-gradient(700px 500px at 50% 120%, rgba(124,140,255,.08), transparent 60%);
            z-index: 0;
            pointer-events: none;
            animation: auroraShift 18s ease-in-out infinite;
        }

        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background: linear-gradient(180deg, rgba(5,6,10,.55) 0%, rgba(5,6,10,.75) 100%);
            z-index: 0;
            pointer-events: none;
        }

        .topbar {
            position: fixed;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(15,17,24,.55);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 5px 10px;
            backdrop-filter: blur(20px) saturate(1.2);
            -webkit-backdrop-filter: blur(20px) saturate(1.2);
            box-shadow: 0 10px 40px -12px var(--shadow), inset 0 1px 0 rgba(255,255,255,.05);
            animation: fadeIn 0.4s ease;
        }

        .topbar a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            transition: all 0.2s;
            text-decoration: none;
            color: var(--text);
        }

        .topbar a:hover {
            background: var(--card-hover);
            color: #fff;
        }
        .topbar a.active {
            background: var(--card);
            box-shadow: inset 0 0 0 1px var(--card-border);
        }

        .topbar a:active { animation: rumble 0.3s ease; }

        .topbar svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .main-content {
            position: relative;
            z-index: 2;
            text-align: center;
            animation: fadeIn 0.6s ease;
            width: 100%;
            max-width: 650px;
            padding: 0 20px;
        }

        .logo-image-wrap {
            display:flex;
            justify-content:center;
            align-items:center;
            margin-bottom:12px;
            min-height:76px;
            animation: logoDrop .85s cubic-bezier(.16,1,.3,1) both;
        }

        .farius-logo {
            display:block;
            width:min(220px, 52vw);
            max-height:82px;
            object-fit:contain;
            filter:
                drop-shadow(0 15px 35px rgba(0,0,0,.5))
                drop-shadow(0 0 22px var(--accent-glow));
            transition: transform .45s cubic-bezier(.2,.9,.2,1), filter .35s ease;
        }

        .logo-image-wrap:hover .farius-logo {
            transform: translateY(-5px) scale(1.035);
            filter:
                drop-shadow(0 22px 50px rgba(0,0,0,.6))
                drop-shadow(0 0 40px var(--accent-glow));
        }

        .tagline {
            font-size: 0.72rem;
            color: var(--text-dim);
            letter-spacing: 3.5px;
            text-transform: uppercase;
            margin-bottom: 28px;
            font-weight: 600;
        }

        /* Glass search bar */
        .search-container {
            display: flex;
            align-items: center;
            max-width: 520px;
            margin: 0 auto;
            background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 6px;
            backdrop-filter: blur(24px) saturate(1.3);
            -webkit-backdrop-filter: blur(24px) saturate(1.3);
            box-shadow:
                0 20px 55px -18px var(--shadow),
                inset 0 1px 0 rgba(255,255,255,.07);
            animation: slideUp 0.6s ease;
            transition: all 0.3s;
        }

        .search-container:focus-within {
            border-color: var(--input-border-focus);
            box-shadow:
                0 0 0 4px var(--ring),
                0 20px 55px -18px var(--shadow),
                inset 0 1px 0 rgba(255,255,255,.09);
        }

        .search-input {
            flex: 1;
            border: none;
            padding: 13px 18px;
            font-size: 0.9rem;
            outline: none;
            background: transparent;
            color: var(--text);
            font-family: inherit;
        }

        .search-input::placeholder { color: var(--text-dim); }

        .search-button {
            background: linear-gradient(180deg, var(--accent), #5a6bff);
            border: none;
            border-radius: 13px;
            padding: 11px 20px;
            cursor: pointer;
            outline: none;
            color: white;
            font-size: 14px;
            font-weight: 700;
            transition: all 0.2s;
            font-family: inherit;
            box-shadow: 0 10px 30px -8px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,.2);
        }

        .search-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 15px 40px -8px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,.25);
        }
        .search-button:active { transform: scale(0.96); }

        .app-buttons {
            display: flex;
            justify-content: center;
            margin-top: 22px;
            gap: 10px;
            flex-wrap: wrap;
            animation: slideUp 0.6s ease 0.15s both;
        }

        .app-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
            backdrop-filter: blur(18px) saturate(1.2);
            -webkit-backdrop-filter: blur(18px) saturate(1.2);
            cursor: pointer;
            outline: none;
            border: 1px solid var(--card-border);
            color: var(--text);
            text-decoration: none;
            transition: all 0.25s cubic-bezier(.2,.9,.25,1.3);
            overflow: hidden;
            box-shadow: 0 6px 20px -8px var(--shadow), inset 0 1px 0 rgba(255,255,255,.05);
        }

        .app-button:hover {
            background: var(--card-hover);
            border-color: var(--card-border-hover);
            transform: translateY(-4px);
            box-shadow: 0 14px 32px -10px var(--shadow), 0 0 0 1px var(--accent-glow);
        }

        .app-button:active { transform: scale(0.9); animation: rumble 0.3s ease; }
        .app-button img { width: 24px; height: 24px; object-fit: contain; opacity: 0.92; }
        .app-button:hover img { opacity: 1; }

        #add-app-button {
            background: transparent;
            border: 1.5px dashed var(--input-border);
        }

        #add-app-button:hover {
            border-color: var(--accent);
            background: var(--card);
        }

        #add-app-button svg { stroke: var(--text) !important; }

        /* ============ BROWSER OVERLAY ============ */
        .browser-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: none;
            flex-direction: column;
            background: var(--bg);
        }

        .browser-overlay.open {
            display: flex;
            animation: browserSlideIn 0.3s ease;
        }

        /* Tabs bar */
        .tabs-bar {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 8px 12px 0;
            background: rgba(10,11,16,.7);
            backdrop-filter: blur(20px) saturate(1.2);
            -webkit-backdrop-filter: blur(20px) saturate(1.2);
            border-bottom: 1px solid var(--card-border);
            overflow-x: auto;
            flex-shrink: 0;
            scrollbar-width: none;
        }

        .tabs-bar::-webkit-scrollbar { display: none; }

        .tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px 8px 12px;
            border-radius: 10px 10px 0 0;
            background: transparent;
            border: 1px solid transparent;
            border-bottom: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 12px;
            white-space: nowrap;
            max-width: 200px;
            min-width: 90px;
            transition: all 0.18s ease;
            flex-shrink: 0;
            animation: tabIn 0.2s ease;
            position: relative;
        }

        .tab:hover {
            background: var(--card);
            color: var(--text);
        }
        .tab.active {
            background: rgba(255,255,255,.06);
            color: var(--text);
            border-color: var(--card-border);
            font-weight: 600;
            box-shadow: inset 0 2px 0 0 var(--accent);
        }

        .tab-favicon {
            width: 14px;
            height: 14px;
            border-radius: 3px;
            flex-shrink: 0;
            object-fit: contain;
            background: rgba(255,255,255,.06);
        }
        .tab-favicon-placeholder {
            width: 14px;
            height: 14px;
            border-radius: 3px;
            flex-shrink: 0;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 8px;
            font-weight: 900;
        }

        .tab-title { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }

        .tab-close {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 10px;
            opacity: 0;
            transition: all 0.15s;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .tab:hover .tab-close, .tab.active .tab-close { opacity: 1; }
        .tab-close:hover { background: rgba(220,38,38,0.22); color: #ff7b7b; }

        .new-tab-btn {
            width: 26px;
            height: 26px;
            border-radius: 8px;
            border: 1px dashed var(--input-border);
            background: transparent;
            cursor: pointer;
            color: var(--text-dim);
            font-size: 15px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 4px;
            margin-bottom: 4px;
            transition: all 0.2s;
        }

        .new-tab-btn:hover {
            border-color: var(--accent);
            color: var(--text);
            background: var(--card);
        }

        /* Toolbar */
        .browser-toolbar {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 10px 14px;
            background: rgba(15,17,24,.6);
            backdrop-filter: blur(20px) saturate(1.2);
            -webkit-backdrop-filter: blur(20px) saturate(1.2);
            border-bottom: 1px solid var(--card-border);
            flex-shrink: 0;
            box-shadow: 0 4px 20px -10px var(--shadow);
        }

        .browser-toolbar button {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            border: none;
            background: transparent;
            color: var(--text-dim-2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.18s;
        }

        .browser-toolbar button:hover:not(:disabled) {
            background: var(--card);
            color: var(--text);
        }
        .browser-toolbar button:active:not(:disabled) { transform: scale(0.94); }
        .browser-toolbar button:disabled { opacity: 0.25; cursor: not-allowed; }

        .browser-toolbar svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .browser-address {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: 18px;
            padding: 0 14px;
            height: 36px;
            transition: all 0.22s ease;
        }

        .browser-address:focus-within {
            border-color: var(--input-border-focus);
            background: var(--card);
            box-shadow: 0 0 0 4px var(--ring);
        }

        .browser-address .lock-icon {
            width: 13px;
            height: 13px;
            stroke: var(--text-dim);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
        }

        .browser-address input {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--text);
            font-size: 12.5px;
            outline: none;
            font-family: inherit;
            font-weight: 500;
        }

        .browser-address input::placeholder { color: var(--text-dim); font-weight: 400; }

        .browser-loader {
            width: 14px;
            height: 14px;
            border: 2px solid var(--card-border);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            flex-shrink: 0;
            display: none;
        }
        .browser-loader.visible { display: block; }

        .browser-frame-wrap {
            flex: 1;
            position: relative;
            background: var(--bg-2);
        }

        .browser-frame-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
            display: none;
        }

        .browser-frame-wrap iframe.visible { display: block; }

        /* New tab page — dark glass */
        .new-tab-page {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(700px 400px at 50% 0%, var(--shadow-glow), transparent 60%),
                var(--bg);
            z-index: 1;
        }

        .new-tab-page.hidden { display: none; }

        .new-tab-logo {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 10px;
            animation: logoFloat 5s ease-in-out infinite;
        }

        .new-tab-logo img {
            width: min(190px, 48vw);
            max-height: 72px;
            object-fit: contain;
            filter: drop-shadow(0 12px 30px rgba(0,0,0,.6)) drop-shadow(0 0 22px var(--accent-glow));
        }

        .new-tab-sub {
            font-size: 0.7rem;
            color: var(--text-dim);
            letter-spacing: 2.5px;
            text-transform: uppercase;
            margin-bottom: 26px;
            font-weight: 600;
        }

        .new-tab-search {
            display: flex;
            align-items: center;
            gap: 8px;
            max-width: 460px;
            width: 85%;
        }

        .new-tab-search input {
            flex: 1;
            background: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: 14px;
            padding: 13px 18px;
            color: var(--text);
            font-size: 13.5px;
            outline: none;
            font-family: inherit;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            box-shadow: 0 8px 24px -10px var(--shadow);
            transition: all 0.2s;
        }

        .new-tab-search input::placeholder { color: var(--text-dim); }

        .new-tab-search input:focus {
            border-color: var(--input-border-focus);
            background: var(--card);
            box-shadow: 0 0 0 4px var(--ring), 0 8px 24px -10px var(--shadow);
        }

        .new-tab-search button {
            background: linear-gradient(180deg, var(--accent), #5a6bff);
            border: none;
            border-radius: 14px;
            padding: 13px 22px;
            color: white;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
            font-size: 13.5px;
            transition: all 0.2s;
            box-shadow: 0 10px 30px -10px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,.2);
        }

        .new-tab-search button:hover {
            transform: translateY(-1px);
            box-shadow: 0 15px 38px -10px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,.25);
        }
        .new-tab-search button:active { transform: scale(0.96); }

        .venusFooter {
            position: fixed;
            bottom: 12px;
            right: 22px;
            color: var(--text-dim);
            font-size: 10px;
            text-decoration: none;
            z-index: 10;
            transition: color .2s;
        }
        .venusFooter:hover { color: var(--text); }

        @media (max-width: 600px) {
            .search-container { max-width: 90%; }
            .app-button { width: 42px; height: 42px; border-radius: 12px; }
            .tab { max-width: 140px; min-width: 70px; }
            .browser-toolbar { padding: 8px; gap: 3px; }
            .browser-toolbar button { width: 30px; height: 30px; }
            .browser-address { height: 32px; padding: 0 10px; }
            .farius-logo { width: min(185px,58vw); }
        }

        /* ===== FARIUM PARTICLES ===== */
        #particle-canvas { position:fixed; inset:0; width:100%; height:100%; z-index:1; pointer-events:none; opacity:.55; }
        .main-content, .topbar, .browser-overlay, .venusFooter, .farium-chat-launch, .chat-overlay { z-index: 10; }

        /* ===== FARIUM CHAT — dark glass ===== */
        .farium-chat-launch {
            position:fixed; right:22px; bottom:22px; display:flex; align-items:center; gap:8px;
            border:1px solid var(--card-border); border-radius:15px; padding:11px 15px;
            color:var(--text); background:rgba(15,17,24,.6); backdrop-filter:blur(18px) saturate(1.2);
            -webkit-backdrop-filter:blur(18px) saturate(1.2); cursor:pointer;
            box-shadow:0 14px 40px -12px var(--shadow), inset 0 1px 0 rgba(255,255,255,.05);
            transition:.25s; font:600 12px Inter,sans-serif;
        }
        .farium-chat-launch:hover {
            transform:translateY(-3px);
            border-color:var(--card-border-hover);
            background:var(--card-hover);
            box-shadow:0 18px 45px -12px var(--shadow), 0 0 0 1px var(--accent-glow);
        }
        .chat-launch-icon { color:var(--accent); font-size:13px; animation:chatPulse 1.8s infinite; }
        @keyframes chatPulse { 50% { opacity:.35; transform:scale(.72); } }
        .chat-overlay { position:fixed; inset:0; display:flex; align-items:flex-end; justify-content:flex-end; padding:22px; background:rgba(0,0,0,.55); backdrop-filter:blur(4px); opacity:0; visibility:hidden; pointer-events:none; transition:.25s; }
        .chat-overlay.open { opacity:1; visibility:visible; pointer-events:auto; }
        .chat-window {
            width:min(900px, calc(100vw - 30px)); height:min(650px, calc(100vh - 45px));
            overflow:hidden; display:flex; flex-direction:column;
            border:1px solid var(--card-border); border-radius:22px;
            background: linear-gradient(180deg, rgba(15,17,24,.92), rgba(10,11,16,.95));
            backdrop-filter:blur(24px) saturate(1.3);
            -webkit-backdrop-filter:blur(24px) saturate(1.3);
            box-shadow:0 35px 100px -20px rgba(0,0,0,.8), inset 0 1px 0 rgba(255,255,255,.06);
            transform:translateY(25px) scale(.97); transition:.35s cubic-bezier(.2,.8,.2,1);
            color: var(--text);
        }
        .chat-overlay.open .chat-window { transform:none; }
        .chat-header { height:62px; flex:none; display:flex; align-items:center; justify-content:space-between; padding:0 15px 0 18px; border-bottom:1px solid var(--card-border); background:linear-gradient(180deg,rgba(255,255,255,.03),transparent); }
        .chat-brand { display:flex; gap:10px; align-items:center; }
        .chat-brand-mark { width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;font-weight:900; box-shadow: 0 8px 20px -6px var(--accent-glow); }
        .chat-brand small,.chat-room-head small { display:block;color:var(--text-dim);font-size:10px;margin-top:2px; }
        .chat-close { border:0;background:var(--card);color:var(--text-dim-2);border-radius:10px;width:32px;height:32px;font-size:20px;cursor:pointer; transition: .2s; }
        .chat-close:hover{color:var(--text);background:var(--card-hover)}
        .chat-auth { width:min(390px,100%); margin:auto; padding:25px; }
        .chat-auth-title{font-size:25px;font-weight:800;color:var(--text)}
        .chat-auth-sub{font-size:12px;color:var(--text-dim);margin:7px 0 18px}
        .chat-tabs{display:flex;gap:4px;padding:4px;background:var(--input-bg);border-radius:11px;margin-bottom:13px; border: 1px solid var(--card-border);}
        .chat-auth-tab{flex:1;border:0;background:transparent;color:var(--text-dim);padding:9px;border-radius:8px;cursor:pointer; font-family: inherit; font-weight: 600; transition: .2s;}
        .chat-auth-tab.active{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff; box-shadow: 0 6px 16px -6px var(--accent-glow);}
        .chat-auth form{display:flex;flex-direction:column;gap:10px}
        .chat-auth input,.chat-search-row input,.chat-compose input{border:1px solid var(--input-border);background:var(--input-bg);color:var(--text);outline:none;border-radius:10px;padding:11px;font:inherit; transition: .2s;}
        .chat-auth input:focus,.chat-search-row input:focus,.chat-compose input:focus{border-color:var(--input-border-focus);background:var(--card);box-shadow:0 0 0 4px var(--ring)}
        .chat-primary,.chat-compose button{border:0;border-radius:10px;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;padding:11px;font-weight:800;cursor:pointer; font-family: inherit; transition: .2s; box-shadow: 0 10px 24px -8px var(--accent-glow);}
        .chat-primary:hover,.chat-compose button:hover{transform: translateY(-1px); box-shadow: 0 14px 30px -8px var(--accent-glow);}
        .chat-error{min-height:15px;color:#ff7b7b;font-size:11px}
        .avatar-picker label{display:block;color:var(--text-dim);font-size:11px;margin:4px 0 8px}
        .avatar-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px}
        .avatar-choice{height:45px;border-radius:12px;border:1px solid var(--input-border);cursor:pointer;color:#fff;font-weight:900; transition: .2s;}
        .avatar-choice.selected{border-color:var(--accent);box-shadow:0 0 0 2px var(--ring)}
        .avatar-choice[data-avatar="red"]{background:#111}
        .avatar-choice[data-avatar="black"]{background:#000}
        .avatar-choice[data-avatar="white"]{background:#eee;color:#111}
        .avatar-choice[data-avatar="crimson"]{background:linear-gradient(135deg,#7a1530,#3a0812)}
        .avatar-choice[data-avatar="ember"]{background:linear-gradient(135deg,#7a3315,#3a1808)}
        .avatar-choice[data-avatar="mono"]{background:linear-gradient(135deg,var(--accent),var(--accent-2))}
        .chat-app{display:grid;grid-template-columns:250px 1fr;min-height:0;flex:1}
        .chat-sidebar{border-right:1px solid var(--card-border);padding:12px;display:flex;flex-direction:column;min-width:0}
        .chat-me{padding:10px;border-radius:12px;background:var(--card);margin-bottom:9px; border: 1px solid var(--card-border);}
        .chat-user-card{display:flex;align-items:center;gap:8px;padding:8px;border-radius:9px; transition: .2s;}
        .chat-user-card:hover{background:var(--card)}
        .chat-avatar{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;font-weight:900;color:#fff;flex:none; box-shadow: 0 4px 12px -4px rgba(0,0,0,.6);}
        .chat-search-row{display:flex;gap:5px}
        .chat-search-row input{width:100%;padding:8px}
        .chat-search-row button{width:34px;border:0;border-radius:9px;background:var(--card);color:var(--text);cursor:pointer; transition: .2s;}
        .chat-search-row button:hover{background:var(--card-hover)}
        .chat-section-title{font-size:9px;text-transform:uppercase;letter-spacing:1.4px;color:var(--text-dim);margin:15px 5px 7px}
        .chat-friends,.chat-results{overflow:auto}
        .friend-add{margin-left:auto;border:0;border-radius:7px;background:var(--card);color:var(--text);padding:5px 7px;cursor:pointer; transition: .2s;}
        .friend-add:hover{background:var(--card-hover)}
        .chat-logout{margin-top:auto;border:1px solid var(--input-border);background:transparent;color:var(--text-dim);border-radius:9px;padding:8px;cursor:pointer; transition: .2s;}
        .chat-logout:hover{color:var(--text);background:var(--card)}
        .chat-main{min-width:0;display:flex;flex-direction:column}
        .chat-room-head{height:56px;flex:none;padding:0 17px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--card-border);color:var(--text)}
        .online-dot{width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 0 12px var(--accent-glow)}
        .chat-messages{flex:1;overflow:auto;padding:16px}
        .chat-message{display:flex;gap:9px;margin-bottom:13px;animation:chatMessageIn .2s ease}
        .chat-message .chat-avatar{width:32px;height:32px}
        .chat-message-body{min-width:0}
        .chat-message-name{font-size:11px;font-weight:800;color:var(--text)}
        .chat-message-time{font-size:8px;color:var(--text-dim);margin-left:6px}
        .chat-message-text{margin-top:3px;color:var(--text-dim-2);font-size:12px;line-height:1.5;white-space:pre-wrap;word-break:break-word}
        .chat-compose{display:flex;gap:8px;padding:12px;border-top:1px solid var(--card-border)}
        .chat-compose input{flex:1}
        .chat-compose button{padding:0 17px}
        @keyframes chatMessageIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
        @media(max-width:700px){.chat-overlay{padding:8px}.chat-window{width:100%;height:calc(100vh - 16px);border-radius:18px}.chat-app{grid-template-columns:1fr}.chat-sidebar{display:none}.farium-chat-launch{right:14px;bottom:14px}.chat-compose button{padding:0 12px}}
    </style>
</head>
<body>
    <canvas id="particle-canvas" aria-hidden="true"></canvas>

    <!-- TOPBAR -->
    <div class="topbar">
        <a href="/" class="active" title="Home">
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
