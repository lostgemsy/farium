<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xylara - Settings</title>
    <script src="https://app.rybbit.io/api/script.js" data-site-id="8b65ec526edf" defer></script>
    <link rel="icon" type="image/gif" href="/logo.gif">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #0a0f0a;
            --bg-2: #0f150f;
            --bg-3: #141c14;
            --text: #e8f0e8;
            --text-dim: rgba(180, 220, 180, 0.55);
            --text-dim-2: rgba(200, 235, 200, 0.82);
            --card: rgba(30, 50, 30, 0.32);
            --card-hover: rgba(50, 80, 50, 0.45);
            --card-border: rgba(120, 200, 120, 0.18);
            --card-border-hover: rgba(140, 240, 140, 0.45);
            --input-bg: rgba(10, 20, 10, 0.45);
            --input-border: rgba(120, 200, 120, 0.22);
            --input-border-focus: rgba(140, 240, 140, 0.65);
            --shadow: rgba(0, 0, 0, 0.85);
            --accent: #5cb85c;
            --accent-2: #3a9e3a;
            --accent-glow: rgba(92, 184, 92, 0.35);
            --ring: rgba(92, 184, 92, 0.25);

            --bg-scale: 1;
            --bg-pos-x: 50%;
            --bg-pos-y: 50%;
        }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes slideRight { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes popIn { from { opacity: 0; transform: scale(.95); } to { opacity: 1; transform: scale(1); } }
        @keyframes logoDrop {
            0% { opacity:0; transform:translateY(-40px) scale(.8); }
            70% { opacity:1; transform:translateY(4px) scale(1.02); }
            100% { opacity:1; transform:none; }
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        html {
            min-height: 100%;
            background: #0a0f0a;
        }

        body {
            color: var(--text);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            position: relative;
            overflow-x: hidden;

            background-color: #0a0f0a;
            background-image: url('/public/background.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            isolation: isolate;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background:
                linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.55) 100%),
                radial-gradient(900px 600px at 50% 40%, rgba(92, 184, 92, 0.06), transparent 70%);
            transition: background 0.2s ease;
        }

        /* ============ SETTINGS WRAPPER ============ */
        .settings-wrapper {
            position: relative;
            z-index: 2;
            width: min(100%, 780px);
            padding: 40px 22px 60px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-right: 180px;
            max-width: 860px;
            transition: margin-right 0.3s cubic-bezier(0.22, 0.98, 0.36, 1);
        }

        .side-dock.collapsed ~ .settings-wrapper {
            margin-right: 60px;
        }

        .logo-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            animation: logoDrop .6s cubic-bezier(.16,1,.3,1) both;
        }

        .farius-logo {
            height: auto;
            width: auto;
            max-height: 90px;
            max-width: 240px;
            object-fit: contain;
            transition: transform 0.3s ease;
            filter: drop-shadow(0 8px 32px rgba(92, 184, 92, 0.25));
        }
        .farius-logo:hover {
            transform: scale(1.05) translateY(-3px);
            filter: drop-shadow(0 12px 40px rgba(92, 184, 92, 0.4));
        }

        .logo-fallback {
            display: none;
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: 6px;
            text-transform: uppercase;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .page-title {
            text-align: center;
            margin: 0 4px 6px;
            font-size: clamp(1.8rem, 5vw, 2.35rem);
            font-weight: 800;
            letter-spacing: -1px;
            animation: slideUp 0.4s 0.05s ease both;
            background: linear-gradient(180deg, #ffffff, #a8d8a8);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.4));
        }

        .page-subtitle {
            text-align: center;
            margin: -8px 4px 12px;
            color: var(--text-dim);
            font-size: 0.86rem;
            letter-spacing: 0.3px;
            font-weight: 500;
            animation: slideUp 0.4s 0.1s ease both;
        }

        /* ============ SETTING CARD ============ */
        .settings-container {
            position: relative;
            background: rgba(20, 40, 20, 0.35);
            backdrop-filter: blur(28px) saturate(140%);
            -webkit-backdrop-filter: blur(28px) saturate(140%);
            padding: 24px 26px;
            border-radius: 20px;
            border: 1px solid rgba(120, 200, 120, 0.18);
            box-shadow: 0 12px 32px -16px var(--shadow), inset 0 1px rgba(255, 255, 255, 0.05);
            animation: slideUp 0.4s ease both;
            transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
        }

        .settings-container::before {
            content: '';
            position: absolute;
            top: 12px;
            bottom: 12px;
            left: 0;
            width: 2px;
            background: linear-gradient(180deg, var(--accent), var(--accent-2) 60%, transparent);
            border-top-left-radius: 2px;
            border-bottom-left-radius: 2px;
            opacity: 0.6;
            transition: opacity 0.25s ease;
        }

        .settings-container:hover {
            border-color: var(--card-border-hover);
            background: rgba(30, 60, 30, 0.45);
            transform: translateY(-2px);
        }
        .settings-container:hover::before { opacity: 1; }

        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            min-height: 40px;
            margin-bottom: 14px;
        }
        .setting-item:last-child { margin-bottom: 0; }

        .setting-item label {
            font-size: 0.82rem;
            margin-right: 10px;
            color: var(--text);
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .setting-item select,
        .setting-item input[type="text"] {
            min-height: 40px;
            border-radius: 12px;
            border: 1.5px solid rgba(120, 200, 120, 0.22);
            background: rgba(10, 25, 10, 0.5);
            color: var(--text);
            font-size: 0.8rem;
            font-family: inherit;
            font-weight: 500;
            outline: none;
            transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .setting-item select {
            min-width: 160px;
            padding: 8px 34px 8px 13px;
            cursor: pointer;
        }

        .setting-item input[type="text"] {
            width: 245px;
            padding: 8px 13px;
        }

        .setting-item select:hover,
        .setting-item input[type="text"]:hover {
            border-color: rgba(140, 240, 140, 0.45);
            background: rgba(20, 45, 20, 0.55);
        }

        .setting-item select:focus,
        .setting-item input[type="text"]:focus {
            border-color: rgba(140, 240, 140, 0.65);
            background: rgba(25, 55, 25, 0.6);
            box-shadow: 0 0 0 4px rgba(92, 184, 92, 0.15);
        }

        .setting-item select option {
            background-color: #0f1a0f;
            color: var(--text);
        }

        .setting-item input::placeholder {
            color: var(--text-dim);
        }

        /* ============ BACKGROUND PICKER ============ */
        .bg-section-title {
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: var(--text-dim);
            margin: 4px 0 14px;
        }

        .bg-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 12px;
        }

        .bg-card {
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 8px;
            border-radius: 14px;
            border: 1.5px solid rgba(120, 200, 120, 0.15);
            background: rgba(10, 25, 10, 0.45);
            cursor: pointer;
            transition: border-color .2s ease, background .2s ease, transform .2s ease;
            text-align: left;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .bg-card:hover {
            border-color: rgba(140, 240, 140, 0.45);
            background: rgba(30, 60, 30, 0.5);
            transform: translateY(-2px);
        }
        .bg-card.selected {
            border-color: var(--accent);
            background: rgba(60, 120, 60, 0.35);
            box-shadow: 0 0 0 3px rgba(92, 184, 92, 0.2);
        }

        .bg-thumb {
            width: 100%;
            aspect-ratio: 16 / 9;
            border-radius: 10px;
            background: #0a0f0a;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
        }

        .bg-name {
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--text);
            padding: 0 2px;
            line-height: 1.3;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .bg-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 3px 8px;
            border-radius: 6px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            color: #fff;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            opacity: 0;
            transition: opacity .2s ease;
            pointer-events: none;
        }
        .bg-card.selected .bg-badge { opacity: 1; }

        .bg-actions-row {
            display: flex;
            gap: 10px;
            margin-top: 14px;
            flex-wrap: wrap;
        }
        .bg-reset,
        .bg-adjust {
            flex: 1;
            padding: 12px 16px;
            border-radius: 12px;
            border: 1.5px solid rgba(120, 200, 120, 0.22);
            background: rgba(10, 25, 10, 0.5);
            color: var(--text);
            font-family: inherit;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform .15s ease, background .15s ease, border-color .15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .bg-reset:hover,
        .bg-adjust:hover {
            transform: translateY(-1px);
            background: rgba(30, 60, 30, 0.5);
            border-color: rgba(140, 240, 140, 0.45);
        }
        .bg-adjust {
            background: linear-gradient(135deg, rgba(92, 184, 92, 0.25), rgba(58, 158, 58, 0.15));
            border-color: rgba(120, 200, 120, 0.35);
        }
        .bg-adjust:hover {
            background: linear-gradient(135deg, rgba(92, 184, 92, 0.4), rgba(58, 158, 58, 0.3));
        }
        .bg-adjust svg, .bg-reset svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ============ BACKGROUND EDITOR (HUD) ============ */
        .bg-editor-overlay {
            position: fixed;
            inset: 0;
            z-index: 25000;
            background: rgba(5, 12, 5, 0.7);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 24px;
            animation: fadeIn .25s ease;
            backdrop-filter: blur(32px) saturate(140%);
            -webkit-backdrop-filter: blur(32px) saturate(140%);
        }
        .bg-editor-overlay.open { display: flex; }

        .bg-editor {
            width: min(100%, 900px);
            background: rgba(20, 40, 20, 0.5);
            backdrop-filter: blur(40px) saturate(140%);
            -webkit-backdrop-filter: blur(40px) saturate(140%);
            border: 1.5px solid rgba(120, 200, 120, 0.2);
            border-radius: 20px;
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            animation: popIn .3s cubic-bezier(.2,.9,.25,1.15);
            box-shadow: 0 30px 80px -20px rgba(0,0,0,.9), inset 0 1px rgba(255, 255, 255, 0.05);
        }

        .bg-editor-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }
        .bg-editor-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--text);
            letter-spacing: -0.3px;
        }
        .bg-editor-sub {
            font-size: 0.75rem;
            color: var(--text-dim);
            margin-top: 3px;
        }
        .bg-editor-close {
            width: 34px; height: 34px;
            border-radius: 10px;
            border: 1.5px solid rgba(120, 200, 120, 0.22);
            background: rgba(10, 25, 10, 0.5);
            color: var(--text);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: background .15s ease, transform .15s ease;
        }
        .bg-editor-close:hover {
            background: rgba(40, 80, 40, 0.5);
            transform: rotate(90deg);
        }

        .bg-editor-preview {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            border-radius: 14px;
            overflow: hidden;
            background-color: #0a0f0a;
            background-image: none;
            background-size: calc(100% * var(--preview-scale, 1));
            background-position: var(--preview-x, 50%) var(--preview-y, 50%);
            background-repeat: no-repeat;
            cursor: grab;
            user-select: none;
            border: 1px solid rgba(120, 200, 120, 0.15);
            touch-action: none;
        }
        .bg-editor-preview.dragging { cursor: grabbing; }

        .bg-editor-preview::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-image:
                linear-gradient(to right, rgba(120, 200, 120, 0.08) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(120, 200, 120, 0.08) 1px, transparent 1px);
            background-size: 8.333% 8.333%;
            z-index: 1;
        }
        .bg-editor-preview::after {
            content: '';
            position: absolute;
            top: 50%; left: 50%;
            width: 40px; height: 40px;
            transform: translate(-50%, -50%);
            border: 1px solid rgba(92, 184, 92, 0.5);
            border-radius: 50%;
            pointer-events: none;
            z-index: 2;
            box-shadow: 0 0 20px rgba(92, 184, 92, 0.3);
        }

        .bg-editor-preview-hint {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(10, 25, 10, 0.7);
            border: 1px solid rgba(120, 200, 120, 0.2);
            border-radius: 10px;
            padding: 6px 12px;
            font-size: 11px;
            color: var(--text-dim-2);
            letter-spacing: .3px;
            pointer-events: none;
            z-index: 3;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .bg-editor-controls {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .bg-editor-control {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .bg-editor-control-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8rem;
            color: var(--text-dim-2);
            font-weight: 600;
        }
        .bg-editor-control-value {
            color: var(--accent);
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .bg-editor-slider {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 6px;
            border-radius: 3px;
            background: rgba(120, 200, 120, 0.15);
            outline: none;
            cursor: pointer;
        }
        .bg-editor-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px; height: 18px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            cursor: pointer;
            box-shadow: 0 0 0 3px rgba(92, 184, 92, 0.25), 0 4px 12px -4px rgba(0,0,0,.8);
            transition: transform .15s ease;
        }
        .bg-editor-slider::-webkit-slider-thumb:hover { transform: scale(1.1); }
        .bg-editor-slider::-moz-range-thumb {
            width: 18px; height: 18px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border: none;
            cursor: pointer;
            box-shadow: 0 0 0 3px rgba(92, 184, 92, 0.25), 0 4px 12px -4px rgba(0,0,0,.8);
        }

        .bg-editor-actions {
            display: flex;
            gap: 10px;
            margin-top: 6px;
            padding-top: 16px;
            border-top: 1px solid rgba(120, 200, 120, 0.12);
        }
        .bg-editor-btn {
            flex: 1;
            padding: 12px 18px;
            border-radius: 12px;
            border: 1.5px solid rgba(120, 200, 120, 0.22);
            background: rgba(10, 25, 10, 0.5);
            color: var(--text);
            font-family: inherit;
            font-size: 0.84rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform .15s ease, background .15s ease;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .bg-editor-btn:hover {
            transform: translateY(-1px);
            background: rgba(30, 60, 30, 0.5);
        }
        .bg-editor-btn.primary {
            background: linear-gradient(180deg, #5cb85c, #3a8e3a);
            border-color: rgba(120, 200, 120, 0.4);
            color: #fff;
            box-shadow: 0 10px 26px -10px var(--accent-glow);
        }
        .bg-editor-btn.primary:hover {
            box-shadow: 0 14px 32px -10px var(--accent-glow);
            filter: brightness(1.08);
        }

        /* ============ DARKNESS SLIDER ============ */
        .darkness-row {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 8px;
        }
        .darkness-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }
        .darkness-header label {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text);
            letter-spacing: 0.3px;
        }
        .darkness-value {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--accent);
            font-variant-numeric: tabular-nums;
            min-width: 48px;
            text-align: right;
        }
        .darkness-slider {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 6px;
            border-radius: 3px;
            background: linear-gradient(90deg, #000 0%, #000 100%);
            outline: none;
            cursor: pointer;
        }
        .darkness-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            cursor: pointer;
            box-shadow: 0 0 0 3px rgba(92, 184, 92, 0.25), 0 4px 12px -4px rgba(0,0,0,.8);
            transition: transform .15s ease;
        }
        .darkness-slider::-webkit-slider-thumb:hover { transform: scale(1.1); }
        .darkness-slider::-moz-range-thumb {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border: none;
            cursor: pointer;
            box-shadow: 0 0 0 3px rgba(92, 184, 92, 0.25), 0 4px 12px -4px rgba(0,0,0,.8);
            transition: transform .15s ease;
        }
        .darkness-slider::-moz-range-thumb:hover { transform: scale(1.1); }

        .darkness-ticks {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-dim);
            letter-spacing: 0.3px;
        }

        /* ============ ACTION BAR ============ */
        .action-bar {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 26px;
            padding-top: 22px;
            border-top: 1px solid rgba(120, 200, 120, 0.12);
            animation: slideUp 0.4s 0.25s ease both;
            flex-wrap: wrap;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 13px 28px;
            border-radius: 14px;
            background: rgba(20, 40, 20, 0.4);
            backdrop-filter: blur(20px) saturate(140%);
            -webkit-backdrop-filter: blur(20px) saturate(140%);
            border: 1.5px solid rgba(120, 200, 120, 0.22);
            color: var(--text);
            font-family: inherit;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            cursor: pointer;
            text-decoration: none;
            transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
            box-shadow: 0 8px 22px -12px var(--shadow);
        }

        .action-btn svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform 0.25s ease;
        }

        .action-btn:hover {
            background: linear-gradient(180deg, #5cb85c, #3a8e3a);
            border-color: rgba(120, 200, 120, 0.4);
            color: #ffffff;
            transform: translateY(-3px);
            box-shadow: 0 14px 36px -12px var(--accent-glow);
        }

        .action-btn:hover svg { transform: translateX(-3px); }
        .action-btn:active { transform: translateY(-1px) scale(0.98); }

        /* ============ RIGHT SIDE PANEL (matching main page) ============ */
        .side-dock {
            position: fixed;
            top: 0;
            bottom: 0;
            right: 0;
            z-index: 100;
            width: 180px;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            justify-content: center;
            gap: 6px;
            padding: 20px 12px;
            background: rgba(15, 30, 15, 0.55);
            border-left: 1px solid rgba(120, 200, 120, 0.15);
            animation: slideRight 0.45s cubic-bezier(0.22, 0.98, 0.36, 1) both;
            backdrop-filter: blur(28px) saturate(140%);
            -webkit-backdrop-filter: blur(28px) saturate(140%);
            transition: width 0.3s cubic-bezier(0.22, 0.98, 0.36, 1);
            box-shadow: -8px 0 32px rgba(0, 0, 0, 0.5);
        }
        .side-dock::before {
            content: "";
            position: absolute;
            left: 0;
            top: 18%;
            bottom: 18%;
            width: 2px;
            background: linear-gradient(180deg, transparent, var(--accent), var(--accent-2), transparent);
            opacity: 0.7;
            pointer-events: none;
            border-radius: 2px;
        }

        .dock-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 6px 10px;
            border-bottom: 1px solid rgba(120, 200, 120, 0.12);
            margin-bottom: 6px;
        }
        .dock-header span {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.6px;
            color: var(--text-dim);
            font-weight: 700;
        }
        .dock-collapse-btn {
            background: transparent;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 16px;
            line-height: 1;
            padding: 4px 8px;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .dock-collapse-btn:hover {
            background: var(--card-hover);
            color: var(--text);
        }

        .dock-items {
            display: flex;
            flex-direction: column;
            gap: 6px;
            overflow-y: auto;
            overflow-x: hidden;
            flex: 1;
            padding-right: 2px;
        }
        .dock-items::-webkit-scrollbar {
            width: 4px;
        }
        .dock-items::-webkit-scrollbar-thumb {
            background: rgba(120, 200, 120, 0.2);
            border-radius: 4px;
        }

        .dock-item {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            height: 44px;
            padding: 0 12px;
            border-radius: 16px;
            text-decoration: none;
            color: var(--text-dim-2);
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.3px;
            background: transparent;
            border: 1px solid transparent;
            transition: all 0.25s cubic-bezier(0.22, 0.98, 0.36, 1);
            cursor: pointer;
            will-change: transform;
            font-family: inherit;
            flex-shrink: 0;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        .dock-item .label {
            flex: 1;
            text-align: left;
        }
        .dock-item svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.9;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
            transition: stroke 0.2s ease, transform 0.25s ease;
        }
        .dock-item:hover {
            color: var(--text);
            background: rgba(50, 100, 50, 0.35);
            border-color: rgba(140, 240, 140, 0.45);
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 12px 28px -12px var(--shadow);
        }
        .dock-item:hover svg {
            stroke: var(--accent);
            transform: scale(1.1);
        }
        .dock-item:active {
            transform: translateY(-1px) scale(1.01);
        }
        .dock-item.active {
            color: var(--text);
            background: rgba(60, 120, 60, 0.3);
            border-color: rgba(120, 200, 120, 0.35);
        }
        .dock-item.games-btn {
            background: linear-gradient(135deg, rgba(60, 140, 60, 0.3), rgba(40, 100, 40, 0.2));
            border: 1px solid rgba(120, 200, 120, 0.35);
            color: var(--text);
        }
        .dock-item.games-btn svg {
            stroke: var(--accent);
        }
        .dock-item.games-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border-color: transparent;
            color: #fff;
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 14px 32px -10px var(--accent-glow);
        }
        .dock-item.games-btn:hover svg {
            stroke: #fff;
        }

        .dock-sep {
            height: 1px;
            margin: 6px 8px;
            background: linear-gradient(90deg, transparent, rgba(120, 200, 120, 0.2), transparent);
            flex-shrink: 0;
        }

        .side-dock.collapsed {
            width: 60px;
            padding: 20px 6px;
            align-items: center;
        }
        .side-dock.collapsed .dock-header span,
        .side-dock.collapsed .dock-item .label,
        .side-dock.collapsed .dock-sep {
            display: none;
        }
        .side-dock.collapsed .dock-header {
            border-bottom: none;
            padding: 0 0 8px;
            justify-content: center;
        }
        .side-dock.collapsed .dock-collapse-btn {
            font-size: 18px;
        }
        .side-dock.collapsed .dock-item {
            justify-content: center;
            padding: 0;
            width: 44px;
            height: 44px;
        }
        .side-dock.collapsed .dock-item svg {
            width: 20px;
            height: 20px;
        }
        .side-dock.collapsed .dock-item .label {
            display: none;
        }

        /* ============ PAGE SLIDE ============ */
        .page-slide {
            position: fixed;
            inset: 0;
            z-index: 30000;
            background: #0a0f0a;
            transform: translateX(100%);
            transition: transform .45s cubic-bezier(.65, 0, .35, 1);
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
            will-change: transform;
        }

        .page-slide::after {
            content: "";
            width: 40px;
            height: 40px;
            border: 3px solid rgba(120, 200, 120, 0.2);
            border-top-color: var(--accent);
            border-radius: 50%;
            opacity: 0;
        }

        .page-slide.active {
            transform: translateX(0);
            pointer-events: auto;
        }
        .page-slide.active::after {
            opacity: 1;
            animation: spin .8s linear infinite;
        }
        .page-slide.enter { transform: translateX(0); transition: none; }
        .page-slide.enter.leaving {
            transform: translateX(-100%);
            transition: transform .45s cubic-bezier(.65, 0, .35, 1);
        }

        /* ============ MOBILE ============ */
        @media (max-width: 720px) {
            .side-dock { width: 68px; padding: 16px 8px; gap: 6px; }
            .dock-item { height: 46px; padding: 0; justify-content: center; gap: 0; }
            .dock-item .label { display: none; }
            .dock-item svg { width: 21px; height: 21px; }
            .settings-wrapper { margin-right: 68px; padding: 30px 14px 40px; gap: 13px; }
            .side-dock.collapsed ~ .settings-wrapper { margin-right: 60px; }
            .farius-logo { max-height: 60px; max-width: 180px; }
            .settings-container { padding: 17px 18px; border-radius: 18px; }
            .setting-item { gap: 12px; }
            .setting-item label { font-size: 0.76rem; }
            .setting-item select { min-width: 132px; max-width: 52%; padding-left: 10px; padding-right: 25px; }
            .setting-item input[type="text"] { width: 52%; min-width: 0; }
            #custom-wisp-server-container { align-items: flex-start; }
            .action-bar { gap: 8px; }
            .action-btn { padding: 11px 20px; font-size: 0.8rem; }
            .bg-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; }
            .bg-editor { padding: 16px; }
            .bg-editor-preview-hint { font-size: 10px; padding: 4px 8px; }
        }

        @media (max-width: 360px) {
            .setting-item { align-items: flex-start; flex-direction: column; }
            .setting-item select,
            .setting-item input[type="text"] { width: 100%; max-width: none; }
            .bg-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>

    <div class="settings-wrapper">

        <div class="logo-area">
            <img src="/logo.gif" alt="Farius" class="farius-logo"
                 onerror="this.style.display='none'; document.querySelector('.logo-fallback').style.display='block';">
            <div class="logo-fallback">Farius</div>
        </div>

        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Configure your browsing experience</p>

        <!-- ============ PROXY TYPE ============ -->
        <div class="settings-container" style="animation-delay: 0.1s;">
            <div class="setting-item">
                <label for="type">Proxy Type</label>
                <select id="type">
                    <option value="ultraviolet">Ultraviolet</option>
                    <option value="scramjet">Scramjet</option>
                </select>
            </div>
        </div>

        <!-- ============ SEARCH ENGINE ============ -->
        <div class="settings-container" style="animation-delay: 0.15s;">
            <div class="setting-item">
                <label for="search-engine">Search Engine</label>
                <select id="search-engine">
                    <option value="https://duckduckgo.com/?q=">DuckDuckGo</option>
                    <option value="https://www.bing.com/search?q=">Bing</option>
                    <option value="https://search.brave.com/search?q=">Brave</option>
                    <option value="https://www.google.com/search?q=">Google</option>
                    <option value="https://www.ecosia.org/search?q=">Ecosia</option>
                </select>
            </div>
        </div>

        <!-- ============ TRANSPORT ============ -->
        <div class="settings-container" style="animation-delay: 0.2s;">
            <div class="setting-item">
                <label for="transport-type">Transport</label>
                <select id="transport-type">
                    <option value="libcurl">Libcurl</option>
                    <option value="epoxy">Epoxy</option>
                </select>
            </div>
        </div>

        <!-- ============ WISP SERVER ============ -->
        <div class="settings-container" style="animation-delay: 0.25s;">
            <div class="setting-item">
                <label for="wisp-server-type">Wisp Server</label>
                <select id="wisp-server-type">
                    <option value="default">Default</option>
                    <option value="custom">Custom</option>
                </select>
            </div>
            <div class="setting-item" id="custom-wisp-server-container" style="display: none;">
                <label for="custom-wisp-server-input">Custom Wisp URL</label>
                <input type="text" id="custom-wisp-server-input" placeholder="wss://your-wisp.com/wisp/">
            </div>
        </div>

        <!-- ============ ACTION BAR ============ -->
        <div class="action-bar">
            <a href="/" class="action-btn">
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
                Back to Home
            </a>
        </div>

    </div>

    <!-- ============ RIGHT SIDE PANEL (matching main page) ============ -->
    <nav class="side-dock" id="sideDock" aria-label="Site navigation">
        <div class="dock-header">
            <span>Menu</span>
            <button class="dock-collapse-btn" id="dockCollapseBtn" title="Collapse/Expand">◀</button>
        </div>
        <div class="dock-items" id="dockItems">
            <a href="/" class="dock-item" data-dock-id="home" title="Home">
                <span class="label">Home</span>
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
            </a>
            <a href="/settings" class="dock-item active" data-dock-id="settings" title="Settings">
                <span class="label">Settings</span>
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
            </a>
            <div class="dock-sep" data-sep-id="sep1"></div>
            <a href="/gnmath.html" class="dock-item games-btn" id="gamesBtn" data-dock-id="games" title="Play Games">
                <span class="label">Games</span>
                <svg viewBox="0 0 24 24">
                    <rect x="2" y="6" width="20" height="12" rx="3"/>
                    <path d="M6 12h4M8 10v4M15 11h.01M17.5 13h.01"/>
                </svg>
            </a>
        </div>
    </nav>

    <div class="page-slide" id="pageSlide"></div>

    <script>
        /* ============================================================
           BACKGROUNDS — real filenames
           ============================================================ */
        const BG_BASE = '/assets/backgrounds/';

        const BACKGROUNDS = [
            { name: 'Foggy Forest',       file: 'foggy-forest.png' },
            { name: 'Mountain Guy',       file: 'mountainguy.png' },
            { name: 'Mountain Guy 2',     file: 'MountainGuy2.png' },
            { name: 'Carry Sunset',       file: 'VinlandSagaThorfinn.png' },
            { name: 'Fallen Knight',      file: 'FallenKnight.png' },
            { name: 'Floating Tree',      file: 'floating-tree.png' },
            { name: 'Touching Hands',     file: 'TouchingHands.png' },
            { name: 'End of the World',   file: 'end-of-the-world.png' },
            { name: 'Dwelling Cat',       file: 'DwrellingCat.png' },
            { name: 'Vega Bong',          file: 'VegaBong.png' },
            { name: 'Backgroundly 2',     file: 'backgroundly2.png' }
        ];

        const DEFAULT_BG = '/public/background.png';
        const DEFAULT_DARKNESS = 72;
        const DEFAULT_SCALE = 1;
        const DEFAULT_X = 50;
        const DEFAULT_Y = 50;

        /* ============ SETTINGS LOGIC ============ */
        document.addEventListener('DOMContentLoaded', () => {

            /* ---------- SIDE DOCK COLLAPSE ---------- */
            (function initDock() {
                const dock = document.getElementById('sideDock');
                const collapseBtn = document.getElementById('dockCollapseBtn');
                const settingsWrapper = document.querySelector('.settings-wrapper');

                let collapsed = localStorage.getItem('dockCollapsed') === 'true';
                if (collapsed) dock.classList.add('collapsed');

                function updateMargin() {
                    if (settingsWrapper) {
                        settingsWrapper.style.marginRight = collapsed ? '60px' : '180px';
                    }
                }

                collapseBtn.addEventListener('click', () => {
                    collapsed = !collapsed;
                    dock.classList.toggle('collapsed', collapsed);
                    localStorage.setItem('dockCollapsed', collapsed);
                    collapseBtn.textContent = collapsed ? '▶' : '◀';
                    updateMargin();
                });
                if (collapsed) {
                    collapseBtn.textContent = '▶';
                    updateMargin();
                }
            })();

            /* ---------- PAGE SLIDE ENTER ---------- */
            (function () {
                const slide = document.getElementById("pageSlide");
                if (sessionStorage.getItem("slideFrom")) {
                    sessionStorage.removeItem("slideFrom");
                    slide.classList.add("enter");
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            slide.classList.add("leaving");
                        });
                    });
                    setTimeout(() => {
                        slide.classList.remove("enter", "leaving");
                    }, 600);
                }
            })();

            /* ---------- PAGE SLIDE EXIT ---------- */
            const gamesBtn = document.getElementById("gamesBtn");
            if (gamesBtn) {
                gamesBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    const slide = document.getElementById("pageSlide");
                    slide.classList.add("active");
                    sessionStorage.setItem("slideFrom", "true");
                    setTimeout(() => {
                        window.location.href = "/gnmath.html";
                    }, 500);
                });
            }

            /* ---------- PROXY TYPE ---------- */
            const proxyTypeSelect = document.getElementById('type');
            if (!localStorage.getItem('proxy')) localStorage.setItem('proxy', 'ultraviolet');
            proxyTypeSelect.value = localStorage.getItem('proxy');
            proxyTypeSelect.addEventListener('change', (event) => localStorage.setItem('proxy', event.target.value));

            /* ---------- SEARCH ENGINE ---------- */
            const searchEngineSelect = document.getElementById('search-engine');
            if (!localStorage.getItem('search')) localStorage.setItem('search', 'https://duckduckgo.com/?q=');
            searchEngineSelect.value = localStorage.getItem('search');
            searchEngineSelect.addEventListener('change', (event) => localStorage.setItem('search', event.target.value));

            /* ---------- TRANSPORT ---------- */
            const transportTypeSelect = document.getElementById('transport-type');
            if (!localStorage.getItem('transport')) localStorage.setItem('transport', 'libcurl');
            transportTypeSelect.value = localStorage.getItem('transport');
            transportTypeSelect.addEventListener('change', (event) => localStorage.setItem('transport', event.target.value));

            /* ---------- WISP SERVER ---------- */
            const wispServerTypeSelect = document.getElementById('wisp-server-type');
            const customWispServerContainer = document.getElementById('custom-wisp-server-container');
            const customWispServerInput = document.getElementById('custom-wisp-server-input');
            const defaultWispUrl = `wss://${window.location.host}/wisp/`;

            if (!localStorage.getItem('wisp')) localStorage.setItem('wisp', defaultWispUrl);

            const currentWispUrl = localStorage.getItem('wisp');
            if (currentWispUrl === defaultWispUrl) {
                wispServerTypeSelect.value = 'default';
                customWispServerInput.value = '';
            } else {
                wispServerTypeSelect.value = 'custom';
                customWispServerInput.value = currentWispUrl;
            }

            const updateWispServerVisibility = () => {
                if (wispServerTypeSelect.value === 'custom') {
                    customWispServerContainer.style.display = 'flex';
                } else {
                    customWispServerContainer.style.display = 'none';
                }
            };
            updateWispServerVisibility();

            wispServerTypeSelect.addEventListener('change', (event) => {
                const selectedType = event.target.value;
                if (selectedType === 'default') localStorage.setItem('wisp', defaultWispUrl);
                else localStorage.setItem('wisp', customWispServerInput.value);
                updateWispServerVisibility();
            });

            customWispServerInput.addEventListener('input', (event) => {
                if (wispServerTypeSelect.value === 'custom') localStorage.setItem('wisp', event.target.value);
            });

            const savedFont = localStorage.getItem('font');
            if (savedFont) document.body.style.fontFamily = savedFont;
        });
    </script>
</body>
</html>