        /* === Dragging === */
        function makeDraggable(win, handle, winId) {
            let startX, startY, startLeft, startTop;
            let isDragging = false;
            let snapSide = null;

            function onDown(e) {
                if (e.target.closest('.os-window-control')) return;
                if (e.target.closest('.os-resize-handle')) return;
                if (win.classList.contains('maximized')) return;
                e.preventDefault();
                const rect = win.getBoundingClientRect();
                startX = e.clientX;
                startY = e.clientY;
                startLeft = rect.left;
                startTop = rect.top;
                isDragging = true;
                document.addEventListener('mousemove', onMove);
                document.addEventListener('mouseup', onUp);
            }

            function onMove(e) {
                if (!isDragging) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                const newLeft = startLeft + dx;
                const newTop = Math.max(0, startTop + dy);

                const preview = document.getElementById('os-snap-preview');
                const threshold = 20;
                const screenW = window.innerWidth;
                const screenH = window.innerHeight - 52;

                clearTimeout(osSnapPreviewTimer);

                if (e.clientX < threshold) {
                    snapSide = 'left';
                    preview.style.display = 'block';
                    preview.style.left = '0';
                    preview.style.top = '0';
                    preview.style.width = '50%';
                    preview.style.height = screenH + 'px';
                } else if (e.clientX > screenW - threshold) {
                    snapSide = 'right';
                    preview.style.display = 'block';
                    preview.style.left = '50%';
                    preview.style.top = '0';
                    preview.style.width = '50%';
                    preview.style.height = screenH + 'px';
                } else {
                    snapSide = null;
                    preview.style.display = 'none';
                }

                win.style.left = newLeft + 'px';
                win.style.top = newTop + 'px';
            }

            function onUp() {
                isDragging = false;
                document.removeEventListener('mousemove', onMove);
                document.removeEventListener('mouseup', onUp);
                const preview = document.getElementById('os-snap-preview');
                if (snapSide) {
                    win.classList.remove('snapped-left', 'snapped-right');
                    win.classList.add('snapped-' + snapSide);
                    preview.style.display = 'none';
                    snapSide = null;
                } else {
                    if (win.classList.contains('snapped-left') || win.classList.contains('snapped-right')) {
                        win.classList.remove('snapped-left', 'snapped-right');
                    }
                }
            }

            handle.addEventListener('mousedown', onDown);
            handle.addEventListener('dblclick', (e) => {
                if (e.target.closest('.os-window-control')) return;
                toggleMaximizeOSWindow(winId);
            });
        }

        /* === Resizing with guideline === */
        function makeResizable(win) {
            const handles = win.querySelectorAll('.os-resize-handle');
            const guideH = document.getElementById('os-resize-guide-h');
            const guideV = document.getElementById('os-resize-guide-v');
            const dimBox = document.getElementById('os-resize-dim');

            handles.forEach(handle => {
                handle.addEventListener('mousedown', (e) => {
                    if (win.classList.contains('maximized')) return;
                    e.preventDefault();
                    e.stopPropagation();

                    const dir = handle.dataset.dir;
                    const rect = win.getBoundingClientRect();
                    const startX = e.clientX;
                    const startY = e.clientY;
                    const startW = rect.width;
                    const startH = rect.height;
                    const startL = rect.left;
                    const startT = rect.top;

                    function onMove(ev) {
                        let newW = startW, newH = startH, newL = startL, newT = startT;
                        if (dir.includes('e')) newW = Math.max(280, startW + (ev.clientX - startX));
                        if (dir.includes('w')) {
                            newW = Math.max(280, startW - (ev.clientX - startX));
                            newL = startL + (startW - newW);
                        }
                        if (dir.includes('s')) newH = Math.max(160, startH + (ev.clientY - startY));
                        if (dir.includes('n')) {
                            newH = Math.max(160, startH - (ev.clientY - startY));
                            newT = startT + (startH - newH);
                        }

                        win.style.width = newW + 'px';
                        win.style.height = newH + 'px';
                        win.style.left = newL + 'px';
                        win.style.top = newT + 'px';

                        // Guide lines
                        if (dir.includes('e') || dir.includes('w')) {
                            guideV.classList.add('show');
                            guideV.style.left = (dir.includes('e') ? newL + newW : newL) + 'px';
                            guideV.style.top = '0';
                            guideV.style.height = '100vh';
                        } else {
                            guideV.classList.remove('show');
                        }
                        if (dir.includes('n') || dir.includes('s')) {
                            guideH.classList.add('show');
                            guideH.style.top = (dir.includes('s') ? newT + newH : newT) + 'px';
                            guideH.style.left = '0';
                            guideH.style.width = '100vw';
                        } else {
                            guideH.classList.remove('show');
                        }

                        // Dimension readout
                        dimBox.classList.add('show');
                        dimBox.textContent = `${Math.round(newW)} × ${Math.round(newH)}`;
                        dimBox.style.left = (newL + newW / 2 - 40) + 'px';
                        dimBox.style.top = (newT + newH + 12) + 'px';
                    }

                    function onUp() {
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                        guideH.classList.remove('show');
                        guideV.classList.remove('show');
                        dimBox.classList.remove('show');
                    }

                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                });
            });
        }

        /* === Window controls === */
        function closeOSWindow(id) {
            const win = osWindows.find(w => w.id === id);
            if (win) {
                win.el.classList.add('closing');
                setTimeout(() => {
                    win.el.remove();
                    osWindows = osWindows.filter(w => w.id !== id);
                    osMinimized = osMinimized.filter(m => m !== id);
                    updateTaskbarRunning();
                }, 220);
            }
        }

        function minimizeOSWindow(id) {
            const win = osWindows.find(w => w.id === id);
            if (!win) return;
            win.el.classList.add('closing');
            setTimeout(() => {
                win.el.classList.remove('closing');
                win.el.classList.add('minimized');
                win.minimized = true;
                if (!osMinimized.includes(id)) osMinimized.push(id);
                updateTaskbarRunning();
            }, 220);
        }

        function restoreOSWindow(id) {
            const win = osWindows.find(w => w.id === id);
            if (!win) return;
            win.el.classList.remove('minimized');
            win.el.style.animation = 'osWindowOpen 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
            win.minimized = false;
            win.el.style.zIndex = ++osWindowZ;
            document.querySelectorAll('.os-window').forEach(w => w.classList.remove('focused'));
            win.el.classList.add('focused');
            osMinimized = osMinimized.filter(m => m !== id);
            updateTaskbarRunning();
        }

        function toggleMaximizeOSWindow(id) {
            const win = osWindows.find(w => w.id === id);
            if (!win) return;
            win.el.classList.toggle('maximized');
        }

        /* === Start menu / taskbar interactions === */
        function initBrowserOS() {
            setInterval(() => {
                if (document.getElementById('os-desktop').classList.contains('open')) {
                    updateOSTrayClock();
                }
            }, 1000);

            document.querySelectorAll('.os-taskbar-btn[data-os-app]').forEach(el => {
                el.addEventListener('click', () => {
                    const app = el.dataset.osApp;
                    handleOSApp(app);
                });
            });

            document.getElementById('os-start-search-input').addEventListener('input', (e) => {
                const q = e.target.value.toLowerCase();
                document.querySelectorAll('#os-start-apps .os-start-app').forEach(app => {
                    const txt = app.textContent.toLowerCase();
                    app.style.display = txt.includes(q) ? '' : 'none';
                });
            });

            document.getElementById('os-wallpaper-input').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (ev) => {
                    localStorage.setItem('os-wallpaper', ev.target.result);
                    applyOSWallpaper();
                };
                reader.readAsDataURL(file);
            });

            document.addEventListener('click', (e) => {
                const menu = document.getElementById('os-start-menu');
                const startBtn = document.querySelector('.os-taskbar-btn[data-os-app="start"]');
                if (menu.classList.contains('open') &&
                    !menu.contains(e.target) &&
                    !startBtn.contains(e.target)) {
                    closeStartMenu();
                }
            });

            // Edit HUD button
            document.getElementById('os-edit-hud-btn').addEventListener('click', () => {
                osState.hudEditing = !osState.hudEditing;
                document.getElementById('os-desktop').classList.toggle('hud-editing', osState.hudEditing);
                closeStartMenu();
            });

            // Power button
            document.getElementById('os-power-btn').addEventListener('click', () => {
                lockScreen();
            });

            // Panic key listener
            document.addEventListener('keydown', (e) => {
                if (!document.getElementById('os-desktop').classList.contains('open')) return;
                if (e.key === osState.panicKey) {
                    e.preventDefault();
                    const flash = document.createElement('div');
                    flash.className = 'panic-flash';
                    document.body.appendChild(flash);
                    setTimeout(() => {
                        window.location.href = osState.panicUrl;
                    }, 200);
                }
            });

            // Lock screen interactions
            initLockScreen();
        }

        /* === Handle app launch === */
        function handleOSApp(app) {
            if (app === 'start') {
                const menu = document.getElementById('os-start-menu');
                if (menu.classList.contains('open')) closeStartMenu();
                else menu.classList.add('open');
                return;
            }
            if (app === 'exit') {
                closeBrowserOS();
                return;
            }

            const existing = osWindows.find(w => w.type === app);
            if (existing) {
                if (existing.minimized) restoreOSWindow(existing.id);
                existing.el.style.zIndex = ++osWindowZ;
                return;
            }

            if (app === 'browser') createOSWindow('browser', { width: 880, height: 580 });
            else if (app === 'calculator') createOSWindow('calculator', { width: 340, height: 500 });
            else if (app === 'clock') createOSWindow('clock', { width: 420, height: 280 });
            else if (app === 'wallpaper') createOSWindow('wallpaper', { width: 580, height: 480 });
            else if (app === 'settings') createOSWindow('settings', { width: 620, height: 560 });
            else if (app === 'files') createOSWindow('files', { width: 640, height: 460 });
            else if (app === 'terminal') createOSWindow('terminal', { width: 640, height: 420 });
            else if (app === 'notes') createOSWindow('notes', { width: 500, height: 420 });
        }

        /* =========================================================
           LOCK SCREEN
           ========================================================= */
        let lockDragStartY = null;

        function lockScreen() {
            const lock = document.getElementById('os-lock-screen');
            lock.classList.add('open');
            updateLockClock();
            setInterval(updateLockClock, 1000);
        }

        function updateLockClock() {
            const t = document.getElementById('os-lock-time');
            const d = document.getElementById('os-lock-date');
            if (!t || !d) return;
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            t.textContent = `${h}:${m}`;
            d.textContent = now.toLocaleDateString(undefined, {
                weekday: 'long', month: 'long', day: 'numeric'
            });
        }

        function initLockScreen() {
            const lock = document.getElementById('os-lock-screen');
            lock.addEventListener('mousedown', (e) => {
                lockDragStartY = e.clientY;
            });
            window.addEventListener('mousemove', (e) => {
                if (lockDragStartY === null) return;
                const dy = lockDragStartY - e.clientY;
                if (dy > 80) {
                    unlockScreen();
                }
            });
            window.addEventListener('mouseup', () => {
                lockDragStartY = null;
            });

            // Touch
            lock.addEventListener('touchstart', (e) => {
                lockDragStartY = e.touches[0].clientY;
            }, { passive: true });
            lock.addEventListener('touchmove', (e) => {
                if (lockDragStartY === null) return;
                const dy = lockDragStartY - e.touches[0].clientY;
                if (dy > 80) unlockScreen();
            }, { passive: true });
            lock.addEventListener('touchend', () => { lockDragStartY = null; });

            // Any key press
            document.addEventListener('keydown', (e) => {
                if (!lock.classList.contains('open')) return;
                if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') {
                    unlockScreen();
                }
            });
        }

        function unlockScreen() {
            const lock = document.getElementById('os-lock-screen');
            if (!lock.classList.contains('open')) return;
            lock.style.transition = 'transform 0.4s cubic-bezier(0.22, 0.98, 0.36, 1), opacity 0.4s ease';
            lock.style.transform = 'translateY(-100%)';
            lock.style.opacity = '0';
            setTimeout(() => {
                lock.classList.remove('open');
                lock.style.transform = '';
                lock.style.opacity = '';
                lock.style.transition = '';
            }, 420);
        }

        loadOSState();
    </script>
</body>
</html>
