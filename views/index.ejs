<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Farium</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/chat.css">

<style>
:root{
  --bg:#07080a;
  --bg2:#0a0b0e;
  --panel:#0e1014;
  --panel2:#13161b;
  --panel3:#191d23;

  --white:#f5f6f8;
  --silver:#c8ccd3;
  --muted:#858b95;
  --dim:#5e646e;

  --line:rgba(255,255,255,.075);
  --line2:rgba(255,255,255,.14);
  --hover:rgba(255,255,255,.065);
  --glow:rgba(255,255,255,.10);

  --ease:cubic-bezier(.2,.9,.3,1);
  --spring:cubic-bezier(.22,1.55,.55,1);
}

*{
  box-sizing:border-box;
}

html,
body{
  width:100%;
  height:100%;
  margin:0;
  overflow:hidden;
  background:var(--bg);
  color:var(--white);
  font-family:Inter,sans-serif;
}

button,
input{
  font:inherit;
}

button{
  cursor:pointer;
}

svg{
  display:block;
}


/* =========================================================
   BACKGROUND
========================================================= */

#bg{
  position:fixed;
  inset:0;
  z-index:0;
  overflow:hidden;
  background:
      radial-gradient(
        circle at 15% 10%,
        rgba(255,255,255,.06),
        transparent 30%
      ),
      radial-gradient(
        circle at 85% 90%,
        rgba(255,255,255,.04),
        transparent 35%
      ),
      radial-gradient(
        ellipse at 50% 0%,
        rgba(255,255,255,.015),
        transparent 50%
      ),
      linear-gradient(
        135deg,
        #060709,
        #0a0b0e 50%,
        #060709
      );
}

#shader{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  opacity:.55;
}

#lines{
  position:absolute;
  inset:0;
  opacity:.5;
}

.noise{
  position:absolute;
  inset:0;
  opacity:.025;
  pointer-events:none;

  background-image:url(
    "data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"
  );
}

.glow{
  position:absolute;
  width:650px;
  height:650px;
  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,.10),
      transparent 68%
    );

  filter:blur(70px);

  left:-230px;
  top:-250px;

  transition:transform .8s var(--ease);
}

.glow.b{
  left:auto;
  top:auto;
  right:-240px;
  bottom:-260px;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,.05),
      transparent 68%
    );
}

.vignette{
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(
      ellipse at center,
      transparent 50%,
      rgba(0,0,0,.55) 100%
    );
}


/* =========================================================
   INTRO
========================================================= */

#intro{
  position:fixed;
  inset:0;
  z-index:1000;

  display:grid;
  place-items:center;

  background:
    radial-gradient(
      circle at center,
      #101216,
      #050608 70%
    );

  transition:
    opacity .8s ease,
    visibility .8s ease;
}

.introbox{
  text-align:center;
}

.intrologo{
  font:
    700 62px
    "Space Grotesk";

  letter-spacing:11px;

  color:#f7f8fa;

  text-shadow:
    0 0 25px rgba(255,255,255,.08),
    0 0 70px rgba(255,255,255,.05);

  animation:
    introLogo 1s var(--spring) both;
}

.intrologo span{
  color:#fff;
}

.introline{
  width:270px;
  height:2px;

  margin:22px auto 0;

  overflow:hidden;

  border-radius:10px;

  background:#191c21;
}

.introline i{
  display:block;

  width:0;
  height:100%;

  background:
    linear-gradient(
      90deg,
      #555b65,
      #fff
    );

  box-shadow:
    0 0 20px rgba(255,255,255,.3);

  animation:
    loading 1.8s var(--ease) forwards;
}

.introcap{
  margin-top:14px;

  color:#656b75;

  font-size:10px;
  letter-spacing:2px;

  text-transform:uppercase;
}

@keyframes loading{
  to{
    width:100%;
  }
}

@keyframes introLogo{
  from{
    opacity:0;
    transform:
      translateY(45px)
      scale(.8);

    filter:blur(12px);
  }

  to{
    opacity:1;
    transform:none;
    filter:none;
  }
}


/* =========================================================
   HOME
========================================================= */

.home{
  position:relative;
  z-index:2;

  width:100%;
  height:100%;

  display:flex;
  flex-direction:column;
  align-items:center;
}

.top{
  width:100%;

  display:flex;
  justify-content:space-between;
  align-items:center;

  padding:20px 28px;
}

.brand{
  font:
    600 13px
    "Space Grotesk";

  color:#c9cdd3;

  letter-spacing:1px;
}

.nav{
  position:relative;
  display:flex;
  gap:4px;

  padding:4px;

  border:
    1px solid var(--line);

  border-radius:25px;

  background:
    rgba(12,14,17,.78);

  backdrop-filter:blur(20px);

  box-shadow:
    0 15px 45px rgba(0,0,0,.35);
}

.nav-indicator{
  position:absolute;
  top:4px;
  bottom:4px;
  border-radius:18px;
  background:#f1f2f4;
  box-shadow:0 0 20px rgba(255,255,255,.15),0 8px 25px rgba(255,255,255,.09);
  pointer-events:none;
  transition:left .35s cubic-bezier(.22,.9,.35,1),width .35s cubic-bezier(.22,.9,.35,1);
  z-index:0;
}

.nav button{
  position:relative;
  border:0;
  z-index:1;

  padding:8px 15px;

  border-radius:18px;

  background:transparent;

  color:var(--muted);

  font-size:12px;

  transition:
    .25s var(--spring);
}

.nav button:hover{
  color:#fff;
  background:var(--hover);

  transform:
    translateY(-2px);
}

.nav button.active{
  color:#08090b;

  background:transparent;

  box-shadow:none;
}


/* =========================================================
   HERO
========================================================= */

.hero{
  width:min(760px,92%);

  margin-top:8vh;

  text-align:center;
}

.hero h1{
  margin:0 0 32px;

  font:
    700 clamp(42px,7vw,78px)
    "Space Grotesk";

  letter-spacing:10px;

  color:#f2f3f5;

  text-shadow:
    0 0 45px rgba(255,255,255,.08);

  user-select:none;
}

.hero h1 span{
  color:#fff;
}


/* =========================================================
   SEARCH
========================================================= */

.search{
  width:100%;

  display:flex;
  align-items:center;

  gap:11px;

  padding:15px 17px;

  border:
    1px solid var(--line2);

  border-radius:16px;

  background:
    rgba(13,15,18,.9);

  backdrop-filter:blur(25px);

  box-shadow:
    0 30px 80px rgba(0,0,0,.5),
    inset 0 1px rgba(255,255,255,.025);

  transition:
    .35s var(--ease);
}

.search:hover{
  border-color:
    rgba(255,255,255,.19);
}

.search:focus-within{
  border-color:
    rgba(255,255,255,.3);

  box-shadow:
    0 0 0 5px rgba(255,255,255,.035),
    0 25px 80px rgba(0,0,0,.6);
}

.search svg{
  width:17px;
  color:#777e88;
}

.search input{
  flex:1;

  min-width:0;

  border:0;
  outline:0;

  background:transparent;

  color:#f2f3f5;

  font-size:14px;
}

.search input::placeholder{
  color:#606670;
}

.engine{
  padding:6px 9px;

  border:
    1px solid var(--line2);

  border-radius:7px;

  color:#aeb3bb;

  background:
    rgba(255,255,255,.025);

  font-size:9px;
  font-weight:700;

  letter-spacing:.8px;
}


/* =========================================================
   SHORTCUTS
========================================================= */

.short-title{
  margin:
    28px 0 11px;

  text-align:left;

  color:#626872;

  font-size:10px;

  letter-spacing:1.5px;

  text-transform:uppercase;
}

.shortcuts{
  display:flex;

  justify-content:center;

  flex-wrap:wrap;

  gap:12px;
}

.shortcut{
  width:82px;
}

.shortcut .ico{
  height:54px;

  display:grid;
  place-items:center;

  border:
    1px solid var(--line);

  border-radius:15px;

  background:
    rgba(13,15,18,.82);

  color:#d9dce1;

  font-size:18px;

  box-shadow:
    inset 0 1px rgba(255,255,255,.02);

  transition:
    .3s var(--spring);
}

.shortcut:hover .ico{
  transform:
    translateY(-7px)
    rotate(-3deg)
    scale(1.03);

  border-color:
    rgba(255,255,255,.17);

  background:#181b20;

  box-shadow:
    0 20px 40px rgba(0,0,0,.45),
    0 0 25px rgba(255,255,255,.025);
}

.shortcut small{
  display:block;

  margin-top:7px;

  overflow:hidden;

  text-overflow:ellipsis;

  white-space:nowrap;

  color:#777e88;

  font-size:10px;
}

.footer{
  position:absolute;

  bottom:30px;

  color:#4e545e;

  font-size:11px;
}


/* =========================================================
   FALLING ANIMATION
========================================================= */

.fall{
  opacity:0;

  animation:
    fall .85s var(--spring) forwards;
}

.fall:nth-child(1){
  animation-delay:.08s;
}

.fall:nth-child(2){
  animation-delay:.15s;
}

.fall:nth-child(3){
  animation-delay:.22s;
}

.fall:nth-child(4){
  animation-delay:.29s;
}

.fall:nth-child(5){
  animation-delay:.36s;
}

.fall:nth-child(6){
  animation-delay:.43s;
}

@keyframes fall{
  0%{
    opacity:0;

    transform:
      translateY(-140px)
      rotate(-9deg)
      scale(.75);
  }

  60%{
    opacity:1;

    transform:
      translateY(13px)
      rotate(2deg)
      scale(1.05);
  }

  80%{
    transform:
      translateY(-6px)
      rotate(-1deg);
  }

  100%{
    opacity:1;
    transform:none;
  }
}


/* =========================================================
   SETTINGS
========================================================= */

.settings{
  position:fixed;
  inset:0;

  z-index:500;

  display:none;

  align-items:center;
  justify-content:center;

  background:
    rgba(0,0,0,.72);

  backdrop-filter:blur(13px);
}

.settings.open{
  display:flex;
}

.card{
  width:min(460px,92%);
  max-height:85vh;

  overflow:auto;

  padding:23px;

  border:
    1px solid var(--line2);

  border-radius:21px;

  background:
    linear-gradient(
      180deg,
      #15181d,
      #0b0d10
    );

  box-shadow:
    0 40px 120px rgba(0,0,0,.75);

  animation:
    settingsPop .45s var(--spring);
}

@keyframes settingsPop{
  from{
    opacity:0;

    transform:
      translateY(35px)
      scale(.9);
  }

  to{
    opacity:1;
    transform:none;
  }
}

.head{
  display:flex;

  justify-content:space-between;
  align-items:center;
}

.head h2{
  margin:0;

  font:
    600 17px
    "Space Grotesk";
}

.x{
  width:32px;
  height:32px;

  border:
    1px solid var(--line);

  border-radius:9px;

  background:transparent;

  color:#7c838d;

  transition:.2s;
}

.x:hover{
  background:#1a1d22;
  color:#fff;
}

.section{
  margin-top:22px;
}

.section h3{
  margin:0 0 9px;

  color:#676e78;

  font-size:10px;

  letter-spacing:1px;

  text-transform:uppercase;
}

.seg{
  display:grid;

  grid-template-columns:repeat(2,1fr);

  gap:5px;

  padding:4px;

  border:
    1px solid var(--line);

  border-radius:12px;

  background:#080a0d;
}

.seg button{
  border:0;

  padding:10px 5px;

  border-radius:9px;

  background:transparent;

  color:#7c838d;

  font-size:11px;

  transition:.2s var(--spring);
}

.seg button:hover{
  background:#171a1f;
  color:#fff;
}

.seg button.active{
  color:#08090b;

  background:#f0f1f3;

  box-shadow:
    0 7px 20px rgba(255,255,255,.09);
}

.row{
  display:flex;

  justify-content:space-between;
  align-items:center;

  padding:14px 2px;

  border-top:
    1px solid var(--line);
}

.row:first-of-type{
  border-top:0;
}

.row b{
  font-size:12px;
}

.row span{
  display:block;

  margin-top:3px;

  color:#626973;

  font-size:10px;
}

.switch{
  width:42px;
  height:24px;

  padding:2px;

  border:
    1px solid var(--line);

  border-radius:20px;

  background:#171a1f;
}

.switch i{
  display:block;

  width:18px;
  height:18px;

  border-radius:50%;

  background:#626974;

  transition:
    .3s var(--spring);
}

.switch.on{
  background:
    rgba(255,255,255,.11);

  border-color:
    rgba(255,255,255,.18);
}

.switch.on i{
  transform:translateX(17px);

  background:#f4f5f7;

  box-shadow:
    0 0 14px rgba(255,255,255,.35);
}


/* =========================================================
   BROWSER
========================================================= */

.browser{
  position:fixed;
  inset:0;

  z-index:20;

  display:none;

  flex-direction:column;

  background:#08090b;

  animation:
    browserIn .5s var(--ease);
}

.browser.show{
  display:flex;
}

@keyframes browserIn{
  from{
    opacity:0;
    transform:scale(.975);
  }

  to{
    opacity:1;
    transform:none;
  }
}

.chrome,
.tabs,
.bar{
  border-bottom:
    1px solid var(--line);

  background:#0d0f12;
}

.chrome{
  height:47px;

  display:flex;
  align-items:center;

  gap:12px;

  padding:0 15px;
}

.traffic{
  display:flex;
  gap:8px;
}

.traffic i{
  width:11px;
  height:11px;

  border-radius:50%;

  background:#393d44;
}

.traffic i:first-child{
  background:#684646;
}

.traffic i:nth-child(2){
  background:#625d45;
}

.traffic i:last-child{
  background:#45554c;
}

.bbrand{
  color:#858b95;

  font:
    600 12px
    "Space Grotesk";
}

.spacer{
  flex:1;
}

.bar{
  display:flex;

  align-items:center;

  gap:7px;

  padding:9px 13px;

  background:#111419;
}

.ib{
  width:31px;
  height:31px;

  border:1px solid transparent;

  border-radius:9px;

  background:transparent;

  color:#7b828d;

  font-size:17px;

  transition:.2s var(--spring);
}

.ib:hover{
  color:#fff;

  background:#1a1d23;

  transform:
    translateY(-2px);
}

.address{
  flex:1;

  min-width:0;

  display:flex;
  align-items:center;

  gap:8px;

  padding:8px 11px;

  border:
    1px solid var(--line);

  border-radius:10px;

  background:#080a0d;
}

.address span{
  color:#6d747e;
}

.address input{
  flex:1;

  min-width:0;

  border:0;
  outline:0;

  background:transparent;

  color:#e9ebee;

  font-size:12px;
}

.go{
  height:34px;

  padding:0 15px;

  border:0;

  border-radius:9px;

  background:#f0f1f3;

  color:#08090b;

  font-weight:700;

  transition:
    .2s var(--spring);
}

.go:hover{
  transform:translateY(-2px);

  box-shadow:
    0 10px 25px rgba(255,255,255,.10);
}


/* =========================================================
   TABS
========================================================= */

.tabs{
  display:flex;

  gap:4px;

  padding:7px 10px 0;

  overflow:auto;
}

.tab{
  min-width:140px;
  max-width:210px;

  display:flex;
  align-items:center;

  gap:8px;

  padding:9px 11px;

  border:
    1px solid transparent;

  border-bottom:0;

  border-radius:9px 9px 0 0;

  background:transparent;

  color:#68707a;

  font-size:11px;

  transition:.2s;
}

.tab:hover{
  background:#111419;
  color:#aeb3ba;
}

.tab.active{
  color:#eef0f3;

  background:#15181d;

  border-color:var(--line);
}

.tab button{
  margin-left:auto;

  border:0;

  background:transparent;

  color:#646b75;

  font-size:14px;
}

.tab button:hover{
  color:#fff;
}


/* =========================================================
   WEB VIEW
========================================================= */

.view{
  position:relative;

  flex:1;

  overflow:hidden;

  background:#fff;
}

.view iframe{
  width:100%;
  height:100%;

  border:0;

  background:#fff;
}

.browserHome{
  position:absolute;
  inset:0;

  display:grid;
  place-items:center;

  background:
    radial-gradient(
      circle at center,
      #111419,
      #07080a 65%
    );
}

.browserHome h2{
  color:#747b85;

  font:
    600 22px
    "Space Grotesk";

  letter-spacing:5px;
}

.status{
  position:absolute;

  top:11px;
  left:50%;

  z-index:10;

  display:none;

  padding:7px 12px;

  border:
    1px solid var(--line);

  border-radius:9px;

  background:#101318;

  color:#777e88;

  font-size:10px;

  box-shadow:
    0 15px 35px rgba(0,0,0,.4);
}

.status.show{
  display:block;
}

.status b{
  color:#e9ebee;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:600px){

  .top{
    padding:16px;
  }

  .hero{
    margin-top:11vh;
  }

  .hero h1{
    letter-spacing:6px;
  }

  .shortcut{
    width:70px;
  }

  .shortcut .ico{
    height:48px;
  }

  .traffic,
  .bbrand{
    display:none;
  }

  .bar{
    padding:7px;
  }

  .go{
    padding:0 11px;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

body.reduced-motion *,
body.reduced-motion *::before,
body.reduced-motion *::after{
  animation-duration:.001ms !important;
  animation-iteration-count:1 !important;
  transition-duration:.001ms !important;
  scroll-behavior:auto !important;
}

/* =========================================================
   PAGE SLIDE
========================================================= */

.page-slide{
  position:fixed;
  inset:0;
  z-index:30000;
  background:var(--bg);
  transform:translateX(100%);
  transition:transform .45s cubic-bezier(.65,0,.35,1);
  pointer-events:none;
  display:flex;
  align-items:center;
  justify-content:center;
  will-change:transform;
}
</style>
</head>

<body>

<!-- BACKGROUND -->
<div id="bg">
  <canvas id="shader"></canvas>
  <canvas id="lines"></canvas>

  <div class="glow" id="g1"></div>
  <div class="glow b" id="g2"></div>

  <div class="vignette"></div>

  <div class="noise"></div>
</div>


<!-- INTRO -->
<div id="intro">
  <div class="introbox">

    <div class="intrologo">
      FARI<span>UM</span>
    </div>

    <div class="introline">
      <i></i>
    </div>

    <div class="introcap">
      Initializing secure browser
    </div>

  </div>
</div>


<!-- HOME -->
<section class="home" id="home">

  <header class="top fall">

    <div class="brand">
      Farium
    </div>

    <nav class="nav" id="nav">

      <div class="nav-indicator" id="navIndicator"></div>

      <button
        id="searchNav"
        class="active">
        Search
      </button>

      <button
        id="settingsNav">
        Settings
      </button>

      <button
        id="chatOpen">
        Chat
      </button>

      <button
        id="gamesNav">
        Games
      </button>

    </nav>

  </header>


  <main class="hero">

    <h1 class="fall">
      FARI<span>UM</span>
    </h1>


    <div class="search fall">

      <span id="searchIcon"></span>

      <input
        id="homeInput"
        autocomplete="off"
        placeholder="Enter a URL or search">

      <span
        class="engine"
        id="homeEngine">
        GOOGLE
      </span>

    </div>


    <div class="short-title fall">
      Shortcuts
    </div>


    <div
      class="shortcuts"
      id="shortcuts">
    </div>

  </main>


  <div class="footer fall">
    Built for the web · Farium
  </div>

</section>


<!-- SETTINGS -->
<div
  class="settings"
  id="settings">

  <div class="card">

    <div class="head">

      <h2>
        Farium Settings
      </h2>

      <button
        class="x"
