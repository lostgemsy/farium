<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xylara - Settings</title>
    <script src="https://app.rybbit.io/api/script.js" data-site-id="8b65ec526edf" defer></script>
    <link rel="icon" type="image/png" href="https://cdn.jsdelivr.net/gh/lostgemsy/SrFrosty-games@main/logo.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-16px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes rumble {
            0%, 100% { transform: translateX(0); }
            15% { transform: translateX(-2px); }
            30% { transform: translateX(2px); }
            45% { transform: translateX(-1px); }
            60% { transform: translateX(1px); }
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(25px, -20px) scale(1.08); }
        }

        @keyframes auroraShift {
            0%, 100% { transform: translate(0,0) scale(1); }
            50% { transform: translate(-4%, 3%) scale(1.15); }
        }

        @keyframes glowPulse {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }

        @keyframes logoDrop {
            0% { opacity:0; transform:translateY(-55px) scale(.72) rotate(-4deg); filter:blur(10px); }
            55% { opacity:1; transform:translateY(7px) scale(1.04) rotate(1deg); filter:blur(0); }
            72% { transform:translateY(-3px) scale(.985); }
            100% { opacity:1; transform:none; }
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @keyframes slidePageOut {
            to { transform: translateX(-100%); }
        }

        @keyframes slidePageIn {
            from { transform: translateX(100%); }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #05060a;
            --bg-2: #0a0b10;
            --bg-3: #0f1118;
            --text: #f5f5f7;
            --text-dim: rgba(255,255,255,.45);
            --text-dim-2: rgba(255,255,255,.68);
            --card: rgba(255,255,255,.045);
            --card-hover: rgba(255,255,255,.08);
            --card-border: rgba(255,255,255,.09);
            --card-border-hover: rgba(255,255,255,.28);
            --input-bg: rgba(255,255,255,.05);
            --input-border: rgba(255,255,255,.1);
            --input-border-focus: rgba(255,255,255,.4);
            --shadow: rgba(0,0,0,.65);
            --shadow-glow: rgba(120,140,255,.14);
            --accent: #7c8cff;
            --accent-2: #b47cff;
            --accent-glow: rgba(124,140,255,.35);
            --ring: rgba(124,140,255,.32);
        }

        html {
            min-height: 100%;
            background: var(--bg);
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            position: relative;
            overflow-x: hidden;
        }

        /* Layered transparent aurora background */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(900px 500px at 15% -5%, var(--shadow-glow), transparent 65%),
                radial-gradient(800px 500px at 100% 0%, rgba(180,124,255,.09), transparent 60%),
                radial-gradient(700px 500px at 50% 120%, rgba(124,140,255,.08), transparent 60%);
            z-index: 0;
            pointer-events: none;
            animation: auroraShift 18s ease-in-out infinite;
        }

        /* Floating soft glow orb */
        body::after {
            content: '';
            position: fixed;
            top: 20%;
            left: 50%;
            width: 500px;
            height: 500px;
            background: radial-gradient(
                circle,
                rgba(124,140,255,0.08) 0%,
                rgba(180,124,255,0.05) 40%,
                transparent 70%
            );
            filter: blur(30px);
            transform: translateX(-50%);
            animation: float 14s ease-in-out infinite, glowPulse 6s ease-in-out infinite;
            z-index: 0;
            pointer-events: none;
        }

        /* Subtle grain/noise overlay */
        .noise {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            opacity: 0.035;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        }

        /* ============ TOPBAR ============ */

        .topbar {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(15,17,24,.55);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 5px;
            box-shadow:
                0 10px 40px -12px var(--shadow),
                inset 0 1px 0 rgba(255,255,255,.05);
            backdrop-filter: blur(20px) saturate(1.2);
            -webkit-backdrop-filter: blur(20px) saturate(1.2);
            animation: fadeIn 0.5s ease, slideDown 0.55s cubic-bezier(.2,.9,.25,1.15);
        }

        .topbar a {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 38px;
            border-radius: 12px;
            transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
            text-decoration: none;
        }

        .topbar a:hover {
            background: var(--card-hover);
            transform: translateY(-2px);
        }

        .topbar a.active {
            background: var(--card);
            box-shadow:
                0 4px 15px rgba(0,0,0,.4),
                inset 0 0 0 1px var(--card-border);
        }

        .topbar a:active {
            animation: rumble 0.3s ease;
        }

        .topbar svg {
            width: 18px;
            height: 18px;
            stroke: var(--text-dim-2);
            fill: none;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: all 0.25s ease;
        }

        .topbar a:hover svg,
        .topbar a.active svg {
            stroke: var(--text);
        }

        /* Games button (accent colored) */
        .topbar a.games-btn {
            width: auto;
            padding: 0 14px 0 10px;
            gap: 8px;
            color: var(--text);
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.3px;
            background: linear-gradient(135deg, rgba(124,140,255,.16), rgba(180,124,255,.12));
            border: 1px solid rgba(124,140,255,.3);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
        }

        .topbar a.games-btn svg {
            width: 16px;
            height: 16px;
            stroke: var(--accent);
        }

        .topbar a.games-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border-color: transparent;
            transform: translateY(-2px);
            box-shadow:
                0 10px 28px -8px var(--accent-glow),
                inset 0 1px 0 rgba(255,255,255,.2);
        }

        .topbar a.games-btn:hover svg {
            stroke: #fff;
        }

        /* ============ SETTINGS ============ */

        .settings-wrapper {
            position: relative;
            z-index: 2;
            width: min(100%, 580px);
            padding: 40px 22px 60px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* Logo area */
        .logo-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            animation: logoDrop 0.85s cubic-bezier(.16,1,.3,1) both;
        }

        .farius-logo {
            height: 72px;
            width: auto;
            object-fit: contain;
            filter:
                drop-shadow(0 15px 35px rgba(0,0,0,.5))
                drop-shadow(0 0 22px var(--accent-glow));
            transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.2, 1.3), filter 0.35s ease;
        }

        .farius-logo:hover {
            transform: scale(1.06) translateY(-3px);
            filter:
                drop-shadow(0 22px 45px rgba(0,0,0,.6))
                drop-shadow(0 0 38px var(--accent-glow));
        }

        .logo-fallback {
            display: none;
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: 6px;
            text-transform: uppercase;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Title */
        .page-title {
            text-align: center;
            margin: 0 4px 6px;
            font-size: clamp(1.8rem, 5vw, 2.35rem);
            font-weight: 800;
            letter-spacing: -1px;
            animation: slideUp 0.6s 0.05s ease both;
            background: linear-gradient(180deg, var(--text), var(--text-dim-2));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Subtitle */
        .page-subtitle {
            text-align: center;
            margin: -8px 4px 12px;
            color: var(--text-dim);
            font-size: 0.86rem;
            letter-spacing: 0.3px;
            font-weight: 500;
            animation: slideUp 0.6s 0.1s ease both;
        }

        /* Glass card */
        .settings-container {
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.02));
            backdrop-filter: blur(22px) saturate(1.25);
            -webkit-backdrop-filter: blur(22px) saturate(1.25);
            padding: 22px 24px;
            border-radius: 18px;
            border: 1px solid var(--card-border);
            box-shadow:
                0 14px 40px -20px var(--shadow),
                inset 0 1px 0 rgba(255,255,255,.06);
            animation: slideUp 0.5s ease both;
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        /* Left accent bar */
        .settings-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 3px;
            height: 100%;
            background: linear-gradient(
                180deg,
                var(--accent),
                var(--accent-2) 40%,
                transparent
            );
            opacity: 0.65;
            transition: opacity 0.3s ease;
        }

        /* Corner glow */
        .settings-container::after {
            content: '';
            position: absolute;
            top: -80px;
            right: -70px;
            width: 170px;
            height: 170px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--accent-glow), transparent 65%);
            filter: blur(28px);
            pointer-events: none;
            opacity: 0.5;
            transition: opacity 0.35s ease;
        }

        .settings-container:hover {
            border-color: var(--card-border-hover);
            transform: translateY(-3px);
            background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
            box-shadow:
                0 22px 55px -20px var(--shadow),
                0 0 0 1px var(--accent-glow),
                inset 0 1px 0 rgba(255,255,255,.08);
        }

        .settings-container:hover::before {
            opacity: 1;
        }

        .settings-container:hover::after {
            opacity: 1;
        }

        .setting-item {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            min-height: 40px;
            margin-bottom: 14px;
        }

        .setting-item:last-child {
            margin-bottom: 0;
        }

        .setting-item label {
            font-size: 0.82rem;
            margin-right: 10px;
            color: var(--text);
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .setting-item select,
        .setting-item input {
            min-height: 40px;
            border-radius: 10px;
            border: 1.5px solid var(--input-border);
            background: var(--input-bg);
            color: var(--text);
            font-size: 0.8rem;
            font-family: inherit;
            font-weight: 500;
            outline: none;
            transition: all 0.25s ease;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .setting-item select {
            min-width: 160px;
            padding: 8px 34px 8px 13px;
            cursor: pointer;
        }

        .setting-item input {
            width: 245px;
            padding: 8px 13px;
        }

        .setting-item select:hover,
        .setting-item input:hover {
            background: var(--card);
            border-color: var(--card-border-hover);
        }

        .setting-item select:focus,
        .setting-item input:focus {
            border-color: var(--input-border-focus);
            background: var(--card);
            box-shadow:
                0 0 0 4px var(--ring),
                0 0 22px var(--accent-glow);
        }

        .setting-item select option {
            background-color: var(--bg-2);
            color: var(--text);
        }

        .setting-item input::placeholder {
            color: var(--text-dim);
        }

        /* ============ BOTTOM ACTION BUTTONS ============ */
        .action-bar {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 26px;
            padding-top: 22px;
            border-top: 1px solid var(--card-border);
            animation: slideUp 0.6s 0.4s ease both;
            flex-wrap: wrap;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 13px 28px;
            border-radius: 12px;
            background: linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.02));
            border: 1.5px solid var(--input-border);
            color: var(--text);
            font-family: inherit;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow:
                0 8px 24px -12px var(--shadow),
                inset 0 1px 0 rgba(255,255,255,.05);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }

        .action-btn svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform 0.3s ease;
        }

        .action-btn:hover {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border-color: transparent;
            color: #ffffff;
            transform: translateY(-3px);
            box-shadow:
                0 16px 40px -10px var(--accent-glow),
                0 0 0 1px var(--accent-glow);
        }

        .action-btn:hover svg {
            transform: translateX(-3px);
        }

        .action-btn:active {
            transform: translateY(-1px) scale(0.98);
        }

        /* ============ PAGE SLIDE TRANSITION ============ */
        .page-slide {
            position: fixed;
            inset: 0;
            z-index: 30000;
            background: var(--bg);
            transform: translateX(100%);
            transition: transform .55s cubic-bezier(.65, 0, .35, 1);
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .page-slide::after {
            content: "";
            width: 44px;
            height: 44px;
            border: 3px solid var(--input-border);
            border-top-color: var(--accent);
            border-radius: 50%;
            opacity: 0;
        }

        .page-slide.active {
            transform: translateX(0);
            pointer-events: auto;
        }

        .page-slide.active::after {
            opacity: 1;
            animation: spin .9s linear infinite;
            animation-delay: .3s;
        }

        /* Enter animation (when arriving from another page) */
        .page-slide.enter {
            transform: translateX(0);
            transition: none;
        }

        .page-slide.enter.leaving {
            transform: translateX(-100%);
            transition: transform .55s cubic-bezier(.65, 0, .35, 1);
        }

        @media (max-width: 600px) {
            .topbar {
                top: 12px;
                right: 12px;
                gap: 4px;
                padding: 4px;
            }

            .topbar a {
                width: 38px;
                height: 34px;
            }

            .topbar a.games-btn {
                padding: 0 10px 0 8px;
                font-size: 11.5px;
            }

            .topbar a.games-btn span {
                display: none;
            }

            .topbar a.games-btn {
                width: 38px;
                padding: 0;
            }

            .settings-wrapper {
                padding: 30px 14px 40px;
                gap: 13px;
            }

            .farius-logo {
                height: 56px;
            }

            .page-title {
                margin-left: 2px;
            }

            .settings-container {
                padding: 17px 18px;
                border-radius: 15px;
            }

            .setting-item {
                gap: 12px;
            }

            .setting-item label {
                font-size: 0.76rem;
            }

            .setting-item select {
                min-width: 132px;
                max-width: 52%;
                padding-left: 10px;
                padding-right: 25px;
            }

            .setting-item input {
                width: 52%;
                min-width: 0;
            }

            #custom-wisp-server-container {
                align-items: flex-start;
            }

            .action-bar {
                gap: 8px;
            }

            .action-btn {
                padding: 11px 20px;
                font-size: 0.8rem;
            }
        }

        @media (max-width: 360px) {
            .setting-item {
                align-items: flex-start;
                flex-direction: column;
            }

            .setting-item select,
            .setting-item input {
                width: 100%;
                max-width: none;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>

    <div class="noise"></div>

    <!-- TOPBAR -->
    <div class="topbar">
        <a href="/" title="Home">
            <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
        </a>
        <a href="/settings" class="active" title="Settings">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </a>
        <a href="/gnmath.html" class="games-btn" id="gamesBtn" title="Play Games">
            <svg viewBox="0 0 24 24">
                <rect x="2" y="6" width="20" height="12" rx="3"/>
                <path d="M6 12h4M8 10v4M15 11h.01M17.5 13h.01"/>
            </svg>
            <span>Games</span>
        </a>
    </div>

    <div class="settings-wrapper">

        <!-- LOGO -->
        <div class="logo-area">
            <img src="https://cdn.jsdelivr.net/gh/lostgemsy/SrFrosty-games@main/logo.png" alt="Farius" class="farius-logo"
                 onerror="this.style.display='none'; document.querySelector('.logo-fallback').style.display='block';">
            <div class="logo-fallback">Farius</div>
        </div>

        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Make sure to use DuckDuckGo — Google ain't workin :sob</p>

        <div class="settings-container" style="animation-delay: 0.05s;">
            <div class="setting-item">
                <label for="type">Proxy Type</label>
                <select id="type">
                    <option value="ultraviolet">Ultraviolet</option>
                    <option value="scramjet">Scramjet</option>
                </select>
            </div>
        </div>

        <div class="settings-container" style="animation-delay: 0.1s;">
            <div class="setting-item">
                <label for="search-engine">Search Engine</label>
                <select id="search-engine">
                    <option value="https://duckduckgo.com/?q=">DuckDuckGo</option>
                    <option value="https://www.bing.com/search?q=">Bing</option>
                    <option value="https://search.brave.com/search?q=">Brave</option>
                    <option value="https://www.google.com/search?q=">Google</option>
                    <option value="https://www.ecosia.org/search?q=">Ecosia</option>
                </select>
            </div>
        </div>

        <div class="settings-container" style="animation-delay: 0.15s;">
            <div class="setting-item">
                <label for="transport-type">Transport</label>
                <select id="transport-type">
                    <option value="libcurl">Libcurl</option>
                    <option value="epoxy">Epoxy</option>
                </select>
            </div>
        </div>

        <div class="settings-container" style="animation-delay: 0.2s;">
            <div class="setting-item">
                <label for="wisp-server-type">Wisp Server</label>
                <select id="wisp-server-type">
                    <option value="default">Default</option>
                    <option value="custom">Custom</option>
                </select>
            </div>
            <div class="setting-item" id="custom-wisp-server-container" style="display: none;">
                <label for="custom-wisp-server-input">Custom Wisp URL</label>
                <input type="text" id="custom-wisp-server-input" placeholder="wss://your-wisp.com/wisp/">
            </div>
        </div>

        <!-- SINGLE ACTION BUTTON -->
        <div class="action-bar">
            <a href="/" class="action-btn">
                <svg viewBox="0 0 24 24"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 20v-6h6v6"/></svg>
                Back to Home
            </a>
        </div>

    </div>

    <!-- PAGE SLIDE OVERLAY -->
    <div class="page-slide" id="pageSlide"></div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            /* ============ PAGE SLIDE — ENTER ANIMATION ============ */
            (function () {
                const slide = document.getElementById("pageSlide");
                if (sessionStorage.getItem("slideFrom")) {
                    sessionStorage.removeItem("slideFrom");
                    slide.classList.add("enter");
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            slide.classList.add("leaving");
                        });
                    });
                    setTimeout(() => {
                        slide.classList.remove("enter", "leaving");
                    }, 700);
                }
            })();

            /* ============ PAGE SLIDE — EXIT ANIMATION (Games button) ============ */
            const gamesBtn = document.getElementById("gamesBtn");
            gamesBtn.addEventListener("click", (e) => {
                e.preventDefault();
                const slide = document.getElementById("pageSlide");
                slide.classList.add("active");
                sessionStorage.setItem("slideFrom", "true");
                setTimeout(() => {
                    window.location.href = "/gnmath.html";
                }, 620);
            });

            /* ============ SETTINGS LOGIC ============ */
            const defaultBg = '/assets/backgrounds/foggy-forest.png';
            let bg = localStorage.getItem('bg');
            if (!bg) {
                bg = defaultBg;
                localStorage.setItem('bg', bg);
            }

            const proxyTypeSelect = document.getElementById('type');
            if (!localStorage.getItem('proxy')) localStorage.setItem('proxy', 'ultraviolet');
            proxyTypeSelect.value = localStorage.getItem('proxy');
            proxyTypeSelect.addEventListener('change', (event) => localStorage.setItem('proxy', event.target.value));

            // Default search engine = DuckDuckGo
            const searchEngineSelect = document.getElementById('search-engine');
            if (!localStorage.getItem('search')) localStorage.setItem('search', 'https://duckduckgo.com/?q=');
            searchEngineSelect.value = localStorage.getItem('search');
            searchEngineSelect.addEventListener('change', (event) => localStorage.setItem('search', event.target.value));

            const transportTypeSelect = document.getElementById('transport-type');
            if (!localStorage.getItem('transport')) localStorage.setItem('transport', 'libcurl');
            transportTypeSelect.value = localStorage.getItem('transport');
            transportTypeSelect.addEventListener('change', (event) => localStorage.setItem('transport', event.target.value));

            const wispServerTypeSelect = document.getElementById('wisp-server-type');
            const customWispServerContainer = document.getElementById('custom-wisp-server-container');
            const customWispServerInput = document.getElementById('custom-wisp-server-input');
            const defaultWispUrl = `wss://${window.location.host}/wisp/`;

            if (!localStorage.getItem('wisp')) localStorage.setItem('wisp', defaultWispUrl);

            const currentWispUrl = localStorage.getItem('wisp');
            if (currentWispUrl === defaultWispUrl) {
                wispServerTypeSelect.value = 'default';
                customWispServerInput.value = '';
            } else {
                wispServerTypeSelect.value = 'custom';
                customWispServerInput.value = currentWispUrl;
            }

            const updateWispServerVisibility = () => {
                if (wispServerTypeSelect.value === 'custom') {
                    customWispServerContainer.style.display = 'flex';
                } else {
                    customWispServerContainer.style.display = 'none';
                }
            };
            updateWispServerVisibility();

            wispServerTypeSelect.addEventListener('change', (event) => {
                const selectedType = event.target.value;
                if (selectedType === 'default') localStorage.setItem('wisp', defaultWispUrl);
                else localStorage.setItem('wisp', customWispServerInput.value);
                updateWispServerVisibility();
            });

            customWispServerInput.addEventListener('input', (event) => {
                if (wispServerTypeSelect.value === 'custom') localStorage.setItem('wisp', event.target.value);
            });

            const savedFont = localStorage.getItem('font');
            if (savedFont) document.body.style.fontFamily = savedFont;
        });
    </script>
</body>
</html>
