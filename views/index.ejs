            }
            return '';
        }

        function buildOSContent(type, opts, winId) {
            if (type === 'browser') return buildOSBrowser(opts);
            if (type === 'calculator') return buildOSCalculator();
            if (type === 'clock') return buildOSClock();
            if (type === 'wallpaper') return buildOSWallpaper();
            if (type === 'settings') return buildOSSettings();
            return document.createElement('div');
        }

        function buildOSBrowser(opts) {
            const wrap = document.createElement('div');
            wrap.className = 'os-browser-inner';

            const bar = document.createElement('div');
            bar.className = 'os-browser-bar';

            const back = document.createElement('button');
            back.innerHTML = '<svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>';
            back.title = 'Back';

            const forward = document.createElement('button');
            forward.innerHTML = '<svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>';
            forward.title = 'Forward';

            const refresh = document.createElement('button');
            refresh.innerHTML = '<svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 11-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>';
            refresh.title = 'Refresh';

            const urlWrap = document.createElement('div');
            urlWrap.className = 'os-browser-url';

            const input = document.createElement('input');
            input.type = 'text';
            input.placeholder = 'Search or enter URL...';
            input.value = opts.url || '';

            urlWrap.appendChild(input);

            const goBtn = document.createElement('button');
            goBtn.innerHTML = '<svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>';
            goBtn.title = 'Go';
            goBtn.style.width = '26px';
            goBtn.style.height = '26px';

            bar.appendChild(back);
            bar.appendChild(forward);
            bar.appendChild(refresh);
            bar.appendChild(urlWrap);
            bar.appendChild(goBtn);

            const iframe = document.createElement('iframe');
            iframe.className = 'os-browser-iframe';
            iframe.referrerPolicy = 'no-referrer';
            iframe.allowFullscreen = true;

            let history = [];
            let historyIdx = -1;

            function navigate(raw) {
                const url = normalizeUrl(raw);
                if (!url) return;
                if (historyIdx < history.length - 1) {
                    history = history.slice(0, historyIdx + 1);
                }
                history.push(url);
                historyIdx = history.length - 1;
                input.value = url;
                iframe.src = getProxyUrl(url);
                updateNav();
            }

            function updateNav() {
                back.disabled = historyIdx <= 0;
                forward.disabled = historyIdx >= history.length - 1;
            }

            back.addEventListener('click', () => {
                if (historyIdx > 0) {
                    historyIdx--;
                    input.value = history[historyIdx];
                    iframe.src = getProxyUrl(history[historyIdx]);
                    updateNav();
                }
            });
            forward.addEventListener('click', () => {
                if (historyIdx < history.length - 1) {
                    historyIdx++;
                    input.value = history[historyIdx];
                    iframe.src = getProxyUrl(history[historyIdx]);
                    updateNav();
                }
            });
            refresh.addEventListener('click', () => {
                if (history[historyIdx]) {
                    iframe.src = getProxyUrl(history[historyIdx]);
                }
            });
            goBtn.addEventListener('click', () => navigate(input.value));
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') navigate(input.value);
            });

            if (opts.url) {
                setTimeout(() => navigate(opts.url), 100);
            }

            wrap.appendChild(bar);
            wrap.appendChild(iframe);
            return wrap;
        }

        function buildOSCalculator() {
            const wrap = document.createElement('div');
            wrap.style.display = 'flex';
            wrap.style.flexDirection = 'column';
            wrap.style.height = '100%';

            const display = document.createElement('div');
            display.className = 'os-calc-display';
            display.textContent = '0';

            const grid = document.createElement('div');
            grid.className = 'os-calc-grid';

            let current = '0';
            let previous = null;
            let op = null;
            let reset = false;

            const buttons = [
                { t: 'C', c: 'clr' }, { t: '⌫', c: '' }, { t: '%', c: 'op' }, { t: '÷', c: 'op', v: '/' },
                { t: '7', c: '' }, { t: '8', c: '' }, { t: '9', c: '' }, { t: '×', c: 'op', v: '*' },
                { t: '4', c: '' }, { t: '5', c: '' }, { t: '6', c: '' }, { t: '−', c: 'op', v: '-' },
                { t: '1', c: '' }, { t: '2', c: '' }, { t: '3', c: '' }, { t: '+', c: 'op', v: '+' },
                { t: '±', c: '' }, { t: '0', c: '' }, { t: '.', c: '' }, { t: '=', c: 'eq' }
            ];

            function update() { display.textContent = current; }

            function handle(action) {
                if (/[0-9]/.test(action) && action.length === 1) {
                    if (reset) { current = action; reset = false; }
                    else { current = current === '0' ? action : current + action; }
                } else if (action === '.') {
                    if (reset) { current = '0.'; reset = false; }
                    else if (!current.includes('.')) current += '.';
                } else if (action === 'C') {
                    current = '0'; previous = null; op = null; reset = false;
                } else if (action === '⌫') {
                    current = current.length > 1 ? current.slice(0, -1) : '0';
                } else if (action === '±') {
                    current = current.startsWith('-') ? current.slice(1) : '-' + current;
                } else if (action === '%') {
                    current = String(parseFloat(current) / 100);
                } else if (['+','-','*','/'].includes(action)) {
                    if (op !== null && !reset) compute();
                    previous = current; op = action; reset = true;
                } else if (action === '=') {
                    compute();
                }
                update();
            }

            function compute() {
                if (op === null || previous === null) return;
                const a = parseFloat(previous), b = parseFloat(current);
                let r = 0;
                if (op === '+') r = a + b;
                else if (op === '-') r = a - b;
                else if (op === '*') r = a * b;
                else if (op === '/') r = b === 0 ? NaN : a / b;
                current = String(r);
                previous = null; op = null; reset = true;
                update();
            }

            buttons.forEach(b => {
                const btn = document.createElement('button');
                btn.className = 'os-calc-btn ' + b.c;
                btn.textContent = b.t;
                btn.addEventListener('click', () => handle(b.v || b.t));
                grid.appendChild(btn);
            });

            wrap.appendChild(display);
            wrap.appendChild(grid);
            return wrap;
        }

        function buildOSClock() {
            const wrap = document.createElement('div');
