<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel · Farium</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: linear-gradient(180deg, #07140a, #0c1d12);
        color: #eefaf0;
        font-family: Inter, Arial, sans-serif;
        padding: 24px;
      }
      .wrap {
        max-width: 980px;
        margin: 0 auto;
      }
      .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
      }
      .card {
        background: rgba(15, 28, 20, 0.9);
        border: 1px solid rgba(160, 245, 160, 0.2);
        border-radius: 18px;
        overflow: hidden;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        padding: 13px 16px;
        text-align: left;
        border-bottom: 1px solid rgba(160, 245, 160, 0.12);
      }
      th {
        background: rgba(26, 46, 32, 0.8);
      }
      button {
        border: none;
        border-radius: 10px;
        padding: 8px 12px;
        font-weight: 700;
        cursor: pointer;
      }
      .ban { background: #f26d6d; color: white; }
      .unban { background: #4bcf8d; color: white; }
      .mute { background: #f7c948; color: #0d1f12; }
      .unmute { background: #7992ff; color: white; }
      .link { color: #bfeec2; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="top">
        <h1>Admin Panel</h1>
        <div>
          <a class="link" href="/chat">Chat</a> · <a class="link" href="/logout">Log out</a>
        </div>
      </div>

      <div class="card">
        <table>
          <thead>
            <tr>
              <th>Username</th>
              <th>Role</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="user-table-body"></tbody>
        </table>
      </div>
    </div>

    <script>
      async function loadUsers() {
        const response = await fetch('/api/admin/users');
        const data = await response.json();
        const tbody = document.getElementById('user-table-body');
        tbody.innerHTML = '';

        data.users.forEach((user) => {
          const row = document.createElement('tr');
          row.innerHTML = `
            <td>${user.username}</td>
            <td>${user.role}</td>
            <td>${user.banned ? 'Banned' : user.muted ? 'Muted' : 'Active'}</td>
            <td>
              ${user.banned ? `<button class="unban" data-action="unban" data-user="${user.username}">Unban</button>` : `<button class="ban" data-action="ban" data-user="${user.username}">Ban</button>`}
              ${user.muted ? `<button class="unmute" data-action="unmute" data-user="${user.username}">Unmute</button>` : `<button class="mute" data-action="mute" data-user="${user.username}">Mute</button>`}
            </td>
          `;
          tbody.appendChild(row);
        });

        document.querySelectorAll('button[data-action]').forEach((button) => {
          button.addEventListener('click', async () => {
            const action = button.dataset.action;
            const username = button.dataset.user;
            await fetch(`/api/admin/${action}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ username })
            });
            loadUsers();
          });
        });
      }

      loadUsers();
    </script>
  </body>
</html>
