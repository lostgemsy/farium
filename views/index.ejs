<script>
/* =========================================================
   GAMES NAV SLIDE
========================================================= */

(function(){
  const gamesBtn = document.getElementById('gamesNav');
  const slide = document.getElementById('pageSlide');

  if(!gamesBtn || !slide) return;

  // If returning from a slide navigation, animate in
  if(sessionStorage.getItem('slideFrom')){
    sessionStorage.removeItem('slideFrom');
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        slide.style.transform = 'translateX(100%)';
        slide.style.pointerEvents = 'none';
      });
    });
  }

  gamesBtn.addEventListener('click', function(e){
    e.preventDefault();
    // Slide out
    slide.style.transform = 'translateX(0)';
    slide.style.pointerEvents = 'auto';
    sessionStorage.setItem('slideFrom', 'true');
    setTimeout(function(){
      window.location.href = '/gnmath.html';
    }, 450);
  });
})();
</script>

